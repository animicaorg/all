# Netlify-style redirects & rewrites
# Order matters: first match wins.

# --- Canonical host (optional) ---
# If you host both apex and www, choose one:
# http://animica.org/*   https://www.animica.org/:splat   301!
# http://www.animica.org/* https://animica.org/:splat     301!

# --- Short-links to external apps ---
/studio      https://studio.animica.org/                 302
/explorer    https://explorer.animica.org/               302

# --- Docs hosted elsewhere ---
/docs        /docs/                                      301
/docs/*      https://docs.animica.org/:splat             301

# --- RPC proxy (optional; uncomment & edit host) ---
# /rpc/*     http://127.0.0.1:8545/:splat              200
# /ws/*      ws://127.0.0.1:8546/:splat                200

# --- Ensure API/serverless routes are not swallowed by SPA fallback ---
/api/*       /api/:splat                                 200

# --- SPA fallback for client-side routes (keep last) ---
/*           /index.html                                 200
