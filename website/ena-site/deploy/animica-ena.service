[Unit]
Description=Animica ENA coordinator (useful-work queue + stats API)
After=network.target

[Service]
Type=simple
User=root
Environment=ANIMICA_ENA_HOME=/var/lib/animica-ena
ExecStart=/root/animica/.venv/bin/animica ena serve --host 127.0.0.1 --port 8791
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
