---
import { links } from "../config/links";
import { docsUrl, explorerUrl, studioUrl } from "../env";

interface Props {
  align?: "start" | "center" | "end";
  showExplorer?: boolean;
  showDocs?: boolean;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  align = "start",
  showExplorer = true,
  showDocs = true,
  size = "md",
  class: className = "",
} = Astro.props as Props;

const studioHref = links?.studio?.home ?? studioUrl ?? "/studio";
const explorerHref = links?.explorer?.home ?? explorerUrl ?? "/explorer";
const docsHref = links?.docs?.home ?? docsUrl ?? "/docs";

const sizeClass = size === "sm" ? "button--sm" : size === "lg" ? "button--lg" : "";
const justifyClass = 
  align === "center" ? "cta-buttons--center" : 
  align === "end" ? "cta-buttons--end" : "";
---

<div class={`cta-buttons ${justifyClass} ${className}`}>
  <!-- Launch Studio (primary) -->
  <a
    href={studioHref}
    class={`button button--primary ${sizeClass} hover-lift group`}
    aria-label="Launch Studio"
  >
    <span>Launch Studio</span>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="cta-icon">
      <path fill="currentColor" d="M14 3h7v7h-2V6.41L9.41 16 8 14.59 16.59 6H14V3zM5 5h5V3H5a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-5h-2v5H5V5z"/>
    </svg>
  </a>

  {showExplorer && (
    <a
      href={explorerHref}
      class={`button button--outline ${sizeClass} hover-lift group`}
      aria-label="Open Explorer"
    >
      <span>Open Explorer</span>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="cta-icon">
        <path fill="currentColor" d="M12 2a10 10 0 1 0 .001 20.001A10 10 0 0 0 12 2m6.92 6h-5.01l-2 3.5l2.75 4.77l4.26-7.27zM11 7l-2 3.5H5.08A8 8 0 0 1 11 7m-5.84 10A7.96 7.96 0 0 1 4 12c0-.34.03-.67.08-1h4.91l2 3.5L8.24 17H5.16zM12 20a8 8 0 0 1-1-.07l2.76-4.73L18.84 17A8 8 0 0 1 12 20"/>
      </svg>
    </a>
  )}

  {showDocs && (
    <a
      href={docsHref}
      class={`button button--ghost ${sizeClass} hover-lift`}
      aria-label="Read Docs"
    >
      <span>Read Docs</span>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="cta-icon">
        <path fill="currentColor" d="M6 2h9a3 3 0 0 1 3 3v14.5a.5.5 0 0 1-.8.4L15 18H6a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3m0 2a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h9.5l.5.4V5a1 1 0 0 0-1-1z"/>
      </svg>
    </a>
  )}
</div>

<style>
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .cta-buttons--center {
    justify-content: center;
  }

  .cta-buttons--end {
    justify-content: flex-end;
  }

  @media (max-width: 640px) {
    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-buttons .button {
      width: 100%;
      justify-content: center;
    }
  }

  .cta-buttons .button {
    position: relative;
    overflow: hidden;
  }
  
  /* Shimmer effect on hover */
  .cta-buttons .button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.2) 50%,
      transparent 100%
    );
    transition: left 0.6s ease;
  }
  
  .cta-buttons .button:hover::before {
    left: 100%;
  }

  .cta-icon {
    transition: transform 0.3s ease;
  }

  .group:hover .cta-icon {
    transform: translateX(3px) translateY(-1px);
  }
  
  /* Enhanced glow for primary button */
  .cta-buttons .button--primary {
    box-shadow: 0 4px 14px rgba(139, 92, 246, 0.3);
  }
  
  .cta-buttons .button--primary:hover {
    box-shadow: 0 6px 20px rgba(139, 92, 246, 0.5), 0 0 40px rgba(34, 211, 238, 0.3);
    transform: translateY(-2px);
  }
  
  /* Enhanced outline button */
  .cta-buttons .button--outline {
    backdrop-filter: blur(8px);
    border-color: rgba(139, 92, 246, 0.3);
  }
  
  .cta-buttons .button--outline:hover {
    border-color: rgba(139, 92, 246, 0.6);
    background: rgba(139, 92, 246, 0.1);
    box-shadow: 0 4px 14px rgba(139, 92, 246, 0.2);
  }
</style>
