---
import site from "../config/site";

const year = new Date().getFullYear();
---

<footer class="aicf-footer">
  <div class="aicf-footer-inner">
    <div>
      <p class="aicf-footer-brand">{site.brand}</p>
      <p class="aicf-footer-copy">
        Post-quantum blockchain infrastructure for wallets, nodes, contracts, explorer tooling, and compute services. AICF is one workload lane in the broader Animica ecosystem.
      </p>
      <p class="aicf-footer-meta">© {year} {site.brand} · {site.contact.email}</p>
    </div>

    {site.nav.footer.map((section) => (
      <div>
        <p class="aicf-footer-title">{section.title}</p>
        <ul class="aicf-footer-links">
          {section.items.map((item) => (
            <li>
              <a
                href={item.href}
                {...(item.external ? { rel: "noopener noreferrer", target: "_blank" } : {})}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</footer>
