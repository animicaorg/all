---
/**
 * ParticleLogo — interactive particle rendering of the Animica wallet mark.
 *
 * The silhouette (thin ring + upward triangle + rounded crossbar) is the same
 * brand mark drawn by the wallet apps (see wallet/lib/widgets/brand/brand_logo.dart
 * and the ◬ glyph used as the wallet favicon). Here it is reconstructed on an
 * offscreen canvas, sampled into a few thousand particles, and animated:
 *   • particles spring toward their home position in the logo
 *   • the cursor / touch point repels nearby particles and draws constellation
 *     lines toward them
 *   • clicking or tapping fires a shockwave that scatters the mark, then it
 *     reassembles
 *
 * Pure vanilla canvas, no dependencies. Honors prefers-reduced-motion by
 * rendering a single static frame with no interaction loop.
 */
---

<section class="particle-banner" aria-label="Animica">
  <canvas
    class="particle-banner__canvas"
    data-particle-logo
    role="img"
    aria-label="Animica logo"></canvas>
  <p class="particle-banner__hint" data-particle-hint aria-hidden="true">
    Move your cursor through the mark · click to scatter
  </p>
  <span class="sr-only">Animica — post-quantum L1</span>
</section>

<style>
  .particle-banner {
    position: relative;
    width: 100%;
    height: clamp(280px, 42vh, 460px);
    margin: 0 auto;
    overflow: hidden;
    isolation: isolate;
  }

  .particle-banner__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
    touch-action: pan-y;
  }

  .particle-banner__hint {
    position: absolute;
    left: 50%;
    bottom: clamp(0.6rem, 2vh, 1.1rem);
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--brand-200, #8ff7e6), transparent 35%);
    opacity: 0.55;
    pointer-events: none;
    transition: opacity 600ms ease;
    user-select: none;
  }

  .particle-banner.is-touched .particle-banner__hint {
    opacity: 0;
  }

  @media (max-width: 520px) {
    .particle-banner__hint {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .particle-banner__canvas {
      cursor: default;
    }
    .particle-banner__hint {
      display: none;
    }
  }
</style>

<script>
  type Pt = { x: number; y: number };

  interface Particle {
    x: number;
    y: number;
    hx: number; // home x
    hy: number; // home y
    vx: number;
    vy: number;
    size: number;
    sprite: number; // index into glow sprite palette
    phase: number; // twinkle phase
    tw: number; // twinkle speed
  }

  const banner = document.querySelector<HTMLElement>(".particle-banner");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-particle-logo]");
  const hint = document.querySelector<HTMLElement>("[data-particle-hint]");

  if (banner && canvas) {
    const ctx = canvas.getContext("2d", { alpha: true })!;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // Brand palette — same mint→cyan the wallet mark uses.
    const PALETTE = ["#8ff7e6", "#5eead4", "#3ad4bd", "#3a9bff"];

    // Tunables
    const SPRING = 0.012;
    const DAMPING = 0.9;
    const REPEL_RADIUS = 116;
    const REPEL_FORCE = 2.0;
    const LINE_RADIUS = 96;
    const MAX_PARTICLES = 2400;

    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let W = 0;
    let H = 0;
    let particles: Particle[] = [];
    let sprites: HTMLCanvasElement[] = [];
    let spriteSize = 14;

    const pointer = { x: -9999, y: -9999, active: false };
    const shock = { x: 0, y: 0, t: 0 }; // t = remaining strength

    // ── Draw the wallet brand mark into a 1-channel offscreen canvas ──────
    function drawMark(c: CanvasRenderingContext2D, S: number) {
      c.clearRect(0, 0, S, S);
      c.fillStyle = "#fff";
      c.strokeStyle = "#fff";
      const cx = S / 2;
      const cy = S / 2;

      // Thin circular ring
      c.lineWidth = S * 0.03;
      c.beginPath();
      c.arc(cx, cy, S * 0.36, 0, Math.PI * 2);
      c.stroke();

      // Upward triangle (core mark)
      c.beginPath();
      c.moveTo(cx, S * 0.28);
      c.lineTo(S * 0.68, S * 0.74);
      c.lineTo(S * 0.32, S * 0.74);
      c.closePath();
      c.fill();
    }

    // ── Build glow sprites (one per palette colour) ───────────────────────
    function buildSprites(d: number) {
      spriteSize = d;
      sprites = PALETTE.map((col) => {
        const s = document.createElement("canvas");
        s.width = s.height = d;
        const g = s.getContext("2d")!;
        const grd = g.createRadialGradient(d / 2, d / 2, 0, d / 2, d / 2, d / 2);
        grd.addColorStop(0, col);
        grd.addColorStop(0.35, hexToRgba(col, 0.55));
        grd.addColorStop(1, hexToRgba(col, 0));
        g.fillStyle = grd;
        g.fillRect(0, 0, d, d);
        return s;
      });
    }

    function hexToRgba(hex: string, a: number) {
      const n = parseInt(hex.slice(1), 16);
      const r = (n >> 16) & 255;
      const g = (n >> 8) & 255;
      const b = n & 255;
      return `rgba(${r},${g},${b},${a})`;
    }

    // ── Sample the mark into particle home positions ──────────────────────
    function buildParticles() {
      const box = Math.min(H * 0.86, W * 0.52, 460);
      const off = document.createElement("canvas");
      off.width = off.height = Math.round(box);
      const oc = off.getContext("2d", { willReadFrequently: true })!;
      drawMark(oc, off.width);
      const data = oc.getImageData(0, 0, off.width, off.height).data;

      const step = Math.max(2, Math.round(off.width / 132));
      const offX = (W - box) / 2;
      const offY = (H - box) / 2;

      let pts: Pt[] = [];
      for (let y = 0; y < off.height; y += step) {
        for (let x = 0; x < off.width; x += step) {
          if (data[(y * off.width + x) * 4 + 3] > 130) {
            pts.push({ x: offX + x, y: offY + y });
          }
        }
      }

      // Cap particle count for steady framerate.
      if (pts.length > MAX_PARTICLES) {
        const keep = MAX_PARTICLES / pts.length;
        pts = pts.filter(() => Math.random() < keep);
      }

      const cx = W / 2;
      particles = pts.map((p) => {
        // Tint by horizontal position across the mark → mint→cyan sweep.
        const frac = Math.min(1, Math.max(0, (p.x - offX) / box));
        const sprite = Math.min(
          PALETTE.length - 1,
          Math.floor(frac * PALETTE.length)
        );
        // Seed off-screen-ish so the mark assembles on first paint.
        const ang = Math.random() * Math.PI * 2;
        const rad = Math.max(W, H) * (0.4 + Math.random() * 0.5);
        return {
          x: cx + Math.cos(ang) * rad,
          y: H / 2 + Math.sin(ang) * rad,
          hx: p.x,
          hy: p.y,
          vx: 0,
          vy: 0,
          size: 2.2 + Math.random() * 2.4,
          sprite,
          phase: Math.random() * Math.PI * 2,
          tw: 0.6 + Math.random() * 1.4,
        };
      });
    }

    // ── Sizing ────────────────────────────────────────────────────────────
    function resize() {
      const rect = banner!.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildSprites(14);
      buildParticles();
      if (reduceMotion) renderStatic();
    }

    function renderStatic() {
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = "lighter";
      for (const p of particles) {
        const s = spriteSize * (p.size / 3);
        ctx.globalAlpha = 0.85;
        ctx.drawImage(sprites[p.sprite], p.hx - s / 2, p.hy - s / 2, s, s);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";
    }

    // ── Animation loop ────────────────────────────────────────────────────
    let t = 0;
    function frame() {
      t += 0.016;
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = "lighter";

      const rr2 = REPEL_RADIUS * REPEL_RADIUS;
      const lr2 = LINE_RADIUS * LINE_RADIUS;
      shock.t *= 0.9;

      for (const p of particles) {
        // Spring toward home.
        let ax = (p.hx - p.x) * SPRING;
        let ay = (p.hy - p.y) * SPRING;

        // Cursor repulsion.
        if (pointer.active) {
          const dx = p.x - pointer.x;
          const dy = p.y - pointer.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < rr2 && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const f = (1 - d / REPEL_RADIUS) * REPEL_FORCE;
            ax += (dx / d) * f;
            ay += (dy / d) * f;
          }
        }

        // Click shockwave.
        if (shock.t > 0.5) {
          const dx = p.x - shock.x;
          const dy = p.y - shock.y;
          const d = Math.sqrt(dx * dx + dy * dy) || 1;
          const f = (shock.t / d) * 9;
          ax += (dx / d) * f;
          ay += (dy / d) * f;
        }

        p.vx = (p.vx + ax) * DAMPING;
        p.vy = (p.vy + ay) * DAMPING;
        p.x += p.vx;
        p.y += p.vy;

        // Constellation line toward the cursor when close.
        if (pointer.active) {
          const dx = p.x - pointer.x;
          const dy = p.y - pointer.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < lr2) {
            const a = (1 - Math.sqrt(d2) / LINE_RADIUS) * 0.5;
            ctx.strokeStyle = hexToRgba(PALETTE[p.sprite], a);
            ctx.lineWidth = 0.6;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(pointer.x, pointer.y);
            ctx.stroke();
          }
        }

        // Twinkle.
        const tw = 0.72 + 0.28 * Math.sin(t * p.tw + p.phase);
        const s = spriteSize * (p.size / 3);
        ctx.globalAlpha = tw;
        ctx.drawImage(sprites[p.sprite], p.x - s / 2, p.y - s / 2, s, s);
      }

      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";
      requestAnimationFrame(frame);
    }

    // ── Pointer handling ──────────────────────────────────────────────────
    function setPointer(clientX: number, clientY: number) {
      const rect = canvas!.getBoundingClientRect();
      pointer.x = clientX - rect.left;
      pointer.y = clientY - rect.top;
      pointer.active = true;
      banner!.classList.add("is-touched");
    }

    function fireShock(clientX: number, clientY: number) {
      const rect = canvas!.getBoundingClientRect();
      shock.x = clientX - rect.left;
      shock.y = clientY - rect.top;
      shock.t = 12;
    }

    if (!reduceMotion) {
      canvas.addEventListener("pointermove", (e) =>
        setPointer(e.clientX, e.clientY)
      );
      canvas.addEventListener("pointerleave", () => {
        pointer.active = false;
        pointer.x = pointer.y = -9999;
      });
      canvas.addEventListener("pointerdown", (e) => {
        setPointer(e.clientX, e.clientY);
        fireShock(e.clientX, e.clientY);
      });

      // Debounced resize.
      let rt: number | undefined;
      const onResize = () => {
        window.clearTimeout(rt);
        rt = window.setTimeout(resize, 150);
      };
      window.addEventListener("resize", onResize);

      resize();
      requestAnimationFrame(frame);

      // Fade the hint out after a few seconds even without interaction.
      window.setTimeout(() => hint?.style.setProperty("opacity", "0"), 6000);
    } else {
      resize();
    }
  }
</script>
