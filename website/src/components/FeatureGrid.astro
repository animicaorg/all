---
import { links } from "../config/links";
import { docsUrl } from "../env";

interface Feature {
  id: string;
  title: string;
  blurb: string;
  href?: string;
  icon?: "poies" | "da" | "vm" | "aicf" | "pq" | "quantum";
}

interface Props {
  items?: Feature[];
  columns?: 2 | 3;
  showLinks?: boolean;
  class?: string;
}

const docsHref = links?.docs?.home ?? docsUrl ?? "/docs";

const defaults: Feature[] = [
  {
    id: "poies",
    title: "PoIES consensus",
    blurb:
      "Proof-of-Integrated-External-Services: combines hash shares with useful work (AI/Quantum/Storage/VDF) under caps & fairness.",
    href: `${docsHref}#poies`,
    icon: "poies",
  },
  {
    id: "da",
    title: "Data Availability (DA)",
    blurb:
      "Namespaced Merkle Trees + erasure coding. Light clients verify blob availability via DAS proofs.",
    href: `${docsHref}#data-availability`,
    icon: "da",
  },
  {
    id: "vm",
    title: "Python VM (deterministic)",
    blurb:
      "Validate → compile → run contracts in a sandboxed Python VM with a tiny, auditable stdlib.",
    href: `${docsHref}#vm-py`,
    icon: "vm",
  },
  {
    id: "aicf",
    title: "AI Compute Fund (AICF)",
    blurb:
      "Queue, assign, attest, and settle off-chain AI/Quantum jobs with verifiable proofs and SLAs.",
    href: `${docsHref}#aicf`,
    icon: "aicf",
  },
  {
    id: "pq",
    title: "Post-Quantum (PQ) accounts",
    blurb:
      "Addresses and signatures using Dilithium / SPHINCS+. Domain separation and bech32m addresses.",
    href: `${docsHref}#post-quantum`,
    icon: "pq",
  },
  {
    id: "quantum",
    title: "Quantum proofs",
    blurb:
      "Provider attestations + trap circuits and QoS metrics map into ψ inputs alongside hash work.",
    href: `${docsHref}#quantum`,
    icon: "quantum",
  },
];

const {
  items = defaults,
  columns = 3,
  showLinks = true,
  class: className = "",
} = Astro.props as Props;

const iconMarkup: Record<Feature["icon"] | "default", string> = {
  poies: `
    <svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
      <path fill="currentColor" d="M12 2 3 6v6c0 5 4 9 9 10c5-1 9-5 9-10V6zM7 9l5-2l5 2v3c0 3.5-2.6 6.6-6 7.5C7.6 18.6 5 15.5 5 12z" />
      <circle cx="12" cy="12" r="2.25" fill="currentColor"/>
    </svg>
  `,
  da: `
    <svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
      <path fill="currentColor" d="M3 6l9-4l9 4v6c0 5-4 9-9 10C7 21 3 17 3 12zM12 5L7 7.2V12c0 3.09 2.2 5.9 5 6.7c2.8-.8 5-3.61 5-6.7V7.2z"/>
      <path fill="currentColor" d="M8.5 10.5h7v3h-7z"/>
    </svg>
  `,
  vm: `
    <svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
      <path fill="currentColor" d="M4 5h16v10H4zM2 17h20v2H2z"/>
      <path fill="currentColor" d="M7 7h2v6H7zm4 0h2v6h-2zm4 0h2v6h-2z"/>
    </svg>
  `,
  aicf: `
    <svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
      <path fill="currentColor" d="M12 2a5 5 0 0 1 5 5v1h2a3 3 0 0 1 0 6h-2v1a5 5 0 1 1-10 0v-1H5a3 3 0 0 1 0-6h2V7a5 5 0 0 1 5-5z"/>
      <path fill="currentColor" d="M11 8h2v8h-2z"/>
    </svg>
  `,
  pq: `
    <svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
      <path fill="currentColor" d="M12 3L2 9l10 6l10-6zm0 18l-6-3.6l-2 1.2L12 23l8-4.4l-2-1.2z"/>
    </svg>
  `,
  quantum: `
    <svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
      <circle cx="12" cy="12" r="2.25" fill="currentColor"/>
      <ellipse cx="12" cy="12" rx="9" ry="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <ellipse transform="rotate(60 12 12)" cx="12" cy="12" rx="9" ry="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <ellipse transform="rotate(-60 12 12)" cx="12" cy="12" rx="9" ry="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  `,
  default: `
    <svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
      <circle cx="12" cy="12" r="9" fill="currentColor"/>
    </svg>
  `,
};

function renderIcon(kind?: Feature["icon"]) {
  return iconMarkup[kind ?? "default"];
}
---

<section class={`feature-grid-section ${className}`}>
  <div class="feature-grid" data-columns={columns}>
    {items.map((f, index) => (
      <article
        class="feature-card scroll-reveal-up"
        style={`animation-delay: ${index * 100}ms`}
      >
        <div class="feature-icon-wrapper">
          <div class="feature-icon" set:html={renderIcon(f.icon)} />
          <div class="feature-icon-glow" aria-hidden="true"></div>
        </div>
        
        <div class="feature-content">
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-description">{f.blurb}</p>
        </div>

        {showLinks && f.href && (
          <a
            href={f.href}
            class="feature-link"
            aria-label={`Learn more about ${f.title}`}
          >
            <span>Learn more</span>
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="feature-link-icon">
              <path fill="currentColor" d="M14 3h7v7h-2V6.41L9.41 16 8 14.59 16.59 6H14V3z"/>
            </svg>
          </a>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .feature-grid-section {
    container-type: inline-size;
  }

  .feature-grid {
    display: grid;
    gap: 1.5rem;
    padding: 0;
  }

  .feature-grid[data-columns="2"] {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .feature-grid[data-columns="3"] {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  @media (min-width: 768px) {
    .feature-grid {
      gap: 2rem;
    }
  }

  /* Feature Card - Legendary UI Enhanced */
  .feature-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: var(--radius-xl);
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(34, 211, 238, 0.1));
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }
  
  .feature-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xl);
    padding: 1px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.4), rgba(34, 211, 238, 0.4));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35), 0 0 60px rgba(139, 92, 246, 0.3);
    border-color: rgba(139, 92, 246, 0.4);
  }

  .feature-card:hover::before {
    opacity: 1;
  }
  
  .feature-card:hover::after {
    opacity: 1;
  }

  /* Icon */
  .feature-icon-wrapper {
    position: relative;
    width: fit-content;
    margin-bottom: 1.5rem;
    z-index: 1;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(139, 92, 246, 0.3);
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(34, 211, 238, 0.15));
    color: var(--legendary-cyan-400);
    transition: all 0.3s ease;
  }

  .feature-card:hover .feature-icon {
    border-color: var(--legendary-purple-500);
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.25), rgba(34, 211, 238, 0.25));
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 8px 24px rgba(139, 92, 246, 0.4);
  }

  .feature-icon :global(.icon) {
    width: 1.75rem;
    height: 1.75rem;
  }

  .feature-icon-glow {
    position: absolute;
    inset: -15px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.5), transparent 60%);
    opacity: 0;
    filter: blur(25px);
    transition: opacity 0.3s ease;
    z-index: -1;
    animation: pulse 3s ease-in-out infinite;
  }

  .feature-card:hover .feature-icon-glow {
    opacity: 1;
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.8;
    }
  }

  /* Content */
  .feature-content {
    flex: 1;
    z-index: 1;
  }

  .feature-title {
    font-size: 1.125rem;
    font-weight: var(--weight-semibold);
    background: linear-gradient(135deg, var(--color-fg), var(--legendary-cyan-400));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .feature-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Link */
  .feature-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0.625rem 1rem;
    background: linear-gradient(135deg, var(--legendary-purple-500), var(--legendary-cyan-400));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: var(--weight-medium);
    border-radius: var(--radius-md);
    background-color: rgba(139, 92, 246, 0.08);
    border: 1px solid rgba(139, 92, 246, 0.2);
    transition: all 0.3s ease;
    width: fit-content;
    z-index: 1;
    position: relative;
  }
  
  .feature-link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(34, 211, 238, 0.2));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .feature-link:hover {
    background-color: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.4);
    transform: translateX(4px);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
  }
  
  .feature-link:hover::before {
    opacity: 1;
  }

  .feature-link-icon {
    transition: transform 0.3s ease;
    color: var(--legendary-cyan-400);
  }

  .feature-link:hover .feature-link-icon {
    transform: translateX(3px) translateY(-2px);
  }

  /* Reveal animation handled by global animations.css */
</style>

<script>
  // Intersection Observer for scroll-triggered animations
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.scroll-reveal-up');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    cards.forEach(card => observer.observe(card));
  });
</script>
