---
import site from "../config/site";
import { links } from "../config/links";

const nav = site.nav.top;
const activePath = Astro.url.pathname;
---

<header class="aicf-header">
  <div class="aicf-header-inner">
    <a href="/" class="aicf-brand" aria-label={site.brand}>
      <img src="/icons/logo.svg" width="24" height="24" alt="" />
      <span>
        {site.brand}
        <small>Post-Quantum L1</small>
      </span>
    </a>

    <nav class="aicf-nav" aria-label="Primary">
      {nav.map((item) => {
        const isActive = activePath === item.href || activePath.startsWith(item.href + "/");
        return (
          <a
            href={item.href}
            class={`aicf-nav-link ${isActive ? "active" : ""}`}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="aicf-header-actions">
      <a class="aicf-ghost-btn" href={links.explorer.home()} target="_blank" rel="noopener noreferrer">
        Explorer
      </a>
      <a class="aicf-cta-btn" href="/downloads">Downloads</a>
      <button class="aicf-mobile-toggle" aria-label="Toggle menu" data-mobile-toggle>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="aicf-mobile-nav" data-mobile-nav>
    <div class="aicf-mobile-nav-inner">
      {nav.map((item) => (
        <a href={item.href} class="aicf-mobile-link">{item.label}</a>
      ))}
      <a class="aicf-cta-btn" href="/downloads">Downloads</a>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.querySelector('[data-mobile-toggle]') as HTMLButtonElement | null;
      const nav = document.querySelector('[data-mobile-nav]') as HTMLDivElement | null;
      if (!toggle || !nav) return;

      toggle.addEventListener('click', () => {
        nav.classList.toggle('open');
        toggle.classList.toggle('open');
      });
    });
  </script>
</header>
