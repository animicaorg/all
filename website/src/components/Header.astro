---
import site from "../config/site";
import links from "../config/links";
import chains from "../config/chains";
import { chainId as envChainId, explorerUrl, rpcUrl as envRpcUrl, studioUrl } from "../env";

const nav = [
  { href: "/docs", label: "Docs" },
  { href: "/explorer", label: "Explorer" },
  { href: "/blog", label: "Blog" },
];

const studioHref = links?.studio?.home ?? studioUrl ?? "/studio";
const explorerHref = links?.explorer?.home ?? explorerUrl ?? "/explorer";

const chainId = envChainId ? String(envChainId) : "";
const rpcUrl = envRpcUrl ?? "";

const chainRec = Array.isArray(chains)
  ? chains.find((c: any) => String(c.chainId ?? c.id) === String(chainId))
  : undefined;

const networkName =
  chainRec?.name ??
  (chainId ? `Chain ${chainId}` : "Network");

const activePath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-container">
    <!-- Brand -->
    <a href="/" class="brand-link" aria-label={site.brand}>
      <img src="/icons/logo.svg" width="24" height="24" alt="" class="brand-logo" />
      <span class="brand-name">{site.brand}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary">
      {nav.map((item) => {
        const isActive = activePath === item.href || activePath.startsWith(item.href + "/");
        return (
          <a
            href={item.href}
            class={`nav-link ${isActive ? "nav-link--active" : ""}`}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <!-- Network Status Pill -->
      <div
        class="network-pill"
        data-network-pill
        title={rpcUrl ? `RPC: ${rpcUrl}` : "No RPC configured"}
      >
        <span class="network-status" data-dot></span>
        <span class="network-name" data-net-name>{networkName}</span>
        {chainId && <span class="network-chain-id" data-chain-id>· {chainId}</span>}
        <span class="sr-only" data-status-sr>(status unknown)</span>
      </div>

      <!-- CTA Button -->
      <a href={studioHref} class="button button--primary button--sm">
        <span>Launch Studio</span>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M14 3h7v7h-2V6.41L9.41 16 8 14.59 16.59 6H14V3zM5 5h5V3H5a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-5h-2v5H5V5z"/>
        </svg>
      </a>

      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" aria-label="Toggle navigation" data-mobile-menu-toggle>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" class="menu-icon">
          <path fill="currentColor" d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" class="close-icon">
          <path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div class="mobile-nav" data-mobile-nav>
    <nav class="mobile-nav-content" aria-label="Mobile">
      {nav.map((item) => {
        const isActive = activePath === item.href || activePath.startsWith(item.href + "/");
        return (
          <a
            href={item.href}
            class={`mobile-nav-link ${isActive ? "mobile-nav-link--active" : ""}`}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
      <a href={explorerHref} class="mobile-nav-link">
        Explorer
      </a>
      <a href={studioHref} class="button button--primary button--lg mobile-cta">
        Launch Studio
      </a>
    </nav>
  </div>

  <!-- Client-side: JSON-RPC network status check -->
  <script define:vars={{ rpcUrl }}>
    (function () {
      if (!rpcUrl) return;

      const dot = document.querySelector("[data-network-pill] [data-dot]");
      const pill = document.querySelector("[data-network-pill]");
      const sr = document.querySelector("[data-network-pill] [data-status-sr]");

      const setStatus = (state, tip) => {
        if (!dot || !pill) return;
        dot.dataset.status = state;
        if (sr) sr.textContent = "(" + state + (tip ? ", head " + tip : "") + ")";
        pill.dataset.status = state;
      };

      const ctrl = new AbortController();
      setTimeout(() => ctrl.abort(), 6_000);

      fetch(rpcUrl, {
        method: "POST",
        headers: {"content-type": "application/json"},
        body: JSON.stringify({
          jsonrpc: "2.0",
          id: 1,
          method: "chain.getHead",
          params: []
        }),
        signal: ctrl.signal
      })
      .then(r => r.json())
      .then(j => {
        const head = j?.result;
        const h = head && (head.number ?? head.height);
        const height = typeof h === "number" ? h : (typeof h === "string" ? Number(h) : undefined);
        setStatus("online", Number.isFinite(height) ? String(height) : undefined);
      })
      .catch(() => setStatus("offline"));
    })();
  </script>

  <!-- Mobile menu toggle script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.querySelector('[data-mobile-menu-toggle]');
      const mobileNav = document.querySelector('[data-mobile-nav]');
      
      if (toggleBtn && mobileNav) {
        toggleBtn.addEventListener('click', () => {
          const isOpen = mobileNav.classList.contains('mobile-nav--open');
          
          if (isOpen) {
            mobileNav.classList.remove('mobile-nav--open');
            toggleBtn.classList.remove('mobile-menu-btn--open');
            document.body.style.overflow = '';
          } else {
            mobileNav.classList.add('mobile-nav--open');
            toggleBtn.classList.add('mobile-menu-btn--open');
            document.body.style.overflow = 'hidden';
          }
        });

        // Close on escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && mobileNav.classList.contains('mobile-nav--open')) {
            mobileNav.classList.remove('mobile-nav--open');
            toggleBtn.classList.remove('mobile-menu-btn--open');
            document.body.style.overflow = '';
          }
        });

        // Close on outside click
        mobileNav.addEventListener('click', (e) => {
          if (e.target === mobileNav) {
            mobileNav.classList.remove('mobile-nav--open');
            toggleBtn.classList.remove('mobile-menu-btn--open');
            document.body.style.overflow = '';
          }
        });
      }
    });
  </script>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    backdrop-filter: var(--backdrop-blur);
    background: rgba(10, 14, 23, 0.8);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Brand */
  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--color-fg);
    font-weight: var(--weight-semibold);
    font-size: 1.125rem;
    transition: opacity var(--transition-fast);
  }

  .brand-link:hover {
    opacity: 0.9;
  }

  .brand-logo {
    width: 24px;
    height: 24px;
  }

  .brand-name {
    font-size: 1.125rem;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: var(--weight-medium);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-fg);
    background: rgba(99, 102, 241, 0.08);
  }

  .nav-link--active {
    color: var(--color-fg);
    background: rgba(99, 102, 241, 0.12);
  }

  .nav-link--active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0.875rem;
    right: 0.875rem;
    height: 2px;
    background: linear-gradient(90deg, var(--brand-grad-from), var(--brand-grad-to));
    border-radius: 2px 2px 0 0;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Network Pill */
  .network-pill {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    cursor: default;
    transition: all var(--transition-fast);
  }

  @media (min-width: 640px) {
    .network-pill {
      display: inline-flex;
    }
  }

  .network-pill:hover {
    border-color: rgba(99, 102, 241, 0.3);
  }

  .network-status {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-muted);
    transition: background var(--transition-fast);
  }

  .network-pill[data-status="online"] .network-status {
    background: var(--color-success);
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
  }

  .network-pill[data-status="offline"] .network-status {
    background: var(--color-danger);
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
  }

  .network-pill[data-status="lagging"] .network-status {
    background: var(--color-warning);
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
  }

  .network-name {
    color: var(--color-fg);
  }

  .network-chain-id {
    color: var(--color-muted);
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    background: transparent;
    color: var(--color-fg);
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  @media (min-width: 768px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .mobile-menu-btn:hover {
    background: rgba(99, 102, 241, 0.08);
  }

  .mobile-menu-btn .close-icon {
    display: none;
  }

  .mobile-menu-btn--open .menu-icon {
    display: none;
  }

  .mobile-menu-btn--open .close-icon {
    display: block;
  }

  /* Mobile Navigation */
  .mobile-nav {
    position: fixed;
    inset: 4rem 0 0 0;
    z-index: var(--z-dropdown);
    background: rgba(10, 14, 23, 0.98);
    backdrop-filter: var(--backdrop-blur);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-base), visibility var(--transition-base);
  }

  .mobile-nav--open {
    opacity: 1;
    visibility: visible;
  }

  @media (min-width: 768px) {
    .mobile-nav {
      display: none;
    }
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    gap: 0.5rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .mobile-nav-link {
    padding: 1rem;
    color: var(--color-fg);
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: var(--weight-medium);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }

  .mobile-nav-link:hover {
    background: rgba(99, 102, 241, 0.08);
  }

  .mobile-nav-link--active {
    background: rgba(99, 102, 241, 0.12);
  }

  .mobile-cta {
    margin-top: 1rem;
    width: 100%;
  }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
