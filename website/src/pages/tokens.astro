---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Tokens — Animica";
const pageDesc =
  "Browse fungible tokens launched on Animica. Post-quantum, on-chain metadata, deterministic contract addresses.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Tokens</h1>
        <p class="mt-2 opacity-80 max-w-2xl">
          Every fungible token deployed through the Animica launcher. All
          metadata is signed by the creator's wallet and pinned to the deploy
          transaction.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/launch"
           class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 font-medium
                  bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]">
          Launch a token
        </a>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-2">
      <input id="tokens-search" type="search" placeholder="Search by name, symbol, or description"
             class="flex-1 rounded-lg border px-3 py-2 bg-transparent
                    border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
      <select id="tokens-sort"
              class="rounded-lg border px-3 py-2 bg-transparent
                     border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]">
        <option value="recent">Newest first</option>
        <option value="oldest">Oldest first</option>
      </select>
    </div>

    <div id="tokens-status" class="mt-6 text-sm opacity-70">Loading tokens…</div>

    <div id="indexer-badge" class="mt-4 text-xs opacity-70"></div>

    <ul id="tokens-grid"
        class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></ul>

    <div class="mt-8 flex items-center justify-center gap-2">
      <button id="tokens-prev" type="button" disabled
              class="rounded-lg border px-3 py-1.5 text-sm
                     border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]
                     disabled:opacity-40 disabled:cursor-not-allowed">
        Previous
      </button>
      <span id="tokens-page" class="text-sm opacity-70">Page 1</span>
      <button id="tokens-next" type="button" disabled
              class="rounded-lg border px-3 py-1.5 text-sm
                     border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]
                     disabled:opacity-40 disabled:cursor-not-allowed">
        Next
      </button>
    </div>
  </section>

  <script>
    // @ts-nocheck
    const LAUNCHER_API = (window.LAUNCHER_API_BASE || '/launcher-api') + '/api';
    const PAGE_SIZE = 24;

    const grid = document.getElementById('tokens-grid');
    const statusEl = document.getElementById('tokens-status');
    const searchEl = document.getElementById('tokens-search');
    const sortEl = document.getElementById('tokens-sort');
    const prevBtn = document.getElementById('tokens-prev');
    const nextBtn = document.getElementById('tokens-next');
    const pageLabel = document.getElementById('tokens-page');

    let offset = 0;
    let total = 0;
    let lastQuery = '';
    let sortOrder = 'recent';
    let debounceTimer = null;

    async function refreshIndexerBadge() {
      try {
        const r = await fetch(`${LAUNCHER_API}/indexer/status`);
        if (!r.ok) return;
        const data = await r.json();
        const state = data.state;
        const badge = document.getElementById('indexer-badge');
        if (!state) {
          badge.textContent = 'Indexer: starting up…';
          return;
        }
        const tickAgo = Math.max(0, Math.floor(Date.now() / 1000) - state.lastTickAt);
        const parts = [
          `Indexer ticked ${tickAgo < 90 ? tickAgo + 's' : Math.floor(tickAgo / 60) + 'm'} ago`,
          `at block #${state.lastChainHeight ?? '?'}`,
        ];
        if (state.tokensAlive || state.tokensMissing) {
          parts.push(`${state.tokensAlive} live · ${state.tokensMissing} missing`);
        }
        if (state.lastError) {
          parts.push(`<span style="color:#dc2626">last error: ${state.lastError.slice(0,80)}</span>`);
        }
        badge.innerHTML = parts.join(' · ');
      } catch { /* silent */ }
    }

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function shortAddr(a) {
      if (!a || typeof a !== 'string') return '';
      return a.length > 16 ? `${a.slice(0, 8)}…${a.slice(-6)}` : a;
    }

    function formatSupply(raw, decimals) {
      try {
        const d = Math.max(0, Math.min(36, Number(decimals ?? 0)));
        const big = BigInt(String(raw));
        if (d === 0) return big.toLocaleString('en-US');
        const base = 10n ** BigInt(d);
        const whole = big / base;
        return whole.toLocaleString('en-US');
      } catch { return String(raw ?? '0'); }
    }

    function formatRelTime(secs) {
      const now = Math.floor(Date.now() / 1000);
      const delta = Math.max(0, now - Number(secs || 0));
      if (delta < 60) return `${delta}s ago`;
      if (delta < 3600) return `${Math.floor(delta / 60)}m ago`;
      if (delta < 86400) return `${Math.floor(delta / 3600)}h ago`;
      return `${Math.floor(delta / 86400)}d ago`;
    }

    function imageHtml(t) {
      const url = t.imageUrl;
      const initial = (t.symbol || '?').slice(0, 2).toUpperCase();
      if (!url) {
        return `<div class="flex h-12 w-12 items-center justify-center rounded-full
                bg-[color-mix(in_srgb,var(--text-primary)_/_8%,transparent)]
                text-sm font-semibold">${escapeHtml(initial)}</div>`;
      }
      return `<img src="${escapeHtml(url)}" alt="" loading="lazy"
              class="h-12 w-12 rounded-full object-cover
                     bg-[color-mix(in_srgb,var(--text-primary)_/_8%,transparent)]" />`;
    }

    function tokenCardHtml(t) {
      const href = `/token?address=${encodeURIComponent(t.contractAddress)}`;
      return `
        <li class="rounded-2xl border p-4 transition hover:bg-[color-mix(in_srgb,var(--text-primary)_/_4%,transparent)]
                   border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
                   bg-[var(--bg-elevated)]">
          <a href="${href}" class="flex gap-3 items-start">
            ${imageHtml(t)}
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="font-semibold truncate">${escapeHtml(t.name || 'Unnamed')}</span>
                <span class="text-xs opacity-70 uppercase tracking-wide">${escapeHtml(t.symbol || '')}</span>
              </div>
              <div class="mt-1 text-xs opacity-70 truncate">${escapeHtml(t.description || '')}</div>
              <div class="mt-2 text-xs opacity-70">
                Supply <span class="opacity-100">${escapeHtml(formatSupply(t.initialSupply, t.decimals))}</span>
                · <span title="${escapeHtml(t.creatorAddress || '')}">by ${escapeHtml(shortAddr(t.creatorAddress))}</span>
                · ${escapeHtml(formatRelTime(t.createdAt))}
              </div>
            </div>
          </a>
        </li>`;
    }

    async function load() {
      statusEl.textContent = 'Loading tokens…';
      grid.innerHTML = '';
      const params = new URLSearchParams();
      params.set('limit', String(PAGE_SIZE));
      params.set('offset', String(offset));
      if (lastQuery) params.set('q', lastQuery);
      try {
        const r = await fetch(`${LAUNCHER_API}/tokens?${params.toString()}`);
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        const data = await r.json();
        let tokens = Array.isArray(data.tokens) ? data.tokens : [];
        total = Number(data.total || 0);
        if (sortOrder === 'oldest') tokens = tokens.slice().reverse();

        if (tokens.length === 0) {
          statusEl.textContent = total === 0
            ? 'No tokens have launched yet. Be the first.'
            : 'No tokens match this search.';
        } else {
          statusEl.textContent = `${total} token${total === 1 ? '' : 's'} total`;
        }
        grid.innerHTML = tokens.map(tokenCardHtml).join('');
        prevBtn.disabled = offset === 0;
        nextBtn.disabled = offset + PAGE_SIZE >= total;
        pageLabel.textContent = `Page ${Math.floor(offset / PAGE_SIZE) + 1}`;
      } catch (err) {
        statusEl.textContent = `Failed to load tokens: ${err && err.message ? err.message : err}`;
      }
    }

    searchEl.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        lastQuery = String(searchEl.value || '').trim();
        offset = 0;
        load();
      }, 250);
    });
    sortEl.addEventListener('change', () => {
      sortOrder = sortEl.value;
      load();
    });
    prevBtn.addEventListener('click', () => {
      offset = Math.max(0, offset - PAGE_SIZE);
      load();
    });
    nextBtn.addEventListener('click', () => {
      offset = offset + PAGE_SIZE;
      load();
    });

    load();
    refreshIndexerBadge();
    setInterval(refreshIndexerBadge, 30_000);
  </script>
</BaseLayout>
