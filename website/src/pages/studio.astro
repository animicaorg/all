---
import BaseLayout from "../layouts/BaseLayout.astro";
import InlineLink from "../components/InlineLink.astro";

import { links } from "../config/links";
import { loadStudioDownloadPageData } from "../features/studio/downloads";

const pageTitle = "Studio — Linux Download";
const pageDesc =
  "Download the official Animica Studio Linux desktop build and verify its checksum before installing.";

const studioDownloads = loadStudioDownloadPageData();
const studioDocs = "https://github.com/animicaorg/all/blob/main/docs/studio_deploy_quickstart.md";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Animica Studio</h1>
    <p class="mt-3 opacity-80">
      Download the official Linux desktop build of Studio for local contract work, node-connected
      workflows, and bundled Qt desktop tooling. The hosted web Studio is currently being rebuilt —
      the desktop build below remains fully available in the meantime.
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="text-xl font-semibold">Linux desktop download</h2>
            <p class="mt-2 text-sm opacity-80">
              This page serves the current published <code>.deb</code> build from{" "}
              <code>website/public/studio</code>.
            </p>
          </div>
          {studioDownloads.buildLabel && (
            <div class="rounded-lg border px-3 py-2 text-sm
                        border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
              <div class="font-medium">Build</div>
              <div class="opacity-80">{studioDownloads.buildLabel}</div>
            </div>
          )}
        </div>

        {studioDownloads.linuxDownload ? (
          <>
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                href={studioDownloads.linuxDownload.href}
                download={studioDownloads.linuxDownload.download}
                class="inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium
                       bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]
                       hover:opacity-90"
              >
                {studioDownloads.linuxDownload.label}
              </a>

              {studioDownloads.checksumLink && (
                <a
                  href={studioDownloads.checksumLink.href}
                  class="inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium
                         border border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]
                         hover:bg-[color-mix(in_srgb,var(--text-primary)_/_6%,transparent)]"
                >
                  {studioDownloads.checksumLink.label}
                </a>
              )}
            </div>

            <ul class="mt-4 space-y-1 text-xs opacity-70">
              <li>
                Filename: <code>{studioDownloads.linuxDownload.download}</code>
              </li>
              {studioDownloads.architecture && <li>Architecture: {studioDownloads.architecture}</li>}
              {studioDownloads.linuxDownload.sizeLabel && <li>Size: {studioDownloads.linuxDownload.sizeLabel}</li>}
              {studioDownloads.linuxDownload.sha256 && (
                <li>
                  SHA-256: <code>{studioDownloads.linuxDownload.sha256}</code>
                </li>
              )}
              {studioDownloads.generatedAt && <li>Published: {studioDownloads.generatedAt}</li>}
            </ul>

            <div class="mt-5">
              <h3 class="font-medium">Install</h3>
              <ul class="mt-2 space-y-2 text-sm opacity-80">
                {studioDownloads.instructions.map((instruction) => (
                  <li>{instruction}</li>
                ))}
              </ul>
            </div>
          </>
        ) : (
          <div class="mt-6">
            <p class="text-sm opacity-80">
              A website-hosted Studio artifact is not published yet. Use{" "}
              <InlineLink href={links.github.releases()}>GitHub Releases</InlineLink> until the
              Linux package is published into <code>website/public/studio</code>.
            </p>
          </div>
        )}
      </div>

      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h2 class="text-xl font-semibold">Need the browser version?</h2>
        <p class="mt-2 text-sm opacity-80">
          The hosted web Studio is being rebuilt. A holding page is live while we work — use the
          Linux desktop build for edit, simulate, and deploy sessions in the meantime.
        </p>
        <div class="mt-4 flex flex-col gap-3">
          <span
            class="inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium
                   border border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
                   opacity-60 cursor-not-allowed select-none"
            aria-disabled="true"
            title="The hosted web Studio is being rebuilt"
          >
            Hosted Studio — rebuilding
          </span>
          <InlineLink href={studioDocs}>Read Studio docs</InlineLink>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="font-semibold">What’s included</h3>
        <p class="mt-2 text-sm opacity-80">
          The Linux desktop package wraps the PySide6-based Studio application and bundled runtime
          assets needed for local workflows.
        </p>
      </div>

      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="font-semibold">Verify before install</h3>
        <p class="mt-2 text-sm opacity-80">
          Compare the downloaded package hash with the published SHA-256 file before running the
          installer on production machines.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
