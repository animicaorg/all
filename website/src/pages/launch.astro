---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Launch a token — Animica";
const pageDesc = "Deploy a post-quantum, on-chain Animica fungible token in a few clicks. Connect your wallet, fill in the form, sign once.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Launch a token</h1>
    <p class="mt-3 opacity-80">
      Deploy a post-quantum-secured Animica fungible token directly from your wallet.
      The wallet signs and submits a single deploy transaction; the contract address
      is deterministic from your sender + nonce, so it appears immediately.
    </p>

    <div id="launch-wallet-banner" class="mt-6 rounded-2xl border p-4 text-sm
         border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
         bg-[var(--bg-elevated)]">
      Detecting wallet…
    </div>

    <form id="launch-form" class="mt-6 grid gap-5 rounded-2xl border p-6
        border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
        bg-[var(--bg-elevated)]">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-sm">
          <span class="font-medium">Token name</span>
          <input name="name" type="text" required minlength="1" maxlength="64"
                 placeholder="My Token"
                 class="rounded-lg border px-3 py-2 bg-transparent
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
        </label>
        <label class="grid gap-1.5 text-sm">
          <span class="font-medium">Symbol</span>
          <input name="symbol" type="text" required minlength="1" maxlength="16"
                 pattern="[A-Za-z0-9_]+" placeholder="TKN"
                 class="rounded-lg border px-3 py-2 bg-transparent
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)] uppercase" />
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-sm">
          <span class="font-medium">Decimals</span>
          <input name="decimals" type="number" required min="0" max="18" value="9"
                 class="rounded-lg border px-3 py-2 bg-transparent
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
        </label>
        <label class="grid gap-1.5 text-sm">
          <span class="font-medium">Initial supply</span>
          <input name="initialSupply" type="number" required min="0" step="any" value="1000000000"
                 class="rounded-lg border px-3 py-2 bg-transparent
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
        </label>
      </div>

      <label class="grid gap-1.5 text-sm">
        <span class="font-medium">Description</span>
        <textarea name="description" rows="3" maxlength="2000"
                  placeholder="What is this token?"
                  class="rounded-lg border px-3 py-2 bg-transparent
                         border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]"></textarea>
      </label>

      <label class="grid gap-1.5 text-sm">
        <span class="font-medium">Image URL</span>
        <input name="imageUrl" type="url" placeholder="https://… or ipfs://…"
               class="rounded-lg border px-3 py-2 bg-transparent
                      border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
      </label>

      <details class="rounded-lg border
            border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)] p-3">
        <summary class="cursor-pointer text-sm opacity-80">Socials (optional)</summary>
        <div class="grid gap-3 mt-3 sm:grid-cols-2">
          <input name="websiteUrl"  type="url" placeholder="Website (https://…)"
                 class="rounded-lg border px-3 py-2 bg-transparent text-sm
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
          <input name="twitterUrl"  type="url" placeholder="Twitter / X"
                 class="rounded-lg border px-3 py-2 bg-transparent text-sm
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
          <input name="telegramUrl" type="url" placeholder="Telegram"
                 class="rounded-lg border px-3 py-2 bg-transparent text-sm
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
          <input name="discordUrl"  type="url" placeholder="Discord"
                 class="rounded-lg border px-3 py-2 bg-transparent text-sm
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
        </div>
      </details>

      <button id="launch-submit" type="submit" disabled
              class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 font-medium
                     bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]
                     disabled:opacity-50 disabled:cursor-not-allowed">
        Connect wallet to continue
      </button>

      <div id="launch-status" class="text-sm"></div>
    </form>

    <p class="mt-6 text-xs opacity-70">
      Don't have the wallet?
      <a href="/wallet" class="underline">Get the Animica wallet extension</a>.
    </p>
  </section>

  <script>
    // @ts-nocheck
    const banner = document.getElementById('launch-wallet-banner');
    const form = document.getElementById('launch-form');
    const submit = document.getElementById('launch-submit');
    const status = document.getElementById('launch-status');

    const LAUNCHER_API = (window.LAUNCHER_API_BASE || '/launcher-api') + '/api';

    let provider = null;
    let connectedAddress = null;
    let chainId = null;
    let cachedTemplate = null;

    function setStatus(text, kind) {
      status.textContent = text || '';
      status.style.color = kind === 'error' ? '#dc2626'
        : kind === 'success' ? '#059669'
        : 'inherit';
    }

    async function waitForProvider(timeoutMs = 4000) {
      if (window.animica) return window.animica;
      return new Promise((resolve) => {
        const finish = () => {
          clearInterval(poll);
          clearTimeout(timer);
          window.removeEventListener('animica#initialized', finish);
          resolve(window.animica || null);
        };
        const poll = setInterval(() => { if (window.animica) finish(); }, 150);
        const timer = setTimeout(() => finish(), timeoutMs);
        window.addEventListener('animica#initialized', finish, { once: true });
      });
    }

    async function connect() {
      if (!provider) {
        banner.textContent = 'Animica wallet not detected. Install the extension and reload.';
        return;
      }
      const accounts = await provider.request({ method: 'animica_requestAccounts' });
      if (Array.isArray(accounts) && accounts.length > 0) {
        connectedAddress = accounts[0];
        try {
          const cid = await provider.request({ method: 'animica_chainId' });
          chainId = typeof cid === 'number' ? cid : Number(cid);
        } catch {
          chainId = 1;
        }
        banner.innerHTML = `Connected: <code>${connectedAddress}</code> · chain <code>${chainId}</code>`;
        submit.disabled = false;
        submit.textContent = 'Launch token';
      }
    }

    async function loadTemplate() {
      if (cachedTemplate) return cachedTemplate;
      const res = await fetch(`${LAUNCHER_API}/contract-template`);
      if (!res.ok) throw new Error(`contract-template fetch failed: ${res.status}`);
      cachedTemplate = await res.json();
      return cachedTemplate;
    }

    async function launch(formData) {
      setStatus('Loading contract template…');
      const tpl = await loadTemplate();

      setStatus('Submitting deploy transaction. Approve in your wallet…');
      const res = await provider.request({
        method: 'animica_deployContract',
        params: [{
          from: connectedAddress,
          code: tpl.codeHex,
          manifest: tpl.manifestHex,
        }],
      });
      if (!res || !res.txid) {
        throw new Error('Wallet did not return a tx id');
      }
      setStatus(`Deploy submitted (tx ${res.txid.slice(0, 18)}…). Waiting for block confirmation…`);

      // Sign a tiny attestation so we can store who claimed this token.
      let signature = '0x';
      try {
        const attest = `register|${connectedAddress}|${formData.get('symbol')}|${res.contractAddress || res.txid}`;
        signature = await provider.request({
          method: 'animica_signMessage',
          params: [{ message: attest }],
        });
      } catch {
        // Best-effort. Backend stores whatever we managed to sign.
      }

      const payload = {
        contractAddress: res.contractAddress,
        txHash: res.txid,
        creatorAddress: connectedAddress,
        name: String(formData.get('name') || '').trim(),
        symbol: String(formData.get('symbol') || '').trim().toUpperCase(),
        decimals: Number(formData.get('decimals') || 9),
        initialSupply: String(formData.get('initialSupply') || '0'),
        description: (formData.get('description') || '').trim() || undefined,
        imageUrl:    (formData.get('imageUrl')    || '').trim() || undefined,
        websiteUrl:  (formData.get('websiteUrl')  || '').trim() || undefined,
        twitterUrl:  (formData.get('twitterUrl')  || '').trim() || undefined,
        telegramUrl: (formData.get('telegramUrl') || '').trim() || undefined,
        discordUrl:  (formData.get('discordUrl')  || '').trim() || undefined,
        chainId,
        signature,
      };
      // Strip undefined to satisfy the strict schema
      for (const k of Object.keys(payload)) {
        if (payload[k] === undefined) delete payload[k];
      }

      // The launcher refuses to register until the deploy tx is mined into
      // a canonical block. Block cadence is the source of truth — we don't
      // bypass it. Poll for up to ~3 minutes (plenty of slack for normal
      // block times, with a clear message if it stalls).
      const REGISTER_DEADLINE_MS = 180_000;
      const POLL_INTERVAL_MS = 3_000;
      const registerWithRetry = async () => {
        const deadline = Date.now() + REGISTER_DEADLINE_MS;
        let last = null;
        let attempt = 0;
        while (Date.now() < deadline) {
          attempt++;
          const r = await fetch(`${LAUNCHER_API}/tokens`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (r.ok) return r.json();
          last = await r.json().catch(() => ({}));
          if (r.status !== 409) {
            return Promise.reject(new Error(last?.error?.message || `HTTP ${r.status}`));
          }
          const txStatus = last?.error?.extra?.status || last?.error?.details?.status || 'pending';
          const elapsedSec = Math.floor((Date.now() - (deadline - REGISTER_DEADLINE_MS)) / 1000);
          setStatus(`Waiting for block confirmation… (${txStatus}, ${elapsedSec}s)`);
          await new Promise((res) => setTimeout(res, POLL_INTERVAL_MS));
        }
        return Promise.reject(new Error(
          last?.error?.message ||
          'deploy not confirmed in time — the tx may still mine; check the explorer'
        ));
      };

      const created = await registerWithRetry();
      setStatus(`Launched! Redirecting…`, 'success');
      setTimeout(() => {
        window.location.href = `/token?address=${encodeURIComponent(payload.contractAddress)}`;
      }, 750);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submit.disabled = true;
      submit.textContent = 'Launching…';
      try {
        await launch(new FormData(form));
      } catch (err) {
        setStatus(err?.message || 'Launch failed', 'error');
        submit.disabled = false;
        submit.textContent = 'Launch token';
      }
    });

    (async () => {
      provider = await waitForProvider();
      if (!provider) {
        banner.innerHTML = 'Animica wallet not detected. <a href="/wallet" class="underline">Install the extension</a> and reload.';
        return;
      }
      banner.innerHTML = 'Wallet detected. <button id="launch-connect" type="button" class="underline">Connect</button> to enable launch.';
      document.getElementById('launch-connect')?.addEventListener('click', () => {
        connect().catch((err) => { banner.textContent = 'Connect failed: ' + (err?.message || err); });
      });
    })();
  </script>
</BaseLayout>
