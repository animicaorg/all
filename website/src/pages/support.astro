---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Support";
const description =
  "AICF support channels for API incidents, provider worker troubleshooting, payout issues, and contract-job disputes.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Support</span>
      <h1 class="aicf-heading">Developer and Provider Operations Support</h1>
      <p class="aicf-subheading">
        Use this page for incident routing, onboarding help, and escalation for billing, payout, or contract-job disputes.
      </p>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-3">
      <article class="aicf-card">
        <h2 style="font-size:1.15rem;">API and Billing</h2>
        <ul style="margin-top:0.65rem; padding-left:1rem; display:grid; gap:0.4rem;">
          <li>Failed model calls and timeout diagnostics</li>
          <li>Usage row mismatch and settlement questions</li>
          <li>ANM balance funding and escrow verification</li>
        </ul>
      </article>

      <article class="aicf-card">
        <h2 style="font-size:1.15rem;">Provider Operations</h2>
        <ul style="margin-top:0.65rem; padding-left:1rem; display:grid; gap:0.4rem;">
          <li>Worker install and benchmark troubleshooting</li>
          <li>GPU detection and runtime health issues</li>
          <li>Payout, reputation, and staking support</li>
        </ul>
      </article>

      <article class="aicf-card">
        <h2 style="font-size:1.15rem;">Contract Workloads</h2>
        <ul style="margin-top:0.65rem; padding-left:1rem; display:grid; gap:0.4rem;">
          <li>Contract-triggered job failures</li>
          <li>Challenge windows and dispute escalation</li>
          <li>Treasury subsidy configuration issues</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <h2 style="font-size:1.25rem;">Support Intake Checklist</h2>
        <ol style="margin-top:0.65rem; padding-left:1rem; display:grid; gap:0.42rem;">
          <li>Include project ID, request ID, and affected endpoint/job class.</li>
          <li>Provide timestamp, expected behavior, and observed behavior.</li>
          <li>Attach worker logs or API response snippets where possible.</li>
          <li>Include ANM settlement ID when reporting billing or payout issues.</li>
        </ol>
      </article>

      <article class="aicf-card">
        <h2 style="font-size:1.25rem;">Contact Channels</h2>
        <ul style="margin-top:0.65rem; padding-left:1rem; display:grid; gap:0.42rem;">
          <li>Email: <strong>aicf@animica.org</strong></li>
          <li>Status page updates: <a href="/status">/status</a></li>
          <li>Documentation: <a href="/docs">/docs</a></li>
          <li>Releases and issues: <a href="https://github.com/animica/animica" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </article>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
