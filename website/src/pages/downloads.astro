---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadProviderDownloadsPageData } from "../features/provider/downloads";

const title = "Downloads";
const description =
  "Download Animica software: wallets for desktop, mobile, and browser, CPU miner bundles, the animica CLI from PyPI, and AICF provider worker bundles.";

const provider = loadProviderDownloadsPageData();
---

<BaseLayout title={title} description={description}>
  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Downloads</span>
      <h1 class="aicf-heading">Everything You Need to Run Animica</h1>
      <p class="aicf-subheading">
        Wallets, miner bundles, the command-line tools, and the AICF provider worker — all builds ship
        with SHA256 checksums. Verify before you run.
      </p>
    </div>
  </section>

  <!-- Wallet -->
  <section class="aicf-section">
    <div class="aicf-container">
      <article class="aicf-card">
        <span class="aicf-kicker">Wallet</span>
        <h2 style="font-size:1.3rem; margin-top:0.5rem;">Animica Wallet</h2>
        <p class="aicf-muted" style="margin-top:0.6rem;">
          Desktop builds for Windows, macOS, and Linux, an Android APK, and a Chrome extension — all
          hosted on the wallet page with install guides and checksums. Prefer not to install anything?
          The web wallet runs in your browser.
        </p>
        <div class="aicf-btn-row" style="margin-top:0.95rem;">
          <a class="aicf-btn" href="/wallet">Wallet Downloads</a>
        </div>
      </article>
    </div>
  </section>

  <!-- Miner -->
  <section class="aicf-section">
    <div class="aicf-container">
      <article class="aicf-card">
        <span class="aicf-kicker">Mining</span>
        <h2 style="font-size:1.3rem; margin-top:0.5rem;">CPU Miner Bundles</h2>
        <p class="aicf-muted" style="margin-top:0.6rem;">
          Miner bundles for Windows, macOS, and Linux, with step-by-step pool setup — including
          dual-mining XMR on the same CPU. Pool stats live at
          <a href="https://pool.animica.org" target="_blank" rel="noopener noreferrer">pool.animica.org</a>.
        </p>
        <div class="aicf-btn-row" style="margin-top:0.95rem;">
          <a class="aicf-btn" href="/mine">Miner Downloads &amp; Setup</a>
          <a class="aicf-ghost-btn" href="https://pool.animica.org" target="_blank" rel="noopener noreferrer">Pool Dashboard</a>
        </div>
      </article>
    </div>
  </section>

  <!-- CLI -->
  <section class="aicf-section">
    <div class="aicf-container">
      <article class="aicf-card">
        <span class="aicf-kicker">Command Line</span>
        <h2 style="font-size:1.3rem; margin-top:0.5rem;">animica CLI &amp; Python SDK</h2>
        <p class="aicf-muted" style="margin-top:0.6rem;">
          One pip install gives you the <code>animica</code> CLI: wallet management, transactions,
          mining (including dual-mine), and node interaction. Python 3.10+.
        </p>
        <div class="aicf-code" style="margin-top:0.85rem; display:flex; align-items:center; justify-content:space-between; gap:0.75rem;">
<pre style="margin:0;"><code id="pip-snippet">pip install animica</code></pre>
          <button
            id="copy-pip"
            class="aicf-ghost-btn"
            type="button"
            style="flex-shrink:0; font-size:0.8rem; padding:0.35rem 0.8rem;"
            data-copy-text="pip install animica"
            aria-label="Copy pip install command"
          >Copy</button>
        </div>
        <p class="aicf-muted" style="margin-top:0.7rem;">
          The complete client — everything to mine, run a node, use the wallet, deploy Python
          contracts, run <code>animica up</code> (the unified miner: PoW + useful-work + GPU
          train/serve + Studio functions), and use the Studio SDK. The native CPU miner
          (<code>animica-fastpow</code>) is included by default. This is what most people want.
        </p>
        <div class="aicf-code" style="margin-top:0.85rem; display:flex; align-items:center; justify-content:space-between; gap:0.75rem;">
<pre style="margin:0;"><code>pip install "animica[all]"</code></pre>
          <button
            id="copy-pip-all"
            class="aicf-ghost-btn"
            type="button"
            style="flex-shrink:0; font-size:0.8rem; padding:0.35rem 0.8rem;"
            data-copy-text={'pip install "animica[all]"'}
            aria-label="Copy pip install animica[all] command"
          >Copy</button>
        </div>
        <p class="aicf-muted" style="margin-top:0.7rem;">
          Everything above <em>plus</em> every optional extra: Qt desktop-wallet QR codes, the full
          distributed Studio client (cloudpickle for closures + omni-sdk for on-chain ANM escrow),
          and all server/operator dependencies pinned. Use it if you want the kitchen sink or are
          running pool/API infrastructure. Quote the extras form so zsh/macOS does not glob the
          brackets.
        </p>
        <div class="aicf-btn-row" style="margin-top:0.95rem;">
          <a class="aicf-btn" href="https://pypi.org/project/animica/" target="_blank" rel="noopener noreferrer">View on PyPI</a>
          <a class="aicf-ghost-btn" href="/docs">CLI Docs</a>
        </div>
      </article>
    </div>
  </section>

  <!-- Provider worker -->
  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">AICF Provider Worker</span>
      <h2 class="aicf-heading" style="font-size:1.5rem;">GPU Contribution Bundles</h2>
      <p class="aicf-subheading">
        Version <strong>{provider.version}</strong>
        {provider.generatedAt ? ` · generated ${provider.generatedAt}` : ''}.
        Download your platform bundle, benchmark hardware, start worker mode, and begin earning ANM.
      </p>
      <div class="aicf-btn-row">
        {provider.checksumFile ? <a class="aicf-ghost-btn" href={provider.checksumFile}>Checksums</a> : null}
        <a class="aicf-ghost-btn" href="/providers">Provider Overview</a>
        <a class="aicf-btn" href="/support">Need Installation Help</a>
      </div>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-3">
      {provider.cards.map((card) => (
        <article class="aicf-card">
          <p class="aicf-kicker" style="margin-bottom:0.6rem;">{card.platform}</p>
          <h3 style="font-size:1.15rem;">{card.label}</h3>
          <p class="aicf-muted" style="margin-top:0.55rem;">{card.notes}</p>
          <dl style="margin-top:0.7rem; display:grid; grid-template-columns:auto 1fr; gap:0.4rem 0.6rem; font-size:0.9rem;">
            <dt class="aicf-muted">Version</dt>
            <dd>{card.version}</dd>
            <dt class="aicf-muted">File</dt>
            <dd><code>{card.filename}</code></dd>
            <dt class="aicf-muted">Size</dt>
            <dd>{card.sizeLabel}</dd>
            <dt class="aicf-muted">SHA256</dt>
            <dd style="font-family:var(--font-mono); font-size:0.78rem; word-break:break-all;">{card.sha256}</dd>
          </dl>
          <div class="aicf-btn-row" style="margin-top:0.95rem;">
            <a class="aicf-btn" href={card.href}>Download</a>
            {card.releaseNotes ? <a class="aicf-ghost-btn" href={card.releaseNotes}>Release Notes</a> : null}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      {provider.cards.map((card) => (
        <article class="aicf-card">
          <h3 style="font-size:1.15rem;">Install · {card.label}</h3>
          <ol style="margin-top:0.65rem; padding-left:1rem; display:grid; gap:0.4rem;">
            {card.installSteps.map((step) => (
              <li class="aicf-muted">{step}</li>
            ))}
          </ol>
          <div class="aicf-code" style="margin-top:0.75rem;">
<pre style="margin:0;"><code>{card.quickStart}</code></pre>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <h2 style="font-size:1.25rem;">Verify Your Downloads</h2>
        <p class="aicf-muted" style="margin-top:0.55rem;">
          Every artifact ships with a SHA256 checksum file alongside it. Compare before running:
        </p>
        <div class="aicf-code" style="margin-top:0.75rem;">
<pre style="margin:0;"><code>sha256sum &lt;downloaded-file&gt;
# compare against the published .sha256 file</code></pre>
        </div>
      </article>

      <article class="aicf-card">
        <h2 style="font-size:1.25rem;">Troubleshooting</h2>
        <ul style="margin-top:0.65rem; padding-left:1rem; display:grid; gap:0.45rem;">
          <li>If no GPU is detected, verify drivers and rerun benchmark mode.</li>
          <li>If wallet binding fails, regenerate config and confirm the anim1&hellip; payout address.</li>
          <li>If heartbeat fails, inspect <code>logs/provider-worker.log</code> and network ACLs.</li>
          <li>If jobs are not assigned, review reputation, stake, and benchmark tier.</li>
        </ul>
        <div class="aicf-btn-row">
          <a class="aicf-ghost-btn" href="/docs">Docs</a>
          <a class="aicf-btn" href="/support">Open Support</a>
        </div>
      </article>
    </div>
  </section>

  <script>
    const copyButtons = ['copy-pip', 'copy-pip-all'];
    for (const id of copyButtons) {
      const btn = document.getElementById(id);
      if (btn) {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy-text') || '';
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = 'Copied';
            setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
          } catch {
            btn.textContent = 'Copy failed';
            setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
          }
        });
      }
    }
  </script>
</BaseLayout>
