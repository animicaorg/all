---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { faqItems } from "../data/aicf";

const title = "FAQ";
const description =
  "Frequently asked questions on AICF ANM billing, provider earnings, contract-funded AI jobs, and contributor onboarding.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">FAQ</span>
      <h1 class="aicf-heading">Common Questions</h1>
      <p class="aicf-subheading">
        Clear answers for developers spending ANM and providers earning ANM through decentralized compute on Animica.
      </p>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container" style="display:grid; gap:0.85rem;">
      {faqItems.map((item) => (
        <article class="aicf-card">
          <h2 style="font-size:1.1rem;">{item.question}</h2>
          <p class="aicf-muted" style="margin-top:0.6rem;">{item.answer}</p>
        </article>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
