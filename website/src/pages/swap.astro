---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Swap — Animica";
const pageDesc =
  "Swap launched tokens against native ANM on the Animica DEX. Constant-product pricing, on-chain quotes, post-quantum signed.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-start justify-between gap-2 flex-wrap">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Swap</h1>
      <div class="flex items-center gap-2 text-sm">
        <a href="/pools" class="underline opacity-80">Pools</a>
        <span class="opacity-30">·</span>
        <a href="/launch" class="underline opacity-80">Launch</a>
      </div>
    </div>

    <div id="dex-banner" class="mt-4 rounded-2xl border p-3 text-sm
         border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
         bg-[var(--bg-elevated)]">
      Loading DEX state…
    </div>

    <form id="swap-form" class="mt-6 grid gap-3 rounded-2xl border p-5
          border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
          bg-[var(--bg-elevated)]">
      <label class="grid gap-1.5 text-sm">
        <span class="opacity-70 flex items-center justify-between">
          <span>From</span>
          <span id="balance-in" class="text-xs opacity-60"></span>
        </span>
        <div class="flex gap-2">
          <select id="token-in"
                  class="rounded-lg border px-3 py-2 bg-transparent w-1/2 text-sm
                         border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]"></select>
          <input id="amount-in" type="text" inputmode="decimal" placeholder="0.0"
                 class="rounded-lg border px-3 py-2 bg-transparent flex-1 text-right
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
        </div>
      </label>

      <div class="flex items-center justify-center">
        <button id="flip" type="button" aria-label="Flip direction"
                class="rounded-full border h-8 w-8
                       border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]">↑↓</button>
      </div>

      <label class="grid gap-1.5 text-sm">
        <span class="opacity-70">To (estimated)</span>
        <div class="flex gap-2">
          <select id="token-out"
                  class="rounded-lg border px-3 py-2 bg-transparent w-1/2 text-sm
                         border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]"></select>
          <output id="amount-out"
                  class="rounded-lg border px-3 py-2 bg-transparent flex-1 text-right opacity-80
                         border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]">—</output>
        </div>
      </label>

      <div class="flex items-center justify-between gap-2 text-xs opacity-70">
        <label class="flex items-center gap-2">
          Slippage tolerance
          <input id="slippage" type="number" step="0.1" min="0.1" max="50" value="1"
                 class="w-16 rounded-md border px-2 py-1 bg-transparent text-right
                        border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
          <span>%</span>
        </label>
        <span id="quote-meta"></span>
      </div>

      <button id="swap-btn" type="submit" disabled
              class="mt-2 inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 font-medium
                     bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]
                     disabled:opacity-50 disabled:cursor-not-allowed">
        Connect wallet to swap
      </button>

      <div id="swap-status" class="text-sm"></div>
    </form>

    <p class="mt-6 text-xs opacity-70">
      Prices are quoted live from the on-chain router. The contract enforces
      the slippage bound: if the actual output drops below your minimum, the
      swap reverts on chain — no funds at risk.
    </p>
  </section>

  <script>
    // @ts-nocheck
    const LAUNCHER_API = (window.LAUNCHER_API_BASE || '/launcher-api') + '/api';
    const RPC_URL = 'https://rpc.animica.org/rpc';

    const banner = document.getElementById('dex-banner');
    const tokenInSel = document.getElementById('token-in');
    const tokenOutSel = document.getElementById('token-out');
    const amountInEl = document.getElementById('amount-in');
    const amountOutEl = document.getElementById('amount-out');
    const balanceInEl = document.getElementById('balance-in');
    const slippageEl = document.getElementById('slippage');
    const flipBtn = document.getElementById('flip');
    const swapBtn = document.getElementById('swap-btn');
    const statusEl = document.getElementById('swap-status');
    const quoteMetaEl = document.getElementById('quote-meta');
    const form = document.getElementById('swap-form');

    const NATIVE_TOKEN = { id: '0x', symbol: 'ANM', name: 'Animica (native)', decimals: 18 };
    let provider = null;
    let connectedAddress = null;
    let chainId = 1;
    let dexAddresses = {};
    let tokens = [NATIVE_TOKEN];
    let lastQuote = null;
    let quoteTimer = null;

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function toBaseUnits(displayStr, decimals) {
      const text = String(displayStr ?? '').trim();
      if (!text || !/^\d*\.?\d*$/.test(text)) return 0n;
      const [whole, frac = ''] = text.split('.');
      const d = Math.max(0, Number(decimals) | 0);
      const fracPadded = (frac + '0'.repeat(d)).slice(0, d);
      return BigInt(whole || '0') * (10n ** BigInt(d)) + BigInt(fracPadded || '0');
    }

    function fromBaseUnits(rawBig, decimals) {
      const d = Math.max(0, Number(decimals) | 0);
      const sign = rawBig < 0n ? '-' : '';
      const abs = rawBig < 0n ? -rawBig : rawBig;
      const base = 10n ** BigInt(d);
      const whole = abs / base;
      const frac = (abs % base).toString().padStart(d, '0').replace(/0+$/, '');
      return frac ? `${sign}${whole}.${frac}` : `${sign}${whole}`;
    }

    function findToken(id) {
      return tokens.find((t) => t.id.toLowerCase() === String(id).toLowerCase()) || tokens[0];
    }

    function renderTokenOptions(selectEl, exclude) {
      selectEl.innerHTML = tokens
        .filter((t) => t.id.toLowerCase() !== String(exclude).toLowerCase())
        .map((t) => `<option value="${escapeHtml(t.id)}">${escapeHtml(t.symbol)} — ${escapeHtml(t.name)}</option>`)
        .join('');
    }

    function refreshSelectors() {
      const inId = tokenInSel.value || NATIVE_TOKEN.id;
      const outId = tokenOutSel.value || (tokens[1]?.id ?? NATIVE_TOKEN.id);
      renderTokenOptions(tokenInSel, '');
      tokenInSel.value = inId;
      renderTokenOptions(tokenOutSel, tokenInSel.value);
      if (tokenOutSel.value === '' || tokenOutSel.value.toLowerCase() === tokenInSel.value.toLowerCase()) {
        const fallback = tokens.find((t) => t.id.toLowerCase() !== tokenInSel.value.toLowerCase());
        if (fallback) tokenOutSel.value = fallback.id;
      } else {
        tokenOutSel.value = outId;
      }
    }

    async function loadDex() {
      const r = await fetch(`${LAUNCHER_API}/dex/addresses?chainId=1`);
      const data = await r.json();
      dexAddresses = data.addresses || {};
      if (!dexAddresses.router || !dexAddresses.factory) {
        banner.innerHTML = `
          DEX is not deployed yet on chain 1. The admin needs to publish the
          factory and router contracts before swaps can be quoted.
          <a href="/admin/deploy-dex" class="underline">Open admin deploy →</a>`;
        return false;
      }
      banner.innerHTML = `
        Router: <code>${escapeHtml(dexAddresses.router.address.slice(0,12))}…${escapeHtml(dexAddresses.router.address.slice(-6))}</code>
        · Factory: <code>${escapeHtml(dexAddresses.factory.address.slice(0,12))}…${escapeHtml(dexAddresses.factory.address.slice(-6))}</code>`;
      return true;
    }

    async function loadTokens() {
      try {
        const r = await fetch(`${LAUNCHER_API}/tokens?limit=100`);
        const data = await r.json();
        const list = Array.isArray(data.tokens) ? data.tokens : [];
        tokens = [
          NATIVE_TOKEN,
          ...list.map((t) => ({
            id: t.contractAddress,
            symbol: t.symbol,
            name: t.name,
            decimals: Number(t.decimals ?? 9),
          })),
        ];
      } catch {
        tokens = [NATIVE_TOKEN];
      }
      refreshSelectors();
    }

    async function fetchQuote() {
      lastQuote = null;
      amountOutEl.textContent = '—';
      quoteMetaEl.textContent = '';
      const tin = findToken(tokenInSel.value);
      const tout = findToken(tokenOutSel.value);
      const amount = String(amountInEl.value || '').trim();
      if (!amount || amount === '0' || tin.id === tout.id) {
        return;
      }
      const amountInBase = toBaseUnits(amount, tin.decimals);
      if (amountInBase <= 0n) return;
      try {
        const r = await fetch(`${LAUNCHER_API}/dex/quote`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            chainId: 1,
            tokenIn: tin.id,
            tokenOut: tout.id,
            amountIn: amountInBase.toString(),
          }),
        });
        if (!r.ok) {
          const e = await r.json().catch(() => ({}));
          quoteMetaEl.textContent = e?.error?.message || `quote HTTP ${r.status}`;
          quoteMetaEl.style.color = '#dc2626';
          return;
        }
        const data = await r.json();
        const out = BigInt(data.amountOut || '0');
        lastQuote = { amountInBase, amountOutBase: out, tin, tout };
        amountOutEl.textContent = fromBaseUnits(out, tout.decimals);
        quoteMetaEl.style.color = '';
        quoteMetaEl.textContent = `1 ${tin.symbol} ≈ ${
          out > 0n && amountInBase > 0n
            ? fromBaseUnits((out * (10n ** BigInt(tin.decimals))) / amountInBase, tout.decimals)
            : '—'
        } ${tout.symbol}`;
      } catch (err) {
        quoteMetaEl.style.color = '#dc2626';
        quoteMetaEl.textContent = `quote failed: ${err?.message || err}`;
      }
    }

    function debounceQuote() {
      clearTimeout(quoteTimer);
      quoteTimer = setTimeout(fetchQuote, 300);
    }

    async function refreshBalance() {
      if (!connectedAddress) { balanceInEl.textContent = ''; return; }
      const tin = findToken(tokenInSel.value);
      if (tin.id === NATIVE_TOKEN.id) {
        try {
          const r = await fetch(RPC_URL, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'state.getBalance', params: [connectedAddress] }),
          });
          const body = await r.json();
          const balRaw = String(body?.result?.balance ?? body?.result ?? '0');
          balanceInEl.textContent = `${fromBaseUnits(BigInt(balRaw || '0'), tin.decimals)} ANM`;
        } catch { balanceInEl.textContent = ''; }
      } else {
        balanceInEl.textContent = '';  // token balance reads need contract view; skip in MVP
      }
    }

    async function waitForProvider(timeoutMs = 3000) {
      if (window.animica) return window.animica;
      return new Promise((resolve) => {
        const finish = () => {
          clearInterval(poll); clearTimeout(timer);
          window.removeEventListener('animica#initialized', finish);
          resolve(window.animica || null);
        };
        const poll = setInterval(() => { if (window.animica) finish(); }, 150);
        const timer = setTimeout(() => finish(), timeoutMs);
        window.addEventListener('animica#initialized', finish, { once: true });
      });
    }

    async function ensureConnected() {
      if (connectedAddress) return true;
      provider = provider || await waitForProvider();
      if (!provider) {
        statusEl.style.color = '#dc2626';
        statusEl.textContent = 'Install the Animica wallet to swap.';
        return false;
      }
      const accs = await provider.request({ method: 'animica_requestAccounts' });
      if (!accs || !accs[0]) return false;
      connectedAddress = accs[0];
      try {
        const cid = await provider.request({ method: 'animica_chainId' });
        chainId = typeof cid === 'number' ? cid : Number(cid) || 1;
      } catch { chainId = 1; }
      swapBtn.textContent = 'Swap';
      refreshBalance();
      return true;
    }

    async function executeSwap(event) {
      event.preventDefault();
      if (!lastQuote) { statusEl.textContent = 'No live quote.'; return; }
      if (!dexAddresses.router) { statusEl.textContent = 'DEX router not pinned.'; return; }
      if (!(await ensureConnected())) return;

      const slippagePct = Math.max(0.001, Math.min(50, Number(slippageEl.value || 1)));
      const minOut = (lastQuote.amountOutBase * BigInt(Math.floor((100 - slippagePct) * 1000))) / 100000n;
      const deadline = Math.floor(Date.now() / 1000) + 300;
      const isNativeIn = lastQuote.tin.id === NATIVE_TOKEN.id;

      statusEl.style.color = '';
      statusEl.textContent = 'Encoding swap…';
      try {
        const encRes = await fetch(`${LAUNCHER_API}/dex/encode-call`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            role: 'router',
            method: 'swap_exact_in',
            args: [
              lastQuote.tin.id,
              lastQuote.tout.id,
              lastQuote.amountInBase.toString(),
              minOut.toString(),
              connectedAddress,
              deadline,
            ],
          }),
        });
        if (!encRes.ok) {
          const e = await encRes.json().catch(() => ({}));
          throw new Error(e?.error?.message || `encode HTTP ${encRes.status}`);
        }
        const { dataHex } = await encRes.json();

        statusEl.textContent = 'Submitting swap. Approve in your wallet…';
        const params = {
          from: connectedAddress,
          to: dexAddresses.router.address,
          data: dataHex,
          kind: 2,
          gas: { limit: 2_500_000 },
        };
        if (isNativeIn) params.amount = lastQuote.amountInBase.toString();

        const res = await provider.request({
          method: 'animica_sendTransaction',
          params: [params],
        });
        const txid = typeof res === 'string' ? res : res?.txid;
        if (!txid) throw new Error('wallet returned no tx id');
        statusEl.textContent = `Submitted ${txid.slice(0, 16)}… waiting for block.`;
        await waitForTxConfirmed(txid, 180_000);
        statusEl.style.color = '#059669';
        statusEl.textContent = `Swap confirmed (${txid.slice(0, 16)}…).`;
        amountInEl.value = '';
        amountOutEl.textContent = '—';
        refreshBalance();
      } catch (err) {
        statusEl.style.color = '#dc2626';
        statusEl.textContent = err?.message || String(err);
      }
    }

    async function waitForTxConfirmed(txid, deadlineMs) {
      const deadline = Date.now() + deadlineMs;
      let last = '';
      while (Date.now() < deadline) {
        const r = await fetch(RPC_URL, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tx.getTransactionStatus', params: [txid] }),
        });
        const body = await r.json().catch(() => null);
        const status = String(body?.result?.status || '').toLowerCase();
        last = status;
        if (status === 'included' || status === 'confirmed' || status === 'finalized') return;
        if (status === 'dropped' || status === 'reorged_out') throw new Error(`tx ${status}`);
        await new Promise((res) => setTimeout(res, 2500));
      }
      throw new Error(`tx not confirmed (last status: ${last || 'unknown'})`);
    }

    tokenInSel.addEventListener('change', () => {
      if (tokenInSel.value === tokenOutSel.value) {
        const alt = tokens.find((t) => t.id.toLowerCase() !== tokenInSel.value.toLowerCase());
        if (alt) tokenOutSel.value = alt.id;
      }
      refreshBalance();
      debounceQuote();
    });
    tokenOutSel.addEventListener('change', debounceQuote);
    amountInEl.addEventListener('input', debounceQuote);
    flipBtn.addEventListener('click', () => {
      const a = tokenInSel.value;
      tokenInSel.value = tokenOutSel.value;
      tokenOutSel.value = a;
      refreshBalance();
      debounceQuote();
    });
    form.addEventListener('submit', executeSwap);

    (async () => {
      const hasDex = await loadDex();
      await loadTokens();
      if (hasDex) {
        provider = await waitForProvider();
        if (provider) {
          swapBtn.textContent = 'Connect wallet to swap';
          swapBtn.disabled = false;  // enable; on-click connects + executes
          swapBtn.addEventListener('click', async (ev) => {
            if (!connectedAddress) { ev.preventDefault(); await ensureConnected(); }
          }, { capture: true });
        }
      }
    })();
  </script>
</BaseLayout>
