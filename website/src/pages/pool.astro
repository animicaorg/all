---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Pool — Animica";
const pageDesc =
  "Liquidity pool details on the Animica DEX: reserves, fee, LP supply, and add/remove liquidity.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
    <a href="/pools" class="text-sm opacity-70 underline">← All pools</a>

    <div id="loading" class="mt-6 opacity-70">Loading pool…</div>
    <div id="error" class="mt-6 text-sm" style="display:none; color:#dc2626"></div>

    <article id="pool" class="mt-6" style="display:none">
      <h1 id="pool-title" class="text-3xl sm:text-4xl font-semibold tracking-tight"></h1>
      <p id="pool-addr" class="mt-1 text-xs font-mono opacity-70"></p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60" id="t0-label">Token 0</dt>
          <dd class="mt-1 text-lg font-semibold"><span id="reserve0"></span> <span id="t0-symbol" class="text-sm opacity-70 uppercase"></span></dd>
          <dd class="text-xs font-mono opacity-70 mt-1 break-all" id="t0-addr"></dd>
        </div>
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60" id="t1-label">Token 1</dt>
          <dd class="mt-1 text-lg font-semibold"><span id="reserve1"></span> <span id="t1-symbol" class="text-sm opacity-70 uppercase"></span></dd>
          <dd class="text-xs font-mono opacity-70 mt-1 break-all" id="t1-addr"></dd>
        </div>
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60">Fee</dt>
          <dd class="mt-1 text-lg font-semibold" id="fee-bps">—</dd>
        </div>
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60">LP supply</dt>
          <dd class="mt-1 text-lg font-semibold" id="lp-total">—</dd>
        </div>
      </dl>

      <section class="mt-10 grid gap-6 sm:grid-cols-2">
        <form id="add-form" class="grid gap-3 rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <h2 class="text-lg font-semibold">Add liquidity</h2>
          <label class="grid gap-1.5 text-sm">
            <span class="opacity-70"><span id="add-t0-label">Token 0</span> amount</span>
            <input id="add-amount0" type="text" inputmode="decimal" placeholder="0.0"
                   class="rounded-lg border px-3 py-2 bg-transparent text-right
                          border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
          </label>
          <label class="grid gap-1.5 text-sm">
            <span class="opacity-70"><span id="add-t1-label">Token 1</span> amount</span>
            <input id="add-amount1" type="text" inputmode="decimal" placeholder="0.0"
                   class="rounded-lg border px-3 py-2 bg-transparent text-right
                          border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
          </label>
          <label class="flex items-center justify-between gap-2 text-xs opacity-70">
            Min LP (optional)
            <input id="add-min-lp" type="text" inputmode="numeric" value="0"
                   class="w-32 rounded-md border px-2 py-1 bg-transparent text-right
                          border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
          </label>
          <button type="submit"
                  class="mt-2 rounded-lg px-3 py-2 font-medium text-sm
                         bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]">
            Add liquidity
          </button>
        </form>

        <form id="remove-form" class="grid gap-3 rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <h2 class="text-lg font-semibold">Remove liquidity</h2>
          <label class="grid gap-1.5 text-sm">
            <span class="opacity-70">LP amount to burn</span>
            <input id="remove-lp" type="text" inputmode="decimal" placeholder="0.0"
                   class="rounded-lg border px-3 py-2 bg-transparent text-right
                          border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" />
          </label>
          <div class="grid grid-cols-2 gap-2 text-xs opacity-70">
            <label class="grid gap-1">Min <span id="rm-t0-label">tok0</span> out
              <input id="remove-min0" type="text" inputmode="numeric" value="0"
                     class="rounded-md border px-2 py-1 bg-transparent text-right
                            border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" /></label>
            <label class="grid gap-1">Min <span id="rm-t1-label">tok1</span> out
              <input id="remove-min1" type="text" inputmode="numeric" value="0"
                     class="rounded-md border px-2 py-1 bg-transparent text-right
                            border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]" /></label>
          </div>
          <button type="submit"
                  class="mt-2 rounded-lg border px-3 py-2 font-medium text-sm
                         border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]">
            Remove liquidity
          </button>
        </form>
      </section>

      <p id="action-status" class="mt-3 text-sm"></p>
    </article>
  </section>

  <script>
    // @ts-nocheck
    const LAUNCHER_API = (window.LAUNCHER_API_BASE || '/launcher-api') + '/api';
    const RPC_URL = 'https://rpc.animica.org/rpc';

    const loadingEl = document.getElementById('loading');
    const errEl = document.getElementById('error');
    const article = document.getElementById('pool');
    const statusEl = document.getElementById('action-status');

    let provider = null;
    let connectedAddress = null;
    let router = null;
    let pool = null;
    let tokenDirectory = new Map();

    function getAddressFromUrl() {
      const params = new URLSearchParams(window.location.search);
      return params.get('address') || '';
    }

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function tokenInfo(id) {
      const key = String(id || '0x').toLowerCase();
      if (key === '0x' || key === '') return { id: '0x', symbol: 'ANM', decimals: 18, name: 'Animica' };
      const t = tokenDirectory.get(key);
      return t || { id, symbol: key.slice(0, 8) + '…', decimals: 9, name: 'unknown' };
    }

    function fromBaseUnits(raw, decimals) {
      try {
        const d = Math.max(0, Number(decimals ?? 0));
        const big = BigInt(String(raw || '0'));
        if (d === 0) return big.toLocaleString('en-US');
        const base = 10n ** BigInt(d);
        const whole = big / base;
        const frac = (big % base).toString().padStart(d, '0').replace(/0+$/, '');
        return frac ? `${whole.toLocaleString('en-US')}.${frac}` : whole.toLocaleString('en-US');
      } catch { return String(raw ?? '0'); }
    }

    function toBaseUnits(display, decimals) {
      const text = String(display ?? '').trim();
      if (!text || !/^\d*\.?\d*$/.test(text)) return 0n;
      const [whole, frac = ''] = text.split('.');
      const d = Math.max(0, Number(decimals) | 0);
      const fracPadded = (frac + '0'.repeat(d)).slice(0, d);
      return BigInt(whole || '0') * (10n ** BigInt(d)) + BigInt(fracPadded || '0');
    }

    async function waitForProvider(timeoutMs = 3000) {
      if (window.animica) return window.animica;
      return new Promise((resolve) => {
        const finish = () => {
          clearInterval(poll); clearTimeout(timer);
          window.removeEventListener('animica#initialized', finish);
          resolve(window.animica || null);
        };
        const poll = setInterval(() => { if (window.animica) finish(); }, 150);
        const timer = setTimeout(() => finish(), timeoutMs);
        window.addEventListener('animica#initialized', finish, { once: true });
      });
    }

    async function ensureConnected() {
      if (connectedAddress) return true;
      provider = provider || await waitForProvider();
      if (!provider) {
        statusEl.style.color = '#dc2626';
        statusEl.textContent = 'Install the Animica wallet to act on this pool.';
        return false;
      }
      const accs = await provider.request({ method: 'animica_requestAccounts' });
      if (!accs || !accs[0]) return false;
      connectedAddress = accs[0];
      return true;
    }

    async function load() {
      const addr = getAddressFromUrl();
      if (!addr) {
        loadingEl.style.display = 'none';
        errEl.style.display = '';
        errEl.textContent = 'No pool address in URL.';
        return;
      }

      try {
        const [tokensRes, dexRes, poolRes] = await Promise.all([
          fetch(`${LAUNCHER_API}/tokens?limit=200`).then(r => r.ok ? r.json() : { tokens: [] }),
          fetch(`${LAUNCHER_API}/dex/addresses?chainId=1`).then(r => r.ok ? r.json() : { addresses: {} }),
          fetch(`${LAUNCHER_API}/dex/pool/${encodeURIComponent(addr)}?chainId=1`),
        ]);
        for (const t of (tokensRes.tokens || [])) {
          tokenDirectory.set(String(t.contractAddress).toLowerCase(), {
            id: t.contractAddress, symbol: t.symbol, decimals: Number(t.decimals ?? 9), name: t.name,
          });
        }
        router = dexRes.addresses?.router?.address || null;
        if (!poolRes.ok) {
          const e = await poolRes.json().catch(() => ({}));
          throw new Error(e?.error?.message || `pool fetch HTTP ${poolRes.status}`);
        }
        const data = await poolRes.json();
        pool = data.pool;
        renderPool();
      } catch (err) {
        loadingEl.style.display = 'none';
        errEl.style.display = '';
        errEl.textContent = err?.message || String(err);
      }
    }

    function renderPool() {
      const t0 = tokenInfo(pool.token0);
      const t1 = tokenInfo(pool.token1);
      document.title = `${t0.symbol} / ${t1.symbol} pool · Animica`;
      document.getElementById('pool-title').textContent = `${t0.symbol} / ${t1.symbol}`;
      document.getElementById('pool-addr').textContent = pool.address;
      document.getElementById('t0-label').textContent = `${t0.symbol} reserve`;
      document.getElementById('t1-label').textContent = `${t1.symbol} reserve`;
      document.getElementById('reserve0').textContent = fromBaseUnits(pool.reserve0, t0.decimals);
      document.getElementById('reserve1').textContent = fromBaseUnits(pool.reserve1, t1.decimals);
      document.getElementById('t0-symbol').textContent = t0.symbol;
      document.getElementById('t1-symbol').textContent = t1.symbol;
      document.getElementById('t0-addr').textContent = pool.token0 || '0x (native)';
      document.getElementById('t1-addr').textContent = pool.token1 || '0x (native)';
      document.getElementById('fee-bps').textContent = `${pool.feeBps} bps`;
      document.getElementById('lp-total').textContent = fromBaseUnits(pool.lpTotal, 18);
      document.getElementById('add-t0-label').textContent = t0.symbol;
      document.getElementById('add-t1-label').textContent = t1.symbol;
      document.getElementById('rm-t0-label').textContent = t0.symbol;
      document.getElementById('rm-t1-label').textContent = t1.symbol;

      loadingEl.style.display = 'none';
      article.style.display = '';
    }

    async function waitForTxConfirmed(txid, deadlineMs) {
      const deadline = Date.now() + deadlineMs;
      let last = '';
      while (Date.now() < deadline) {
        const r = await fetch(RPC_URL, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tx.getTransactionStatus', params: [txid] }),
        });
        const body = await r.json().catch(() => null);
        const status = String(body?.result?.status || '').toLowerCase();
        last = status;
        if (status === 'included' || status === 'confirmed' || status === 'finalized') return;
        if (status === 'dropped' || status === 'reorged_out') throw new Error(`tx ${status}`);
        await new Promise((res) => setTimeout(res, 2500));
      }
      throw new Error(`tx not confirmed (last status: ${last || 'unknown'})`);
    }

    async function sendRouterCall(method, args, nativeValueBase) {
      if (!router) throw new Error('Router not pinned for this chain');
      if (!(await ensureConnected())) return;
      const encRes = await fetch(`${LAUNCHER_API}/dex/encode-call`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ role: 'router', method, args }),
      });
      if (!encRes.ok) {
        const e = await encRes.json().catch(() => ({}));
        throw new Error(e?.error?.message || `encode HTTP ${encRes.status}`);
      }
      const { dataHex } = await encRes.json();
      const params = {
        from: connectedAddress,
        to: router,
        data: dataHex,
        kind: 2,
        gas: { limit: 3_000_000 },
      };
      if (nativeValueBase && nativeValueBase > 0n) params.amount = nativeValueBase.toString();
      const res = await provider.request({ method: 'animica_sendTransaction', params: [params] });
      const txid = typeof res === 'string' ? res : res?.txid;
      if (!txid) throw new Error('wallet returned no tx id');
      statusEl.style.color = '';
      statusEl.textContent = `Submitted ${txid.slice(0, 16)}… waiting for block.`;
      await waitForTxConfirmed(txid, 180_000);
      return txid;
    }

    document.getElementById('add-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const t0 = tokenInfo(pool.token0);
      const t1 = tokenInfo(pool.token1);
      const a0 = toBaseUnits(document.getElementById('add-amount0').value, t0.decimals);
      const a1 = toBaseUnits(document.getElementById('add-amount1').value, t1.decimals);
      const minLp = BigInt(document.getElementById('add-min-lp').value || '0');
      const deadline = Math.floor(Date.now() / 1000) + 600;
      if (a0 <= 0n || a1 <= 0n) {
        statusEl.style.color = '#dc2626';
        statusEl.textContent = 'Provide both amounts.';
        return;
      }
      try {
        // Router.add_liquidity takes amounts in token-order independent of t0/t1
        // (router internally sorts). We pass our t0/t1 as a/b.
        let nativeValue = 0n;
        if (t0.id === '0x') nativeValue = a0;
        else if (t1.id === '0x') nativeValue = a1;
        const txid = await sendRouterCall(
          'add_liquidity',
          [t0.id, t1.id, a0.toString(), a1.toString(), minLp.toString(), deadline],
          nativeValue,
        );
        statusEl.style.color = '#059669';
        statusEl.textContent = `Liquidity added (${txid.slice(0, 16)}…). Reload to see new reserves.`;
      } catch (err) {
        statusEl.style.color = '#dc2626';
        statusEl.textContent = err?.message || String(err);
      }
    });

    document.getElementById('remove-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const t0 = tokenInfo(pool.token0);
      const t1 = tokenInfo(pool.token1);
      const lp = toBaseUnits(document.getElementById('remove-lp').value, 18);
      const min0 = BigInt(document.getElementById('remove-min0').value || '0');
      const min1 = BigInt(document.getElementById('remove-min1').value || '0');
      const deadline = Math.floor(Date.now() / 1000) + 600;
      if (lp <= 0n) {
        statusEl.style.color = '#dc2626';
        statusEl.textContent = 'Specify LP amount to burn.';
        return;
      }
      try {
        const txid = await sendRouterCall(
          'remove_liquidity',
          [t0.id, t1.id, lp.toString(), min0.toString(), min1.toString(), deadline],
          0n,
        );
        statusEl.style.color = '#059669';
        statusEl.textContent = `LP burned (${txid.slice(0, 16)}…). Reload to refresh reserves.`;
      } catch (err) {
        statusEl.style.color = '#dc2626';
        statusEl.textContent = err?.message || String(err);
      }
    });

    load();
  </script>
</BaseLayout>
