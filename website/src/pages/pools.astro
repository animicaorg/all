---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Pools — Animica";
const pageDesc =
  "Active liquidity pools on the Animica DEX. Constant-product AMM with on-chain reserves and fee accounting.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-start justify-between gap-3 flex-wrap">
      <div>
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Pools</h1>
        <p class="mt-2 opacity-80 max-w-2xl">
          Every constant-product pool registered with the factory. Reserves and
          LP totals read live from the chain on each page view.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/swap" class="inline-flex items-center justify-center rounded-lg border px-3 py-2 text-sm
              border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]">Swap</a>
        <a href="/launch" class="inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-medium
              bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]">Launch a token</a>
      </div>
    </div>

    <div id="pools-status" class="mt-6 text-sm opacity-70">Loading pools…</div>
    <ul id="pools-list" class="mt-4 grid gap-3"></ul>

    <p class="mt-8 text-xs opacity-60">
      To create a new pool, open a token's detail page and use “Add liquidity”
      — the router will deploy the pair contract and seed the initial reserves
      in a single transaction.
    </p>
  </section>

  <script>
    // @ts-nocheck
    const LAUNCHER_API = (window.LAUNCHER_API_BASE || '/launcher-api') + '/api';

    const statusEl = document.getElementById('pools-status');
    const listEl = document.getElementById('pools-list');

    let tokenDirectory = new Map();

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function fromBaseUnits(raw, decimals) {
      try {
        const d = Math.max(0, Number(decimals ?? 0));
        const big = BigInt(String(raw || '0'));
        if (d === 0) return big.toLocaleString('en-US');
        const base = 10n ** BigInt(d);
        const whole = big / base;
        const frac = (big % base).toString().padStart(d, '0').slice(0, 6).replace(/0+$/, '');
        return frac ? `${whole.toLocaleString('en-US')}.${frac}` : whole.toLocaleString('en-US');
      } catch { return String(raw ?? '0'); }
    }

    function tokenInfo(id) {
      const key = String(id || '0x').toLowerCase();
      if (key === '0x' || key === '') return { symbol: 'ANM', decimals: 18, name: 'Animica' };
      const t = tokenDirectory.get(key);
      return t || { symbol: short(id), decimals: 9, name: 'unknown' };
    }

    function short(id) {
      const s = String(id || '');
      return s.length > 16 ? `${s.slice(0, 8)}…${s.slice(-6)}` : s;
    }

    async function loadTokenDirectory() {
      try {
        const r = await fetch(`${LAUNCHER_API}/tokens?limit=200`);
        const data = await r.json();
        for (const t of (data.tokens || [])) {
          tokenDirectory.set(String(t.contractAddress).toLowerCase(), {
            symbol: t.symbol, decimals: Number(t.decimals ?? 9), name: t.name,
          });
        }
      } catch { /* ignore */ }
    }

    async function loadPools() {
      const r = await fetch(`${LAUNCHER_API}/dex/pools?limit=50&chainId=1`);
      if (r.status === 503) {
        const e = await r.json().catch(() => ({}));
        statusEl.innerHTML = `${escapeHtml(e?.error?.message || 'DEX not deployed')} · <a href="/admin/deploy-dex" class="underline">deploy</a>`;
        return;
      }
      if (!r.ok) {
        statusEl.textContent = `Failed to load pools (HTTP ${r.status})`;
        return;
      }
      const data = await r.json();
      const pools = data.pools || [];
      if (pools.length === 0) {
        statusEl.innerHTML = `No pools yet. <a href="/launch" class="underline">Launch a token</a> and seed liquidity.`;
        return;
      }
      statusEl.textContent = `${data.total} pool${data.total === 1 ? '' : 's'} total · showing ${pools.length}`;
      listEl.innerHTML = pools.map((p) => {
        const t0 = tokenInfo(p.token0);
        const t1 = tokenInfo(p.token1);
        return `
          <li class="rounded-2xl border p-4 transition hover:bg-[color-mix(in_srgb,var(--text-primary)_/_4%,transparent)]
                border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
                bg-[var(--bg-elevated)]">
            <a href="/pool?address=${encodeURIComponent(p.address)}" class="grid sm:grid-cols-[1fr_auto] gap-2">
              <div>
                <div class="font-semibold">${escapeHtml(t0.symbol)} / ${escapeHtml(t1.symbol)}</div>
                <div class="mt-1 text-xs opacity-70 font-mono">${escapeHtml(short(p.address))}</div>
              </div>
              <div class="text-sm grid gap-0.5">
                <div>Reserves <code class="opacity-90">${escapeHtml(fromBaseUnits(p.reserve0, t0.decimals))} ${escapeHtml(t0.symbol)}</code> ·
                     <code class="opacity-90">${escapeHtml(fromBaseUnits(p.reserve1, t1.decimals))} ${escapeHtml(t1.symbol)}</code></div>
                <div class="text-xs opacity-70">Fee <code>${escapeHtml(String(p.feeBps))} bps</code> · LP supply <code>${escapeHtml(fromBaseUnits(p.lpTotal, 18))}</code></div>
              </div>
            </a>
          </li>`;
      }).join('');
    }

    (async () => {
      await loadTokenDirectory();
      await loadPools();
    })();
  </script>
</BaseLayout>
