---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { networkPanels } from "../data/aicf";

const title = "Network";
const description =
  "AICF network telemetry including active providers, utilization, jobs, rewards paid, model call volume, latency, and subsidy usage.";

const utilizationSeries = [52, 57, 61, 65, 62, 68, 71, 74, 70, 73, 76, 78];
const providerRegions = [
  { region: 'EU Central', providers: 49, avgLatency: '212 ms' },
  { region: 'US East', providers: 38, avgLatency: '241 ms' },
  { region: 'US West', providers: 27, avgLatency: '255 ms' },
  { region: 'AP Southeast', providers: 19, avgLatency: '278 ms' },
  { region: 'South America', providers: 9, avgLatency: '315 ms' },
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Network Telemetry</span>
      <h1 class="aicf-heading">Live AICF Compute Network</h1>
      <p class="aicf-subheading">
        Production metrics for provider availability, queue behavior, workload throughput, and ANM reward distribution.
        Values are real-time where available and mock-live where backend streams are still being wired.
      </p>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-4">
      {networkPanels.map((panel) => (
        <article class="aicf-card">
          <p class="aicf-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.07em;">{panel.label}</p>
          <p class="aicf-value">{panel.value}</p>
          <p class="aicf-muted" style="font-size:0.82rem;">{panel.footnote}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <h2 style="font-size:1.35rem;">Utilization Trend (12h)</h2>
        <p class="aicf-muted" style="margin-top:0.55rem;">Queue-weighted utilization of active provider capacity.</p>
        <div style="margin-top:0.85rem; display:flex; align-items:flex-end; gap:0.45rem; height:210px;">
          {utilizationSeries.map((point) => (
            <div style={`flex:1; border-radius:0.35rem; background:linear-gradient(180deg, rgba(22,217,195,0.86), rgba(58,155,255,0.62)); height:${point}%;`} title={`${point}%`} />
          ))}
        </div>
      </article>

      <article class="aicf-card">
        <h2 style="font-size:1.35rem;">Current Workload Split</h2>
        <div style="margin-top:0.9rem; display:grid; gap:0.6rem;">
          <div>
            <div style="display:flex;justify-content:space-between;font-size:0.9rem;"><span>Chat Inference</span><strong>54%</strong></div>
            <div style="height:8px;background:rgba(149,170,198,0.2);border-radius:999px;overflow:hidden;"><div style="height:100%;width:54%;background:#16d9c3;"></div></div>
          </div>
          <div>
            <div style="display:flex;justify-content:space-between;font-size:0.9rem;"><span>Embeddings</span><strong>24%</strong></div>
            <div style="height:8px;background:rgba(149,170,198,0.2);border-radius:999px;overflow:hidden;"><div style="height:100%;width:24%;background:#3a9bff;"></div></div>
          </div>
          <div>
            <div style="display:flex;justify-content:space-between;font-size:0.9rem;"><span>Agent Tasks</span><strong>15%</strong></div>
            <div style="height:8px;background:rgba(149,170,198,0.2);border-radius:999px;overflow:hidden;"><div style="height:100%;width:15%;background:#7bd7ff;"></div></div>
          </div>
          <div>
            <div style="display:flex;justify-content:space-between;font-size:0.9rem;"><span>Training / Batch</span><strong>7%</strong></div>
            <div style="height:8px;background:rgba(149,170,198,0.2);border-radius:999px;overflow:hidden;"><div style="height:100%;width:7%;background:#a7f5e8;"></div></div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <h2 style="font-size:1.25rem;">Regional Provider Distribution</h2>
        <table class="aicf-table" style="margin-top:0.8rem;">
          <thead>
            <tr>
              <th>Region</th>
              <th>Providers</th>
              <th>Avg Latency</th>
            </tr>
          </thead>
          <tbody>
            {providerRegions.map((row) => (
              <tr>
                <td><strong>{row.region}</strong></td>
                <td>{row.providers}</td>
                <td>{row.avgLatency}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </article>

      <article class="aicf-card">
        <h2 style="font-size:1.25rem;">Network Economy Snapshot</h2>
        <ul style="margin-top:0.8rem; padding-left:1rem; display:grid; gap:0.45rem;">
          <li>Active providers online: <strong>142</strong></li>
          <li>Jobs completed this epoch: <strong>3.2M</strong></li>
          <li>ANM paid to providers this epoch: <strong>812k</strong></li>
          <li>Treasury subsidy in use: <strong>214k ANM</strong></li>
          <li>Average completion SLA adherence: <strong>98.1%</strong></li>
        </ul>
      </article>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
