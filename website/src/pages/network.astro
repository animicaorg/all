---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Network";
const description =
  "The Animica network: live post-quantum L1 chain endpoints (explorer, RPC, mining pool) plus AICF compute telemetry fetched from the live status endpoint.";
const aicfApiBaseUrl =
  (import.meta.env.ANIMICA_AICF_API_BASE_URL as string | undefined)?.trim() ||
  (import.meta.env.PUBLIC_ANIMICA_AICF_API_BASE_URL as string | undefined)?.trim() ||
  "https://aicf.animica.org/api";

const chainEndpoints = [
  {
    name: "Block Explorer",
    detail: "Blocks, transactions, and addresses on Animica mainnet (chain id 1).",
    href: "https://explorer.animica.org",
    label: "explorer.animica.org",
  },
  {
    name: "Public JSON-RPC",
    detail: "JSON-RPC 2.0 over HTTPS, POST only. See the developer docs for a curl example.",
    href: "/developers#rpc",
    label: "rpc.animica.org/rpc",
  },
  {
    name: "Mining Pool",
    detail: "PoIES useful-work mining with XMR dual-mining and live pool stats.",
    href: "https://pool.animica.org",
    label: "pool.animica.org",
  },
  {
    name: "Web Wallet",
    detail: "Post-quantum accounts with bech32m addresses (anim1...).",
    href: "https://wallet.animica.org",
    label: "wallet.animica.org",
  },
];

const summaryMetrics = [
  { key: "providers", label: "Providers" },
  { key: "nodes", label: "Nodes" },
  { key: "jobs", label: "Jobs" },
  { key: "contractJobs", label: "Contract Jobs" },
  { key: "agentTasks", label: "Agent Tasks" },
  { key: "queueUnits", label: "Total Queue Units" },
  { key: "usage", label: "Usage Records" },
  { key: "settlements", label: "Settlements" },
];

const healthMetrics = [
  { key: "serviceStatus", label: "Service Status", footnote: "From AICF /status" },
  { key: "paused", label: "Scheduler Paused", footnote: "Governance pause flag" },
  { key: "apiLatencyMs", label: "API Latency", footnote: "Browser-observed fetch RTT" },
  { key: "updatedAt", label: "Last Update", footnote: "UTC timestamp from status payload" },
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Animica Network</span>
      <h1 class="aicf-heading">One Chain, Two Workloads: Consensus + Compute</h1>
      <p class="aicf-subheading">
        Animica mainnet is a live post-quantum L1 secured by useful-work consensus (PoIES). The chain endpoints below are
        always available; AICF compute telemetry further down is fetched live from the AICF status endpoint.
      </p>
      <div class="aicf-btn-row">
        <a class="aicf-btn" href="https://explorer.animica.org">Open Explorer</a>
        <a class="aicf-ghost-btn" href="/mine">Start Mining</a>
        <a class="aicf-ghost-btn" href="/developers#rpc">RPC Reference</a>
      </div>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Chain Endpoints</span>
      <div class="aicf-grid-4" style="margin-top:0.95rem;">
        {chainEndpoints.map((ep) => (
          <article class="aicf-card">
            <h3 style="font-size:1.1rem;">{ep.name}</h3>
            <p class="aicf-muted" style="margin-top:0.45rem;">{ep.detail}</p>
            <p style="margin-top:0.6rem;"><a href={ep.href}><code>{ep.label}</code></a></p>
          </article>
        ))}
      </div>
      <p class="aicf-muted" style="margin-top:0.75rem; font-size:0.9rem;">
        The RPC endpoint accepts JSON-RPC over POST only — <code>https://rpc.animica.org/rpc</code>. GET requests are not served.
      </p>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container" data-aicf-network-root data-aicf-api-base={aicfApiBaseUrl}>
      <span class="aicf-kicker">AICF Compute Telemetry</span>
      <h2 class="aicf-heading" style="font-size:1.6rem;">Live Compute Network Metrics</h2>
      <p class="aicf-subheading">
        Values below are fetched live from the AICF status endpoint. If the endpoint cannot be reached, metrics are marked
        unavailable instead of showing placeholders.
      </p>
      <div class="aicf-grid-4" style="margin-top:0.95rem;">
        {summaryMetrics.map((metric) => (
          <article class="aicf-card">
            <p class="aicf-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.07em;">{metric.label}</p>
            <p class="aicf-value" data-aicf-network-metric={metric.key}>--</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <h2 style="font-size:1.25rem;">Status Health</h2>
        <div class="aicf-grid-2" style="margin-top:0.85rem;">
          {healthMetrics.map((metric) => (
            <div class="aicf-card" style="padding:0.75rem; background:rgba(7,15,28,0.56);">
              <p class="aicf-muted" style="font-size:0.8rem;">{metric.label}</p>
              <p class="aicf-value" style="font-size:1.45rem;" data-aicf-network-metric={metric.key}>--</p>
              <p class="aicf-muted" style="font-size:0.82rem;">{metric.footnote}</p>
            </div>
          ))}
        </div>
      </article>

      <article class="aicf-card">
        <h2 style="font-size:1.25rem;">Live Count Breakdown</h2>
        <table class="aicf-table" style="margin-top:0.8rem;">
          <thead>
            <tr>
              <th>Metric</th>
              <th>Value</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Users</strong></td>
              <td data-aicf-network-metric="users">--</td>
            </tr>
            <tr>
              <td><strong>Projects</strong></td>
              <td data-aicf-network-metric="projects">--</td>
            </tr>
            <tr>
              <td><strong>Providers</strong></td>
              <td data-aicf-network-metric="providers">--</td>
            </tr>
            <tr>
              <td><strong>Nodes</strong></td>
              <td data-aicf-network-metric="nodes">--</td>
            </tr>
            <tr>
              <td><strong>Jobs</strong></td>
              <td data-aicf-network-metric="jobs">--</td>
            </tr>
            <tr>
              <td><strong>Contract Jobs</strong></td>
              <td data-aicf-network-metric="contractJobs">--</td>
            </tr>
            <tr>
              <td><strong>Agent Tasks</strong></td>
              <td data-aicf-network-metric="agentTasks">--</td>
            </tr>
            <tr>
              <td><strong>Usage Records</strong></td>
              <td data-aicf-network-metric="usage">--</td>
            </tr>
            <tr>
              <td><strong>Settlements</strong></td>
              <td data-aicf-network-metric="settlements">--</td>
            </tr>
          </tbody>
        </table>
      </article>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container">
      <article class="aicf-card">
        <h2 style="font-size:1.2rem;">Raw Status Payload</h2>
        <p class="aicf-muted" style="margin-top:0.6rem;">Direct payload from the live AICF status endpoint.</p>
        <div class="aicf-code" style="margin-top:0.75rem;">
          <pre style="margin:0;" data-aicf-network-raw>{`Loading...`}</pre>
        </div>
      </article>
      <p class="aicf-muted" style="margin-top:0.75rem;" data-aicf-network-message>Loading live AICF metrics...</p>
    </div>
  </section>

  <script>
    import {
      deriveAicfCounts,
      fetchAicfStatus,
      formatCount,
      formatUtc,
    } from "../features/aicf/liveMetricsClient";

    const rootEl = document.querySelector<HTMLElement>("[data-aicf-network-root]");
    const aicfApiBaseUrl = rootEl?.dataset.aicfApiBase || "https://aicf.animica.org/api";
    const messageEl = document.querySelector("[data-aicf-network-message]");
    const rawEl = document.querySelector("[data-aicf-network-raw]");
    const metricEls = Array.from(document.querySelectorAll("[data-aicf-network-metric]"));

    const setMetric = (key: string, value: string) => {
      for (const el of metricEls) {
        if (el.getAttribute("data-aicf-network-metric") === key) {
          el.textContent = value;
        }
      }
    };

    const setUnavailable = () => {
      for (const el of metricEls) {
        el.textContent = "Unavailable";
      }
      if (rawEl) {
        rawEl.textContent = "Unavailable";
      }
      if (messageEl) {
        messageEl.textContent =
          "Live AICF telemetry is temporarily unavailable. Chain endpoints above are unaffected.";
      }
    };

    const loadMetrics = async () => {
      try {
        const { payload, latencyMs } = await fetchAicfStatus(aicfApiBaseUrl);
        const counts = deriveAicfCounts(payload);

        setMetric("users", formatCount(counts.users));
        setMetric("projects", formatCount(counts.projects));
        setMetric("providers", formatCount(counts.providers));
        setMetric("nodes", formatCount(counts.nodes));
        setMetric("jobs", formatCount(counts.jobs));
        setMetric("contractJobs", formatCount(counts.contractJobs));
        setMetric("agentTasks", formatCount(counts.agentTasks));
        setMetric("queueUnits", formatCount(counts.queueUnits));
        setMetric("usage", formatCount(counts.usage));
        setMetric("settlements", formatCount(counts.settlements));
        setMetric("serviceStatus", String(payload.status ?? "unknown").toUpperCase());
        setMetric("paused", payload.paused ? "YES" : "NO");
        setMetric("apiLatencyMs", `${latencyMs} ms`);
        setMetric("updatedAt", formatUtc(payload.timestamp));

        if (rawEl) {
          rawEl.textContent = JSON.stringify(payload, null, 2);
        }
        if (messageEl) {
          messageEl.textContent = `Live AICF metrics refreshed at ${formatUtc(payload.timestamp)}.`;
        }
      } catch (error) {
        console.error("[aicf-network] unable to fetch live status", error);
        setUnavailable();
      }
    };

    loadMetrics().catch(() => setUnavailable());
  </script>

  <Footer slot="footer" />
</BaseLayout>
