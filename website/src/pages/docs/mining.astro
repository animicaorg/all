---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InlineLink from "../../components/InlineLink.astro";

const pageTitle = "Mining & animica up — Animica Docs";
const pageDesc =
  "Mine Animica with one command. animica up is the unified miner: Proof-of-Work + useful-work (AI/ENA) " +
  "+ GPU train/serve + Studio functions. The native CPU miner (animica-fastpow) ships by default with " +
  "pip install animica for real multi-core SHA3-256 hashrate.";
const canonical = "https://animica.org/docs/mining";

const lanes = [
  ["Proof-of-Work", "Native SHA3-256 CPU hashing (animica-fastpow) across all cores, with a pure-Python fallback."],
  ["Useful-work (PoIES)", "AI/ENA jobs from the AICF lane — useful computation that also secures the chain."],
  ["GPU train / serve", "If a GPU is present, the same rig trains and serves models (torch/transformers ship in the base install)."],
  ["Studio functions", "The rig also runs serverless Studio functions submitted to the fleet, settled in ANM."],
];

const installs = [
  ["pip install animica", "The complete client. Mine, run a node, use the wallet, deploy Python contracts, run animica up, and use the Studio SDK. The native CPU miner (animica-fastpow) is included BY DEFAULT. What most people want."],
  ["pip install \"animica[all]\"", "Everything above PLUS every optional extra: Qt desktop-wallet QR codes, the full distributed Studio client (cloudpickle + omni-sdk for on-chain ANM escrow), and all server/operator deps pinned. Quote the brackets so zsh/macOS doesn't glob them."],
  ["pip install animica-fastpow", "Just the native accelerator (prebuilt wheels for Linux/macOS/Windows). Already bundled by pip install animica — only needed to install it standalone."],
];

const faqs = [
  {
    q: "Do I need to install the native miner separately?",
    a: "No. animica-fastpow ships by default with pip install animica, so animica up gets real multi-core " +
      "SHA3-256 hashrate out of the box. Its build is tolerant: on a platform with no prebuilt wheel and no C " +
      "compiler it installs a pure-Python no-op and the miner falls back — so it never breaks the install.",
  },
  {
    q: "What's the difference between animica and animica[all]?",
    a: "pip install animica is the complete client — mining, node, wallet, contracts, animica up, and the " +
      "Studio SDK, with the native CPU miner included by default. pip install \"animica[all]\" adds every " +
      "optional extra on top (Qt QR codes, the full distributed Studio client, and pinned server/operator " +
      "dependencies). Most people want plain animica; use [all] for the kitchen sink or pool/API infra.",
  },
  {
    q: "Does mining require a GPU?",
    a: "No. The CPU PoW + useful-work lanes run anywhere. A GPU is optional — if present, animica up also " +
      "trains and serves models and earns from those lanes too. The base install ships the GPU/AI stack " +
      "(torch, transformers, accelerate) so it's GPU-ready with no extra step.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Mining Animica with animica up",
    description: pageDesc,
    url: canonical,
    inLanguage: "en",
    keywords: "Animica mining, animica up, native CPU miner, animica-fastpow, SHA3-256, useful work, " +
      "PoIES, GPU mining, ANM",
    isPartOf: { "@type": "WebSite", name: "Animica", url: "https://animica.org" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Animica", item: "https://animica.org" },
      { "@type": "ListItem", position: 2, name: "Docs", item: "https://animica.org/docs" },
      { "@type": "ListItem", position: 3, name: "Mining", item: canonical },
    ],
  },
];

const card = "rounded-2xl border p-5 bg-[var(--bg-elevated)] border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]";
const pre = "mt-4 overflow-x-auto rounded-2xl border p-5 text-sm leading-relaxed bg-[var(--bg-elevated)] border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]";
---

<BaseLayout title={pageTitle} description={pageDesc} canonical={canonical} jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <p class="font-mono text-xs uppercase tracking-[0.16em] opacity-60">Docs · Mining</p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight">Mining &amp; <code>animica up</code></h1>
    <p class="mt-4 text-lg opacity-85 max-w-3xl">
      One command turns a machine into an Animica miner. <code>animica up</code> is the
      <strong>unified miner</strong>: it runs Proof-of-Work, useful-work (AI/ENA), GPU train/serve, and
      Studio functions from the same process — and the native CPU miner ships <strong>by default</strong>.
    </p>

    <pre class={pre}><code>{`pip install animica      # complete client; native CPU miner included by default
animica up               # unified miner: PoW + useful-work + GPU train/serve + Studio`}</code></pre>

    <!-- Lanes -->
    <h2 class="mt-12 text-2xl font-semibold">What <code>animica up</code> does</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {lanes.map((l) => (
        <div class={card}>
          <div class="font-semibold text-sm">{l[0]}</div>
          <p class="mt-2 text-sm opacity-80">{l[1]}</p>
        </div>
      ))}
    </div>

    <!-- Native miner -->
    <h2 class="mt-12 text-2xl font-semibold">The native CPU miner</h2>
    <p class="mt-2 text-sm opacity-80 max-w-3xl">
      <code>animica-fastpow</code> is a small C extension (optimized <code>tiny_sha3</code> keccak) that
      gives the miner real multi-core SHA3-256 hashrate instead of pure-Python hashing. It ships with
      <code>pip install animica</code>, so there's nothing extra to do. The miner imports it
      automatically and <strong>falls back to a pure-Python loop</strong> if it isn't present — it's an
      accelerator, never a hard requirement.
    </p>
    <ul class="mt-4 space-y-1.5 text-sm opacity-85 list-disc pl-5 max-w-3xl">
      <li>Prebuilt wheels for Linux, macOS (Intel + Apple Silicon) and Windows (cp38–cp313).</li>
      <li>Tolerant build: no wheel and no C compiler → installs a pure-Python no-op; the install never breaks.</li>
      <li>From source needs a C compiler (gcc/clang, or MSVC Build Tools on Windows).</li>
    </ul>

    <!-- Install matrix -->
    <h2 class="mt-12 text-2xl font-semibold">Install options</h2>
    <div class="mt-4 space-y-4">
      {installs.map((i) => (
        <div class={card}>
          <code class="block font-mono text-sm">{i[0]}</code>
          <p class="mt-2 text-sm opacity-80">{i[1]}</p>
        </div>
      ))}
    </div>
    <p class="mt-3 text-xs opacity-60 max-w-3xl">
      To install only the accelerator via the miner extra: <code>pip install "animica[fast]"</code>.
    </p>

    <!-- FAQ -->
    <h2 class="mt-12 text-2xl font-semibold">FAQ</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((f) => (
        <details class={card}>
          <summary class="cursor-pointer font-medium">{f.q}</summary>
          <p class="mt-2 text-sm opacity-80">{f.a}</p>
        </details>
      ))}
    </div>

    <p class="mt-10 text-sm opacity-70">
      See also: <InlineLink href="/docs/studio">Animica Studio SDK</InlineLink> ·
      <InlineLink href="/providers">Become a compute provider</InlineLink> ·
      <InlineLink href="/docs">All docs</InlineLink>
    </p>
  </section>
</BaseLayout>
