---
/**
 * /docs/<group>/<slug> — renders entries of the `docs` content collection
 * (generated by scripts/sync_curated_docs.mjs from the repository docs).
 */
import { getCollection, type CollectionEntry } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import groups from "../../content/docs/_groups.json";

type Doc = CollectionEntry<"docs">;
type NavItem = { slug: string; title: string };
type NavGroup = { key: string; title: string; items: NavItem[] };

export async function getStaticPaths() {
  const order = groups.map((g) => g.key);
  const rank = (k?: string) => {
    const i = order.indexOf(k ?? "");
    return i === -1 ? 999 : i;
  };
  const all = (await getCollection("docs", ({ data }) => !data.draft && !data.redirect)).sort(
    (a, b) =>
      rank(a.data.group) - rank(b.data.group) ||
      (a.data.order ?? 999) - (b.data.order ?? 999) ||
      a.data.title.localeCompare(b.data.title),
  );
  const nav: NavGroup[] = groups
    .map((g) => ({
      key: g.key,
      title: g.title,
      items: all.filter((e) => e.data.group === g.key).map((e) => ({ slug: e.slug, title: e.data.title })),
    }))
    .filter((g) => g.items.length > 0);

  return all.map((entry, idx) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      nav,
      prev: idx > 0 ? { slug: all[idx - 1].slug, title: all[idx - 1].data.title } : null,
      next: idx < all.length - 1 ? { slug: all[idx + 1].slug, title: all[idx + 1].data.title } : null,
    },
  }));
}

const { entry, nav, prev, next } = Astro.props as {
  entry: Doc;
  nav: NavGroup[];
  prev: NavItem | null;
  next: NavItem | null;
};

const { Content, headings } = await entry.render();
const fm = entry.data;
const groupTitle = groups.find((g) => g.key === fm.group)?.title ?? "Docs";
const canonical = `https://animica.org/docs/${entry.slug}`;
const toc = headings.filter((h) => h.depth === 2);
const words = entry.body ? entry.body.split(/\s+/).length : 0;
const minutes = Math.max(1, Math.round(words / 220));

// The generated body starts with "*Source: `docs/...` — ...*"; recover the repo path for the GitHub link.
const sourceMatch = entry.body?.match(/Source: `([^`]+)`/);
const sourcePath = sourceMatch ? sourceMatch[1] : null;
const sourceUrl = sourcePath ? `https://github.com/animicaorg/all/blob/main/${sourcePath}` : null;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: fm.title,
    description: fm.description,
    url: canonical,
    inLanguage: "en",
    wordCount: words,
    author: { "@type": "Organization", name: "Animica", url: "https://animica.org" },
    isPartOf: { "@type": "CollectionPage", name: "Animica Documentation", url: "https://animica.org/docs" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Docs", item: "https://animica.org/docs" },
      { "@type": "ListItem", position: 2, name: groupTitle, item: `https://animica.org/docs#${fm.group}` },
      { "@type": "ListItem", position: 3, name: fm.title, item: canonical },
    ],
  },
];
---

<DocsLayout title={fm.title} description={fm.description ?? `${fm.title} — Animica documentation.`} jsonLd={jsonLd}>
  <div class="mx-auto max-w-7xl lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-12">
    <aside class="docs-side mb-10 lg:mb-0" aria-label="Documentation sections">
      <div class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto pr-2">
        <p class="text-xs uppercase tracking-wide opacity-60 m-0 mb-2">
          <a href="/docs" class="hover:opacity-100">Docs home</a>
        </p>
        {nav.map((g) => (
          <details open={g.key === fm.group} class="mb-2 group/nav">
            <summary class="cursor-pointer select-none text-sm font-semibold py-1 list-none flex items-center justify-between">
              <span>{g.title}</span>
              <span class="text-xs opacity-50">{g.items.length}</span>
            </summary>
            <ul class="m-0 mt-1 mb-2 p-0 list-none border-l border-white/10">
              {g.items.map((it) => (
                <li class="m-0">
                  <a
                    href={`/docs/${it.slug}`}
                    aria-current={it.slug === entry.slug ? "page" : undefined}
                    class:list={[
                      "block pl-3 pr-2 py-1 text-sm leading-snug -ml-px border-l",
                      it.slug === entry.slug
                        ? "border-[var(--anm-blue-fill,#2e63ff)] text-white font-medium bg-white/5"
                        : "border-transparent opacity-75 hover:opacity-100 hover:border-white/30",
                    ]}
                  >
                    {it.title}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </aside>

    <article class="min-w-0">
      <nav class="text-sm opacity-70 flex gap-2 mb-4" aria-label="Breadcrumb">
        <a href="/docs" class="hover:opacity-100">Docs</a>
        <span aria-hidden="true">/</span>
        <a href={`/docs#${fm.group}`} class="hover:opacity-100">{groupTitle}</a>
      </nav>

      <header class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-semibold m-0 leading-tight">{fm.title}</h1>
        {fm.description && <p class="mt-3 mb-0 text-lg opacity-80 leading-relaxed">{fm.description}</p>}
        <p class="mt-3 mb-0 text-xs opacity-60 flex flex-wrap gap-x-3 gap-y-1">
          <span>{minutes} min read</span>
          <span aria-hidden="true">·</span>
          <span>{words.toLocaleString("en-US")} words</span>
          {sourceUrl && (
            <>
              <span aria-hidden="true">·</span>
              <a href={sourceUrl} rel="noopener noreferrer" class="underline hover:opacity-100">
                View <code>{sourcePath}</code> on GitHub
              </a>
            </>
          )}
        </p>
      </header>

      {toc.length > 2 && (
        <nav class="toc rounded-lg border border-white/10 bg-white/5 p-4 mb-8" aria-label="On this page">
          <p class="m-0 mb-2 text-xs uppercase tracking-wide opacity-60">On this page</p>
          <ol class="m-0 pl-5 text-sm leading-7">
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} class="opacity-80 hover:opacity-100 hover:underline">{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose-docs">
        <Content />
      </div>

      <nav class="mt-12 grid gap-4 sm:grid-cols-2" aria-label="Previous and next">
        {prev ? (
          <a href={`/docs/${prev.slug}`} class="block rounded-lg border border-white/10 bg-white/5 p-4 hover:border-white/25 hover:bg-white/10 transition-colors">
            <span class="block text-xs opacity-60">← Previous</span>
            <strong class="block mt-1">{prev.title}</strong>
          </a>
        ) : <span />}
        {next ? (
          <a href={`/docs/${next.slug}`} class="block rounded-lg border border-white/10 bg-white/5 p-4 text-right hover:border-white/25 hover:bg-white/10 transition-colors">
            <span class="block text-xs opacity-60">Next →</span>
            <strong class="block mt-1">{next.title}</strong>
          </a>
        ) : <span />}
      </nav>

      <p class="mt-10 text-sm opacity-70">
        This page mirrors a file in the <a href="https://github.com/animicaorg/all" rel="noopener noreferrer" class="underline">animicaorg/all</a>
        repository. If the repository and this page ever disagree, the repository is authoritative. For
        long-form explainers written for newcomers, see <a href="/learn" class="underline">Learn</a>.
      </p>
    </article>
  </div>

  <style>
    .docs-side summary::-webkit-details-marker { display: none; }
    .toc ol { columns: 2; column-gap: 2rem; }
    @media (max-width: 640px) { .toc ol { columns: 1; } }

    .prose-docs { font-size: 1rem; line-height: 1.7; }
    .prose-docs :global(p) { margin: 0.85rem 0; }
    .prose-docs :global(h2) { margin: 2.25rem 0 0.6rem; font-size: 1.5rem; font-weight: 600; letter-spacing: -0.01em; scroll-margin-top: 5rem; }
    .prose-docs :global(h3) { margin: 1.6rem 0 0.4rem; font-size: 1.2rem; font-weight: 600; scroll-margin-top: 5rem; }
    .prose-docs :global(h4) { margin: 1.2rem 0 0.3rem; font-size: 1.05rem; font-weight: 600; scroll-margin-top: 5rem; }
    .prose-docs :global(ul), .prose-docs :global(ol) { margin: 0.75rem 0; padding-left: 1.5rem; }
    .prose-docs :global(ul) { list-style: disc; }
    .prose-docs :global(ol) { list-style: decimal; }
    .prose-docs :global(li) { margin: 0.25rem 0; }
    .prose-docs :global(li > p) { margin: 0.25rem 0; }
    .prose-docs :global(code) { background: rgba(255,255,255,0.08); padding: 0.12rem 0.35rem; border-radius: 0.35rem; font-size: 0.92em; }
    .prose-docs :global(pre) { padding: 1rem; border-radius: 0.75rem; border: 1px solid rgba(255,255,255,0.1); overflow-x: auto; line-height: 1.55; font-size: 0.88rem; margin: 1rem 0; }
    .prose-docs :global(pre code) { background: none; padding: 0; font-size: inherit; }
    .prose-docs :global(a) { color: var(--anm-blue-fill, #2e63ff); text-decoration: underline; text-underline-offset: 2px; }
    .prose-docs :global(table) { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 0.92rem; display: block; overflow-x: auto; }
    .prose-docs :global(th), .prose-docs :global(td) { border: 1px solid rgba(255,255,255,0.15); padding: 0.45rem 0.6rem; text-align: left; vertical-align: top; }
    .prose-docs :global(th) { background: rgba(255,255,255,0.05); }
    .prose-docs :global(blockquote) { margin: 1rem 0; padding: 0.6rem 1rem; border-left: 3px solid var(--anm-phthalo, #14c79b); background: rgba(255,255,255,0.03); border-radius: 0 0.5rem 0.5rem 0; }
    .prose-docs :global(blockquote p) { margin: 0.3rem 0; }
    .prose-docs :global(hr) { border: 0; border-top: 1px solid rgba(255,255,255,0.15); margin: 2rem 0; }
    .prose-docs :global(img) { max-width: 100%; height: auto; border-radius: 0.5rem; }
    .prose-docs :global(details) { margin: 0.75rem 0; }
    .prose-docs :global(> p:first-child) { font-size: 0.9rem; opacity: 0.75; }
  </style>
</DocsLayout>
