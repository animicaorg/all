---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { ENV } from "../env";

const pageTitle = "Start Mining Animica";
const pageDesc =
  "Production mining portal for Animica with live Stratum detection, starter bundles, generated launch files, and troubleshooting guidance.";
const miningApiBase = ENV.MINING_API_BASE_URL || ENV.POOL_URL || "";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <Header slot="header" />

  <main class="min-h-screen">
    <section class="relative overflow-hidden border-b border-white/10 bg-[radial-gradient(circle_at_top_left,rgba(14,165,233,0.22),transparent_42%),radial-gradient(circle_at_bottom_right,rgba(249,115,22,0.18),transparent_38%),linear-gradient(180deg,rgba(5,10,20,0.98),rgba(10,18,30,0.92))]">
      <div class="absolute inset-0 bg-[linear-gradient(90deg,transparent,rgba(255,255,255,0.04),transparent)] opacity-40"></div>
      <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-[1.3fr_0.9fr]">
          <div>
            <div class="flex flex-wrap gap-3">
              <span
                id="pool-status-chip"
                class="inline-flex items-center rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-emerald-200"
              >
                Checking pool status
              </span>
              <span
                id="network-chip"
                class="inline-flex items-center rounded-full border border-sky-400/20 bg-sky-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-sky-100"
              >
                Loading network
              </span>
              <span
                id="profile-chip"
                class="inline-flex items-center rounded-full border border-orange-300/20 bg-orange-300/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-orange-100"
              >
                Detecting profile
              </span>
            </div>

            <h1 class="mt-6 max-w-4xl text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl">
              Start Mining Animica
            </h1>
            <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-200/90">
              Connect to the live Animica Stratum pool, download the right starter bundle for your
              machine, and launch a reference CPU miner with the detected host and port already wired in.
            </p>

            <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-300">Stratum Host</p>
                <div class="mt-3 flex items-start justify-between gap-3">
                  <p id="stratum-host" class="text-lg font-semibold text-white">Resolving…</p>
                  <button
                    data-copy-value-target="stratum-host"
                    class="rounded-lg border border-white/10 px-3 py-1 text-xs font-medium text-slate-200 transition hover:border-sky-300/40 hover:text-white"
                  >
                    Copy
                  </button>
                </div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-300">Stratum Port</p>
                <div class="mt-3 flex items-start justify-between gap-3">
                  <p id="stratum-port" class="text-lg font-semibold text-white">Resolving…</p>
                  <button
                    data-copy-value-target="stratum-port"
                    class="rounded-lg border border-white/10 px-3 py-1 text-xs font-medium text-slate-200 transition hover:border-sky-300/40 hover:text-white"
                  >
                    Copy
                  </button>
                </div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-300">Algorithm</p>
                <p id="algorithm-text" class="mt-3 text-lg font-semibold text-white">Loading…</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-300">Active Miners</p>
                <p id="active-miners" class="mt-3 text-lg font-semibold text-white">0</p>
              </div>
            </div>

            <div id="warning-panel" class="mt-8 hidden rounded-2xl border border-amber-400/30 bg-amber-500/10 p-5 text-sm text-amber-50">
              <p class="font-semibold uppercase tracking-[0.24em] text-amber-100">Deployment Warnings</p>
              <ul id="warning-list" class="mt-3 space-y-2"></ul>
            </div>
          </div>

          <div class="rounded-[28px] border border-white/10 bg-slate-950/60 p-6 shadow-2xl shadow-slate-950/50 backdrop-blur">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-300">Quick Start</p>
            <div class="mt-6 space-y-5">
              <div class="rounded-2xl border border-white/8 bg-white/5 p-4">
                <p class="text-sm font-semibold text-white">1. Get a payout address</p>
                <p class="mt-2 text-sm text-slate-300">
                  Use an Animica wallet address that matches the active network shown on this page.
                </p>
              </div>
              <div class="rounded-2xl border border-white/8 bg-white/5 p-4">
                <p class="text-sm font-semibold text-white">2. Download your starter bundle</p>
                <p class="mt-2 text-sm text-slate-300">
                  Windows gets a <code>.zip</code>, macOS a <code>.zip</code> with a
                  <code>.command</code> launcher, and Ubuntu/Linux a <code>.tar.gz</code>.
                </p>
              </div>
              <div class="rounded-2xl border border-white/8 bg-white/5 p-4">
                <p class="text-sm font-semibold text-white">3. Run the included launcher</p>
                <p class="mt-2 text-sm text-slate-300">
                  Browsers cannot open local terminals directly. The downloaded launcher does that on
                  your machine after you unpack and run it.
                </p>
              </div>
              <div class="rounded-2xl border border-white/8 bg-white/5 p-4">
                <p class="text-sm font-semibold text-white">4. Track pool health</p>
                <p class="mt-2 text-sm text-slate-300">
                  Current height: <span id="pool-height" class="font-semibold text-white">0</span><br />
                  Pool hashrate: <span id="pool-hashrate" class="font-semibold text-white">0 H/s</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-8 xl:grid-cols-[1.1fr_0.9fr]">
        <div class="rounded-[28px] border border-slate-200/10 bg-[color:var(--bg-elevated)] p-6 shadow-xl shadow-slate-950/10">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">Connection Builder</p>
              <h2 class="mt-2 text-2xl font-semibold text-white">Connect your wallet and worker</h2>
            </div>
            <button
              id="refresh-generated"
              class="inline-flex items-center rounded-xl border border-sky-400/30 bg-sky-500/10 px-4 py-2 text-sm font-medium text-sky-100 transition hover:border-sky-300 hover:bg-sky-500/20"
            >
              Refresh Commands
            </button>
          </div>

          <div class="mt-6 grid gap-5 md:grid-cols-3">
            <label class="block">
              <span class="text-sm font-medium text-slate-200">Payout address</span>
              <input
                id="payout-address"
                type="text"
                placeholder="anim1..."
                class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-sky-400/60"
              />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-slate-200">Worker name</span>
              <input
                id="worker-name"
                type="text"
                placeholder="office-cpu"
                class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-sky-400/60"
              />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-slate-200">CPU threads</span>
              <input
                id="thread-count"
                type="number"
                min="1"
                max="256"
                step="1"
                class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-sky-400/60"
              />
            </label>
          </div>

          <div class="mt-5 rounded-2xl border border-white/8 bg-slate-950/40 p-4 text-sm text-slate-300">
            <p class="font-medium text-white">Worker naming</p>
            <p class="mt-2">
              Worker names are labels only. The payout address and worker name are sent separately, so
              you can use short names like <code>rig-01</code>, <code>mac-mini</code>, or
              <code>office-cpu</code>.
            </p>
          </div>

          <div class="mt-6 rounded-2xl border border-white/8 bg-slate-950/50 p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-white">Manual connection string</p>
                <p class="mt-1 text-sm text-slate-300">
                  Use this for power-user miners or if you are wiring your own launch scripts.
                </p>
              </div>
              <button
                data-copy-value-target="stratum-url"
                class="rounded-xl border border-white/10 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-sky-300/40 hover:text-white"
              >
                Copy endpoint
              </button>
            </div>
            <div class="mt-4 rounded-2xl border border-sky-400/20 bg-sky-500/10 p-4 font-mono text-sm text-sky-100">
              <span id="stratum-url">stratum+tcp://loading:0</span>
            </div>
          </div>
        </div>

        <div class="rounded-[28px] border border-slate-200/10 bg-[color:var(--bg-elevated)] p-6 shadow-xl shadow-slate-950/10">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">Generated Config</p>
          <h2 class="mt-2 text-2xl font-semibold text-white">Starter files and commands</h2>

          <div class="mt-6 flex flex-wrap gap-3">
            <button
              class="command-tab inline-flex items-center rounded-full border border-white/10 px-4 py-2 text-sm font-medium text-white transition hover:border-sky-300/40"
              data-tab-target="windows"
            >
              Windows
            </button>
            <button
              class="command-tab inline-flex items-center rounded-full border border-white/10 px-4 py-2 text-sm font-medium text-slate-300 transition hover:border-sky-300/40 hover:text-white"
              data-tab-target="macos"
            >
              macOS
            </button>
            <button
              class="command-tab inline-flex items-center rounded-full border border-white/10 px-4 py-2 text-sm font-medium text-slate-300 transition hover:border-sky-300/40 hover:text-white"
              data-tab-target="linux"
            >
              Ubuntu / Linux
            </button>
          </div>

          <div class="mt-5 rounded-2xl border border-white/10 bg-slate-950/70 p-4">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-semibold text-white">Command</p>
              <button
                id="copy-active-command"
                class="rounded-xl border border-white/10 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-sky-300/40 hover:text-white"
              >
                Copy command
              </button>
            </div>
            <pre id="command-output" class="mt-4 overflow-x-auto rounded-2xl bg-black/40 p-4 text-sm text-slate-100">Loading command…</pre>
          </div>

          <div class="mt-5 rounded-2xl border border-white/10 bg-slate-950/70 p-4">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-semibold text-white">Config snippet</p>
              <button
                id="copy-config"
                class="rounded-xl border border-white/10 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-sky-300/40 hover:text-white"
              >
                Copy config
              </button>
            </div>
            <pre id="config-output" class="mt-4 max-h-72 overflow-auto rounded-2xl bg-black/40 p-4 text-sm text-slate-100">Loading config…</pre>
          </div>

          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <button
              id="download-config"
              class="rounded-2xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-left text-sm font-medium text-emerald-100 transition hover:border-emerald-300 hover:bg-emerald-500/20"
            >
              Download config JSON
            </button>
            <button
              id="download-active-launcher"
              class="rounded-2xl border border-orange-300/30 bg-orange-400/10 px-4 py-3 text-left text-sm font-medium text-orange-100 transition hover:border-orange-200 hover:bg-orange-400/20"
            >
              Download launcher for active OS tab
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
      <div class="rounded-[28px] border border-slate-200/10 bg-[color:var(--bg-elevated)] p-6 shadow-xl shadow-slate-950/10">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">Downloads</p>
            <h2 class="mt-2 text-2xl font-semibold text-white">Starter bundles per platform</h2>
            <p class="mt-2 text-sm text-slate-300">
              Each bundle contains a real miner entrypoint, a platform launcher, a config template,
              and a README wired to the detected pool endpoint.
            </p>
          </div>
          <p class="text-sm text-slate-300">
            Checksums below are for generic bundles. Personalized downloads are generated on demand
            after you fill in your payout address.
          </p>
        </div>

        <div class="mt-8 grid gap-5 lg:grid-cols-3">
          {[
            { key: "windows", title: "Windows", launcher: ".bat launcher" },
            { key: "macos", title: "macOS", launcher: ".command launcher" },
            { key: "linux", title: "Ubuntu / Linux", launcher: ".sh launcher" },
          ].map((item) => (
            <article
              class="download-card rounded-[24px] border border-white/10 bg-slate-950/55 p-5"
              data-platform={item.key}
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-lg font-semibold text-white">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-300">{item.launcher}</p>
                </div>
                <span class="rounded-full border border-white/10 px-3 py-1 text-xs font-medium text-slate-200">
                  <span data-download-version>Loading…</span>
                </span>
              </div>

              <dl class="mt-5 space-y-3 text-sm">
                <div class="flex items-center justify-between gap-3">
                  <dt class="text-slate-400">Package</dt>
                  <dd data-download-file class="font-medium text-white">Resolving…</dd>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <dt class="text-slate-400">Launcher</dt>
                  <dd data-download-launcher class="font-medium text-white">Resolving…</dd>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <dt class="text-slate-400">Size</dt>
                  <dd data-download-size class="font-medium text-white">Resolving…</dd>
                </div>
              </dl>

              <div class="mt-5 rounded-2xl border border-white/8 bg-white/5 p-3">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-400">SHA256</p>
                <div class="mt-2 flex items-start justify-between gap-3">
                  <code data-download-sha class="block break-all text-xs text-slate-200">Pending…</code>
                  <button
                    data-copy-download-sha={item.key}
                    class="rounded-lg border border-white/10 px-3 py-1 text-xs font-medium text-slate-200 transition hover:border-sky-300/40 hover:text-white"
                  >
                    Copy
                  </button>
                </div>
              </div>

              <div class="mt-5 space-y-3">
                <a
                  href="#"
                  data-download-link={item.key}
                  class="inline-flex w-full items-center justify-center rounded-2xl border border-sky-400/30 bg-sky-500/10 px-4 py-3 text-sm font-medium text-sky-100 transition hover:border-sky-300 hover:bg-sky-500/20"
                >
                  Download {item.title} bundle
                </a>
                <p data-download-note class="text-sm text-slate-300">Preparing platform metadata…</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
        <div class="rounded-[28px] border border-slate-200/10 bg-[color:var(--bg-elevated)] p-6 shadow-xl shadow-slate-950/10">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">How It Works</p>
          <div class="mt-6 space-y-5">
            <div class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
              <p class="text-sm font-semibold text-white">Step 1. Get an Animica payout address</p>
              <p class="mt-2 text-sm text-slate-300">
                Use a wallet that matches the active network. Testnet and devnet addresses should not
                be reused on mainnet.
              </p>
            </div>
            <div class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
              <p class="text-sm font-semibold text-white">Step 2. Download the miner for your computer</p>
              <p class="mt-2 text-sm text-slate-300">
                The bundle includes the miner, a launcher, and a config template already pointed at the
                detected Animica Stratum host.
              </p>
            </div>
            <div class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
              <p class="text-sm font-semibold text-white">Step 3. Run the included launcher</p>
              <p class="mt-2 text-sm text-slate-300">
                Windows opens Command Prompt, macOS opens Terminal through the
                <code>.command</code> file, and Linux uses the included shell script.
              </p>
            </div>
            <div class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
              <p class="text-sm font-semibold text-white">Step 4. Your miner connects automatically</p>
              <p class="mt-2 text-sm text-slate-300">
                The launcher reads the generated config, prompts if the address is missing, and begins
                streaming jobs from the Animica pool.
              </p>
            </div>
            <div class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
              <p class="text-sm font-semibold text-white">Step 5. Track rewards and status</p>
              <p class="mt-2 text-sm text-slate-300">
                Keep an eye on the live pool status above and your miner terminal output for accepted
                shares, difficulty updates, and blocks.
              </p>
            </div>
          </div>
        </div>

        <div class="space-y-8">
          <div class="rounded-[28px] border border-slate-200/10 bg-[color:var(--bg-elevated)] p-6 shadow-xl shadow-slate-950/10">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">Troubleshooting</p>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
              <div class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
                <p class="text-sm font-semibold text-white">Pool says offline</p>
                <p class="mt-2 text-sm text-slate-300">
                  Confirm the pool service is running and that the mining webpage is reverse-proxying
                  <code>/api/mining/*</code> to the Stratum API.
                </p>
              </div>
              <div class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
                <p class="text-sm font-semibold text-white">Host resolves to localhost</p>
                <p class="mt-2 text-sm text-slate-300">
                  Set <code>ANIMICA_PUBLIC_STRATUM_HOST</code> or
                  <code>ANIMICA_PUBLIC_STRATUM_URL</code> so remote miners get a public endpoint.
                </p>
              </div>
              <div class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
                <p class="text-sm font-semibold text-white">Launcher cannot find Python</p>
                <p class="mt-2 text-sm text-slate-300">
                  Install Python 3.10 or newer, reopen your terminal, and rerun the launcher. The
                  bundle is dependency-free and only needs Python.
                </p>
              </div>
              <div class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
                <p class="text-sm font-semibold text-white">Wrong network or payout address</p>
                <p class="mt-2 text-sm text-slate-300">
                  The portal warns when you are on testnet or devnet. Use an address that belongs to
                  that network to avoid operator-side payout issues.
                </p>
              </div>
            </div>
          </div>

          <div class="rounded-[28px] border border-slate-200/10 bg-[color:var(--bg-elevated)] p-6 shadow-xl shadow-slate-950/10">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">FAQ</p>
            <div class="mt-6 space-y-3">
              <details class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
                <summary class="cursor-pointer text-sm font-semibold text-white">Can the browser launch my terminal directly?</summary>
                <p class="mt-3 text-sm text-slate-300">
                  No. Browsers cannot start arbitrary local terminals. That is why the portal ships
                  platform launchers inside the downloaded bundle instead.
                </p>
              </details>
              <details class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
                <summary class="cursor-pointer text-sm font-semibold text-white">What if I want to use another miner?</summary>
                <p class="mt-3 text-sm text-slate-300">
                  Use the generated <code id="faq-endpoint">stratum+tcp://loading:0</code> endpoint and the
                  manual commands above as your reference for host, port, worker, and payout address.
                </p>
              </details>
              <details class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
                <summary class="cursor-pointer text-sm font-semibold text-white">Does the bundle include checksums?</summary>
                <p class="mt-3 text-sm text-slate-300">
                  The portal shows SHA-256 hashes for the generic bundles. Personalized bundles are
                  generated on demand with your address and worker name filled in.
                </p>
              </details>
              <details class="rounded-2xl border border-white/8 bg-slate-950/50 p-4">
                <summary class="cursor-pointer text-sm font-semibold text-white">What if I deploy behind nginx?</summary>
                <p class="mt-3 text-sm text-slate-300">
                  Keep the website and <code>/api/mining/*</code> on the same public domain when possible.
                  If you split them, set <code>ANIMICA_MINING_API_BASE_URL</code> on the website and
                  <code>ANIMICA_PUBLIC_STRATUM_HOST</code> on the pool service.
                </p>
              </details>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />

  <script is:inline define:vars={{ miningApiBase }}>
    const state = {
      config: null,
      downloads: [],
      generated: null,
      activeTab: 'windows',
    };

    const elements = {
      poolStatus: document.getElementById('pool-status-chip'),
      networkChip: document.getElementById('network-chip'),
      profileChip: document.getElementById('profile-chip'),
      warningPanel: document.getElementById('warning-panel'),
      warningList: document.getElementById('warning-list'),
      stratumHost: document.getElementById('stratum-host'),
      stratumPort: document.getElementById('stratum-port'),
      stratumUrl: document.getElementById('stratum-url'),
      faqEndpoint: document.getElementById('faq-endpoint'),
      algorithmText: document.getElementById('algorithm-text'),
      activeMiners: document.getElementById('active-miners'),
      poolHeight: document.getElementById('pool-height'),
      poolHashrate: document.getElementById('pool-hashrate'),
      payoutAddress: document.getElementById('payout-address'),
      workerName: document.getElementById('worker-name'),
      threadCount: document.getElementById('thread-count'),
      refreshGenerated: document.getElementById('refresh-generated'),
      commandOutput: document.getElementById('command-output'),
      configOutput: document.getElementById('config-output'),
      copyActiveCommand: document.getElementById('copy-active-command'),
      copyConfig: document.getElementById('copy-config'),
      downloadConfig: document.getElementById('download-config'),
      downloadActiveLauncher: document.getElementById('download-active-launcher'),
      tabButtons: [...document.querySelectorAll('.command-tab')],
      downloadCards: [...document.querySelectorAll('.download-card')],
    };

    const formatter = new Intl.NumberFormat('en-US');

    function apiUrl(path) {
      if (miningApiBase) {
        return new URL(path, miningApiBase).toString();
      }
      return path;
    }

    function formatHashrate(value) {
      const numeric = Number(value || 0);
      if (numeric >= 1_000_000) return `${(numeric / 1_000_000).toFixed(2)} MH/s`;
      if (numeric >= 1_000) return `${(numeric / 1_000).toFixed(2)} kH/s`;
      return `${numeric.toFixed(2)} H/s`;
    }

    function formatBytes(value) {
      const numeric = Number(value || 0);
      if (numeric >= 1024 * 1024) return `${(numeric / (1024 * 1024)).toFixed(2)} MB`;
      if (numeric >= 1024) return `${(numeric / 1024).toFixed(2)} KB`;
      return `${numeric} B`;
    }

    async function fetchJson(path, params = null) {
      const url = new URL(apiUrl(path), window.location.origin);
      if (params) {
        Object.entries(params).forEach(([key, value]) => {
          if (value !== undefined && value !== null && value !== '') url.searchParams.set(key, String(value));
        });
      }
      const response = await fetch(url.toString(), { headers: { accept: 'application/json' } });
      if (!response.ok) {
        throw new Error(await response.text() || response.statusText);
      }
      return response.json();
    }

    async function copyText(text) {
      await navigator.clipboard.writeText(text);
    }

    function readValue(id) {
      const element = document.getElementById(id);
      return element ? element.textContent?.trim() || '' : '';
    }

    function triggerDownload(filename, content) {
      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    function currentInput() {
      return {
        address: elements.payoutAddress.value.trim(),
        worker: elements.workerName.value.trim(),
        threads: Number(elements.threadCount.value || 0),
      };
    }

    function setWarnings(warnings) {
      if (!warnings || warnings.length === 0) {
        elements.warningPanel.classList.add('hidden');
        elements.warningList.innerHTML = '';
        return;
      }
      elements.warningPanel.classList.remove('hidden');
      elements.warningList.innerHTML = warnings.map((warning) => `<li>${warning}</li>`).join('');
    }

    function setActiveTab(tab) {
      state.activeTab = tab;
      elements.tabButtons.forEach((button) => {
        const active = button.dataset.tabTarget === tab;
        button.classList.toggle('bg-sky-500/15', active);
        button.classList.toggle('border-sky-300/40', active);
        button.classList.toggle('text-white', active);
        button.classList.toggle('text-slate-300', !active);
      });
      renderGenerated();
    }

    function renderStatus(configPayload) {
      const status = configPayload.status || {};
      elements.poolStatus.textContent = status.online ? 'Pool online' : 'Pool requires attention';
      elements.poolStatus.classList.toggle('bg-emerald-400/10', status.online);
      elements.poolStatus.classList.toggle('border-emerald-400/30', status.online);
      elements.poolStatus.classList.toggle('text-emerald-200', status.online);
      elements.poolStatus.classList.toggle('bg-amber-500/10', !status.online);
      elements.poolStatus.classList.toggle('border-amber-400/30', !status.online);
      elements.poolStatus.classList.toggle('text-amber-100', !status.online);
      elements.networkChip.textContent = configPayload.network || 'Unknown network';
      elements.profileChip.textContent = `${configPayload.profile || 'pool'} · ${configPayload.device_type || 'miner'}`;
      elements.algorithmText.textContent = configPayload.algorithm || 'Unknown';
      elements.stratumHost.textContent = configPayload.stratum_host || 'Unknown';
      elements.stratumPort.textContent = String(configPayload.stratum_port || '0');
      elements.stratumUrl.textContent = configPayload.stratum_url || 'stratum+tcp://unknown:0';
      elements.faqEndpoint.textContent = configPayload.stratum_url || 'stratum+tcp://unknown:0';
      elements.activeMiners.textContent = formatter.format(Number(status.miners || 0));
      elements.poolHeight.textContent = formatter.format(Number(status.height || 0));
      elements.poolHashrate.textContent = formatHashrate(status.pool_hashrate || 0);
      setWarnings(configPayload.warnings || []);
    }

    function renderDownloads() {
      elements.downloadCards.forEach((card) => {
        const platform = card.dataset.platform;
        const item = state.downloads.find((entry) => entry.platform === platform);
        if (!item) return;
        const link = card.querySelector(`[data-download-link="${platform}"]`);
        const personalizedUrl = state.generated?.download_urls?.[platform] || item.url;
        link.href = personalizedUrl;
        link.textContent = `Download ${item.label} bundle`;
        card.querySelector('[data-download-version]').textContent = item.version;
        card.querySelector('[data-download-file]').textContent = item.filename;
        card.querySelector('[data-download-launcher]').textContent = item.launcher;
        card.querySelector('[data-download-size]').textContent = formatBytes(item.size_bytes);
        card.querySelector('[data-download-sha]').textContent = item.sha256;
        card.querySelector('[data-download-note]').textContent = item.notes;
      });
    }

    function renderGenerated() {
      if (!state.generated) return;
      const commands = state.generated.commands || {};
      elements.commandOutput.textContent = commands[state.activeTab] || 'No command generated yet.';
      elements.configOutput.textContent = state.generated.config?.content || '{}';
      renderDownloads();
    }

    async function refreshGenerated() {
      const payload = currentInput();
      state.generated = await fetchJson('/api/mining/generate', payload);
      renderGenerated();
    }

    async function load() {
      try {
        const [configPayload, downloadsPayload] = await Promise.all([
          fetchJson('/api/mining/config'),
          fetchJson('/api/mining/downloads'),
        ]);
        state.config = configPayload;
        state.downloads = downloadsPayload.items || [];
        elements.workerName.value = configPayload.default_worker || '';
        const browserThreads = navigator.hardwareConcurrency ? Math.max(1, navigator.hardwareConcurrency - 1) : 0;
        elements.threadCount.value = String(browserThreads || configPayload.default_threads || 4);
        renderStatus(configPayload);
        await refreshGenerated();
      } catch (error) {
        elements.poolStatus.textContent = 'Mining API unavailable';
        elements.poolStatus.classList.remove('bg-emerald-400/10', 'border-emerald-400/30', 'text-emerald-200');
        elements.poolStatus.classList.add('bg-rose-500/10', 'border-rose-400/30', 'text-rose-100');
        elements.warningPanel.classList.remove('hidden');
        elements.warningList.innerHTML = `<li>${String(error.message || error)}</li>`;
        elements.commandOutput.textContent = 'The mining portal API could not be reached. Start the Stratum API or set ANIMICA_MINING_API_BASE_URL.';
        elements.configOutput.textContent = '{\n  "error": "mining API unavailable"\n}';
      }
    }

    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      if (target.dataset.copyValueTarget) {
        await copyText(readValue(target.dataset.copyValueTarget));
      }

      if (target.id === 'copy-active-command') {
        await copyText(elements.commandOutput.textContent || '');
      }

      if (target.id === 'copy-config') {
        await copyText(elements.configOutput.textContent || '');
      }

      if (target.dataset.copyDownloadSha) {
        const card = target.closest('.download-card');
        const sha = card?.querySelector('[data-download-sha]')?.textContent || '';
        await copyText(sha);
      }

      if (target.id === 'download-config') {
        triggerDownload(state.generated?.config?.filename || 'animica-miner.config.json', state.generated?.config?.content || '{}');
      }

      if (target.id === 'download-active-launcher') {
        const file = (state.generated?.starter_files || []).find((entry) => entry.platform === state.activeTab);
        if (file) triggerDownload(file.filename, file.content);
      }
    });

    elements.tabButtons.forEach((button) => {
      button.addEventListener('click', () => setActiveTab(button.dataset.tabTarget || 'windows'));
    });

    elements.refreshGenerated.addEventListener('click', refreshGenerated);
    elements.payoutAddress.addEventListener('change', refreshGenerated);
    elements.workerName.addEventListener('change', refreshGenerated);
    elements.threadCount.addEventListener('change', refreshGenerated);

    setActiveTab('windows');
    load();
  </script>
</BaseLayout>
