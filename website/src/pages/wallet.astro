---
import BaseLayout from "../layouts/BaseLayout.astro";
import InlineLink from "../components/InlineLink.astro";
import { links } from "../config/links";
import { loadWalletDownloadPageData, loadWalletExtensionDownloadData } from "../features/wallet/downloads";

const pageTitle = "Wallet — secure storage for ANM";
const pageDesc =
  "Download official Animica wallets, verify signatures, and learn about address formats and CLI usage.";
const walletDownloads = loadWalletDownloadPageData();
const walletExtension = loadWalletExtensionDownloadData();
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Wallet</h1>
    <p class="mt-3 opacity-80">
      Official wallets keep keys local and support post-quantum signatures. Verify every download
      and always confirm addresses before sending funds.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)] md:col-span-2">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="text-xl font-semibold">Desktop Wallet</h2>
            <p class="mt-2 text-sm opacity-80">
              This page reads <code>/wallet/manifest.json</code> when release artifacts are published
              into the website. GitHub Releases remain the fallback.
            </p>
          </div>
          {walletDownloads.versionLabel && (
            <div class="rounded-lg border px-3 py-2 text-sm
                        border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
              <div class="font-medium">Build</div>
              <div class="opacity-80">{walletDownloads.versionLabel}</div>
            </div>
          )}
        </div>

        {walletDownloads.platformCards.length > 0 ? (
          <div class="mt-6 grid gap-6 lg:grid-cols-2">
            {walletDownloads.platformCards.map((platform) => (
              <div class="rounded-2xl border p-6
                          border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 class="text-lg font-semibold">{platform.title}</h3>
                    <p class="mt-2 text-sm opacity-80">{platform.description}</p>
                  </div>
                  <div class="text-right text-xs opacity-70">
                    {platform.architecture && <div>Arch: {platform.architecture}</div>}
                    {platform.buildLabel && <div>Build: {platform.buildLabel}</div>}
                  </div>
                </div>

                <div class="mt-4 flex flex-wrap gap-3">
                  {platform.downloads.map((download) => (
                    <a
                      href={download.href}
                      download={download.download}
                      class:list={[
                        "inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium",
                        download.primary
                          ? "bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)] hover:opacity-90"
                          : "border border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)] hover:bg-[color-mix(in_srgb,var(--text-primary)_/_6%,transparent)]",
                      ]}
                    >
                      {download.label}
                    </a>
                  ))}
                </div>

                <ul class="mt-4 space-y-1 text-xs opacity-70">
                  {platform.downloads.map((download) => (
                    <li>
                      {download.label}
                      {download.sizeLabel && <> · {download.sizeLabel}</>}
                      {download.sha256 && <> · SHA-256: <code>{download.sha256}</code></>}
                    </li>
                  ))}
                </ul>

                {platform.checksums.length > 0 && (
                  <p class="mt-4 text-xs opacity-70">
                    {platform.checksums.map((checksum, index) => (
                      <>
                        {index > 0 && " · "}
                        <InlineLink href={checksum.href}>{checksum.label}</InlineLink>
                      </>
                    ))}
                  </p>
                )}

                <div class="mt-4">
                  <h4 class="font-medium">Install</h4>
                  <ul class="mt-2 space-y-2 text-sm opacity-80">
                    {platform.instructions.map((instruction) => (
                      <li>{instruction}</li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="mt-4">
            <a
              href={links.github.releases()}
              class="inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium
                     bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]
                     hover:opacity-90"
              target="_blank" rel="noopener noreferrer"
            >
              Download latest release
            </a>
            <p class="mt-3 text-xs opacity-70">
              Website wallet artifacts have not been published yet. Use{" "}
              <InlineLink href={links.github.releases()}>GitHub Releases</InlineLink>{" "}
              until <code>website/public/wallet/manifest.json</code> is populated.
            </p>
          </div>
        )}
      </div>

      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="text-xl font-semibold">Browser Extension</h2>
            <p class="mt-2 text-sm opacity-80">Lightweight wallet for dApps and contract approvals.</p>
          </div>
          <a
            href={walletExtension.download?.href ?? links.docs.page("WALLET")}
            target="_blank"
            rel="noopener noreferrer"
            class="sm:hidden inline-flex h-9 w-9 items-center justify-center rounded-full border
                   border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]
                   hover:bg-[color-mix(in_srgb,var(--text-primary)_/_8%,transparent)]"
            aria-label="Open extension install link in mobile browser"
            title="Open extension install link in mobile browser"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 3v12" />
              <path d="m7 10 5 5 5-5" />
              <path d="M5 19h14" />
            </svg>
          </a>
        </div>

        {walletExtension.download ? (
          <>
            <div class="mt-4 flex flex-wrap gap-3">
              <a
                href={walletExtension.download.href}
                download={walletExtension.download.download}
                class="inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium
                       bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]
                       hover:opacity-90"
              >
                Download Extension ZIP
              </a>
              <a
                href={links.docs.page("WALLET")}
                class="inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium border
                       border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]
                       hover:bg-[color-mix(in_srgb,var(--text-primary)_/_6%,transparent)]"
              >
                Setup Guide
              </a>
            </div>

            <ul class="mt-4 space-y-1 text-xs opacity-70">
              <li>
                {walletExtension.download.label}
                {walletExtension.download.sizeLabel && <> · {walletExtension.download.sizeLabel}</>}
                {walletExtension.download.sha256 && <> · SHA-256: <code>{walletExtension.download.sha256}</code></>}
              </li>
            </ul>

            {walletExtension.checksumLink && (
              <p class="mt-4 text-xs opacity-70">
                <InlineLink href={walletExtension.checksumLink.href}>
                  {walletExtension.checksumLink.label}
                </InlineLink>
              </p>
            )}

            <div class="mt-4">
              <h4 class="font-medium">Install & Connect</h4>
              <ul class="mt-2 space-y-2 text-sm opacity-80">
                {walletExtension.instructions.map((instruction) => (
                  <li>{instruction}</li>
                ))}
                <li>After install, open your dApp and approve the connection prompt from Animica Wallet.</li>
              </ul>
            </div>

            <p class="mt-3 text-xs opacity-70 sm:hidden">
              Mobile quick action: tap the round icon above to open the extension package in your mobile browser.
            </p>
          </>
        ) : (
          <>
            <p class="mt-4 text-sm">Store release is pending. Use GitHub for progress and local build instructions.</p>
            <a href={links.github.issues()} class="inline-link">Follow extension work →</a>
          </>
        )}
      </div>
    </div>

    <div class="mt-10 rounded-2xl border p-6 bg-[var(--bg-elevated)]
                border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
      <h2 class="text-xl font-semibold">CLI wallet</h2>
      <p class="mt-2 text-sm opacity-80">Use the CLI for automation, cold storage, and batch ops.</p>
      <div class="mt-4 text-sm font-mono rounded-lg p-4 bg-black/40">
        animica wallet create --label mywallet
        <br />
        animica wallet show mywallet
        <br />
        animica wallet export mywallet --out cold.key
      </div>
      <p class="mt-2 text-xs opacity-70">
        Learn more in <InlineLink href={links.docs.page("wallet/overview")}>Wallet docs</InlineLink>.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="font-semibold">Address format</h3>
        <p class="mt-2 text-sm opacity-80">Animica uses bech32m addresses starting with <code>anim1</code>.</p>
        <p class="mt-2 text-sm opacity-80">Always verify the full address and checksum.</p>
      </div>
      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="font-semibold">Verify downloads</h3>
        <p class="mt-2 text-sm opacity-80">Compare SHA-256 hashes and signed manifests before use.</p>
        <p class="mt-2 text-sm opacity-80">Use release signatures from {links.github.root}.</p>
      </div>
    </div>

    {links.faucet.url && (
      <div class="mt-10 rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="font-semibold">Faucet (testnet/devnet)</h3>
        <p class="mt-2 text-sm opacity-80">
          Request test tokens for development and QA environments.
        </p>
        <InlineLink href={links.faucet.url}>Open faucet →</InlineLink>
      </div>
    )}
  </section>
</BaseLayout>
