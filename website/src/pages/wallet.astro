---
import BaseLayout from "../layouts/BaseLayout.astro";
import InlineLink from "../components/InlineLink.astro";
import { links } from "../config/links";
import { existsSync } from "node:fs";

const pageTitle = "Wallet — secure storage for ANM";
const pageDesc =
  "Download official Animica wallets, verify signatures, and learn about address formats and CLI usage.";
const linuxAppImageUrl = "/wallet/animica-wallet-linux.AppImage";
const linuxDebUrl = "/wallet/animica-wallet-linux.deb";
const linuxTarballUrl = "/wallet/animica-wallet-linux.tar.gz";
const linuxPackagesChecksumUrl = "/wallet/animica-wallet-linux.sha256";
const linuxExecutableUrl = "/wallet/animica-wallet";
const linuxRawChecksumUrl = "/wallet/animica-wallet.sha256";

const linuxDownloadButtons = [
  existsSync(new URL("../../public/wallet/animica-wallet-linux.AppImage", import.meta.url))
    ? {
        href: linuxAppImageUrl,
        download: "animica-wallet-linux.AppImage",
        label: "Download AppImage",
        primary: true,
      }
    : undefined,
  existsSync(new URL("../../public/wallet/animica-wallet-linux.deb", import.meta.url))
    ? {
        href: linuxDebUrl,
        download: "animica-wallet-linux.deb",
        label: "Download .deb",
      }
    : undefined,
  existsSync(new URL("../../public/wallet/animica-wallet-linux.tar.gz", import.meta.url))
    ? {
        href: linuxTarballUrl,
        download: "animica-wallet-linux.tar.gz",
        label: "Download tarball",
      }
    : undefined,
  existsSync(new URL("../../public/wallet/animica-wallet", import.meta.url))
    ? {
        href: linuxExecutableUrl,
        download: "animica-wallet",
        label: "Raw executable fallback",
      }
    : undefined,
].filter(Boolean);

const hasLinuxPackageChecksums = existsSync(
  new URL("../../public/wallet/animica-wallet-linux.sha256", import.meta.url)
);
const hasLinuxRawChecksum = existsSync(
  new URL("../../public/wallet/animica-wallet.sha256", import.meta.url)
);
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Wallet</h1>
    <p class="mt-3 opacity-80">
      Official wallets keep keys local and support post-quantum signatures. Verify every download
      and always confirm addresses before sending funds.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h2 class="text-xl font-semibold">Desktop Wallet</h2>
        <p class="mt-2 text-sm opacity-80">
          Published Linux downloads are shown here when available. Signed cross-platform releases
          remain available on GitHub.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          {linuxDownloadButtons.map((button) => (
            <a
              href={button.href}
              download={button.download}
              class:list={[
                "inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium",
                button.primary
                  ? "bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)] hover:opacity-90"
                  : "border border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)] hover:bg-[color-mix(in_srgb,var(--text-primary)_/_6%,transparent)]",
              ]}
            >
              {button.label}
            </a>
          ))}
          {linuxDownloadButtons.length === 0 && (
            <a
              href={links.github.releases()}
              class="inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium
                     bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]
                     hover:opacity-90"
              target="_blank" rel="noopener noreferrer"
            >
              Download latest release
            </a>
          )}
        </div>
        <p class="mt-3 text-xs opacity-70">
          Choose the package that fits your setup. AppImage is best for portable desktop use,
          <code>.deb</code> for apt-style installs, and the tarball for a bundled runtime without
          installation.
          {hasLinuxPackageChecksums && (
            <>
              {" "}Verify packaged downloads with the{" "}
              <InlineLink href={linuxPackagesChecksumUrl}>Linux package checksums</InlineLink>.
            </>
          )}
          {hasLinuxRawChecksum && (
            <>
              {" "}If you use the raw binary, verify the matching{" "}
              <InlineLink href={linuxRawChecksumUrl}>raw executable checksum</InlineLink>{" "}
              and run <code>chmod +x ./animica-wallet</code> before launching if your browser strips the
              executable bit.
            </>
          )}
          {" "}For signed macOS and Windows releases, see{" "}
          <InlineLink href={links.github.releases()}>GitHub Releases</InlineLink>.
        </p>
      </div>

      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h2 class="text-xl font-semibold">Browser Extension</h2>
        <p class="mt-2 text-sm opacity-80">Lightweight wallet for dApps and contract approvals.</p>
        <p class="mt-4 text-sm">Coming from the official store. Track progress on GitHub.</p>
        <a href={links.github.issues()} class="inline-link">Follow extension work →</a>
      </div>
    </div>

    <div class="mt-10 rounded-2xl border p-6 bg-[var(--bg-elevated)]
                border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
      <h2 class="text-xl font-semibold">CLI wallet</h2>
      <p class="mt-2 text-sm opacity-80">Use the CLI for automation, cold storage, and batch ops.</p>
      <div class="mt-4 text-sm font-mono rounded-lg p-4 bg-black/40">
        animica wallet create --label mywallet
        <br />
        animica wallet show mywallet
        <br />
        animica wallet export mywallet --out cold.key
      </div>
      <p class="mt-2 text-xs opacity-70">
        Learn more in <InlineLink href={links.docs.page("wallet/overview")}>Wallet docs</InlineLink>.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="font-semibold">Address format</h3>
        <p class="mt-2 text-sm opacity-80">Animica uses bech32m addresses starting with <code>anim1</code>.</p>
        <p class="mt-2 text-sm opacity-80">Always verify the full address and checksum.</p>
      </div>
      <div class="rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="font-semibold">Verify downloads</h3>
        <p class="mt-2 text-sm opacity-80">Compare SHA-256 hashes and signed manifests before use.</p>
        <p class="mt-2 text-sm opacity-80">Use release signatures from {links.github.root}.</p>
      </div>
    </div>

    {links.faucet.url && (
      <div class="mt-10 rounded-2xl border p-6 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="font-semibold">Faucet (testnet/devnet)</h3>
        <p class="mt-2 text-sm opacity-80">
          Request test tokens for development and QA environments.
        </p>
        <InlineLink href={links.faucet.url}>Open faucet →</InlineLink>
      </div>
    )}
  </section>
</BaseLayout>
