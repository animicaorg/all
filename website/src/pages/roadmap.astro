---
/**
 * Roadmap Page
 * 
 * Development milestones organized by phase with clear status indicators.
 * Data-driven from src/data/roadmap.ts for easy updates.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Badge from "../components/Badge.astro";
import Card from "../components/Card.astro";
import roadmapData from "../data/roadmap";

const pageTitle = "Roadmap";
const pageDesc = "Track Animica's development progress across infrastructure, consensus, execution, tooling, and ecosystem.";

// Map status to badge variant
const statusToBadge = {
  'done': 'success' as const,
  'in-progress': 'warning' as const,
  'planned': 'planned' as const,
};

const categoryIcons = {
  'infrastructure': '🏗️',
  'consensus': '⚙️',
  'execution': '🐍',
  'tooling': '🛠️',
  'ecosystem': '🌐',
};
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <Header slot="header" />
  
  <main class="min-h-screen bg-white dark:bg-dark-50">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-brand-50 to-white dark:from-dark-100 dark:to-dark-50 py-20 md:py-32">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6">
            Roadmap
          </h1>
          <p class="text-xl sm:text-2xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
            {pageDesc}
          </p>
        </div>

        <!-- Legend -->
        <div class="flex flex-wrap gap-4 justify-center mt-8">
          <div class="flex items-center gap-2">
            <Badge variant="success">Done</Badge>
            <span class="text-sm text-gray-600 dark:text-gray-400">Completed</span>
          </div>
          <div class="flex items-center gap-2">
            <Badge variant="warning" dot>In Progress</Badge>
            <span class="text-sm text-gray-600 dark:text-gray-400">Active Development</span>
          </div>
          <div class="flex items-center gap-2">
            <Badge variant="planned">Planned</Badge>
            <span class="text-sm text-gray-600 dark:text-gray-400">Future Work</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Roadmap Phases -->
    <section class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-16">
          {roadmapData.map((phase, index) => (
            <div class="relative">
              <!-- Phase Header -->
              <div class="mb-8">
                <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-3">
                  {phase.phase}
                </h2>
                <p class="text-lg text-gray-600 dark:text-gray-300">
                  {phase.description}
                </p>
              </div>

              <!-- Items Grid -->
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {phase.items.map((item) => (
                  <Card variant="bordered" padding="md" hoverable>
                    <div class="flex items-start justify-between mb-3">
                      <div class="text-2xl" aria-hidden="true">
                        {categoryIcons[item.category]}
                      </div>
                      <Badge 
                        variant={statusToBadge[item.status]}
                        dot={item.status === 'in-progress'}
                      >
                        {item.status === 'done' ? 'Done' : item.status === 'in-progress' ? 'In Progress' : 'Planned'}
                      </Badge>
                    </div>

                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                      {item.title}
                    </h3>

                    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-3">
                      {item.description}
                    </p>

                    {item.date && (
                      <div class="text-xs text-brand-600 dark:text-brand-400 font-medium">
                        Target: {item.date}
                      </div>
                    )}
                  </Card>
                ))}
              </div>

              <!-- Phase Connector (not for last phase) -->
              {index < roadmapData.length - 1 && (
                <div class="mt-12 mb-4 flex justify-center">
                  <div class="flex items-center gap-2 text-gray-400 dark:text-gray-600">
                    <div class="w-3 h-3 rounded-full bg-gray-300 dark:bg-gray-700"></div>
                    <div class="w-3 h-3 rounded-full bg-gray-300 dark:bg-gray-700"></div>
                    <div class="w-3 h-3 rounded-full bg-gray-300 dark:bg-gray-700"></div>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Category Legend -->
    <section class="py-16 bg-gray-50 dark:bg-dark-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">
          Categories
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          {Object.entries(categoryIcons).map(([category, icon]) => (
            <div class="flex flex-col items-center gap-2 p-4 bg-white dark:bg-dark-50 rounded-lg border border-gray-200 dark:border-dark-300">
              <div class="text-3xl">{icon}</div>
              <div class="text-sm font-medium text-gray-900 dark:text-white capitalize">
                {category}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contributing Section -->
    <section class="py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">
          Want to contribute?
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
          Animica is open source and welcomes contributions from the community. Help us build the future of blockchain.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="https://github.com/animicaorg/all" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3 bg-brand-500 text-white font-medium rounded-lg hover:bg-brand-600 transition-colors duration-150"
          >
            View on GitHub
          </a>
          <a 
            href="/community" 
            class="inline-flex items-center justify-center px-6 py-3 bg-gray-200 dark:bg-dark-200 text-gray-900 dark:text-white font-medium rounded-lg hover:bg-gray-300 dark:hover:bg-dark-300 transition-colors duration-150"
          >
            Join Community
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
