---
/**
 * Roadmap Page
 *
 * Development milestones organized by phase with clear status indicators.
 * Data-driven from src/data/roadmap.ts for easy updates.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import roadmapData from "../data/roadmap";

const pageTitle = "Roadmap";
const pageDesc =
  "Animica mainnet is live. Track what has shipped — and what is in progress — across infrastructure, consensus, execution, tooling, and ecosystem.";

const statusLabel = {
  'done': 'Shipped',
  'in-progress': 'In Progress',
  'planned': 'Planned',
} as const;

const statusStyle = {
  'done': 'background:rgba(22,217,195,0.12); color:var(--brand-500, #16d9c3); border:1px solid rgba(22,217,195,0.35);',
  'in-progress': 'background:rgba(245,184,73,0.12); color:#f5b849; border:1px solid rgba(245,184,73,0.35);',
  'planned': 'background:rgba(255,255,255,0.06); color:var(--text-secondary, #bacce4); border:1px solid rgba(255,255,255,0.14);',
} as const;

const badgeBase =
  'display:inline-block; padding:0.2rem 0.6rem; border-radius:999px; font-size:0.72rem; font-weight:600; letter-spacing:0.04em; text-transform:uppercase; white-space:nowrap;';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Roadmap</span>
      <h1 class="aicf-heading">Mainnet Is Live</h1>
      <p class="aicf-subheading">
        The foundation phases are shipped: the chain, post-quantum signatures, the Python VM, the pool,
        and the public infrastructure are running in production. This page tracks what shipped and what
        we are actively working on — no promises we can't keep.
      </p>
      <div class="aicf-btn-row">
        <span style={`${badgeBase} ${statusStyle['done']}`}>Shipped</span>
        <span style={`${badgeBase} ${statusStyle['in-progress']}`}>In Progress</span>
        <span style={`${badgeBase} ${statusStyle['planned']}`}>Planned</span>
      </div>
    </div>
  </section>

  {roadmapData.map((phase) => (
    <section class="aicf-section">
      <div class="aicf-container">
        <h2 style="font-size:1.45rem;">{phase.phase}</h2>
        <p class="aicf-muted" style="margin-top:0.4rem;">{phase.description}</p>
        <div class="aicf-grid-3" style="margin-top:1.1rem;">
          {phase.items.map((item) => (
            <article class="aicf-card">
              <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:0.6rem;">
                <h3 style="font-size:1.05rem;">{item.title}</h3>
                <span style={`${badgeBase} ${statusStyle[item.status]}`}>{statusLabel[item.status]}</span>
              </div>
              <p class="aicf-muted" style="margin-top:0.55rem; font-size:0.92rem;">{item.description}</p>
              {item.date && (
                <p style="margin-top:0.55rem; font-size:0.78rem; color:var(--brand-500, #16d9c3); font-weight:600;">
                  {item.status === 'done' ? `Shipped ${item.date}` : `Target ${item.date}`}
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="aicf-section">
    <div class="aicf-container">
      <article class="aicf-card" style="text-align:center;">
        <h2 style="font-size:1.3rem;">Want to contribute?</h2>
        <p class="aicf-muted" style="margin-top:0.6rem; max-width:46rem; margin-left:auto; margin-right:auto;">
          Animica is open source. The node, wallets, SDKs, and pool all live in one public monorepo —
          issues and pull requests are welcome.
        </p>
        <div class="aicf-btn-row" style="margin-top:1rem; justify-content:center;">
          <a class="aicf-btn" href="https://github.com/animicaorg/all" target="_blank" rel="noopener noreferrer">View on GitHub</a>
          <a class="aicf-ghost-btn" href="/community">Join the Community</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
