---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "About";
const description =
  "AICF vision: useful decentralized AI compute on Animica with ANM-native economics for developers and providers.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">About AICF</span>
      <h1 class="aicf-heading">Useful AI Compute, Not Hype</h1>
      <p class="aicf-subheading">
        AICF exists to turn decentralized infrastructure into productive AI compute.
        Developers should be able to buy inference and training with ANM. Providers should be able to monetize real hardware with clear economics and accountable quality.
      </p>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-3">
      <article class="aicf-card">
        <h2 style="font-size:1.2rem;">Mission</h2>
        <p class="aicf-muted" style="margin-top:0.6rem;">
          Build a decentralized compute cloud on Animica where model workloads settle natively in ANM and quality is enforced through measurable performance.
        </p>
      </article>
      <article class="aicf-card">
        <h2 style="font-size:1.2rem;">Developer Promise</h2>
        <p class="aicf-muted" style="margin-top:0.6rem;">
          Fast APIs, clear pricing, deterministic budget controls, and a path from quick inference to contract-funded orchestration.
        </p>
      </article>
      <article class="aicf-card">
        <h2 style="font-size:1.2rem;">Provider Promise</h2>
        <p class="aicf-muted" style="margin-top:0.6rem;">
          Simple onboarding, benchmark-driven routing, transparent rewards, and a fair reputation/staking framework.
        </p>
      </article>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <h2 style="font-size:1.35rem;">Why Decentralized AI Compute Matters</h2>
        <ul style="margin-top:0.75rem; padding-left:1rem; display:grid; gap:0.45rem;">
          <li>Distributes supply across many providers instead of a single centralized point.</li>
          <li>Creates open market pressure for better pricing and performance.</li>
          <li>Aligns incentives between useful workload demand and infrastructure supply.</li>
          <li>Anchors payment and settlement in a native chain economy (ANM).</li>
        </ul>
      </article>
      <article class="aicf-card">
        <h2 style="font-size:1.35rem;">Operating Principles</h2>
        <ul style="margin-top:0.75rem; padding-left:1rem; display:grid; gap:0.45rem;">
          <li>Practical API usability over marketing abstractions.</li>
          <li>Transparent job economics and provider reward math.</li>
          <li>Security and dispute controls for critical workloads.</li>
          <li>Continuous provider tooling improvements and release discipline.</li>
        </ul>
      </article>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
