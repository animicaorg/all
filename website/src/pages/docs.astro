---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { links } from "../config/links";

const title = "Docs";
const description =
  "AICF documentation hub for developers, providers, contract jobs, API usage, and local environment setup.";

const repo = links.github.root;

const sections = [
  {
    title: 'Developer Docs',
    guides: [
      { label: 'API Quickstart', href: `${repo}/blob/main/docs/aicf-cloud/quickstart.md` },
      { label: 'API Keys and Auth', href: `${repo}/blob/main/docs/aicf-cloud/api-keys.md` },
      { label: 'Chat Completions', href: `${repo}/blob/main/docs/aicf-cloud/chat-completions.md` },
      { label: 'Embeddings', href: `${repo}/blob/main/docs/aicf-cloud/embeddings.md` },
      { label: 'Jobs and Async Workloads', href: `${repo}/blob/main/docs/aicf-cloud/jobs.md` },
    ],
  },
  {
    title: 'Provider Docs',
    guides: [
      { label: 'Provider Onboarding', href: `${repo}/blob/main/docs/aicf-cloud/provider-onboarding.md` },
      { label: 'Provider Daemon Install', href: `${repo}/blob/main/docs/aicf-cloud/provider-daemon-install.md` },
      { label: 'Provider Fulfillment Flow', href: `${repo}/blob/main/docs/aicf-cloud/provider-fulfillment-flow.md` },
      { label: 'Staking and Slashing', href: `${repo}/blob/main/docs/aicf-cloud/staking-slashing.md` },
      { label: 'Troubleshooting', href: `${repo}/blob/main/docs/aicf-cloud/troubleshooting.md` },
    ],
  },
  {
    title: 'Contract Docs',
    guides: [
      { label: 'Contract + LLM Patterns', href: `${repo}/blob/main/docs/aicf-cloud/contracts-calling-llms-agents.md` },
      { label: 'Contract Escrow Settlement', href: `${repo}/blob/main/docs/aicf-cloud/contract-escrow-settlement.md` },
      { label: 'Dispute Resolution', href: `${repo}/blob/main/docs/aicf-cloud/contract-dispute-resolution.md` },
      { label: 'Deterministic Offchain Model', href: `${repo}/blob/main/docs/aicf-cloud/deterministic-offchain-model.md` },
      { label: 'Contract Security Model', href: `${repo}/blob/main/docs/aicf-cloud/contract-security-model.md` },
    ],
  },
  {
    title: 'Local and Ops Setup',
    guides: [
      { label: 'Local Development', href: `${repo}/blob/main/docs/aicf-cloud/local-dev.md` },
      { label: 'Deployment', href: `${repo}/blob/main/docs/aicf-cloud/deployment.md` },
      { label: 'Contract Jobs Local Dev', href: `${repo}/blob/main/docs/aicf-cloud/contract-jobs-local-dev.md` },
      { label: 'ANM Funding Flow', href: `${repo}/blob/main/docs/aicf-cloud/anm-funding-flow.md` },
      { label: 'ANM Billing Model', href: `${repo}/blob/main/docs/aicf-cloud/anm-billing-model.md` },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Documentation Hub</span>
      <h1 class="aicf-heading">Developer, Provider, Contract, and Ops Docs</h1>
      <p class="aicf-subheading">
        AICF docs are organized by real workflows: build APIs, fund workloads with ANM, operate provider workers, and ship contract-driven AI jobs.
      </p>
      <div class="aicf-btn-row">
        <a class="aicf-btn" href="/developers">Developer Start</a>
        <a class="aicf-ghost-btn" href="/providers">Provider Start</a>
        <a class="aicf-ghost-btn" href={repo} target="_blank" rel="noopener noreferrer">Open Full Repo Docs</a>
      </div>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      {sections.map((section) => (
        <article class="aicf-card">
          <h2 style="font-size:1.3rem;">{section.title}</h2>
          <ul style="margin-top:0.7rem; list-style:none; padding:0; display:grid; gap:0.45rem;">
            {section.guides.map((guide) => (
              <li>
                <a href={guide.href} target="_blank" rel="noopener noreferrer" class="aicf-ghost-btn" style="width:100%; justify-content:space-between;">
                  <span>{guide.label}</span>
                  <span style="font-family:var(--font-mono); font-size:0.75rem;">open</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
