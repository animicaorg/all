---
/**
 * Homepage - Animica L1 Blockchain
 * 
 * Professional landing page showcasing Animica's key features,
 * value propositions, and clear CTAs for different user types.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Badge from "../components/Badge.astro";
import { links } from "../config/links";

const heroTitle = "Animica";
const heroSubtitle = "Post-quantum blockchain for real-world compute";
const heroDesc = "A production-ready L1 with quantum-resistant security, Python smart contracts, and useful-work consensus. Built for builders, miners, and node operators who value transparency and practical infrastructure.";

// Key features/proof points
const proofPoints = [
  {
    icon: "🔐",
    title: "Post-Quantum Security",
    description: "Built-in Dilithium3 and SPHINCS+ signatures protect against future quantum threats"
  },
  {
    icon: "🐍",
    title: "Python Smart Contracts",
    description: "Write and deploy deterministic contracts in Python with our Python-VM execution layer"
  },
  {
    icon: "⚡",
    title: "Useful Work Consensus",
    description: "PoIES rewards meaningful computation alongside traditional mining"
  },
  {
    icon: "🛠️",
    title: "Production Tooling",
    description: "Complete ecosystem with wallets, explorer, SDKs, and monitoring"
  }
];

// Get started cards
const getStartedCards = [
  {
    title: "Run a Node",
    description: "Join the network and help secure the chain with a single command",
    href: "/node",
    icon: "🖥️",
    cta: "Setup Guide"
  },
  {
    title: "Build Contracts",
    description: "Deploy Python smart contracts using our SDKs and development tools",
    href: "/developers",
    icon: "👨‍💻",
    cta: "Start Building"
  },
  {
    title: "Mine Blocks",
    description: "Contribute hash power and earn rewards through CPU or GPU mining",
    href: "/mine",
    icon: "⛏️",
    cta: "Mining Guide"
  },
  {
    title: "Explore Chain",
    description: "Browse blocks, transactions, and addresses on the live explorer",
    href: links.explorer.home(),
    icon: "🔍",
    cta: "Open Explorer"
  }
];

// Stats/metrics (can be updated with real data later)
const stats = [
  { label: "Post-Quantum", value: "Secure" },
  { label: "Python VM", value: "Deterministic" },
  { label: "Multi-Language", value: "3 SDKs" },
  { label: "Network", value: "P2P First" }
];
---

<BaseLayout title={heroTitle} description={heroDesc}>
  <Header slot="header" />
  
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-white via-brand-50/30 to-white dark:from-dark-50 dark:via-dark-100 dark:to-dark-50">
      <!-- Background decoration -->
      <div class="absolute inset-0 bg-grid-gray-900/[0.02] dark:bg-grid-white/[0.02]" aria-hidden="true"></div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32">
        <div class="text-center">
          <!-- Badge -->
          <div class="mb-6 animate-fade-in-up">
            <Badge variant="info" class="text-sm">
              Post-quantum · Useful work · Python VM
            </Badge>
          </div>

          <!-- Title -->
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight animate-fade-in-up">
            {heroTitle}
          </h1>
          
          <!-- Subtitle -->
          <p class="text-2xl sm:text-3xl text-gray-700 dark:text-gray-200 mb-4 font-medium animate-fade-in-up">
            {heroSubtitle}
          </p>

          <!-- Description -->
          <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-10 leading-relaxed animate-fade-in-up">
            {heroDesc}
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8 animate-fade-in-up">
            <Button href="/node" variant="primary" size="lg">
              Run a Node
            </Button>
            <Button href="/developers" variant="outline" size="lg">
              Build a Contract
            </Button>
            <Button href={links.explorer.home()} variant="ghost" size="lg">
              Open Explorer →
            </Button>
          </div>

          <!-- Secondary links -->
          <div class="flex flex-wrap gap-6 justify-center text-sm animate-fade-in-up">
            <a href="/docs" class="text-brand-600 dark:text-brand-400 hover:underline">
              Read Docs
            </a>
            <a href={links.github.root} class="text-brand-600 dark:text-brand-400 hover:underline" target="_blank" rel="noopener">
              View on GitHub
            </a>
            <a href="/wallet" class="text-brand-600 dark:text-brand-400 hover:underline">
              Get Wallet
            </a>
          </div>
        </div>

        <!-- Stats bar -->
        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
          {stats.map((stat) => (
            <div class="text-center p-4">
              <div class="text-2xl font-bold text-gray-900 dark:text-white mb-1">
                {stat.value}
              </div>
              <div class="text-sm text-gray-600 dark:text-gray-400">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Proof Points Section -->
    <section class="py-20 md:py-32 bg-white dark:bg-dark-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4">
            Why Animica?
          </h2>
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
            Built from the ground up with security, transparency, and practical infrastructure in mind
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {proofPoints.map((point) => (
            <Card variant="bordered" padding="lg" hoverable>
              <div class="text-4xl mb-4">{point.icon}</div>
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
                {point.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                {point.description}
              </p>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- Get Started Section -->
    <section class="py-20 md:py-32 bg-gray-50 dark:bg-dark-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4">
            Get Started
          </h2>
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
            Choose your path and start building on Animica today
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {getStartedCards.map((card) => (
            <Card variant="elevated" padding="lg" hoverable href={card.href}>
              <div class="text-4xl mb-4">{card.icon}</div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                {card.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4 text-sm leading-relaxed">
                {card.description}
              </p>
              <div class="text-brand-600 dark:text-brand-400 font-medium text-sm">
                {card.cta} →
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="py-20 md:py-32 bg-white dark:bg-dark-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4">
            How It Works
          </h2>
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
            Simple, transparent, and secure from the ground up
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-12">
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-100 dark:bg-brand-900/30 text-brand-600 dark:text-brand-400 font-bold text-2xl mb-6">
              1
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Run a Node
            </h3>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
              Start a mainnet node in minutes with Docker or native installs. Connect to peers and sync the chain.
            </p>
          </div>

          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-100 dark:bg-brand-900/30 text-brand-600 dark:text-brand-400 font-bold text-2xl mb-6">
              2
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Secure & Verify
            </h3>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
              Validate headers with post-quantum signatures. Lock down RPC endpoints and enable monitoring.
            </p>
          </div>

          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-100 dark:bg-brand-900/30 text-brand-600 dark:text-brand-400 font-bold text-2xl mb-6">
              3
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Build or Mine
            </h3>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
              Deploy contracts, mine blocks, or integrate with your stack using our SDKs and tooling.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-20 md:py-32 bg-brand-500 dark:bg-brand-600 overflow-hidden">
      <div class="absolute inset-0 bg-grid-white/[0.05]" aria-hidden="true"></div>
      
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
          Ready to get started?
        </h2>
        <p class="text-xl text-brand-50 mb-10 max-w-2xl mx-auto">
          Join the community of builders, miners, and node operators making Animica a reality
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button 
            href="/node" 
            variant="secondary"
            size="lg"
            class="bg-white text-brand-600 hover:bg-gray-100"
          >
            Run a Node
          </Button>
          <Button 
            href="/community" 
            variant="outline"
            size="lg"
            class="border-white text-white hover:bg-white hover:text-brand-600"
          >
            Join Community
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Grid pattern for background */
  .bg-grid-gray-900\/\[0\.02\],
  .bg-grid-white\/\[0\.02\],
  .bg-grid-white\/\[0\.05\] {
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, currentColor 1px, transparent 1px),
      linear-gradient(to bottom, currentColor 1px, transparent 1px);
    opacity: 0.5;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out;
  }

  .animate-fade-in-up:nth-child(2) {
    animation-delay: 0.1s;
  }

  .animate-fade-in-up:nth-child(3) {
    animation-delay: 0.2s;
  }

  .animate-fade-in-up:nth-child(4) {
    animation-delay: 0.3s;
  }

  .animate-fade-in-up:nth-child(5) {
    animation-delay: 0.4s;
  }
</style>
