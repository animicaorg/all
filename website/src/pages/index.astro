---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  howItWorks,
  useCases,
  modelCatalog,
  providerSteps,
} from "../data/aicf";

const title = "Decentralized AI Compute on Animica";
const description =
  "Spend ANM. Run models. Contribute GPU. AICF is Animica's decentralized AI compute cloud for inference, embeddings, training, and agent workloads.";
const aicfApiBaseUrl =
  (import.meta.env.ANIMICA_AICF_API_BASE_URL as string | undefined)?.trim() ||
  (import.meta.env.PUBLIC_ANIMICA_AICF_API_BASE_URL as string | undefined)?.trim() ||
  "/api";

const heroLiveMetrics = [
  { key: "providers", label: "Active Providers" },
  { key: "nodes", label: "Provider Nodes" },
  { key: "queueUnits", label: "Queued Work Units" },
  { key: "settlements", label: "Settlements Recorded" },
];

const liveNetworkPanels = [
  { key: "serviceStatus", label: "Service Status", footnote: "From AICF /status" },
  { key: "paused", label: "Scheduler Paused", footnote: "Governance pause flag" },
  { key: "apiLatencyMs", label: "API Latency", footnote: "Browser-observed fetch RTT" },
  { key: "updatedAt", label: "Last Update", footnote: "UTC timestamp from status payload" },
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">AICF Mainnet · Live Compute Economy</span>
      <h1 class="aicf-heading">The AI Cloud Built on Animica</h1>
      <p class="aicf-subheading">
        AICF is decentralized AI compute where developers spend ANM for model APIs and provider nodes earn ANM by supplying real GPU and CPU capacity.
        Contracts can fund AI jobs with escrow-backed settlement.
      </p>
      <div class="aicf-btn-row">
        <a class="aicf-btn" href="/developers">Start Building</a>
        <a class="aicf-ghost-btn" href="/providers">Contribute GPU</a>
        <a class="aicf-ghost-btn" href="/downloads">Download Worker</a>
      </div>

      <div class="aicf-grid-4" style="margin-top:1.5rem;">
        {heroLiveMetrics.map((stat) => (
          <article class="aicf-card">
            <p class="aicf-muted" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.07em;">{stat.label}</p>
            <p class="aicf-value" data-aicf-metric={stat.key}>--</p>
          </article>
        ))}
      </div>
      <p class="aicf-muted" style="margin-top:0.75rem;" data-aicf-message>Loading live AICF metrics...</p>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <h2 style="font-size:1.5rem;">What AICF Is</h2>
        <p class="aicf-muted" style="margin-top:0.7rem;">
          AICF is the decentralized compute cloud of Animica. It combines API-grade developer ergonomics with on-chain ANM settlement, verifiable provider contribution,
          and programmable contract funding flows.
        </p>
        <ul style="margin-top:0.85rem; padding-left:1rem; display:grid; gap:0.5rem;">
          <li>OpenAI-compatible endpoints for chat and embeddings</li>
          <li>ANM-native balances, escrow, receipts, and payouts</li>
          <li>Provider routing by benchmark score, uptime, and reputation</li>
          <li>Async jobs for inference, training, indexing, and agents</li>
        </ul>
      </article>

      <article class="aicf-card">
        <h2 style="font-size:1.5rem;">Why It Matters</h2>
        <p class="aicf-muted" style="margin-top:0.7rem;">
          Useful decentralized compute only works when incentives are direct and measurable. AICF aligns demand and supply in one ANM-native marketplace:
          developers get elastic compute, providers monetize hardware, treasury can bootstrap strategic workloads.
        </p>
        <div class="aicf-grid-2" style="margin-top:0.9rem;">
          {useCases.slice(0, 4).map((item) => (
            <div class="aicf-card" style="padding:0.75rem; background:rgba(7,15,30,0.62);">
              <h3>{item.title}</h3>
              <p class="aicf-muted" style="font-size:0.9rem;">{item.description}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">How It Works</span>
      <h2 class="aicf-heading" style="font-size:clamp(1.8rem,3vw,2.8rem);">Spend ANM. Route Jobs. Reward Providers.</h2>
      <div class="aicf-grid-4" style="margin-top:1rem;">
        {howItWorks.map((step, idx) => (
          <article class="aicf-card">
            <p style="font-family:var(--font-mono); color:var(--brand-300);">0{idx + 1}</p>
            <h3 style="margin-top:0.3rem;">{step.title}</h3>
            <p class="aicf-muted" style="margin-top:0.45rem;">{step.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <span class="aicf-kicker">Spend ANM for AI</span>
        <h2 style="font-size:1.65rem; margin-top:0.8rem;">Developer Billing You Can Reason About</h2>
        <p class="aicf-muted" style="margin-top:0.7rem;">
          Every project balance is denominated in ANM. Requests reserve ANM budgets before execution. Final receipts settle directly against escrow.
          No hidden fiat conversion, no opaque provider markups.
        </p>
        <div class="aicf-code" style="margin-top:0.9rem;">
<pre style="margin:0;"><code>POST /v1/chat/completions
Authorization: Bearer sk_live_aicf_...

{`{
  "model": "aicf-chat-1",
  "messages": [{ "role": "user", "content": "summarize this contract" }],
  "max_tokens": 512
}`}</code></pre>
        </div>
      </article>

      <article class="aicf-card">
        <span class="aicf-kicker">Contribute GPU and Earn</span>
        <h2 style="font-size:1.65rem; margin-top:0.8rem;">Provider Workflow in Minutes</h2>
        <ol style="margin-top:0.7rem; padding-left:1.1rem; display:grid; gap:0.5rem;">
          {providerSteps.map((step) => (
            <li class="aicf-muted">{step}</li>
          ))}
        </ol>
        <div class="aicf-btn-row" style="margin-top:1rem;">
          <a class="aicf-btn" href="/downloads">Get Worker Bundle</a>
          <a class="aicf-ghost-btn" href="/providers">Provider Guide</a>
        </div>
      </article>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Built-In Models and APIs</span>
      <h2 class="aicf-heading" style="font-size:clamp(1.8rem,3vw,2.8rem);">Default Hosted Models. OpenAI-Compatible Shape.</h2>
      <div class="aicf-card" style="margin-top:1rem; padding:0; overflow:auto;">
        <table class="aicf-table">
          <thead>
            <tr>
              <th>Model</th>
              <th>Type</th>
              <th>Context</th>
              <th>Latency</th>
              <th>Price (ANM)</th>
            </tr>
          </thead>
          <tbody>
            {modelCatalog.map((row) => (
              <tr>
                <td><strong>{row.model}</strong></td>
                <td>{row.type}</td>
                <td>{row.context}</td>
                <td>{row.latency}</td>
                <td>{row.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="aicf-grid-2" style="margin-top:1rem;">
        <div class="aicf-code">
<pre style="margin:0;"><code>POST /v1/embeddings
{`{
  "model": "aicf-embed-1",
  "input": ["decentralized compute", "anm billing"]
}`}</code></pre>
        </div>
        <div class="aicf-code">
<pre style="margin:0;"><code>POST /v1/jobs
{`{
  "class": "fine_tuning_training",
  "maxBudgetAnmNanos": "4500000000",
  "request": {"model": "aicf-train-1", "input": {...}}
}`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <span class="aicf-kicker">Contract-Powered AI Jobs</span>
        <h2 style="font-size:1.6rem; margin-top:0.8rem;">On-Chain Funding. Off-Chain Execution. Verifiable Settlement.</h2>
        <p class="aicf-muted" style="margin-top:0.7rem;">
          Contracts can initiate AI tasks by locking ANM budget in escrow. AICF workers execute, submit receipts, and trigger deterministic settlement callbacks.
          Dispute windows and slashing hooks enforce quality and accountability.
        </p>
        <ul style="margin-top:0.8rem; padding-left:1rem; display:grid; gap:0.5rem;">
          <li>Escrow budget before execution</li>
          <li>Provider attestations and challenge windows</li>
          <li>Treasury subsidy overlays for priority workloads</li>
        </ul>
      </article>
      <article class="aicf-card">
        <span class="aicf-kicker">Live Network Stats</span>
        <div class="aicf-grid-2" style="margin-top:0.85rem;">
          {liveNetworkPanels.map((panel) => (
            <div class="aicf-card" style="padding:0.75rem; background:rgba(7,15,28,0.56);">
              <p class="aicf-muted" style="font-size:0.8rem;">{panel.label}</p>
              <p class="aicf-value" style="font-size:1.45rem;" data-aicf-metric={panel.key}>--</p>
              <p class="aicf-muted" style="font-size:0.82rem;">{panel.footnote}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <span class="aicf-kicker">Ecosystem Roadmap</span>
        <h2 style="font-size:1.55rem; margin-top:0.8rem;">What Ships Next</h2>
        <ul style="margin-top:0.8rem; padding-left:1rem; display:grid; gap:0.5rem;">
          <li>Specialized GPU queues for model families and latency SLAs</li>
          <li>Provider release channels with signed worker bundles</li>
          <li>Contract-native agent orchestration templates</li>
          <li>Fine-grained subsidy controls for ecosystem workloads</li>
          <li>Model marketplace and custom deployment onboarding</li>
        </ul>
      </article>

      <article class="aicf-card" style="display:flex; flex-direction:column; justify-content:space-between;">
        <div>
          <span class="aicf-kicker">Build or Supply</span>
          <h2 style="font-size:1.8rem; margin-top:0.8rem;">Two-Sided AI Compute Economy</h2>
          <p class="aicf-muted" style="margin-top:0.7rem;">
            Developers get immediate API utility. Providers get ANM-denominated revenue for useful compute. AICF aligns both sides in one live network.
          </p>
        </div>
        <div class="aicf-btn-row" style="margin-top:1.1rem;">
          <a class="aicf-btn" href="/developers">Create API Key</a>
          <a class="aicf-ghost-btn" href="/downloads">Download Worker</a>
          <a class="aicf-ghost-btn" href="/docs">Read Docs</a>
        </div>
      </article>
    </div>
  </section>

  <script define:vars={{ aicfApiBaseUrl }}>
    import {
      deriveAicfCounts,
      fetchAicfStatus,
      formatCount,
      formatUtc,
    } from "../features/aicf/liveMetricsClient";

    const messageEl = document.querySelector("[data-aicf-message]");
    const metricEls = Array.from(document.querySelectorAll("[data-aicf-metric]"));

    const setMetric = (key, value) => {
      for (const el of metricEls) {
        if (el.getAttribute("data-aicf-metric") === key) {
          el.textContent = value;
        }
      }
    };

    const setUnavailable = () => {
      for (const el of metricEls) {
        el.textContent = "Unavailable";
      }
      if (messageEl) {
        messageEl.textContent = "Live AICF metrics unavailable.";
      }
    };

    const loadMetrics = async () => {
      try {
        const { payload, latencyMs } = await fetchAicfStatus(aicfApiBaseUrl);
        const counts = deriveAicfCounts(payload);

        setMetric("providers", formatCount(counts.providers));
        setMetric("nodes", formatCount(counts.nodes));
        setMetric("queueUnits", formatCount(counts.queueUnits));
        setMetric("settlements", formatCount(counts.settlements));
        setMetric("serviceStatus", String(payload.status ?? "unknown").toUpperCase());
        setMetric("paused", payload.paused ? "YES" : "NO");
        setMetric("apiLatencyMs", `${latencyMs} ms`);
        setMetric("updatedAt", formatUtc(payload.timestamp));

        if (messageEl) {
          messageEl.textContent = `Live AICF metrics refreshed at ${formatUtc(payload.timestamp)}.`;
        }
      } catch (error) {
        console.error("[aicf-metrics] unable to fetch live status", error);
        setUnavailable();
      }
    };

    loadMetrics().catch(() => setUnavailable());
  </script>

  <Footer slot="footer" />
</BaseLayout>
