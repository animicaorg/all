---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MetricTicker from "../components/MetricTicker.astro";
import StatusBadge from "../components/StatusBadge.astro";
import CTAButtons from "../components/CTAButtons.astro";
import InlineLink from "../components/InlineLink.astro";

import { links } from "../config/links";

const heroTitle = "Animica — post-quantum blockchain";
const heroDesc =
  "A serious, production-ready L1 with useful-work consensus, deterministic execution, and a toolchain built for node operators, explorers, and developers.";

const whyCards = [
  {
    title: "Post-quantum security",
    detail:
      "Dilithium/SPHINCS+ signatures, hash-hardened primitives, and forward-looking crypto safety.",
  },
  {
    title: "Useful work consensus",
    detail:
      "PoIES aligns block production with real compute, not wasted energy.",
  },
  {
    title: "Deterministic Python VM",
    detail:
      "Python-first contracts with reproducible execution and predictable gas.",
  },
  {
    title: "Real infrastructure",
    detail:
      "Explorer, RPC, wallet, node tooling, and monitoring built together.",
  },
  {
    title: "Operational clarity",
    detail:
      "Stable APIs, strong observability, and docs for every operator workflow.",
  },
];

const howSteps = [
  {
    step: "01",
    title: "Run a node",
    text: "Start a mainnet node in minutes with Docker or native installs.",
  },
  {
    step: "02",
    title: "Sync & secure",
    text: "Connect to peers, validate headers, and lock down RPC/metrics.",
  },
  {
    step: "03",
    title: "Build or mine",
    text: "Deploy contracts, mine blocks, or integrate with your stack.",
  },
];

const startCols = [
  {
    title: "Get Wallet",
    text: "Download the desktop wallet, or use CLI for hot/cold storage workflows.",
    href: "/wallet",
  },
  {
    title: "Run a Node",
    text: "Join the network with a single command and ship production configs.",
    href: "/node",
  },
  {
    title: "Mining",
    text: "CPU/GPU mining guides and pool endpoints for steady rewards.",
    href: "/mine",
  },
];
---

<BaseLayout title={heroTitle} description={heroDesc} bodyClass="home">
  <fragment slot="header">
    <Header />
  </fragment>

  <section class="hero">
    <div class="hero__content">
      <p class="eyebrow">Post-quantum · Useful work · Python VM</p>
      <h1>{heroTitle}</h1>
      <p class="lede">{heroDesc}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/wallet">Get Wallet</a>
        <a class="button button--outline" href="/node">Run a Node</a>
        <a class="button button--ghost" href={links.explorer.home()}>Open Explorer</a>
      </div>
      <div class="hero__secondary">
        <InlineLink href="/docs" class="hero__link">Read Docs →</InlineLink>
        <InlineLink href={links.github.root} class="hero__link">View on GitHub →</InlineLink>
      </div>
      <div class="hero__badges">
        <div class="badge">
          <span class="label">Network</span>
          <StatusBadge rpcUrl={links.rpc.url} />
        </div>
        <div class="badge">
          <span class="label">Head height</span>
          <span class="metric"><MetricTicker rpcUrl={links.rpc.url} kind="height" /></span>
        </div>
        <div class="badge">
          <span class="label">TPS</span>
          <span class="metric"><MetricTicker rpcUrl={links.rpc.url} kind="tps" /></span>
        </div>
      </div>
    </div>
    <div class="hero__panel">
      <div class="panel-card">
        <h2>Operate the serious chain</h2>
        <p class="muted">
          Animica ships with production infrastructure: Studio, Explorer, wallets, RPC APIs, and
          a deterministic VM designed for long-term stability.
        </p>
        <CTAButtons align="start" />
      </div>
      <div class="panel-card panel-card--ghost">
        <h3>Network snapshot</h3>
        <MetricTicker rpcUrl={links.rpc.url} compact />
        <p class="muted">Live head, TPS, and block age from your configured RPC.</p>
        <a class="button button--full" href="/status">Open status dashboard</a>
      </div>
    </div>
  </section>

  <section class="section">
    <header class="section__header">
      <p class="eyebrow">Why Animica</p>
      <h2>Infrastructure built for serious operators</h2>
      <p class="muted">Modern primitives, predictable execution, and clean tooling for teams that ship.</p>
    </header>
    <div class="card-grid">
      {whyCards.map((card) => (
        <div class="card">
          <h3>{card.title}</h3>
          <p>{card.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <header class="section__header">
      <p class="eyebrow">How it works</p>
      <h2>From node boot to production apps</h2>
      <p class="muted">Each step is documented, observable, and ready for deployment.</p>
    </header>
    <div class="step-grid">
      {howSteps.map((step) => (
        <div class="step-card">
          <div class="step-number">{step.step}</div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <header class="section__header">
      <p class="eyebrow">Get started</p>
      <h2>Choose your path</h2>
      <p class="muted">Wallets, nodes, and mining — all documented and ready to go.</p>
    </header>
    <div class="start-grid">
      {startCols.map((col) => (
        <a class="start-card" href={col.href}>
          <h3>{col.title}</h3>
          <p>{col.text}</p>
          <span class="inline-link">Go now →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--cta">
    <div class="cta-panel">
      <div>
        <p class="eyebrow">Ready to build</p>
        <h2>Launch a node and ship production-grade apps today</h2>
        <p class="muted">Join the network, instrument your RPC, and build with certainty.</p>
      </div>
      <div class="cta-panel__actions">
        <a class="button button--primary" href="/node">Run a Node</a>
        <a class="button button--outline" href="/wallet">Get Wallet</a>
        <a class="button button--ghost" href={links.docs.home()}>Read Docs</a>
      </div>
    </div>
  </section>

  <fragment slot="footer">
    <Footer />
  </fragment>
</BaseLayout>

<style>
  .hero {
    max-width: 1280px;
    margin: 0 auto;
    padding: 5rem 1rem 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    align-items: center;
  }

  .hero__content h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero__secondary {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .hero__badges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .badge {
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.2);
  }

  .section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1rem;
  }

  .section__header h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .card-grid,
  .step-grid,
  .start-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .card-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .step-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .start-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card,
  .step-card,
  .start-card {
    padding: 1.5rem;
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.15);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .start-card:hover,
  .card:hover,
  .step-card:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 92, 246, 0.5);
  }

  .step-number {
    font-size: 0.9rem;
    opacity: 0.6;
    margin-bottom: 0.5rem;
  }

  .section--cta {
    padding-bottom: 5rem;
  }

  .cta-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 2.5rem;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.9));
    border: 1px solid rgba(148, 163, 184, 0.2);
  }

  .cta-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
