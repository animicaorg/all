---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AdBanner from "../components/AdBanner.astro";
import StudioBanner from "../components/StudioBanner.astro";
import ParticleLogo from "../components/ParticleLogo.astro";

const title = "Animica — Post-Quantum Blockchain for Verifiable Compute";
const description =
  "Animica is a live post-quantum L1: Dilithium3 + SPHINCS+ signatures, deterministic Python smart contracts, and PoIES useful-work consensus — with a working mining pool, explorer, wallet, and public RPC.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Animica",
    url: "https://animica.org",
    logo: "https://animica.org/icons/logo.svg",
    sameAs: ["https://x.com/animicaorg", "https://github.com/animicaorg/all"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Animica",
    url: "https://animica.org",
  },
];

const heroFacts: Array<{ label: string; value: string; href?: string; linkText?: string }> = [
  { label: "Post-quantum", value: "Dilithium3 + SPHINCS+ signatures" },
  { label: "Contracts", value: "Deterministic Python VM" },
  { label: "Consensus", value: "PoIES useful work" },
  {
    label: "Mainnet",
    value: "Live",
    href: "https://explorer.animica.org",
    linkText: "explorer.animica.org",
  },
];

const corePillars = [
  {
    title: "Post-Quantum Security",
    detail:
      "Dilithium3 and SPHINCS+ signatures protect every account and transaction against both classical and future quantum attackers.",
  },
  {
    title: "Useful-Work Consensus",
    detail:
      "PoIES points mining power at useful compute — the pool supports XMR dual-mining and Bittensor GPU workloads on the same rig.",
  },
  {
    title: "Deterministic Python VM",
    detail:
      "Write contracts in Python with deterministic execution and auditable state transitions, then deploy them with the animica CLI.",
  },
  {
    title: "Live Infrastructure",
    detail:
      "Mainnet runs today with a public explorer, web and desktop wallets, JSON-RPC at rpc.animica.org, and a working mining pool.",
  },
];

const startPaths = [
  {
    title: "Mine ANM",
    description:
      "Point a miner at the pool and earn ANM — with optional XMR dual-mining and Bittensor GPU compute on the same hardware.",
    href: "/mine",
  },
  {
    title: "Build on Animica",
    description:
      "Write deterministic Python contracts, deploy with the animica CLI, and read chain state over the public JSON-RPC endpoint.",
    href: "/developers",
  },
  {
    title: "Hold & Use ANM",
    description:
      "Create an anim1… address with the web or desktop wallet, send and receive ANM, and verify everything in the explorer.",
    href: "/wallet",
  },
];

const ecosystemProducts = [
  {
    title: "Mining Pool",
    description:
      "Mine ANM with XMR dual-mining and Bittensor GPU compute, with a public dashboard at pool.animica.org.",
    href: "/mine",
  },
  {
    title: "Wallet",
    description:
      "Web wallet at wallet.animica.org plus desktop releases for key management, transfers, and day-to-day ANM operations.",
    href: "/wallet",
  },
  {
    title: "Explorer",
    description:
      "Track blocks, transactions, addresses, contracts, and chain activity in real time.",
    href: "/explorer",
  },
  {
    title: "Studio",
    description:
      "Serverless compute — write a Python function, decorate it, and run it on the fleet for ANM. Modal-style DX at studio.animica.org.",
    href: "https://studio.animica.org",
  },
  {
    title: "EVM Bridge",
    description:
      "Connect MetaMask to Animica (chain 149) and move ANM between an EVM wallet and native accounts — deposit, send, withdraw at evm.animica.org.",
    href: "https://evm.animica.org",
  },
  {
    title: "Academy",
    description:
      "academy.animica.org — the official learning hub for getting started with Animica, from wallets to contracts.",
    href: "https://academy.animica.org",
  },
  {
    title: "AICF Compute",
    description:
      "Animica's AI-compute lane for decentralized AI workloads and provider markets, with a dashboard at aicf.animica.org.",
    href: "https://aicf.animica.org",
  },
  {
    title: "Open Source",
    description:
      "github.com/animicaorg — the node, wallets, pool, and tooling are public and open to contributions.",
    href: "https://github.com/animicaorg/all",
  },
  {
    title: "AI API · Console",
    description:
      "For businesses & AI agents: an OpenAI-compatible API — point the OpenAI SDK at api.animica.org/v1 and your code just works. Free monthly tokens, real streaming, spend caps, usage analytics, and HMAC webhooks. Sign up at console.animica.org.",
    href: "https://console.animica.org",
  },
  {
    title: "Free AI · animica.dev",
    description:
      "Free, keyless AI for developers and their agents — an OpenAI-compatible /v1 you can call with no signup and no API key, plus a GitHub coding agent that turns a prompt into a pull request. Served on-chain by the miner network at animica.dev.",
    href: "https://animica.dev",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Header slot="header" />

  <ParticleLogo />

  <section class="aicf-section aicf-hero">
    <div class="aicf-container">
      <div class="aicf-hero-beacon anm-reveal" role="status" aria-label="Mainnet status">
        <span class="anm-verify">MAINNET LIVE</span>
        <a class="aicf-beacon-link anm-mono" href="https://explorer.animica.org">explorer.animica.org</a>
      </div>
      <div class="aicf-hero-spine anm-spine">
        <span class="aicf-kicker anm-reveal">Live mainnet · Post-quantum L1 · Native coin ANM</span>
        <h1 class="aicf-heading anm-reveal-2">The post-quantum chain where mining does <span class="anm-grad-text">useful work</span></h1>
        <p class="aicf-subheading anm-reveal-2">
          Animica mainnet is live: Dilithium3 + SPHINCS+ signatures, smart contracts in
          deterministic Python, and PoIES consensus that rewards useful compute — including
          attested, <span class="anm-grad-text">verifiable quantum randomness</span> — instead of
          wasted hashes.
        </p>
      </div>

      <div class="aicf-btn-row anm-reveal-3">
        <a class="aicf-btn" href="/mine">Start Mining</a>
        <a class="aicf-ghost-btn" href="/docs">Read the Docs</a>
        <anm-price-ticker variant="hero" aria-label="Live ANM price — trade on NonKYC"></anm-price-ticker>
      </div>

      <div class="aicf-pip-chip">
        <code data-pip-cmd>pip install animica</code>
        <button
          type="button"
          class="aicf-pip-copy"
          data-copy-pip
          aria-label="Copy command: pip install animica"
        >Copy</button>
      </div>
      <p class="aicf-pip-note">
        The complete client — mine, run a node, use the wallet, deploy Python contracts,
        run <code>animica up</code> (the unified PoW + useful-work + GPU train/serve +
        Studio miner), and use the Studio SDK. The native CPU miner is included by default.
        Want the kitchen sink? <code>pip install "animica[all]"</code> adds every optional
        extra: Qt wallet QR codes, the full distributed Studio client (cloudpickle + omni-sdk
        for on-chain ANM escrow), and all pinned server/operator deps.
      </p>

      <ul class="aicf-fact-strip" aria-label="Chain facts">
        {heroFacts.map((fact) => (
          <li>
            <span class="aicf-fact-label">{fact.label}</span>
            <span class="aicf-fact-value">
              {fact.value}{fact.href && (
                <> — <a href={fact.href}>{fact.linkText}</a></>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

<section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">New · Animica AI · for businesses &amp; AI agents · Live</span>
      <h2 class="aicf-heading aicf-h2">An OpenAI-compatible API for your SaaS &amp; AI agents.</h2>
      <p class="aicf-subheading">
        Businesses and agent builders ship on Animica AI — a drop-in, OpenAI-compatible API.
        Point the official OpenAI SDK at our base URL, swap in an Animica key, and your existing
        chat, streaming, tool-calling, and embeddings code runs unchanged — exactly what autonomous
        agents need. Go to production with per-key spend caps, usage analytics, and signed webhooks.
        Start free with monthly free tokens; pay with card, PayPal, or crypto. Manage it all at
        <a href="https://console.animica.org">console.animica.org</a>.
      </p>

      <div class="aicf-btn-row">
        <a class="aicf-btn" href="https://console.animica.org">Open the console — get an API key</a>
        <a class="aicf-ghost-btn" href="https://console.animica.org/pricing">Pricing</a>
        <a class="aicf-ghost-btn" href="https://api.animica.org/api/docs">API reference</a>
      </div>

      <div class="aicf-pip-chip">
        <code data-api-cmd>base_url="https://api.animica.org/v1"</code>
        <button
          type="button"
          class="aicf-pip-copy"
          data-copy-api
          aria-label="Copy base URL: https://api.animica.org/v1"
        >Copy</button>
      </div>
      <p class="aicf-pip-note">
        Two lines change: <code>base_url</code> → <code>https://api.animica.org/v1</code> and
        <code>api_key</code> → your Animica key — no rewrites. Or use the native SDKs:
        <code>npm i @animica/sdk</code> and <code>pip install animica-ai</code>. Businesses sign up,
        mint keys, and watch usage and billing at <a href="https://console.animica.org">console.animica.org</a>.
      </p>

      <ul class="aicf-ai-models" aria-label="Model lineup">
        <li class="aicf-ai-model"><code>anm-fast-8b</code><span>Low-latency chat</span></li>
        <li class="aicf-ai-model"><code>anm-code-7b</code><span>Code generation</span></li>
        <li class="aicf-ai-model"><code>anm-pro-70b</code><span>Frontier reasoning</span></li>
        <li class="aicf-ai-model"><code>anm-bittensor-router</code><span>Routes to Bittensor subnets</span></li>
        <li class="aicf-ai-model"><code>anm-embed</code><span>Embeddings</span></li>
      </ul>

      <div class="aicf-grid-4" style="margin-top:1.5rem;">
        <article class="aicf-card">
          <h3>Real streaming</h3>
          <p class="aicf-muted" style="margin-top:0.6rem;">
            Token-by-token SSE on <code>/chat/completions</code> with <code>stream=true</code>
            — first tokens in milliseconds, not after the full response lands. Wire it straight
            into your existing chat UI.
          </p>
        </article>
        <article class="aicf-card">
          <h3>Spend controls</h3>
          <p class="aicf-muted" style="margin-top:0.6rem;">
            Per-key rate limits and monthly spend caps, org-level budgets with auto-recharge,
            and idempotency keys so retries never double-bill. Fund it with ANM or crypto
            credits — no surprise overages.
          </p>
        </article>
        <article class="aicf-card">
          <h3>Usage analytics</h3>
          <p class="aicf-muted" style="margin-top:0.6rem;">
            Break usage down per key, per model, and per day in the console, or export the raw
            numbers to CSV for finance and customer billing.
          </p>
        </article>
        <article class="aicf-card">
          <h3>Signed webhooks</h3>
          <p class="aicf-muted" style="margin-top:0.6rem;">
            HMAC-signed webhooks for usage, billing, and budget events — verify the signature
            and react inside your own backend.
          </p>
        </article>
      </div>
    </div>

    <style>
      /* model lineup chips — mono, matches the hero fact-strip / pip-chip look */
      .aicf-ai-models {
        list-style: none;
        margin: 1.4rem 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }

      .aicf-ai-model {
        display: inline-flex;
        flex-direction: column;
        gap: 0.18rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0.7rem;
        background: rgba(255, 255, 255, 0.02);
        padding: 0.55rem 0.85rem;
      }

      .aicf-ai-model code {
        font-family: var(--font-mono);
        font-size: 0.86rem;
        color: var(--brand-200);
        white-space: nowrap;
      }

      .aicf-ai-model span {
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        color: rgba(241, 246, 255, 0.6);
      }
    </style>

    <script>
      // Copy-to-clipboard for the OpenAI drop-in base_url chip. Distinct
      // data-attributes keep it independent of the hero pip-install chip.
      // Without JS the value stays plain, selectable text and the button is inert.
      const apiCopyBtn = document.querySelector<HTMLButtonElement>("[data-copy-api]");
      const apiCmd = document.querySelector<HTMLElement>("[data-api-cmd]");
      if (apiCopyBtn && apiCmd) {
        apiCopyBtn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(apiCmd.textContent?.trim() ?? "");
            apiCopyBtn.textContent = "Copied";
            apiCopyBtn.classList.add("is-copied");
            window.setTimeout(() => {
              apiCopyBtn.textContent = "Copy";
              apiCopyBtn.classList.remove("is-copied");
            }, 1600);
          } catch {
            // Clipboard API unavailable — leave the value selectable by hand.
          }
        });
      }
    </script>
  </section>

  <StudioBanner href="https://studio.animica.org" />

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">New · Desktop app</span>
      <h2 class="aicf-heading aicf-h2">Animica Studio — agentic code studio</h2>
      <p class="aicf-subheading">
        A local AI coding IDE powered by Animica: chat with agents, browse and edit your
        project, generate complete features, and run commands with approval — an agentic
        workflow that builds software with you, all on your machine.
      </p>

      <div class="aicf-btn-row">
        <a class="aicf-btn" href="/studio/animica-studio-qt-linux-amd64.deb" download>Linux (.deb)</a>
        <a class="aicf-btn" href="/studio/animica-studio-qt-windows-x64-setup.exe" download>Windows (.exe)</a>
        <a class="aicf-btn" href="/studio/animica-studio-qt-macos.zip" download>macOS (.zip)</a>
        <a class="aicf-ghost-btn" href="/studio/animica-studio-qt-src.zip" download>Source (pip)</a>
      </div>
      <p class="aicf-subheading" style="margin-top:0.75rem; font-size:0.9rem; opacity:0.75;">
        Self-contained desktop builds that bundle Python + Qt. Windows: run the installer.
        macOS: unzip, then right-click → Open (unsigned). Or run from source:
        <code>pip install -r requirements.txt</code> &amp; <code>python main.py</code>.
      </p>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Why Animica</span>
      <h2 class="aicf-heading aicf-h2">Core Capabilities</h2>
      <div class="aicf-grid-4" style="margin-top:1rem;">
        {corePillars.map((item) => (
          <article class="aicf-card">
            <h3>{item.title}</h3>
            <p class="aicf-muted" style="margin-top:0.6rem;">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Get Started</span>
      <h2 class="aicf-heading aicf-h2">Choose Your Path</h2>
      <div class="aicf-grid-3" style="margin-top:1rem;">
        {startPaths.map((path) => (
          <a class="aicf-card aicf-link-card" href={path.href}>
            <h3>{path.title}</h3>
            <p class="aicf-muted" style="margin-top:0.55rem;">{path.description}</p>
            <span class="aicf-link-card-cta">Go now -></span>
          </a>
        ))}
      </div>
      <aside class="aicf-get-anm">
        <strong>How do I get ANM today?</strong>
        <a href="/mine">Mine it through the pool</a> — that is the only official
        channel today. There is no other sales channel.
      </aside>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Ecosystem</span>
      <h2 class="aicf-heading aicf-h2">Products on Animica</h2>
      <p class="aicf-subheading" style="margin-top:0.7rem;">
        Every product below runs against the live chain — same coin, same anim1… addresses,
        same explorer-verifiable state.
      </p>
      <div class="aicf-grid-4" style="margin-top:1rem;">
        {ecosystemProducts.map((product) => (
          <a class="aicf-card aicf-link-card" href={product.href}>
            <h3>{product.title}</h3>
            <p class="aicf-muted" style="margin-top:0.55rem;">{product.description}</p>
            <span class="aicf-link-card-cta">Open -></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container">
      <article class="aicf-card aicf-final-cta">
        <div>
          <span class="aicf-kicker">Build and Operate</span>
          <h2 class="aicf-final-cta-title">Everything here is live and open source</h2>
          <p class="aicf-muted" style="margin-top:0.7rem; max-width:62ch;">
            Run a node, deploy a Python contract, or point a miner at the pool — the chain,
            the tools, and the source are public today.
          </p>
        </div>
        <div class="aicf-btn-row" style="margin-top:1.1rem;">
          <a class="aicf-btn" href="/node">Run a Node</a>
          <a class="aicf-ghost-btn" href="/developers">Developers</a>
          <a class="aicf-ghost-btn" href="/downloads">Downloads</a>
        </div>
      </article>
    </div>
  </section>

  <AdBanner />

  <style>
    /* ── shared heading scale ───────────────────────────────────── */
    .aicf-h2 {
      font-size: clamp(1.8rem, 3vw, 2.8rem);
    }

    /* ── hero ───────────────────────────────────────────────────── */
    .aicf-hero-beacon {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      margin-bottom: 1.1rem;
    }

    .aicf-beacon-link {
      font-size: 0.8rem;
      color: var(--anm-ink-2, #aeb7ce);
      text-decoration: none;
      border-bottom: 1px solid color-mix(in oklab, var(--brand-400), transparent 60%);
    }

    .aicf-beacon-link:hover {
      color: #fff;
      border-bottom-color: var(--brand-400);
    }

    /* hash-chain spine threading the hero's core message */
    .aicf-hero-spine {
      margin-block: 0.25rem 0.5rem;
    }

    .aicf-hero-spine > * + * {
      margin-top: 1rem;
    }

    .aicf-pip-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      margin-top: 1.1rem;
      padding: 0.55rem 0.6rem 0.55rem 1rem;
      border-radius: 0.78rem;
      border: 1px solid color-mix(in oklab, var(--brand-400), transparent 55%);
      background: rgba(7, 11, 22, 0.72);
    }

    .aicf-pip-chip code {
      font-family: var(--font-mono);
      font-size: 0.92rem;
      color: var(--brand-200);
      white-space: nowrap;
    }

    .aicf-pip-copy {
      border: 1px solid color-mix(in oklab, var(--brand-400), transparent 45%);
      border-radius: 0.55rem;
      background: transparent;
      color: var(--brand-300);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.35rem 0.62rem;
      cursor: pointer;
      transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
    }

    .aicf-pip-copy:hover,
    .aicf-pip-copy:focus-visible {
      color: #07120f;
      background: var(--brand-300);
      border-color: var(--brand-300);
      outline: none;
    }

    .aicf-pip-copy.is-copied {
      color: #07120f;
      background: var(--brand-300);
      border-color: var(--brand-300);
    }

    .aicf-pip-note {
      margin: 0.7rem 0 0;
      max-width: 64ch;
      font-size: 0.86rem;
      line-height: 1.5;
      color: rgba(241, 246, 255, 0.72);
    }

    .aicf-pip-note code {
      font-family: var(--font-mono);
      font-size: 0.82em;
      color: var(--brand-200);
    }

    .aicf-fact-strip {
      list-style: none;
      margin: 1.4rem 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .aicf-fact-strip li {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 0.85rem;
      background: rgba(255, 255, 255, 0.02);
      padding: 0.75rem 0.95rem;
    }

    .aicf-fact-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--brand-300), transparent 25%);
    }

    .aicf-fact-value {
      font-size: 0.92rem;
      color: rgba(241, 246, 255, 0.88);
    }

    .aicf-fact-value a {
      color: var(--brand-200);
      text-decoration: none;
      border-bottom: 1px solid color-mix(in oklab, var(--brand-300), transparent 55%);
    }

    .aicf-fact-value a:hover {
      border-bottom-color: var(--brand-200);
    }

    @media (max-width: 900px) {
      .aicf-fact-strip {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 480px) {
      .aicf-fact-strip {
        grid-template-columns: 1fr;
      }
    }

    /* ── path & ecosystem cards ─────────────────────────────────── */
    .aicf-link-card {
      display: block;
      transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    }

    .aicf-link-card:hover {
      transform: translateY(-2px);
      border-color: color-mix(in oklab, var(--brand-400), #ffffff 22%);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
    }

    .aicf-link-card-cta {
      display: inline-flex;
      margin-top: 0.85rem;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--brand-300);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .aicf-get-anm {
      margin-top: 1.1rem;
      border: 1px solid color-mix(in oklab, var(--brand-400), transparent 60%);
      border-left: 3px solid var(--brand-400);
      border-radius: 0.85rem;
      background: rgba(110, 168, 254, 0.06);
      padding: 0.85rem 1.1rem;
      font-size: 0.95rem;
      color: rgba(241, 246, 255, 0.85);
    }

    .aicf-get-anm strong {
      color: #ffffff;
    }

    .aicf-get-anm a {
      color: var(--brand-200);
    }

    /* ── final CTA ──────────────────────────────────────────────── */
    .aicf-final-cta {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .aicf-final-cta-title {
      font-size: clamp(1.6rem, 2.8vw, 2.3rem);
      margin-top: 0.85rem;
    }
  </style>

  <script>
    // Copy-to-clipboard for the pip install chip. Without JS the command
    // is still plain selectable text; the button is simply inert.
    const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-pip]");
    const pipCmd = document.querySelector<HTMLElement>("[data-pip-cmd]");
    if (copyBtn && pipCmd) {
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pipCmd.textContent?.trim() ?? "");
          copyBtn.textContent = "Copied";
          copyBtn.classList.add("is-copied");
          window.setTimeout(() => {
            copyBtn.textContent = "Copy";
            copyBtn.classList.remove("is-copied");
          }, 1600);
        } catch {
          // Clipboard API unavailable — leave the command selectable by hand.
        }
      });
    }
  </script>

  <Footer slot="footer" />
</BaseLayout>
