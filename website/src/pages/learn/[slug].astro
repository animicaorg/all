---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const all = (await getCollection("learn", ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
  );
  return all.map((entry) => {
    const series = all.filter((e) => e.data.category === entry.data.category);
    const idx = series.findIndex((e) => e.slug === entry.slug);
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        series: series.map((e) => ({ slug: e.slug, title: e.data.title })),
        prev: idx > 0 ? { slug: series[idx - 1].slug, title: series[idx - 1].data.title } : null,
        next: idx < series.length - 1 ? { slug: series[idx + 1].slug, title: series[idx + 1].data.title } : null,
      },
    };
  });
}

type Link = { slug: string; title: string };
const { entry, series, prev, next } = Astro.props as {
  entry: CollectionEntry<"learn">;
  series: Link[];
  prev: Link | null;
  next: Link | null;
};
const { Content, headings } = await entry.render();
const fm = entry.data;

const CATEGORY_TITLE: Record<string, string> = {
  protocol: "Protocol",
  operate: "Operate",
  build: "Build",
  economy: "Economy",
  reference: "Reference",
};

const words = entry.body ? entry.body.split(/\s+/).length : 0;
const minutes = Math.max(1, Math.round(words / 200));
const published = fm.date.toISOString();
const modified = (fm.updated ?? fm.date).toISOString();
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonical = `https://animica.org/learn/${entry.slug}`;
const toc = headings.filter((h) => h.depth === 2);
const repoBase = "https://github.com/animicaorg/all/blob/main/";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: fm.title,
    description: fm.description,
    datePublished: published,
    dateModified: modified,
    author: { "@type": "Organization", name: "Animica", url: "https://animica.org" },
    publisher: { "@type": "Organization", name: "Animica", url: "https://animica.org" },
    mainEntityOfPage: canonical,
    keywords: fm.tags.join(", ") || undefined,
    wordCount: words,
    proficiencyLevel: fm.readingLevel,
    isPartOf: { "@type": "CollectionPage", name: "Learn Animica", url: "https://animica.org/learn" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Learn", item: "https://animica.org/learn" },
      { "@type": "ListItem", position: 2, name: CATEGORY_TITLE[fm.category], item: `https://animica.org/learn#${fm.category}` },
      { "@type": "ListItem", position: 3, name: fm.title, item: canonical },
    ],
  },
];
---

<BaseLayout title={fm.title} description={fm.description} jsonLd={jsonLd} canonical={canonical}>
  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/learn">Learn</a>
      <span aria-hidden="true">/</span>
      <a href={`/learn#${fm.category}`}>{CATEGORY_TITLE[fm.category]}</a>
    </nav>

    <div class="grid">
      <article class="article" itemscope itemtype="https://schema.org/TechArticle">
        <header class="head">
          <h1 itemprop="headline">{fm.title}</h1>
          <p class="desc" itemprop="description">{fm.description}</p>
          <p class="meta">
            <span class="level">{fm.readingLevel}</span>
            <span class="sep">·</span>
            <span>{minutes} min read</span>
            <span class="sep">·</span>
            <span>Published <time datetime={published} itemprop="datePublished">{fmt(fm.date)}</time></span>
            {fm.updated && (
              <>
                <span class="sep">·</span>
                <span>Updated <time datetime={modified} itemprop="dateModified">{fmt(fm.updated)}</time></span>
              </>
            )}
          </p>
          {fm.tags.length > 0 && (
            <ul class="tags" role="list">
              {fm.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
          )}
        </header>

        {toc.length > 2 && (
          <nav class="toc" aria-label="On this page">
            <p class="tocTitle">On this page</p>
            <ol>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}

        <div class="prose" itemprop="articleBody">
          <Content />
        </div>

        {fm.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-h">
            <h2 id="sources-h">Written from</h2>
            <p>
              This article was written from the following files in the
              <a href="https://github.com/animicaorg/all">animicaorg/all</a> repository. If the repository and this
              page ever disagree, the repository is authoritative.
            </p>
            <ul>
              {fm.sources.map((s) => (
                <li><a href={repoBase + s} rel="noopener"><code>{s}</code></a></li>
              ))}
            </ul>
          </section>
        )}

        <nav class="pager" aria-label="Series navigation">
          {prev ? <a class="pagerLink" href={`/learn/${prev.slug}`}><span>← Previous</span><strong>{prev.title}</strong></a> : <span />}
          {next ? <a class="pagerLink next" href={`/learn/${next.slug}`}><span>Next →</span><strong>{next.title}</strong></a> : <span />}
        </nav>
      </article>

      <aside class="side" aria-label="In this track">
        <p class="sideTitle">{CATEGORY_TITLE[fm.category]} track</p>
        <ol class="sideList">
          {series.map((s, i) => (
            <li class:list={["sideItem", { current: s.slug === entry.slug }]}>
              <a href={`/learn/${s.slug}`} aria-current={s.slug === entry.slug ? "page" : undefined}>
                <span class="n">{i + 1}</span> {s.title}
              </a>
            </li>
          ))}
        </ol>
        <div class="sideBox">
          <p><strong>Get ANM</strong></p>
          <p>Mine at <a href="https://pool.animica.org">pool.animica.org</a> or trade ANM/USDT on <a href="https://nonkyc.io/market/ANM_USDT" rel="noopener">NonKYC</a>.</p>
        </div>
      </aside>
    </div>
  </main>

  <style>
    .wrap { max-width: 80rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
    .crumbs { display: flex; gap: 0.5rem; font-size: 0.9rem; color: var(--text-muted, #aab4c3); margin-bottom: 1rem; }
    .crumbs a { color: inherit; }
    .grid { display: grid; grid-template-columns: minmax(0, 1fr) 18rem; gap: 3rem; align-items: start; }
    .article { min-width: 0; }
    .head h1 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 0.6rem; }
    .desc { font-size: 1.1rem; line-height: 1.6; color: var(--text-muted, #aab4c3); margin: 0 0 0.6rem; }
    .meta { display: flex; flex-wrap: wrap; gap: 0.45rem; font-size: 0.85rem; color: var(--text-muted, #aab4c3); margin: 0 0 0.5rem; }
    .level { text-transform: capitalize; }
    .sep { opacity: 0.5; }
    .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0; margin: 0 0 1.25rem; list-style: none; }
    .tag { font-size: 0.72rem; padding: 0.12rem 0.55rem; border-radius: 999px; border: 1px solid color-mix(in oklch, canvastext, transparent 80%); }
    .toc { border: 1px solid color-mix(in oklch, canvastext, transparent 88%); border-radius: 0.9rem; padding: 0.9rem 1.1rem; margin: 0 0 1.5rem; }
    .tocTitle { margin: 0 0 0.4rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #aab4c3); }
    .toc ol { margin: 0; padding-left: 1.2rem; line-height: 1.7; columns: 2; column-gap: 2rem; }
    .toc a { color: inherit; text-decoration: none; }
    .toc a:hover { text-decoration: underline; }
    .prose { font-size: 1.02rem; }
    .prose :global(p) { margin: 0.85rem 0; line-height: 1.75; }
    .prose :global(h2) { margin: 2.2rem 0 0.6rem; font-size: 1.55rem; letter-spacing: -0.01em; scroll-margin-top: 5rem; }
    .prose :global(h3) { margin: 1.5rem 0 0.4rem; font-size: 1.2rem; scroll-margin-top: 5rem; }
    .prose :global(ul), .prose :global(ol) { margin: 0.75rem 0; padding-left: 1.5rem; line-height: 1.75; }
    .prose :global(li) { margin: 0.2rem 0; }
    .prose :global(code) { background: color-mix(in oklch, canvas, canvastext 6%); padding: 0.12rem 0.35rem; border-radius: 0.35rem; font-size: 0.92em; }
    .prose :global(pre) { padding: 1rem; border-radius: 0.75rem; border: 1px solid color-mix(in oklch, canvastext, transparent 88%); overflow-x: auto; line-height: 1.55; font-size: 0.9rem; }
    .prose :global(pre code) { background: none; padding: 0; }
    .prose :global(a) { color: var(--anm-blue-fill, #2e63ff); }
    .prose :global(table) { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 0.93rem; display: block; overflow-x: auto; }
    .prose :global(th), .prose :global(td) { border: 1px solid color-mix(in oklch, canvastext, transparent 85%); padding: 0.45rem 0.6rem; text-align: left; vertical-align: top; }
    .prose :global(th) { background: color-mix(in oklch, canvas, canvastext 5%); }
    .prose :global(blockquote) { margin: 1rem 0; padding: 0.5rem 1rem; border-left: 3px solid var(--anm-phthalo, #14c79b); color: var(--text-muted, #aab4c3); }
    .prose :global(hr) { border: 0; border-top: 1px solid color-mix(in oklch, canvastext, transparent 85%); margin: 2rem 0; }
    .sources { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid color-mix(in oklch, canvastext, transparent 85%); }
    .sources h2 { font-size: 1.1rem; margin: 0 0 0.4rem; }
    .sources p { color: var(--text-muted, #aab4c3); line-height: 1.6; margin: 0 0 0.5rem; }
    .sources ul { margin: 0; padding-left: 1.2rem; line-height: 1.8; }
    .sources a { color: inherit; }
    .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem; }
    .pagerLink { display: grid; gap: 0.15rem; padding: 0.9rem 1rem; border: 1px solid color-mix(in oklch, canvastext, transparent 85%); border-radius: 0.9rem; text-decoration: none; color: inherit; }
    .pagerLink span { font-size: 0.8rem; color: var(--text-muted, #aab4c3); }
    .pagerLink.next { text-align: right; }
    .pagerLink:hover { border-color: var(--anm-blue-fill, #2e63ff); }
    .side { position: sticky; top: 5rem; }
    .sideTitle { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #aab4c3); margin: 0 0 0.5rem; }
    .sideList { list-style: none; margin: 0 0 1.25rem; padding: 0; display: grid; gap: 0.15rem; }
    .sideItem a { display: block; padding: 0.4rem 0.6rem; border-radius: 0.5rem; text-decoration: none; color: inherit; font-size: 0.92rem; line-height: 1.4; }
    .sideItem a:hover { background: color-mix(in oklch, canvas, canvastext 6%); }
    .sideItem.current a { background: color-mix(in oklch, canvas, var(--anm-blue-fill, #2e63ff) 14%); font-weight: 600; }
    .n { display: inline-block; width: 1.4rem; color: var(--anm-phthalo, #14c79b); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8rem; }
    .sideBox { border: 1px solid color-mix(in oklch, canvastext, transparent 85%); border-radius: 0.9rem; padding: 0.9rem 1rem; font-size: 0.9rem; line-height: 1.55; }
    .sideBox p { margin: 0 0 0.35rem; }
    .sideBox a { color: var(--anm-blue-fill, #2e63ff); }
    @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .side { position: static; order: 2; } .toc ol { columns: 1; } .pager { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
