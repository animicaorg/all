---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Token — Animica";
const pageDesc =
  "Token details on Animica: metadata, supply, creator, deploy transaction, and on-chain links.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <a href="/tokens" class="text-sm opacity-70 underline">← All tokens</a>

    <div id="token-loading" class="mt-6 opacity-70">Loading token…</div>
    <div id="token-error" class="mt-6 text-sm" style="display:none"></div>

    <article id="token-detail" class="mt-6" style="display:none">
      <div class="flex items-start gap-4 flex-wrap">
        <div id="token-image-slot"></div>
        <div class="min-w-0 flex-1">
          <h1 id="token-name" class="text-3xl sm:text-4xl font-semibold tracking-tight"></h1>
          <div class="mt-2 flex items-center gap-3 flex-wrap text-sm opacity-80">
            <span id="token-symbol" class="rounded-full border px-2 py-0.5
                  border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]
                  uppercase tracking-wide"></span>
            <span id="token-created"></span>
            <span>·</span>
            <span>by <code id="token-creator"></code></span>
          </div>
        </div>
        <div class="flex gap-2 flex-wrap">
          <a id="token-swap" href="#" style="display:none"
             class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium
                    bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]">
            Swap
          </a>
          <button id="token-copy" type="button"
             class="inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-sm
                    border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]">
            Copy address
          </button>
        </div>
      </div>

      <p id="token-description" class="mt-6 opacity-90 leading-relaxed"></p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60">Contract address</dt>
          <dd class="mt-1 break-all font-mono text-sm"><code id="token-address"></code></dd>
        </div>
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60">Deploy tx</dt>
          <dd class="mt-1 break-all font-mono text-sm"><code id="token-tx"></code></dd>
        </div>
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60">Initial supply</dt>
          <dd class="mt-1 text-lg font-semibold"><span id="token-supply"></span> <span id="token-supply-symbol" class="text-sm opacity-70 uppercase"></span></dd>
        </div>
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60">Decimals</dt>
          <dd class="mt-1 text-lg font-semibold"><span id="token-decimals"></span></dd>
        </div>
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60">Chain</dt>
          <dd class="mt-1"><code id="token-chain"></code></dd>
        </div>
        <div class="rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <dt class="text-xs uppercase tracking-wide opacity-60">Block</dt>
          <dd class="mt-1"><span id="token-block">—</span></dd>
        </div>
      </dl>

      <div id="token-socials" class="mt-8 flex gap-3 flex-wrap"></div>

      <section class="mt-12">
        <h2 class="text-xl font-semibold">Comments</h2>
        <div id="comments-list" class="mt-4 grid gap-3"></div>
        <form id="comment-form" class="mt-6 grid gap-3 rounded-2xl border p-4
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <div id="comment-banner" class="text-xs opacity-70">Detecting wallet…</div>
          <textarea name="body" required minlength="1" maxlength="2000" rows="3"
                placeholder="Share your thoughts about this token"
                class="rounded-lg border px-3 py-2 bg-transparent text-sm
                       border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]"></textarea>
          <div class="flex items-center justify-end">
            <button id="comment-submit" type="submit" disabled
                class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium
                       bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]
                       disabled:opacity-50 disabled:cursor-not-allowed">
              Post comment
            </button>
          </div>
          <div id="comment-status" class="text-xs"></div>
        </form>
      </section>
    </article>
  </section>

  <script>
    // @ts-nocheck
    const LAUNCHER_API = (window.LAUNCHER_API_BASE || '/launcher-api') + '/api';

    const loadingEl = document.getElementById('token-loading');
    const errEl = document.getElementById('token-error');
    const article = document.getElementById('token-detail');

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function formatSupply(raw, decimals) {
      try {
        const d = Math.max(0, Math.min(36, Number(decimals ?? 0)));
        const big = BigInt(String(raw));
        if (d === 0) return big.toLocaleString('en-US');
        const base = 10n ** BigInt(d);
        const whole = big / base;
        return whole.toLocaleString('en-US');
      } catch { return String(raw ?? '0'); }
    }

    function getAddressFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const fromQs = params.get('address');
      if (fromQs) return fromQs;
      // Allow /tokens/<addr> style links by reading the last path segment.
      const path = window.location.pathname;
      const m = path.match(/\/tokens?\/([^/?#]+)$/);
      return m ? decodeURIComponent(m[1]) : '';
    }

    function showError(msg) {
      loadingEl.style.display = 'none';
      errEl.style.display = '';
      errEl.textContent = msg;
      errEl.style.color = '#dc2626';
    }

    function renderImage(t) {
      const slot = document.getElementById('token-image-slot');
      const url = t.imageUrl;
      const initial = (t.symbol || '?').slice(0, 2).toUpperCase();
      if (url) {
        slot.innerHTML = `<img src="${escapeHtml(url)}" alt="" loading="lazy"
              class="h-20 w-20 rounded-full object-cover
                     bg-[color-mix(in_srgb,var(--text-primary)_/_8%,transparent)]" />`;
      } else {
        slot.innerHTML = `<div class="flex h-20 w-20 items-center justify-center rounded-full
                bg-[color-mix(in_srgb,var(--text-primary)_/_8%,transparent)] text-lg font-semibold">${escapeHtml(initial)}</div>`;
      }
    }

    function renderSocials(t) {
      const slots = [
        ['Website', t.websiteUrl],
        ['Twitter', t.twitterUrl],
        ['Telegram', t.telegramUrl],
        ['Discord', t.discordUrl],
      ];
      const out = slots
        .filter(([, url]) => !!url)
        .map(([label, url]) => `
          <a href="${escapeHtml(url)}" target="_blank" rel="noopener nofollow"
             class="inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-sm
                    border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]">
            ${escapeHtml(label)} ↗
          </a>`)
        .join('');
      document.getElementById('token-socials').innerHTML = out;
    }

    function formatRelTime(secs) {
      const now = Math.floor(Date.now() / 1000);
      const delta = Math.max(0, now - Number(secs || 0));
      if (delta < 60) return `${delta}s ago`;
      if (delta < 3600) return `${Math.floor(delta / 60)}m ago`;
      if (delta < 86400) return `${Math.floor(delta / 3600)}h ago`;
      return `${Math.floor(delta / 86400)}d ago`;
    }

    async function loadComments(addr) {
      const r = await fetch(`${LAUNCHER_API}/tokens/${encodeURIComponent(addr)}/comments?limit=100`);
      if (!r.ok) return;
      const data = await r.json();
      const list = Array.isArray(data.comments) ? data.comments : [];
      const target = document.getElementById('comments-list');
      if (list.length === 0) {
        target.innerHTML = `<div class="text-sm opacity-60">No comments yet — be the first.</div>`;
        return;
      }
      target.innerHTML = list.map((c) => `
        <div class="rounded-xl border p-3
              border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
              bg-[var(--bg-elevated)]">
          <div class="text-xs opacity-60 flex items-center gap-2">
            <code>${escapeHtml(String(c.author_address).slice(0, 12))}…${escapeHtml(String(c.author_address).slice(-6))}</code>
            <span>·</span>
            <span>${escapeHtml(formatRelTime(c.created_at))}</span>
          </div>
          <div class="mt-1 text-sm whitespace-pre-wrap">${escapeHtml(c.body)}</div>
        </div>`).join('');
    }

    async function waitForProvider(timeoutMs = 3000) {
      if (window.animica) return window.animica;
      return new Promise((resolve) => {
        const finish = () => {
          clearInterval(poll); clearTimeout(timer);
          window.removeEventListener('animica#initialized', finish);
          resolve(window.animica || null);
        };
        const poll = setInterval(() => { if (window.animica) finish(); }, 150);
        const timer = setTimeout(() => finish(), timeoutMs);
        window.addEventListener('animica#initialized', finish, { once: true });
      });
    }

    let provider = null;
    let connectedAddress = null;

    async function bindCommentForm(addr) {
      const banner = document.getElementById('comment-banner');
      const submit = document.getElementById('comment-submit');
      const statusEl = document.getElementById('comment-status');
      const form = document.getElementById('comment-form');

      provider = await waitForProvider();
      if (!provider) {
        banner.innerHTML = 'Install the <a href="/wallet" class="underline">Animica wallet</a> to comment.';
        return;
      }
      banner.innerHTML = 'Wallet detected. <button id="comment-connect" type="button" class="underline">Connect</button> to comment.';
      document.getElementById('comment-connect').addEventListener('click', async () => {
        try {
          const accs = await provider.request({ method: 'animica_requestAccounts' });
          if (accs && accs[0]) {
            connectedAddress = accs[0];
            banner.innerHTML = `Commenting as <code>${escapeHtml(connectedAddress.slice(0,12))}…${escapeHtml(connectedAddress.slice(-6))}</code>`;
            submit.disabled = false;
          }
        } catch (err) {
          banner.textContent = 'Connect failed: ' + (err?.message || err);
        }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!connectedAddress) return;
        submit.disabled = true;
        statusEl.style.color = 'inherit';
        statusEl.textContent = 'Signing comment…';
        const body = String(new FormData(form).get('body') || '').trim();
        try {
          const attest = `comment|${connectedAddress}|${addr}|${body.slice(0, 256)}`;
          let signature = '0x';
          try {
            signature = await provider.request({
              method: 'animica_signMessage',
              params: [{ message: attest }],
            });
          } catch { /* best effort */ }
          const r = await fetch(`${LAUNCHER_API}/tokens/${encodeURIComponent(addr)}/comments`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ authorAddress: connectedAddress, body, signature }),
          });
          if (!r.ok) {
            const e = await r.json().catch(() => ({}));
            throw new Error(e?.error?.message || `HTTP ${r.status}`);
          }
          form.reset();
          statusEl.style.color = '#059669';
          statusEl.textContent = 'Posted.';
          await loadComments(addr);
        } catch (err) {
          statusEl.style.color = '#dc2626';
          statusEl.textContent = 'Failed: ' + (err?.message || err);
        } finally {
          submit.disabled = !connectedAddress;
        }
      });
    }

    async function loadToken() {
      const addr = getAddressFromUrl();
      if (!addr) return showError('No token address in URL.');
      try {
        const r = await fetch(`${LAUNCHER_API}/tokens/${encodeURIComponent(addr)}`);
        if (r.status === 404) return showError('Token not found.');
        if (!r.ok) return showError(`Failed to load token (HTTP ${r.status}).`);
        const data = await r.json();
        const t = data.token;

        document.title = `${t.name} (${t.symbol}) · Animica`;

        renderImage(t);
        document.getElementById('token-name').textContent = t.name;
        document.getElementById('token-symbol').textContent = t.symbol;
        document.getElementById('token-created').textContent = formatRelTime(t.createdAt);
        document.getElementById('token-creator').textContent =
          t.creatorAddress.length > 16
            ? `${t.creatorAddress.slice(0, 10)}…${t.creatorAddress.slice(-6)}`
            : t.creatorAddress;
        document.getElementById('token-creator').title = t.creatorAddress;
        document.getElementById('token-description').textContent = t.description || '';
        document.getElementById('token-address').textContent = t.contractAddress;
        document.getElementById('token-tx').textContent = t.txHash;
        // Prefer the indexer's observed total_supply over the at-launch value
        // when available — supply changes over time as mint/burn fires.
        const displaySupply = t.observedTotalSupply ?? t.initialSupply;
        document.getElementById('token-supply').textContent = formatSupply(displaySupply, t.decimals);
        document.getElementById('token-supply-symbol').textContent = t.symbol;
        document.getElementById('token-decimals').textContent = String(t.decimals);
        document.getElementById('token-chain').textContent = String(t.chainId);

        const blockEl = document.getElementById('token-block');
        if (t.lastSeenBlock != null) {
          const ts = t.observedAt ? ` · verified ${formatRelTime(t.observedAt)}` : '';
          const statusBadge = t.observedStatus === 'live'
            ? '<span style="color:#059669"> · live</span>'
            : t.observedStatus === 'missing'
            ? '<span style="color:#dc2626"> · missing on chain</span>'
            : t.observedStatus === 'error'
            ? '<span style="color:#d97706"> · indexer error</span>'
            : '';
          blockEl.innerHTML = `#${t.lastSeenBlock}${escapeHtml(ts)}${statusBadge}`;
        } else {
          blockEl.textContent = 'awaiting indexer';
        }

        const swap = document.getElementById('token-swap');
        swap.href = `/swap?token=${encodeURIComponent(t.contractAddress)}`;
        swap.style.display = '';

        document.getElementById('token-copy').addEventListener('click', () => {
          navigator.clipboard?.writeText(t.contractAddress).catch(() => {});
        });

        renderSocials(t);

        loadingEl.style.display = 'none';
        article.style.display = '';

        loadComments(t.contractAddress);
        bindCommentForm(t.contractAddress);
      } catch (err) {
        showError(`Failed to load token: ${err?.message || err}`);
      }
    }

    loadToken();
  </script>
</BaseLayout>
