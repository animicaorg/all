---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import MetricTicker from "../components/MetricTicker.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { links } from "../config/links";

const pageTitle = "Network Status — RPC, P2P, Explorer";
const pageDesc =
  "Live status dashboard for Animica networks: RPC/WS reachability, head height, peers, mempool, and explorer checks.";

const baseRpc = links.rpc.url;
const rpcHttp = baseRpc.endsWith("/rpc") ? baseRpc : `${baseRpc}/rpc`;
const wsUrl = links.rpc.ws();
const explorerUrl = links.explorer.home();
const explorer2Url = links.explorer2 ? links.explorer2.home() : "";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Live Status</h1>
    <p class="mt-3 text-base opacity-80">
      Reaching <code class="font-mono text-[0.95em] break-all">{rpcHttp}</code>.
      WebSocket target: <code class="font-mono text-[0.95em] break-all">{wsUrl}</code>.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border p-5 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-sm font-medium opacity-80">RPC</h3>
          <StatusBadge rpcUrl={baseRpc} />
        </div>
        <p class="mt-4 text-xs opacity-70">HTTP endpoint</p>
        <p class="font-mono text-xs break-all opacity-90">{rpcHttp}</p>
      </div>

      <div class="rounded-xl border p-5 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-medium opacity-80">WebSocket</h3>
          <span id="ws-pill" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs border opacity-80">
            <span id="ws-dot" class="inline-block size-2 rounded-full bg-[color-mix(in_srgb,var(--text-primary)_/_45%,transparent)]"></span>
            <span id="ws-text">checking…</span>
          </span>
        </div>
        <p class="mt-4 text-xs opacity-70">Latency (ms)</p>
        <p id="ws-lat" class="text-lg font-semibold tracking-tight">—</p>
      </div>

      <div class="rounded-xl border p-5 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="text-sm font-medium opacity-80">Head height</h3>
        <p class="mt-3 text-2xl font-semibold tracking-tight">
          <MetricTicker rpcUrl={baseRpc} kind="height" />
        </p>
        <p class="text-xs opacity-70 mt-1">Updates live</p>
      </div>

      <div class="rounded-xl border p-5 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="text-sm font-medium opacity-80">Mempool</h3>
        <p class="mt-3 text-2xl font-semibold tracking-tight">
          <span id="mempool-count">—</span>
          <span class="text-sm font-normal opacity-70 ml-1">txs</span>
        </p>
        <p class="text-xs opacity-70 mt-1">Pending tx count</p>
      </div>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border p-5 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="text-sm font-medium opacity-80">Node Health</h3>
        <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div>
            <dt class="opacity-70">Peers</dt>
            <dd id="peers" class="mt-0.5 font-medium">—</dd>
          </div>
          <div>
            <dt class="opacity-70">RPC latency</dt>
            <dd id="rpc-lat" class="mt-0.5 font-medium">—</dd>
          </div>
          <div>
            <dt class="opacity-70">Inbound</dt>
            <dd id="peers-in" class="mt-0.5 font-medium">—</dd>
          </div>
          <div>
            <dt class="opacity-70">Outbound</dt>
            <dd id="peers-out" class="mt-0.5 font-medium">—</dd>
          </div>
        </dl>
        <p class="mt-3 text-xs opacity-70">Peer metrics use <code>net.peerCount</code> and <code>net.peers</code>.</p>
      </div>

      <div class="rounded-xl border p-5 bg-[var(--bg-elevated)]
                  border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
        <h3 class="text-sm font-medium opacity-80">Explorer Health</h3>
        <dl class="mt-3 text-sm space-y-2">
          <div class="flex items-center justify-between">
            <span>Explorer</span>
            <span id="explorer-health" class="font-medium">—</span>
          </div>
          {explorer2Url && (
            <div class="flex items-center justify-between">
              <span>Explorer 2</span>
              <span id="explorer2-health" class="font-medium">—</span>
            </div>
          )}
          <div>
            <span class="opacity-70 text-xs">Checks fetch /healthz or /</span>
          </div>
        </dl>
      </div>
    </div>

    <div class="mt-8 rounded-2xl border p-6 sm:p-8 bg-[var(--bg-elevated)]
                border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]">
      <h2 class="text-xl font-semibold tracking-tight">Query examples</h2>
      <div class="mt-4 grid gap-6 md:grid-cols-2">
        <CodeBlock lang="bash" title="Get head (cURL)">
{`curl -s ${rpcHttp} \\
  -H 'content-type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"chain.getHead","params":[]}' | jq .`}
        </CodeBlock>
        <CodeBlock lang="bash" title="Peers (cURL)">
{`curl -s ${rpcHttp} \\
  -H 'content-type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"net.peerCount","params":[]}' | jq .`}
        </CodeBlock>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const rpcHttpUrl = "{rpcHttp}";
      const wsUrlClient = "{wsUrl}";
      const explorerUrl = "{explorerUrl}";
      const explorer2Url = "{explorer2Url}";

      const el = (id) => document.getElementById(id);
      const peersEl = el('peers');
      const peersInEl = el('peers-in');
      const peersOutEl = el('peers-out');
      const rpcLatEl = el('rpc-lat');
      const mempoolEl = el('mempool-count');
      const wsText = el('ws-text');
      const wsDot = el('ws-dot');
      const wsLat = el('ws-lat');
      const explorerHealth = el('explorer-health');
      const explorer2Health = el('explorer2-health');

      async function rpc(method, params) {
        const body = { jsonrpc: "2.0", id: Math.floor(Math.random()*1e6), method, params: params ?? [] };
        const t0 = performance.now();
        const res = await fetch(rpcHttpUrl, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
          cache: "no-store",
        });
        const dt = performance.now() - t0;
        const data = await res.json();
        if (data && data.result !== undefined) {
          return { result: data.result, ms: dt };
        }
        throw new Error((data && data.error && data.error.message) || "RPC error");
      }

      async function refreshPeers() {
        try {
          const count = await rpc('net.peerCount');
          if (peersEl) peersEl.textContent = String(count.result ?? '—');
          if (rpcLatEl) rpcLatEl.textContent = `${Math.round(count.ms)} ms`;

          const peers = await rpc('net.peers');
          const list = Array.isArray(peers.result) ? peers.result : [];
          const inbound = list.filter((p) => String(p.direction || p.inbound || '').includes('in')).length;
          const outbound = list.filter((p) => String(p.direction || p.outbound || '').includes('out')).length;
          if (peersInEl) peersInEl.textContent = String(inbound || 0);
          if (peersOutEl) peersOutEl.textContent = String(outbound || 0);
        } catch {
          if (peersEl) peersEl.textContent = '—';
          if (peersInEl) peersInEl.textContent = '—';
          if (peersOutEl) peersOutEl.textContent = '—';
        }
      }

      async function refreshMempool() {
        try {
          const stats = await rpc('mempool.getStats');
          const count = stats.result?.count ?? stats.result?.pending ?? stats.result?.size;
          if (mempoolEl) mempoolEl.textContent = String(count ?? '—');
        } catch {
          if (mempoolEl) mempoolEl.textContent = '—';
        }
      }

      function checkWs() {
        if (!wsUrlClient) return;
        const ws = new WebSocket(wsUrlClient);
        const t0 = performance.now();
        let done = false;
        const mark = (ok) => {
          if (done) return;
          done = true;
          ws.close();
          if (wsText) wsText.textContent = ok ? 'online' : 'offline';
          if (wsDot) wsDot.style.background = ok ? '#22c55e' : '#ef4444';
          if (wsLat) wsLat.textContent = ok ? `${Math.round(performance.now() - t0)} ms` : '—';
        };
        ws.addEventListener('open', () => mark(true));
        ws.addEventListener('error', () => mark(false));
        setTimeout(() => mark(false), 4000);
      }

      async function checkExplorer(url, elRef) {
        if (!url || !elRef) return;
        try {
          const res = await fetch(url + '/healthz', { method: 'GET' });
          elRef.textContent = res.ok ? 'online' : 'degraded';
        } catch {
          try {
            const res = await fetch(url, { method: 'GET' });
            elRef.textContent = res.ok ? 'online' : 'offline';
          } catch {
            elRef.textContent = 'offline';
          }
        }
      }

      refreshPeers();
      refreshMempool();
      checkWs();
      checkExplorer(explorerUrl, explorerHealth);
      if (explorer2Url) checkExplorer(explorer2Url, explorer2Health);

      setInterval(refreshPeers, 15000);
      setInterval(refreshMempool, 15000);
    })();
  </script>
</BaseLayout>
