---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Status";
const description = "AICF service status for API, scheduler, provider routing, settlement, and downloads.";

const services = [
  { name: 'API Gateway', status: 'Operational', uptime: '99.97%', latency: '182 ms p50' },
  { name: 'Job Scheduler', status: 'Operational', uptime: '99.94%', latency: '280 ms assignment' },
  { name: 'Provider Heartbeat', status: 'Operational', uptime: '99.91%', latency: '4.2 s interval' },
  { name: 'ANM Settlement', status: 'Operational', uptime: '99.88%', latency: '1.2 block avg finality' },
  { name: 'Downloads CDN', status: 'Operational', uptime: '99.99%', latency: 'global edge cache' },
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="aicf-section">
    <div class="aicf-container">
      <span class="aicf-kicker">Service Health</span>
      <h1 class="aicf-heading">AICF Platform Status</h1>
      <p class="aicf-subheading">
        Live operational view for AICF API endpoints, scheduler routing, provider infrastructure, and settlement flows.
      </p>
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container" style="display:grid; gap:0.75rem;">
      {services.map((service) => (
        <article class="aicf-card" style="display:flex; align-items:center; justify-content:space-between; gap:1rem;">
          <div>
            <h2 style="font-size:1.1rem;">{service.name}</h2>
            <p class="aicf-muted" style="font-size:0.9rem; margin-top:0.35rem;">{service.uptime} · {service.latency}</p>
          </div>
          <span class="aicf-kicker" style="border-color:rgba(63,223,154,0.45); color:#9af6cc;">{service.status}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="aicf-section">
    <div class="aicf-container aicf-grid-2">
      <article class="aicf-card">
        <h2 style="font-size:1.2rem;">Recent Events</h2>
        <ul style="margin-top:0.65rem; padding-left:1rem; display:grid; gap:0.45rem;">
          <li><strong>2026-04-22 14:35 UTC</strong> · Provider benchmark queue scaling rollout completed.</li>
          <li><strong>2026-04-22 08:05 UTC</strong> · API latency spike mitigated by scheduler cache warmup.</li>
          <li><strong>2026-04-21 17:48 UTC</strong> · Worker bundle release v0.2.0 published.</li>
        </ul>
      </article>
      <article class="aicf-card">
        <h2 style="font-size:1.2rem;">Incident Response</h2>
        <ul style="margin-top:0.65rem; padding-left:1rem; display:grid; gap:0.45rem;">
          <li>Primary channel: status updates and recovery timeline on this page.</li>
          <li>Escalation: aicf@animica.org with project ID and request/job IDs.</li>
          <li>Postmortems: published in release notes after major incidents.</li>
        </ul>
      </article>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
