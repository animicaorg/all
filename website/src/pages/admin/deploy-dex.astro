---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Deploy DEX — Animica";
const pageDesc =
  "One-time admin flow: deploy the Animica DEX factory + router contracts and wire them on mainnet.";
---

<BaseLayout title={pageTitle} description={pageDesc} noIndex={true}>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Deploy DEX</h1>
    <p class="mt-3 opacity-80">
      One-time bring-up of the on-chain DEX. Order:
      <strong>router → factory → init factory → init router → register</strong>.
      Each deploy waits for block confirmation before proceeding to the next.
      The pair contract is a per-pool template — its compiled code is stored
      here as a sidecar reference but no singleton is deployed.
    </p>

    <div id="banner" class="mt-6 rounded-2xl border p-4 text-sm
         border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
         bg-[var(--bg-elevated)]">
      Detecting wallet…
    </div>

    <div id="existing" class="mt-4" style="display:none">
      <div class="rounded-2xl border p-4 text-sm
            border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
            bg-[color-mix(in_srgb,#fde68a_/_25%,var(--bg-elevated))]">
        <div class="font-medium">DEX already deployed on this chain.</div>
        <div class="mt-2 grid gap-1 font-mono text-xs" id="existing-list"></div>
        <div class="mt-3 text-xs opacity-70">
          Re-deploying will overwrite the pinned addresses on the launcher
          backend, but the on-chain contracts at the previous addresses stay
          live and unowned by this UI. Only proceed if you know why.
        </div>
      </div>
    </div>

    <ol id="steps" class="mt-8 grid gap-4">
      <li id="step-router"   data-step="router"   class="step rounded-2xl border p-4
            border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
            bg-[var(--bg-elevated)]">
        <div class="flex items-center justify-between gap-3">
          <div class="font-medium">1. Deploy router</div>
          <span class="state text-xs opacity-70">pending</span>
        </div>
        <div class="hint mt-1 text-xs opacity-70">router has no constructor deps; we deploy it first so we can pass its address to factory.init.</div>
        <div class="result mt-2 grid gap-1 text-xs font-mono opacity-90" style="display:none"></div>
      </li>
      <li id="step-factory"  data-step="factory"  class="step rounded-2xl border p-4
            border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
            bg-[var(--bg-elevated)]">
        <div class="flex items-center justify-between gap-3">
          <div class="font-medium">2. Deploy factory</div>
          <span class="state text-xs opacity-70">pending</span>
        </div>
        <div class="hint mt-1 text-xs opacity-70">factory's deploy bytecode has no constructor; init runs in a follow-up call.</div>
        <div class="result mt-2 grid gap-1 text-xs font-mono opacity-90" style="display:none"></div>
      </li>
      <li id="step-init-factory" data-step="init-factory" class="step rounded-2xl border p-4
            border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
            bg-[var(--bg-elevated)]">
        <div class="flex items-center justify-between gap-3">
          <div class="font-medium">3. Initialize factory</div>
          <span class="state text-xs opacity-70">pending</span>
        </div>
        <div class="hint mt-1 text-xs opacity-70">factory.init(owner=you, router, default_fee_bps=30, launch_fee_anm=0, fee_recipient=you).</div>
        <div class="result mt-2 grid gap-1 text-xs font-mono opacity-90" style="display:none"></div>
      </li>
      <li id="step-init-router" data-step="init-router" class="step rounded-2xl border p-4
            border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
            bg-[var(--bg-elevated)]">
        <div class="flex items-center justify-between gap-3">
          <div class="font-medium">4. Initialize router</div>
          <span class="state text-xs opacity-70">pending</span>
        </div>
        <div class="hint mt-1 text-xs opacity-70">router.init(owner=you, factory).</div>
        <div class="result mt-2 grid gap-1 text-xs font-mono opacity-90" style="display:none"></div>
      </li>
      <li id="step-register" data-step="register" class="step rounded-2xl border p-4
            border-[color-mix(in_srgb,var(--text-primary)_/_12%,transparent)]
            bg-[var(--bg-elevated)]">
        <div class="flex items-center justify-between gap-3">
          <div class="font-medium">5. Pin addresses</div>
          <span class="state text-xs opacity-70">pending</span>
        </div>
        <div class="hint mt-1 text-xs opacity-70">POST /launcher-api/api/dex/addresses — the swap UI reads from here.</div>
        <div class="result mt-2 grid gap-1 text-xs font-mono opacity-90" style="display:none"></div>
      </li>
    </ol>

    <div class="mt-8 flex gap-3 flex-wrap">
      <button id="run" type="button" disabled
              class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 font-medium
                     bg-[var(--btn-primary-bg,#111)] text-[var(--btn-primary-fg,#fff)]
                     disabled:opacity-50 disabled:cursor-not-allowed">
        Connect wallet to continue
      </button>
      <a href="/launcher-api/api/dex/addresses?chainId=1" target="_blank" rel="noopener"
         class="inline-flex items-center justify-center rounded-lg border px-4 py-2 text-sm
                border-[color-mix(in_srgb,var(--text-primary)_/_20%,transparent)]">
        View current addresses
      </a>
    </div>

    <p id="run-status" class="mt-3 text-sm"></p>
  </section>

  <script>
    // @ts-nocheck
    const LAUNCHER_API = (window.LAUNCHER_API_BASE || '/launcher-api') + '/api';
    const DEFAULT_FEE_BPS = 30;
    const LAUNCH_FEE_ANM = 0;

    const banner = document.getElementById('banner');
    const runBtn = document.getElementById('run');
    const runStatus = document.getElementById('run-status');
    const existing = document.getElementById('existing');
    const existingList = document.getElementById('existing-list');

    let provider = null;
    let connectedAddress = null;
    let chainId = 1;
    let templates = null;
    let factoryAddress = null;
    let routerAddress = null;

    function setStepState(stepId, state, color) {
      const el = document.querySelector(`#step-${stepId} .state`);
      if (!el) return;
      el.textContent = state;
      el.style.color = color || '';
    }
    function setStepResult(stepId, lines) {
      const el = document.querySelector(`#step-${stepId} .result`);
      if (!el) return;
      el.style.display = '';
      el.innerHTML = lines.map((s) => `<div>${s}</div>`).join('');
    }

    async function waitForProvider(timeoutMs = 4000) {
      if (window.animica) return window.animica;
      return new Promise((resolve) => {
        const finish = () => {
          clearInterval(poll); clearTimeout(timer);
          window.removeEventListener('animica#initialized', finish);
          resolve(window.animica || null);
        };
        const poll = setInterval(() => { if (window.animica) finish(); }, 150);
        const timer = setTimeout(() => finish(), timeoutMs);
        window.addEventListener('animica#initialized', finish, { once: true });
      });
    }

    async function connect() {
      const accs = await provider.request({ method: 'animica_requestAccounts' });
      if (!accs || !accs[0]) throw new Error('No accounts');
      connectedAddress = accs[0];
      try {
        const cid = await provider.request({ method: 'animica_chainId' });
        chainId = typeof cid === 'number' ? cid : Number(cid) || 1;
      } catch { chainId = 1; }
      banner.innerHTML = `Connected: <code>${connectedAddress}</code> · chain <code>${chainId}</code>`;
      runBtn.disabled = false;
      runBtn.textContent = 'Run deployment';

      await loadExistingAddresses();
    }

    async function loadExistingAddresses() {
      try {
        const r = await fetch(`${LAUNCHER_API}/dex/addresses?chainId=${chainId}`);
        if (!r.ok) return;
        const data = await r.json();
        const addrs = data.addresses || {};
        if (Object.keys(addrs).length === 0) return;
        existing.style.display = '';
        existingList.innerHTML = Object.entries(addrs)
          .map(([role, info]) => `<div>${role}: <code>${info.address}</code> · block <code>${info.blockHeight ?? '—'}</code></div>`)
          .join('');
      } catch { /* ignore */ }
    }

    async function loadTemplates() {
      if (templates) return templates;
      const r = await fetch(`${LAUNCHER_API}/dex/templates`);
      if (!r.ok) throw new Error(`dex/templates HTTP ${r.status}`);
      templates = await r.json();
      return templates;
    }

    async function deployOne(role, tpl) {
      setStepState(role, 'submitting…');
      const res = await provider.request({
        method: 'animica_deployContract',
        params: [{ from: connectedAddress, code: tpl.codeHex, manifest: tpl.manifestHex }],
      });
      if (!res || !res.txid || !res.contractAddress) {
        throw new Error(`${role} deploy returned no contract address`);
      }
      setStepState(role, 'waiting for block…');
      await waitForTxConfirmed(res.txid, 180_000);
      setStepResult(role, [
        `address: ${res.contractAddress}`,
        `tx:      ${res.txid}`,
      ]);
      setStepState(role, 'done ✓', '#059669');
      return { address: res.contractAddress, txHash: res.txid };
    }

    async function callOne(stepId, toAddress, role, method, args, hintLines) {
      setStepState(stepId, 'encoding…');
      const encRes = await fetch(`${LAUNCHER_API}/dex/encode-init`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ role, method, args }),
      });
      if (!encRes.ok) {
        const e = await encRes.json().catch(() => ({}));
        throw new Error(`encode-init failed: ${e?.error?.message || encRes.status}`);
      }
      const { dataHex } = await encRes.json();
      setStepState(stepId, 'submitting…');
      const sendRes = await provider.request({
        method: 'animica_sendTransaction',
        params: [{
          from: connectedAddress,
          to: toAddress,
          data: dataHex,
          kind: 2,
          // Init calls touch a handful of storage slots — generous limit so
          // the wallet doesn't default to 21k (which is for transfers only).
          gas: { limit: 2_000_000 },
        }],
      });
      const txid = typeof sendRes === 'string' ? sendRes : sendRes?.txid;
      if (!txid) throw new Error(`${stepId} returned no tx id`);
      setStepState(stepId, 'waiting for block…');
      await waitForTxConfirmed(txid, 180_000);
      setStepResult(stepId, [...hintLines, `tx:      ${txid}`]);
      setStepState(stepId, 'done ✓', '#059669');
    }

    async function waitForTxConfirmed(txid, deadlineMs) {
      const deadline = Date.now() + deadlineMs;
      let last = '';
      while (Date.now() < deadline) {
        const r = await fetch('https://rpc.animica.org/rpc', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tx.getTransactionStatus', params: [txid] }),
        });
        const body = await r.json().catch(() => null);
        const status = String(body?.result?.status || '').toLowerCase();
        last = status;
        if (status === 'included' || status === 'confirmed' || status === 'finalized') return;
        if (status === 'dropped' || status === 'reorged_out') throw new Error(`tx ${txid.slice(0, 16)}… ${status}`);
        await new Promise((res) => setTimeout(res, 2500));
      }
      throw new Error(`tx ${txid.slice(0, 16)}… not confirmed (last status: ${last || 'unknown'})`);
    }

    async function run() {
      runBtn.disabled = true;
      runBtn.textContent = 'Running…';
      runStatus.style.color = '';
      runStatus.textContent = 'Loading compiled IRs…';
      try {
        const tpls = await loadTemplates();

        runStatus.textContent = 'Step 1 of 5: deploying router…';
        const router = await deployOne('router', tpls.router);
        routerAddress = router.address;

        runStatus.textContent = 'Step 2 of 5: deploying factory…';
        const factory = await deployOne('factory', tpls.factory);
        factoryAddress = factory.address;

        runStatus.textContent = 'Step 3 of 5: initializing factory…';
        await callOne(
          'init-factory',
          factoryAddress,
          'factory',
          'init',
          [connectedAddress, routerAddress, DEFAULT_FEE_BPS, LAUNCH_FEE_ANM, '0x'],
          [
            `owner:           ${connectedAddress}`,
            `router:          ${routerAddress}`,
            `default_fee_bps: ${DEFAULT_FEE_BPS}`,
            `launch_fee_anm:  ${LAUNCH_FEE_ANM}`,
          ],
        );

        runStatus.textContent = 'Step 4 of 5: initializing router…';
        await callOne(
          'init-router',
          routerAddress,
          'router',
          'init',
          [connectedAddress, factoryAddress],
          [
            `owner:   ${connectedAddress}`,
            `factory: ${factoryAddress}`,
          ],
        );

        runStatus.textContent = 'Step 5 of 5: pinning addresses to launcher backend…';
        setStepState('register', 'posting…');
        const regRes = await fetch(`${LAUNCHER_API}/dex/addresses`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            chainId,
            deployer: connectedAddress,
            factory: { address: factoryAddress, txHash: factory.txHash },
            router:  { address: routerAddress,  txHash: router.txHash  },
          }),
        });
        if (!regRes.ok) {
          const e = await regRes.json().catch(() => ({}));
          throw new Error(`register failed: ${e?.error?.message || regRes.status}`);
        }
        const regBody = await regRes.json();
        setStepResult('register', [
          `factory: ${regBody.addresses?.factory?.address}`,
          `router:  ${regBody.addresses?.router?.address}`,
        ]);
        setStepState('register', 'done ✓', '#059669');

        runStatus.style.color = '#059669';
        runStatus.textContent = 'DEX deployed and registered. Swap UI can now read addresses from /launcher-api/api/dex/addresses.';
      } catch (err) {
        runStatus.style.color = '#dc2626';
        runStatus.textContent = err?.message || String(err);
        runBtn.disabled = false;
        runBtn.textContent = 'Retry from failed step';
      }
    }

    (async () => {
      provider = await waitForProvider();
      if (!provider) {
        banner.innerHTML = 'Animica wallet not detected. <a href="/wallet" class="underline">Install</a> and reload.';
        return;
      }
      banner.innerHTML = 'Wallet detected. <button id="banner-connect" type="button" class="underline">Connect</button> to continue.';
      document.getElementById('banner-connect').addEventListener('click', () => {
        connect().catch((err) => { banner.textContent = 'Connect failed: ' + (err?.message || err); });
      });
      runBtn.addEventListener('click', () => { run(); });
    })();
  </script>
</BaseLayout>
