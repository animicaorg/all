{
  "name": "animica-website",
  "private": true,
  "version": "0.1.0",
  "description": "Animica marketing & docs site built with Astro + TypeScript (+ optional Tailwind).",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "astro check",
    "sync": "astro sync",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro,.mdx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,astro,md,mdx,css}\"",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "prepare": "husky install",
    "predeploy": "astro build",
    "serve": "astro preview --host",
    "postinstall": "playwright install --with-deps || true"
  },
  "dependencies": {
    "@animica/sdk": "workspace:*",
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/sitemap": "^3.2.1",
    "@types/node": "^20.19.24",
    "astro": "^4.16.19",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^5.1.5",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.4.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,md,mdx,css}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "astro",
    "typescript",
    "tailwind",
    "animica",
    "website"
  ]
}
