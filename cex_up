#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$SCRIPT_DIR"
CEX_DIR="$ROOT_DIR/cex"
COMPOSE_FILE="$CEX_DIR/ops/docker-compose.yml"
ENV_DIR="$CEX_DIR/ops/env"
ENV_FILE="$ENV_DIR/.env"
ENV_EXAMPLE="$ENV_DIR/.env.example"
LOG_DIR="$ROOT_DIR/.cex_logs"
PID_FILE="$ROOT_DIR/.cex_pids"

DAEMON=false
SHOW_LOGS=false
LOG_SERVICE=""
NO_INSTALL=false
RESET_NODE_MODULES=false

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1"; }

usage() {
  cat <<'EOF'
Usage: ./cex_up [options]

Options:
  --daemon                Run API/admin services in the background.
  --logs [service]        Tail docker compose logs (optionally for a service).
  --no-install            Skip pnpm install steps.
  --reset-node-modules    Remove node_modules before reinstalling.
  --help                  Show this help message.
EOF
}

compose_cmd() {
  if docker compose version >/dev/null 2>&1; then
    echo "docker compose"
    return
  fi
  if command -v docker-compose >/dev/null 2>&1; then
    echo "docker-compose"
    return
  fi
  log_error "Docker Compose not found. Install Docker Desktop or docker-compose."
  exit 1
}

read_package_manager_version() {
  local file="$1"
  if [[ -f "$file" ]]; then
    local line
    line=$(grep -m1 '"packageManager"' "$file" 2>/dev/null || true)
    if [[ -n "$line" ]]; then
      sed -E 's/.*"packageManager": "pnpm@([^"]+)".*/\1/' <<<"$line"
    fi
  fi
}

ensure_prereqs() {
  log_info "Checking prerequisites..."
  if ! command -v docker >/dev/null 2>&1; then
    log_error "Docker is not installed. Install Docker Desktop first."
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    log_error "Docker is not running. Start Docker Desktop and retry."
    exit 1
  fi
  if [[ ! -d "$CEX_DIR" ]]; then
    log_error "CEX directory not found at $CEX_DIR"
    exit 1
  fi
  if [[ ! -f "$COMPOSE_FILE" ]]; then
    log_error "Compose file not found at $COMPOSE_FILE"
    exit 1
  fi
  log_success "Prerequisites look good"
}

ensure_env_files() {
  log_info "Ensuring environment files exist..."
  mkdir -p "$ENV_DIR"
  if [[ ! -f "$ENV_EXAMPLE" ]]; then
    log_error "Missing $ENV_EXAMPLE. Please restore it from version control."
    exit 1
  fi
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    log_warning "Created $ENV_FILE from example defaults."
  else
    log_success "Environment file already present."
  fi
}

load_env() {
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

set_service_defaults() {
  API_GATEWAY_PORT="${API_GATEWAY_PORT:-2456}"
  ADMIN_SERVICE_PORT="${ADMIN_SERVICE_PORT:-4000}"
  ADMIN_WEB_PORT="${ADMIN_WEB_PORT:-5173}"
  EXCHANGE_WEB_PORT="${EXCHANGE_WEB_PORT:-5174}"
  API_GATEWAY_HOST="${API_GATEWAY_HOST:-0.0.0.0}"
  ADMIN_SERVICE_HOST="${ADMIN_SERVICE_HOST:-0.0.0.0}"
  ADMIN_WEB_HOST="${ADMIN_WEB_HOST:-0.0.0.0}"
  EXCHANGE_WEB_HOST="${EXCHANGE_WEB_HOST:-0.0.0.0}"
}

setup_corepack() {
  export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
  local pnpm_version
  pnpm_version="$(read_package_manager_version "$CEX_DIR/package.json")"
  if [[ -z "$pnpm_version" ]]; then
    pnpm_version="$(read_package_manager_version "$ROOT_DIR/package.json")"
  fi
  pnpm_version="${pnpm_version:-10.28.1}"
  log_info "Using pnpm@${pnpm_version} via corepack."
  corepack enable
  corepack prepare "pnpm@${pnpm_version}" --activate
}

reset_node_modules() {
  log_warning "Removing node_modules for a clean install..."
  rm -rf "$CEX_DIR/node_modules" "$ROOT_DIR/node_modules" "$ROOT_DIR/apps/admin-web/node_modules"
  find "$CEX_DIR" -name node_modules -type d -prune -exec rm -rf {} +
  find "$ROOT_DIR/apps/admin-web" -name node_modules -type d -prune -exec rm -rf {} +
  log_success "node_modules removed."
}

install_deps() {
  if [[ "$NO_INSTALL" == "true" ]]; then
    log_warning "Skipping pnpm install (--no-install)."
    return
  fi
  setup_corepack
  log_info "Installing dependencies (root workspace)..."
  pnpm -C "$ROOT_DIR" -w install
  log_info "Installing dependencies (cex workspace)..."
  pnpm -C "$CEX_DIR" -w install
  log_success "Dependencies installed."
}

start_infra() {
  local compose
  compose="$(compose_cmd)"
  log_info "Starting infrastructure (postgres, redis, nats)..."
  $compose -f "$COMPOSE_FILE" up -d postgres redis nats
  log_success "Infrastructure containers started."
}

wait_for_postgres() {
  local compose
  compose="$(compose_cmd)"
  log_info "Waiting for PostgreSQL to be ready..."
  local retries=30
  local count=0
  until $compose -f "$COMPOSE_FILE" exec -T postgres \
    pg_isready -U "$DB_USER" -d "$DB_NAME" >/dev/null 2>&1; do
    count=$((count + 1))
    if [[ "$count" -ge "$retries" ]]; then
      log_error "PostgreSQL did not become ready in time."
      exit 1
    fi
    sleep 2
  done
  log_success "PostgreSQL is ready."
}

ensure_postgres_role_and_db() {
  local compose
  compose="$(compose_cmd)"
  log_info "Ensuring PostgreSQL role/database exist..."
  local admin_user
  admin_user="${DB_ADMIN_USER:-$DB_USER}"
  if ! $compose -f "$COMPOSE_FILE" exec -T postgres \
    psql -U "$admin_user" -d postgres -tAc "SELECT 1" >/dev/null 2>&1; then
    if $compose -f "$COMPOSE_FILE" exec -T postgres \
      psql -U "$DB_USER" -d postgres -tAc "SELECT 1" >/dev/null 2>&1; then
      admin_user="$DB_USER"
    else
      admin_user="postgres"
    fi
  fi
  local role_exists
  role_exists="$($compose -f "$COMPOSE_FILE" exec -T postgres \
    psql -U "$admin_user" -d postgres -tAc "SELECT 1 FROM pg_roles WHERE rolname='${DB_USER}'" || true)"
  if [[ "$role_exists" != "1" ]]; then
    log_warning "Creating missing role ${DB_USER}."
    $compose -f "$COMPOSE_FILE" exec -T postgres \
      psql -U "$admin_user" -d postgres -v ON_ERROR_STOP=1 \
      -c "CREATE ROLE ${DB_USER} WITH LOGIN SUPERUSER PASSWORD '${DB_PASSWORD}';"
  fi

  local db_exists
  db_exists="$($compose -f "$COMPOSE_FILE" exec -T postgres \
    psql -U "$admin_user" -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='${DB_NAME}'" || true)"
  if [[ "$db_exists" != "1" ]]; then
    log_warning "Creating missing database ${DB_NAME}."
    $compose -f "$COMPOSE_FILE" exec -T postgres \
      psql -U "$admin_user" -d postgres -v ON_ERROR_STOP=1 \
      -c "CREATE DATABASE ${DB_NAME} OWNER ${DB_USER};"
  fi
  log_success "PostgreSQL role/database ensured."
}

run_migrations() {
  log_info "Running database migrations..."
  pnpm -C "$CEX_DIR" --filter @cex/db migrate
  log_success "Migrations complete."
}

run_seed() {
  log_info "Seeding database..."
  pnpm -C "$CEX_DIR" --filter @cex/db seed
  log_success "Seed complete."
}

start_docker_logs() {
  if [[ "$SHOW_LOGS" != "true" ]]; then
    return
  fi
  local compose
  compose="$(compose_cmd)"
  log_info "Tailing docker compose logs..."
  if [[ -n "$LOG_SERVICE" ]]; then
    $compose -f "$COMPOSE_FILE" logs -f "$LOG_SERVICE" &
  else
    $compose -f "$COMPOSE_FILE" logs -f &
  fi
}

is_port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltnp | grep -q ":${port}"
    return $?
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
    return $?
  fi
  python - "$port" <<'PY'
import socket, sys
port = int(sys.argv[1])
s = socket.socket()
try:
    s.bind(("0.0.0.0", port))
except OSError:
    sys.exit(0)
s.close()
sys.exit(1)
PY
}

ensure_port_available() {
  local service="$1"
  local host="$2"
  local port="$3"
  if is_port_in_use "$port"; then
    log_error "${service} cannot start because ${host}:${port} is already in use."
    log_error "Try: pnpm -C cex ports:check ${port}"
    log_error "Or free the port (lsof -nP -iTCP:${port} -sTCP:LISTEN || ss -ltnp | grep \":${port}\")."
    exit 1
  fi
}

start_dev_services() {
  log_info "Starting CEX services + admin console + exchange web..."
  echo "Assumptions:"
  echo "  - Admin console is apps/admin-web (Vite on :${ADMIN_WEB_PORT})."
  echo "  - Exchange web is cex/apps/exchange-web (Vite on :${EXCHANGE_WEB_PORT})."
  echo "  - Admin API is @cex/admin-service (PORT=${ADMIN_SERVICE_PORT})."
  echo "  - Exchange API is @cex/api-gateway (PORT=${API_GATEWAY_PORT})."
  echo ""

  ensure_port_available "api-gateway" "$API_GATEWAY_HOST" "$API_GATEWAY_PORT"
  ensure_port_available "admin-service" "$ADMIN_SERVICE_HOST" "$ADMIN_SERVICE_PORT"
  ensure_port_available "admin-web" "$ADMIN_WEB_HOST" "$ADMIN_WEB_PORT"
  ensure_port_available "exchange-web" "$EXCHANGE_WEB_HOST" "$EXCHANGE_WEB_PORT"

  local admin_web_host_args=(--host "$ADMIN_WEB_HOST" --port "$ADMIN_WEB_PORT")
  local exchange_web_host_args=(--host "$EXCHANGE_WEB_HOST" --port "$EXCHANGE_WEB_PORT")

  if [[ "$DAEMON" == "true" ]]; then
    mkdir -p "$LOG_DIR"
    : > "$PID_FILE"
    PORT="$API_GATEWAY_PORT" HOST="$API_GATEWAY_HOST" \
      nohup pnpm -C "$CEX_DIR" --filter @cex/api-gateway dev > "$LOG_DIR/api-gateway.log" 2>&1 &
    echo $! >> "$PID_FILE"
    PORT="$ADMIN_SERVICE_PORT" HOST="$ADMIN_SERVICE_HOST" \
      nohup pnpm -C "$CEX_DIR" --filter @cex/admin-service dev > "$LOG_DIR/admin-service.log" 2>&1 &
    echo $! >> "$PID_FILE"
    nohup pnpm -C "$ROOT_DIR" --filter @animica/admin-web dev "${admin_web_host_args[@]}" \
      > "$LOG_DIR/admin-web.log" 2>&1 &
    echo $! >> "$PID_FILE"
    PORT="$EXCHANGE_WEB_PORT" HOST="$EXCHANGE_WEB_HOST" \
      nohup pnpm -C "$CEX_DIR" --filter @cex/exchange-web dev > "$LOG_DIR/exchange-web.log" 2>&1 &
    echo $! >> "$PID_FILE"
    log_success "Services started in the background."
    log_info "Logs: $LOG_DIR (and docker compose logs via --logs)."
  else
    PORT="$API_GATEWAY_PORT" HOST="$API_GATEWAY_HOST" pnpm -C "$CEX_DIR" --filter @cex/api-gateway dev &
    pid_api=$!
    PORT="$ADMIN_SERVICE_PORT" HOST="$ADMIN_SERVICE_HOST" pnpm -C "$CEX_DIR" --filter @cex/admin-service dev &
    pid_admin=$!
    pnpm -C "$ROOT_DIR" --filter @animica/admin-web dev "${admin_web_host_args[@]}" &
    pid_admin_web=$!
    PORT="$EXCHANGE_WEB_PORT" HOST="$EXCHANGE_WEB_HOST" pnpm -C "$CEX_DIR" --filter @cex/exchange-web dev &
    pid_exchange_web=$!
    trap 'kill "$pid_api" "$pid_admin" "$pid_admin_web" "$pid_exchange_web" 2>/dev/null || true' EXIT
    wait "$pid_api" "$pid_admin" "$pid_admin_web" "$pid_exchange_web"
  fi
}

print_next_steps() {
  echo ""
  echo "═══════════════════════════════════════════════════════════════"
  echo "CEX dev environment is ready."
  echo "═══════════════════════════════════════════════════════════════"
  echo "API Gateway:        http://localhost:${API_GATEWAY_PORT}"
  echo "Admin Service:      http://localhost:${ADMIN_SERVICE_PORT}"
  echo "Admin Console:      http://localhost:${ADMIN_WEB_PORT}"
  echo "Exchange Web:       http://localhost:${EXCHANGE_WEB_PORT}"
  echo "PostgreSQL:         ${DB_USER}@localhost:${DB_PORT}/${DB_NAME}"
  echo "Redis:              ${REDIS_URL}"
  echo "NATS:               ${NATS_URL}"
  echo ""
  echo "Seeded user:"
  echo "  Email: test@cex.local (see cex/packages/db/src/seeds/seed.js)"
  echo "  Password: (none - adjust seed if needed)"
  echo ""
  echo "Exchange Web (Demo Mode):"
  echo "  - Login with any email/password"
  echo "  - Mock data is used for markets, orderbook, trades"
  echo "  - API endpoints need to be implemented in @cex/api-gateway"
  echo ""
  echo "Next steps:"
  echo "  - Stop services: ./cex_down"
  echo "  - Tail docker logs: ./cex_up --logs [service]"
  echo "  - Rerun migrations: pnpm -C ./cex --filter @cex/db migrate"
  echo "═══════════════════════════════════════════════════════════════"
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --daemon)
        DAEMON=true
        shift
        ;;
      --logs)
        SHOW_LOGS=true
        if [[ -n "${2:-}" && "${2:-}" != --* ]]; then
          LOG_SERVICE="$2"
          shift 2
        else
          shift
        fi
        ;;
      --no-install)
        NO_INSTALL=true
        shift
        ;;
      --reset-node-modules)
        RESET_NODE_MODULES=true
        shift
        ;;
      --help)
        usage
        exit 0
        ;;
      *)
        log_error "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  ensure_prereqs
  ensure_env_files
  load_env
  set_service_defaults

  if [[ "$RESET_NODE_MODULES" == "true" ]]; then
    reset_node_modules
  fi

  install_deps
  start_infra
  wait_for_postgres
  ensure_postgres_role_and_db
  run_migrations
  run_seed
  start_docker_logs
  print_next_steps
  start_dev_services
}

main "$@"
