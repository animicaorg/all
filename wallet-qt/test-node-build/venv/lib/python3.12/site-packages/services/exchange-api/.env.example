# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/exchange_api?schema=public"

# Node Environment
NODE_ENV="development"

# Service Configuration
SERVICE_NAME="exchange-api"
LOG_LEVEL="info"

# HTTP Server
HTTP_PORT=3000
HTTP_HOST="0.0.0.0"

# WebSocket Server
WS_PORT=3001
WS_HOST="0.0.0.0"
WS_HEARTBEAT_INTERVAL_MS=15000
WS_HEARTBEAT_TIMEOUT_MS=45000
WS_MAX_SUBSCRIPTIONS_PER_CLIENT=50
WS_MAX_OUTGOING_QUEUE_SIZE=1000

# Redis Configuration (for rate limiting and caching)
REDIS_URL="redis://localhost:6379/0"
# Or separate config:
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""
# REDIS_DB=0

# Authentication
API_KEY_TIMESTAMP_WINDOW_MS=30000
API_KEY_NONCE_TTL_MS=300000
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="24h"

# Rate Limiting
RATE_LIMIT_PUBLIC_PER_IP=120
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PRIVATE_PER_KEY=60
RATE_LIMIT_PRIVATE_WINDOW_MS=60000
RATE_LIMIT_PRIVATE_BURST=20
RATE_LIMIT_USER_AGGREGATE=240

# CORS
CORS_ORIGIN="*"
CORS_CREDENTIALS=false

# Cache TTLs
CACHE_ORDERBOOK_TTL_MS=250
CACHE_TICKER_TTL_MS=1000
CACHE_MARKETS_TTL_MS=60000

# Pagination
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=50

# Market Data
ORDERBOOK_MAX_DEPTH=50
TRADES_MAX_LIMIT=100

# Internal Service URLs (if not using NATS)
MATCHING_ENGINE_URL="http://localhost:3100"
LEDGER_SERVICE_URL="http://localhost:3200"
DEPOSITS_SERVICE_URL="http://localhost:3300"
WITHDRAWALS_SERVICE_URL="http://localhost:3400"

# NATS Configuration (if using message bus)
NATS_URL="nats://localhost:4222"
# NATS_USER="nats_user"
# NATS_PASS="nats_password"

# External Services (legacy)
BITGO_API_URL="https://app.bitgo.com/api/v2"
BITGO_ACCESS_TOKEN="your-bitgo-token"
BITGO_ENVIRONMENT="test"

# Animica Node
ANIMICA_NODE_URL="http://localhost:8545"
ANIMICA_CHAIN_ID="1"

# Reconciliation
RECONCILIATION_SCHEDULE="0 0 * * *" # Daily at midnight
RECONCILIATION_TOLERANCE="0.000000000000000001"

# Withdrawals
WITHDRAWAL_MIN_APPROVALS=2
WITHDRAWAL_HOT_WALLET_LIMIT="10000"
