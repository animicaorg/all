cmake_minimum_required(VERSION 3.16)

project(AnimicaWallet VERSION 0.1.0 LANGUAGES CXX)

set(WALLET_DISPLAY_NAME "Animica Wallet")
set(WALLET_BUNDLE_NAME "AnimicaWallet")
set(WALLET_GUI_IDENTIFIER "org.animica.wallet")
set(WALLET_COPYRIGHT "Copyright (c) 2026 Animica")

configure_file(
    "${CMAKE_CURRENT_SOURCE_DIR}/resources/macos/Info.plist.in"
    "${CMAKE_CURRENT_BINARY_DIR}/Info.plist"
    @ONLY
)

option(WALLET_REMOTE_RPC_ONLY "Disable embedded node and use remote RPC only" ON)

# Set C++ standard
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Include custom CMake modules
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")

# Include GNUInstallDirs for standard install directories
include(GNUInstallDirs)

# Find Qt6 packages (Qt5 fallback for older systems)
find_package(Qt6 COMPONENTS Core Widgets Network Sql Concurrent)
if(NOT Qt6_FOUND)
    message(STATUS "Qt6 not found, trying Qt5...")
    find_package(Qt5 5.15 REQUIRED COMPONENTS Core Widgets Network Sql Concurrent)
    set(QT_VERSION_MAJOR 5)
else()
    set(QT_VERSION_MAJOR 6)
endif()

# Find OpenSSL (required for wallet crypto)
find_package(OpenSSL REQUIRED)

# Set Qt version for source code
add_compile_definitions(QT_VERSION_MAJOR=${QT_VERSION_MAJOR})

# Enable automoc and autouic
set(CMAKE_AUTOMOC ON)
set(CMAKE_AUTOUIC ON)
set(CMAKE_AUTORCC ON)

# Get git commit hash (best effort)
execute_process(
    COMMAND git rev-parse --short HEAD
    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
    OUTPUT_VARIABLE GIT_COMMIT_HASH
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)
if(NOT GIT_COMMIT_HASH)
    set(GIT_COMMIT_HASH "unknown")
endif()

# Build timestamp
string(TIMESTAMP BUILD_TIMESTAMP "%Y-%m-%d %H:%M:%S UTC" UTC)

# Add version definitions
add_compile_definitions(
    WALLET_VERSION="${PROJECT_VERSION}"
    GIT_COMMIT_HASH="${GIT_COMMIT_HASH}"
    BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"
)

if(WALLET_REMOTE_RPC_ONLY)
    add_compile_definitions(WALLET_REMOTE_RPC_ONLY=1)
else()
    add_compile_definitions(WALLET_REMOTE_RPC_ONLY=0)
endif()

# Source files
set(SOURCES
    src/main.cpp
    resources/wallet-qt.qrc
    src/platform/AppPaths.cpp
    src/platform/DataDirManager.cpp
    src/rpc/AnimicaRpcClient.cpp
    src/rpc/RpcReply.cpp
    src/rpc/RpcSettings.cpp
    src/ui/RpcSettingsDialog.cpp
    src/wallet/WalletAccount.cpp
    src/wallet/AnimicaWalletBackend.cpp
    src/wallet/EncryptedKeystore.cpp
    src/wallet/AccountManager.cpp
    src/wallet/AddressBook.cpp
    src/wallet/BalanceTracker.cpp
    src/wallet/WalletEngine.cpp
    src/wallet/UnlockDialog.cpp
    src/wallet/AccountsWidget.cpp
    src/wallet/AddressBookWidget.cpp
    src/wallet/CreateAccountDialog.cpp
    src/wallet/WalletWidget.cpp
    src/wallet/WalletDatabase.cpp
    src/wallet/TransactionMonitor.cpp
    src/wallet/TransactionHistoryWidget.cpp
    src/wallet/FeeEstimator.cpp
    src/wallet/SendWidget.cpp
    src/wallet/ReconciliationJob.cpp
    src/wallet/ReceiveWidget.cpp
    src/wallet/ReceiveQrService.cpp
    src/wallet/ContractInteractionWidget.cpp
    src/wallet/SettingsWidget.cpp
    src/wallet/WalletImporter.cpp
    src/wallet/WalletExporter.cpp
    src/diagnostics/Redactor.cpp
    src/diagnostics/RoleManager.cpp
    src/diagnostics/CommandAllowlist.cpp
    src/diagnostics/ConsoleExecutor.cpp
    src/diagnostics/NodeController.cpp
    src/diagnostics/DiagnosticsConsoleWidget.cpp
    src/diagnostics/DiagnosticsStatusWidget.cpp
)

if(NOT WALLET_REMOTE_RPC_ONLY)
    list(APPEND SOURCES
        src/node/NodeManager.cpp
        src/ui/NodeControlWidget.cpp
        src/diagnostics/DiagnosticsLogsWidget.cpp
        src/diagnostics/DiagnosticsWindow.cpp
    )
endif()

    qt_generate_deploy_app_script(
        TARGET animica-wallet
        OUTPUT_SCRIPT qt_deploy_script
        NO_UNSUPPORTED_PLATFORM_ERROR
    )
endif()
if(QT_VERSION_MAJOR EQUAL 6 AND (WIN32 OR APPLE))
    qt_generate_deploy_app_script(
        TARGET animica-wallet
        OUTPUT_SCRIPT qt_deploy_script
        NO_UNSUPPORTED_PLATFORM_ERROR
    )
endif()

if(QT_VERSION_MAJOR EQUAL 6 AND (WIN32 OR APPLE) AND qt_deploy_script)
    install(SCRIPT "${qt_deploy_script}")
endif()
set(HEADERS
    src/platform/AppPaths.h
    src/platform/DataDirManager.h
    src/rpc/AnimicaRpcClient.h
    src/rpc/RpcReply.h
    src/rpc/RpcSettings.h
    src/ui/RpcSettingsDialog.h
    src/wallet/WalletAccount.h
    src/wallet/AnimicaWalletBackend.h
    src/wallet/EncryptedKeystore.h
    src/wallet/AccountManager.h
    src/wallet/AddressBook.h
    src/wallet/BalanceTracker.h
    src/wallet/WalletEngine.h
    src/wallet/UnlockDialog.h
    src/wallet/AccountsWidget.h
    src/wallet/AddressBookWidget.h
    src/wallet/CreateAccountDialog.h
    src/wallet/WalletWidget.h
    src/wallet/WalletDatabase.h
    src/wallet/TransactionMonitor.h
    src/wallet/TransactionHistoryWidget.h
    src/wallet/FeeEstimator.h
    src/wallet/SendWidget.h
    src/wallet/ReconciliationJob.h
    src/wallet/ReceiveWidget.h
    src/wallet/ReceiveQrService.h
    src/wallet/ContractInteractionWidget.h
    src/wallet/SettingsWidget.h
    src/wallet/WalletImporter.h
    src/wallet/WalletExporter.h
    src/diagnostics/Redactor.h
    src/diagnostics/RoleManager.h
    src/diagnostics/CommandAllowlist.h
    src/diagnostics/ConsoleExecutor.h
    src/diagnostics/NodeController.h
    src/diagnostics/DiagnosticsConsoleWidget.h
    src/diagnostics/DiagnosticsStatusWidget.h
)

if(NOT WALLET_REMOTE_RPC_ONLY)
    list(APPEND HEADERS
        src/node/NodeManager.h
        src/ui/NodeControlWidget.h
        src/diagnostics/DiagnosticsLogsWidget.h
        src/diagnostics/DiagnosticsWindow.h
    )
endif()

# Create executable
add_executable(animica-wallet ${SOURCES} ${HEADERS})

# Compiler-specific warnings
if(MSVC)
    target_compile_options(animica-wallet PRIVATE /W4 /WX-)
else()
    target_compile_options(animica-wallet PRIVATE 
        -Wall -Wextra -Wpedantic
        -Wno-unused-parameter
    )
endif()

# Link Qt libraries
if(QT_VERSION_MAJOR EQUAL 6)
    target_link_libraries(animica-wallet
        Qt6::Core
        Qt6::Widgets
        Qt6::Network
        Qt6::Sql
        Qt6::Concurrent
        OpenSSL::SSL
        OpenSSL::Crypto
    )
else()
    target_link_libraries(animica-wallet
        Qt5::Core
        Qt5::Widgets
        Qt5::Network
        Qt5::Sql
        Qt5::Concurrent
        OpenSSL::SSL
        OpenSSL::Crypto
    )
endif()

# Set output directory
set_target_properties(animica-wallet PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
)

if(NOT WALLET_REMOTE_RPC_ONLY)
    # Build the Animica node
    include(AnimicaNode)
    animica_build_node(NODE_PYTHON_PATH)

    # Bundle the node into the wallet output
    # This creates a platform-specific bundle structure
    if(APPLE)
        # macOS: Create app bundle with node inside Resources
        set_target_properties(animica-wallet PROPERTIES
            MACOSX_BUNDLE TRUE
            MACOSX_BUNDLE_GUI_IDENTIFIER "${WALLET_GUI_IDENTIFIER}"
            MACOSX_BUNDLE_BUNDLE_NAME "${WALLET_BUNDLE_NAME}"
            MACOSX_BUNDLE_BUNDLE_VERSION ${PROJECT_VERSION}
            MACOSX_BUNDLE_SHORT_VERSION_STRING ${PROJECT_VERSION}
            MACOSX_BUNDLE_ICON_FILE "animica.icns"
            MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_BINARY_DIR}/Info.plist"
            OUTPUT_NAME "${WALLET_BUNDLE_NAME}"
        )
        
        # Copy icon into app bundle Resources
        set(MACOS_ICON "${CMAKE_CURRENT_SOURCE_DIR}/resources/icons/animica.icns")
        if(EXISTS "${MACOS_ICON}")
            set_source_files_properties("${MACOS_ICON}" PROPERTIES
                MACOSX_PACKAGE_LOCATION "Resources")
            target_sources(animica-wallet PRIVATE "${MACOS_ICON}")
        endif()
        
        # Copy node venv into app bundle
        set(BUNDLE_NODE_DIR "${CMAKE_BINARY_DIR}/bin/AnimicaWallet.app/Contents/Resources/node")
        add_custom_command(TARGET animica-wallet POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E make_directory "${BUNDLE_NODE_DIR}"
            # Remove existing venv if present to avoid nested directories
            COMMAND rm -rf "${BUNDLE_NODE_DIR}/venv"
            # Use native cp on macOS to preserve symlinks in venv
            COMMAND cp -R "${ANIMICA_NODE_VENV}" "${BUNDLE_NODE_DIR}/venv"
            COMMENT "Bundling Animica node into macOS app bundle"
        )
        
        # Create wrapper script for easy access
        set(NODE_WRAPPER "${BUNDLE_NODE_DIR}/animica-node")
        add_custom_command(TARGET animica-wallet POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E echo "#!/bin/bash" > "${NODE_WRAPPER}"
            COMMAND ${CMAKE_COMMAND} -E echo "exec \"\$(dirname \"\$0\")/venv/bin/python\" -m rpc \"\$@\"" >> "${NODE_WRAPPER}"
            COMMAND chmod +x "${NODE_WRAPPER}"
            COMMENT "Creating node wrapper script"
        )
        
    elseif(WIN32)
        # Windows: Set icon and version metadata via RC file
        set(WINDOWS_ICON "${CMAKE_CURRENT_SOURCE_DIR}/resources/icons/animica.ico")
        if(EXISTS "${WINDOWS_ICON}")
            set(RC_FILE "${CMAKE_BINARY_DIR}/animica-wallet.rc")
            configure_file(
                "${CMAKE_CURRENT_SOURCE_DIR}/resources/windows/animica-wallet.rc.in"
                "${RC_FILE}"
                @ONLY
            )
            target_sources(animica-wallet PRIVATE "${RC_FILE}")
        endif()
        
        # Windows: Copy node alongside executable
        set(BUNDLE_NODE_DIR "${CMAKE_BINARY_DIR}/bin/node")
        add_custom_command(TARGET animica-wallet POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E make_directory "${BUNDLE_NODE_DIR}"
            COMMAND ${CMAKE_COMMAND} -E copy_directory
                "${ANIMICA_NODE_VENV}"
                "${BUNDLE_NODE_DIR}/venv"
            COMMENT "Bundling Animica node for Windows"
        )
        
        # Create batch wrapper
        set(NODE_WRAPPER "${BUNDLE_NODE_DIR}/animica-node.bat")
        add_custom_command(TARGET animica-wallet POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E echo "@echo off" > "${NODE_WRAPPER}"
            COMMAND ${CMAKE_COMMAND} -E echo "\"%~dp0venv\\Scripts\\python.exe\" -m rpc %*" >> "${NODE_WRAPPER}"
            COMMENT "Creating node wrapper script"
        )
        
    else()
        # Linux: Copy node into dist/node
        set(BUNDLE_NODE_DIR "${CMAKE_BINARY_DIR}/bin/node")
        add_custom_command(TARGET animica-wallet POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E make_directory "${BUNDLE_NODE_DIR}"
            # Remove existing venv if present to avoid nested directories
            COMMAND rm -rf "${BUNDLE_NODE_DIR}/venv"
            # Use native cp on Linux to preserve symlinks in venv
            COMMAND cp -R "${ANIMICA_NODE_VENV}" "${BUNDLE_NODE_DIR}/venv"
            COMMENT "Bundling Animica node for Linux"
        )
        
        # Create wrapper script
        set(NODE_WRAPPER "${BUNDLE_NODE_DIR}/animica-node")
        add_custom_command(TARGET animica-wallet POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E echo "#!/bin/bash" > "${NODE_WRAPPER}"
            COMMAND ${CMAKE_COMMAND} -E echo "exec \"\$(dirname \"\$0\")/venv/bin/python\" -m rpc \"\$@\"" >> "${NODE_WRAPPER}"
            COMMAND chmod +x "${NODE_WRAPPER}"
            COMMENT "Creating node wrapper script"
        )
    endif()

    # Copy deterministic runtime assets that some Python modules resolve relative to the repo root.
    set(BUNDLE_NODE_ASSET_DIR "${BUNDLE_NODE_DIR}/assets")
    add_custom_command(TARGET animica-wallet POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E remove_directory "${BUNDLE_NODE_ASSET_DIR}/spec"
        COMMAND ${CMAKE_COMMAND} -E remove_directory "${BUNDLE_NODE_ASSET_DIR}/genesis"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${BUNDLE_NODE_ASSET_DIR}"
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${ANIMICA_REPO_ROOT}/spec" "${BUNDLE_NODE_ASSET_DIR}/spec"
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${ANIMICA_REPO_ROOT}/core/genesis" "${BUNDLE_NODE_ASSET_DIR}/genesis"
        COMMENT "Bundling node runtime assets"
    )
    
    # Store bundle info for runtime
    add_compile_definitions(
        BUNDLED_NODE_PATH="${BUNDLE_NODE_DIR}"
    )
endif()

# Install target
# Note: On macOS, animica-wallet is built as a MACOSX_BUNDLE (.app bundle).
# CMake requires BUNDLE DESTINATION to be specified for bundle targets,
# otherwise install fails with "install TARGETS given no BUNDLE DESTINATION".
# On other platforms, it's a regular executable installed to bin.
if(APPLE)
    # On macOS, install as bundle. RUNTIME DESTINATION is not needed for bundles.
    install(TARGETS animica-wallet
        BUNDLE DESTINATION "."
    )
elseif(WIN32)
    install(TARGETS animica-wallet
        RUNTIME DESTINATION "."
    )
else()
    install(TARGETS animica-wallet
        RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
    )
endif()

if(UNIX AND NOT APPLE)
    install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/resources/linux/animica-wallet.desktop"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/applications"
    )
    foreach(ICON_SIZE 16 32 48 64 128 256 512)
        install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/resources/icons/hicolor/${ICON_SIZE}x${ICON_SIZE}/apps/animica-wallet.png"
            DESTINATION "${CMAKE_INSTALL_DATADIR}/icons/hicolor/${ICON_SIZE}x${ICON_SIZE}/apps"
        )
    endforeach()
endif()

if(NOT WALLET_REMOTE_RPC_ONLY)
    if(APPLE)
        install(DIRECTORY "${ANIMICA_NODE_VENV}"
            DESTINATION "AnimicaWallet.app/Contents/Resources/node"
            USE_SOURCE_PERMISSIONS
        )
        install(DIRECTORY "${ANIMICA_REPO_ROOT}/spec"
            DESTINATION "AnimicaWallet.app/Contents/Resources/node/assets"
            USE_SOURCE_PERMISSIONS
        )
        install(DIRECTORY "${ANIMICA_REPO_ROOT}/core/genesis"
            DESTINATION "AnimicaWallet.app/Contents/Resources/node/assets"
            USE_SOURCE_PERMISSIONS
        )
    elseif(WIN32)
        install(DIRECTORY "${ANIMICA_NODE_VENV}"
            DESTINATION "node"
            USE_SOURCE_PERMISSIONS
        )
        install(DIRECTORY "${ANIMICA_REPO_ROOT}/spec"
            DESTINATION "node/assets"
            USE_SOURCE_PERMISSIONS
        )
        install(DIRECTORY "${ANIMICA_REPO_ROOT}/core/genesis"
            DESTINATION "node/assets"
            USE_SOURCE_PERMISSIONS
        )
    else()
        install(DIRECTORY "${ANIMICA_NODE_VENV}"
            DESTINATION "${CMAKE_INSTALL_LIBDIR}/animica-wallet/node"
            USE_SOURCE_PERMISSIONS
        )
        install(DIRECTORY "${ANIMICA_REPO_ROOT}/spec"
            DESTINATION "${CMAKE_INSTALL_LIBDIR}/animica-wallet/node/assets"
            USE_SOURCE_PERMISSIONS
        )
        install(DIRECTORY "${ANIMICA_REPO_ROOT}/core/genesis"
            DESTINATION "${CMAKE_INSTALL_LIBDIR}/animica-wallet/node/assets"
            USE_SOURCE_PERMISSIONS
        )
    endif()
endif()

if(QT_VERSION_MAJOR EQUAL 6 AND (WIN32 OR APPLE) AND qt_deploy_script)
    install(SCRIPT "${qt_deploy_script}")
endif()

# Print build information
# Add tests subdirectory (optional, enable with -DBUILD_TESTING=ON)
option(BUILD_TESTING "Build tests" ON)
if(BUILD_TESTING)
    enable_testing()
    add_subdirectory(tests)
endif()

