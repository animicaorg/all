# ===== Animica Explorer Configuration =========================================
# Copy this file to .env.local and edit with your values
# ==============================================================================

# Required: HTTP JSON-RPC endpoint for your Animica node
# This is the primary data source for the explorer
# Examples:
# - Mainnet:       https://rpc.animica.org/rpc
# - Local devnet:  http://localhost:8545
# - Testnet:       https://rpc.testnet.animica.xyz
VITE_RPC_URL=http://localhost:8545

# Required: Numeric chain identifier (CAIP-2 format)
# Must match the chain ID of the node you're connecting to
# Common values:
# - Mainnet:  659658 (0xa11ca in hex)
# - Testnet:  2
# - Devnet:   1337
VITE_CHAIN_ID=1337

# Optional: WebSocket endpoint for live updates (real-time block/tx notifications)
# If not provided, will be derived from VITE_RPC_URL (http→ws, https→wss)
# Examples:
# - Mainnet:  wss://rpc.animica.org/ws
# - Local:    ws://localhost:8546
# - Testnet:  wss://rpc.testnet.animica.xyz/ws
# Leave commented to auto-derive from VITE_RPC_URL
# VITE_RPC_WS=ws://localhost:8546

# Optional: Explorer API (if using separate indexer/aggregation service)
# Leave blank to query the node RPC directly (recommended for most setups)
# Example: https://explorer-api.testnet.animica.xyz
VITE_EXPLORER_API=

# Optional: Studio Services URL for contract verification and deployment tools
# Used for deep-links and artifact lookups in the explorer UI
# Example: http://localhost:8090
VITE_SERVICES_URL=http://localhost:8090

# ==============================================================================
# Configuration Notes
# ==============================================================================
# 1. After editing, restart the dev server: pnpm dev
# 2. For production, use HTTPS for RPC/WS endpoints
# 3. Ensure CORS is configured on your RPC server to allow the explorer origin
# 4. Test connectivity: curl -X POST $VITE_RPC_URL \
#      -H "Content-Type: application/json" \
#      -d '{"jsonrpc":"2.0","id":1,"method":"chain.getChainId","params":[]}'
# 
# Troubleshooting: See docs/TROUBLESHOOTING.md for common issues
# ==============================================================================
