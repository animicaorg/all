from __future__ import annotations

import json
from pathlib import Path
from typing import Any, Dict, Mapping, Tuple

import cbor2

from ..tx import encode as tx_encode
from ..tx import send as tx_send

TxLike = Any


def _rpc_req(rpc, method: str, params=None):
    params = [] if params is None else params
    if rpc is None:
        return None
    if hasattr(rpc, "request"):
        return rpc.request(method, params)
    if hasattr(rpc, "call"):
        return rpc.call(method, params)
    raise TypeError("rpc object has neither request() nor call()")


def _coerce_bytes(value: Any, *, field: str) -> bytes:
    if isinstance(value, bytes):
        return value
    if isinstance(value, bytearray):
        return bytes(value)
    if isinstance(value, memoryview):
        return value.tobytes()
    if isinstance(value, str):
        s = value.strip()
        if s.startswith("0x"):
            return bytes.fromhex(s[2:])
        return s.encode()
    raise TypeError(f"{field} must be bytes-like, got {type(value).__name__}")


def _infer_chain_height(rpc) -> int:
    for method in ("chain.getHead", "chain.getInfo", "node.status"):
        try:
            out = _rpc_req(rpc, method, [])
        except Exception:
            continue
        if isinstance(out, Mapping):
            for key in ("height", "head_height", "best_height", "block_height"):
                val = out.get(key)
                if isinstance(val, int):
                    return val
            head = out.get("head")
            if isinstance(head, Mapping):
                val = head.get("height")
                if isinstance(val, int):
                    return val
    return 0


def _resolve_validity_window_from_rpc(
    rpc,
    *,
    valid_after: int | None,
    valid_until: int | None,
) -> Tuple[int, int]:
    if valid_after is not None and valid_until is not None:
        return int(valid_after), int(valid_until)
    chain_height = _infer_chain_height(rpc)
    resolved_after = int(valid_after) if valid_after is not None else chain_height
    resolved_until = int(valid_until) if valid_until is not None else (resolved_after + 120)
    return resolved_after, resolved_until


def _load_json(path_like: str | Path) -> Any:
    return json.loads(Path(path_like).read_text())


def make_package_bytes(
    *,
    manifest: str | Path | Mapping[str, Any],
    code: str | Path | bytes,
) -> bytes:
    manifest_obj = manifest if isinstance(manifest, Mapping) else _load_json(manifest)
    if isinstance(code, (str, Path)) and Path(code).exists():
        code_bytes = Path(code).read_bytes()
    elif isinstance(code, bytes):
        code_bytes = code
    else:
        code_bytes = str(code).encode()

    package = {
        "manifest": manifest_obj,
        "code": code_bytes,
    }
    return cbor2.dumps(package, canonical=True)


def _resolve_sign_bytes(tx: Mapping[str, Any]) -> bytes:
    body = tx_encode.canonical_body_dict(tx)
    return cbor2.dumps(body, canonical=True)


def build_deploy_tx(
    *,
    from_addr: str,
    chain_id: int,
    nonce: int = 0,
    max_fee: int = 1,
    package_bytes: bytes,
    gas_limit: int | None = None,
    valid_after: int = 0,
    valid_until: int = 10_000_000,
    salt: bytes | None = None,
) -> Dict[str, Any]:
    if gas_limit is None:
        gas_limit = max(58353, len(package_bytes) * 20)

    tx: Dict[str, Any] = {
        "from_addr": from_addr,
        "to": None,
        "value": 0,
        "data": package_bytes,
        "gas_limit": int(gas_limit),
        "max_fee": int(max_fee),
        "chain_id": int(chain_id),
        "valid_after": int(valid_after),
        "valid_until": int(valid_until),
    }
    if salt is not None:
        tx["salt"] = _coerce_bytes(salt, field="salt")
    return tx


def _get_public_key_bytes(signer: Any) -> bytes:
    for attr in ("public_key", "pubkey", "public_key_bytes", "pubkey_bytes"):
        value = getattr(signer, attr, None)
        if value is None:
            continue
        if callable(value):
            try:
                value = value()
            except TypeError:
                continue
        try:
            return _coerce_bytes(value, field=attr)
        except Exception:
            pass
    raise RuntimeError("Could not extract public key bytes from signer")


def _get_alg_id(signer: Any) -> int:
    for attr in ("alg_id", "algorithm_id", "sig_scheme_id"):
        value = getattr(signer, attr, None)
        if value is None:
            continue
        if callable(value):
            try:
                value = value()
            except TypeError:
                continue
        if isinstance(value, int):
            return value
    raise RuntimeError("Could not determine signer algorithm id")


def _sign_tx_with_animica(tx: Mapping[str, Any], signer: Any) -> bytes:
    import sys

    repo_python = Path.cwd() / "python"
    if repo_python.exists():
        repo_python_str = str(repo_python)
        if repo_python_str not in sys.path:
            sys.path.insert(0, repo_python_str)

    from animica.tx.signing import tx_sign_hash

    sign_hash = tx_sign_hash(tx)

    if hasattr(signer, "sign_bytes") and callable(signer.sign_bytes):
        return _coerce_bytes(signer.sign_bytes(sign_hash), field="signer.sign_bytes")
    if hasattr(signer, "sign") and callable(signer.sign):
        return _coerce_bytes(signer.sign(sign_hash), field="signer.sign")
    raise RuntimeError("Signer has no supported signing method for tx_sign_hash output")


def _extract_contract_address(receipt: Any) -> str | None:
    if not isinstance(receipt, Mapping):
        return None
    for key in ("contractAddress", "contract_address"):
        value = receipt.get(key)
        if isinstance(value, str) and value:
            return value
    logs = receipt.get("logs")
    if isinstance(logs, list):
        for log in logs:
            if isinstance(log, Mapping):
                for key in ("contractAddress", "contract_address"):
                    value = log.get(key)
                    if isinstance(value, str) and value:
                        return value
    return None


def deploy_package(
    *,
    rpc,
    signer,
    from_addr: str,
    chain_id: int,
    manifest: str | Path | Mapping[str, Any],
    code: str | Path | bytes,
    nonce: int = 0,
    max_fee: int = 1,
    gas_limit: int | None = None,
    valid_after: int | None = None,
    valid_until: int | None = None,
    salt: bytes | None = None,
    timeout_s: float = 120.0,
):
    package_bytes = make_package_bytes(manifest=manifest, code=code)
    resolved_valid_after, resolved_valid_until = _resolve_validity_window_from_rpc(
        rpc,
        valid_after=valid_after,
        valid_until=valid_until,
    )

    tx = build_deploy_tx(
        from_addr=from_addr,
        chain_id=chain_id,
        nonce=nonce,
        max_fee=max_fee,
        package_bytes=package_bytes,
        gas_limit=gas_limit,
        valid_after=resolved_valid_after,
        valid_until=resolved_valid_until,
        salt=salt,
    )

    signature = _sign_tx_with_animica(tx, signer)
    public_key = _get_public_key_bytes(signer)
    alg_id = _get_alg_id(signer)

    raw = tx_encode.pack_signed(
        tx,
        signature=signature,
        public_key=public_key,
        alg_id=alg_id,
    )

    receipt = tx_send.submit_and_wait(rpc, raw, timeout_s=timeout_s)
    contract_address = _extract_contract_address(receipt)
    return contract_address, receipt
