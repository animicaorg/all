# Animica Hash Worker Configuration - Quantum Backend
# Copy this file to .env and customize for your environment

# RPC Configuration
ANIMICA_RPC_URL=http://localhost:8545
ANIMICA_CHAIN_ID=1337

# Backend Configuration
HASH_BACKEND_TYPE=quantum
HASH_BACKEND_CONFIG='{"simulator": "qiskit", "backend": "aer_simulator", "shots": 1024}'

# Worker Identity
HASH_WORKER_ADDRESS=anim1your_worker_address_here

# Operational Settings
HASH_POLL_INTERVAL=10.0  # Quantum jobs take longer
HASH_STATE_FILE=/var/lib/animica/hash_worker_quantum_state.json
HASH_MAX_CONCURRENT_JOBS=1  # Quantum resources are expensive

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/animica/hash_worker_quantum.log

# Quantum-Specific Settings
# Simulator/Hardware selection
QUANTUM_BACKEND_TYPE=simulator  # or "hardware"
QUANTUM_SIMULATOR=qiskit_aer  # qiskit_aer, cirq, pennylane
QUANTUM_PROVIDER=ibm_quantum  # ibm_quantum, aws_braket, azure_quantum

# Hardware Backend (if using real quantum computer)
# QUANTUM_HARDWARE_BACKEND=ibmq_quito
# QUANTUM_API_TOKEN=your_ibm_quantum_api_token

# Quantum Algorithm Settings
# Use Grover's algorithm for search (quadratic speedup)
QUANTUM_USE_GROVER=true
# Number of qubits available
QUANTUM_NUM_QUBITS=10
# Circuit depth limit
QUANTUM_MAX_CIRCUIT_DEPTH=100

# Measurement Settings
# Number of shots per circuit execution
QUANTUM_SHOTS=1024
# Use error mitigation
QUANTUM_ERROR_MITIGATION=true
# Readout error correction
QUANTUM_READOUT_CORRECTION=true

# Performance
# Estimated speedup factor vs classical (for scheduling)
QUANTUM_SPEEDUP_FACTOR=1.4  # Quadratic for Grover
# Job timeout (seconds)
QUANTUM_JOB_TIMEOUT=600

# Algorithm Support
# Quantum backends may not support all algorithms efficiently
HASH_ENABLE_SHA256=true
HASH_ENABLE_SHA256D=true
HASH_ENABLE_SCRYPT=false  # Not suitable for quantum
HASH_ENABLE_BLAKE2B=true

# Resource Management
# Maximum qubits per job
QUANTUM_MAX_QUBITS_PER_JOB=20
# Maximum circuit depth per job
QUANTUM_MAX_DEPTH_PER_JOB=100
# Queue position preference (higher = more urgent)
QUANTUM_QUEUE_PRIORITY=5

# Fallback Configuration
# Fall back to classical if quantum unavailable
QUANTUM_FALLBACK_TO_CLASSICAL=true
# Fallback backend
QUANTUM_FALLBACK_BACKEND=cpu

# Cost Management (for cloud quantum services)
# Maximum cost per job (USD)
QUANTUM_MAX_COST_PER_JOB=5.0
# Monthly budget limit (USD)
QUANTUM_MONTHLY_BUDGET=1000.0

# Resource Limits
HASH_MAX_ITERATIONS=10000000  # Limited by quantum coherence time
HASH_MAX_MEMORY_MB=4096

# Auto-registration
HASH_AUTO_REGISTER=true
HASH_WORKERS_CONTRACT=anim1hash_workers_contract_address

# Research Mode
# Enable experimental features
QUANTUM_RESEARCH_MODE=false
# Log quantum state vectors (for debugging)
QUANTUM_LOG_STATE_VECTORS=false
# Save circuit diagrams
QUANTUM_SAVE_CIRCUITS=true
QUANTUM_CIRCUIT_DIR=/var/lib/animica/quantum_circuits/
