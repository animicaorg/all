{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animica.org/schema/wallets_json.schema.json",
  "title": "Animica Wallet Store",
  "type": "object",
  "required": ["format", "version", "created_at", "updated_at", "wallets"],
  "properties": {
    "format": { "const": "animica.wallets" },
    "version": { "const": 2 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "default": { "type": ["string", "null"] },
    "wallets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "address", "alg_id", "public_key_hex", "created_at"],
        "properties": {
          "label": { "type": "string" },
          "address": { "type": "string" },
          "alg_id": { "type": "integer" },
          "alg_name": { "type": "string" },
          "public_key_hex": { "type": "string" },
          "created_at": { "type": "string" },
          "pub_fingerprint": { "type": "string" },
          "private_key_enc": { "type": "string" },
          "keystore": { "type": "object" },
          "meta": { "type": "object" },
          "secret_key_hex": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
