NODE_ENV=development
USDAN_API_HOST=0.0.0.0
USDAN_API_PORT=8098
USDAN_API_LOG_LEVEL=info
USDAN_API_JWT_SECRET=replace-with-strong-secret
USDAN_API_ADMIN_API_KEY=replace-with-admin-api-key
USDAN_API_WEBHOOK_SECRET=replace-with-webhook-secret
USDAN_API_RATE_LIMIT_WINDOW_MS=60000
USDAN_API_RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/usdan

ANIMICA_RPC_URL=http://127.0.0.1:8545/rpc
ANIMICA_CHAIN_ID=1337
ANIMICA_USDAN_TOKEN_ADDRESS=anim1_usdan_token
ANIMICA_USDAN_MINT_CONTROLLER_ADDRESS=anim1_usdan_mint_controller
ANIMICA_USDAN_REDEMPTION_CONTROLLER_ADDRESS=anim1_usdan_redemption_controller
ANIMICA_MINT_SIGNER_PRIVATE_KEY=replace-with-mint-signer-private-key
ANIMICA_MIN_CONFIRMATIONS=6

MODERN_TREASURY_BASE_URL=https://app.moderntreasury.com
MODERN_TREASURY_API_KEY=replace-with-modern-treasury-api-key
MODERN_TREASURY_ORG_ID=replace-with-org-id
MODERN_TREASURY_LEDGER_ID=replace-with-ledger-id
MODERN_TREASURY_WEBHOOK_SECRET=replace-with-modern-treasury-webhook-secret
MODERN_TREASURY_SOURCE_ACCOUNT_ID=replace-with-source-account-id
MODERN_TREASURY_PAYOUT_ACCOUNT_ID=replace-with-payout-account-id

USDAN_RESERVE_ATTESTATION_CONTRACT=anim1_usdan_reserve_attestation
USDAN_RESERVE_MIN_COVERAGE_BPS=10000
USDAN_KYC_PROVIDER=internal
USDAN_NOTIFICATIONS_FROM_EMAIL=noreply@usdan.animica
