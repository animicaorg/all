// This is your Prisma schema file for the Animica CEX Exchange API
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserRole {
  USER
  ADMIN
  OPS
  COMPLIANCE
}

enum AdminRole {
  SUPERADMIN
  OPS
  COMPLIANCE
  SUPPORT
  READONLY
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum RiskFlagStatus {
  OPEN
  CLOSED
}

enum RiskFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum KycProvider {
  BITGO
  SUMSUB
  MANUAL
  NONE
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  REVIEW
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
}

enum NetworkKind {
  UTXO
  EVM
  SOLANA
  ANIMICA
  OTHER
}

enum AssetKind {
  NATIVE
  TOKEN
}

enum WalletPurpose {
  HOT
  WARM
  COLD
  TREASURY
  FEE
}

enum WalletProvider {
  BITGO
  LOCAL_ANIMICA
  OTHER
}

enum DepositAddressStatus {
  ACTIVE
  ROTATED
  DISABLED
}

enum MarketStatus {
  ONLINE
  HALTED
  READONLY
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
  STOP_LIMIT
  STOP_MARKET
}

enum TimeInForce {
  GTC
  IOC
  FOK
  POST_ONLY
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
  EXPIRED
}

enum OrderEventType {
  CREATED
  ACCEPTED
  PARTIAL_FILL
  FILLED
  CANCELED
  REJECTED
  EXPIRED
  REPLACED
}

enum LedgerAccountOwnerType {
  USER
  SYSTEM
}

enum LedgerAccountType {
  AVAILABLE
  LOCKED
  FEE
  CLEARING
  HOT_WALLET
  COLD_WALLET
  INSURANCE
}

enum LedgerTransactionType {
  DEPOSIT_CREDIT
  WITHDRAWAL_DEBIT
  TRADE_SETTLE
  FEE_CHARGE
  TRANSFER
  ADJUSTMENT
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum DepositStatus {
  DETECTED
  CONFIRMED
  CREDITED
  REORGED
  FAILED
}

enum DepositSource {
  BITGO
  ANIMICA_NODE
  MANUAL
}

enum WithdrawalStatus {
  REQUESTED
  RISK_REVIEW
  APPROVED
  SIGNING
  BROADCAST
  CONFIRMED
  FAILED
  CANCELED
}

enum WithdrawalProvider {
  BITGO
  ANIMICA_NODE
  MANUAL
}

enum WithdrawalApprovalAction {
  APPROVE
  REJECT
}

enum FeeScope {
  GLOBAL
  USER_TIER
  MARKET
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum BitgoEnvironment {
  TEST
  PROD
}

enum AdminActionType {
  LOGIN
  LOGOUT
  CREATE_ADMIN
  UPDATE_ADMIN
  DELETE_ADMIN
  FREEZE_USER
  UNFREEZE_USER
  APPROVE_KYC
  REJECT_KYC
  REQUEST_KYC_INFO
  HALT_MARKET
  RESUME_MARKET
  CANCEL_ALL_ORDERS
  UPDATE_MARKET_CONTROLS
  CREATE_FEE_SCHEDULE
  UPDATE_FEE_SCHEDULE
  UPDATE_FEE_OVERRIDE
  APPROVE_WITHDRAWAL
  DENY_WITHDRAWAL
  FORCE_RETRY_WITHDRAWAL
  CREATE_INCIDENT
  FREEZE_MARKET_INCIDENT
  FREEZE_USER_INCIDENT
  PAUSE_WITHDRAWALS
  REPLAY_EVENTS
}

enum IdempotencyScope {
  DEPOSIT
  WITHDRAWAL
  TRADE_SETTLE
  WEBHOOK
}

// ============================================================================
// USERS & AUTH
// ============================================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique @db.Citext
  phone        String?    @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  role         UserRole   @default(USER)
  twofaEnabled Boolean    @default(false) @map("twofa_enabled")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  profile             UserProfile?
  apiKeys             ApiKey[]
  sessions            Session[]
  kycCases            KycCase[]
  depositAddresses    UserDepositAddress[]
  orders              Order[]
  takerTrades         Trade[]              @relation("TakerTrades")
  makerTrades         Trade[]              @relation("MakerTrades")
  ledgerAccounts      LedgerAccount[]
  deposits            Deposit[]
  withdrawals         Withdrawal[]
  withdrawalApprovals WithdrawalApproval[]
  auditLogs           AuditLog[]
  kycCaseReviews      KycCase[]            @relation("KycReviewer")
  riskFlags           RiskFlag[]

  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name")
  country     String?
  region      String?
  legalName   String?  @map("legal_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  keyId       String    @unique @map("key_id")
  secretHash  String    @map("secret_hash")
  scopes      Json      @default("[]")
  ipAllowlist Json?     @map("ip_allowlist")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// KYC / AML
// ============================================================================

model KycCase {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  provider       KycProvider
  status         KycStatus   @default(NOT_STARTED)
  riskTier       RiskTier?   @map("risk_tier")
  submittedAt    DateTime?   @map("submitted_at") @db.Timestamptz(3)
  reviewedAt     DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  reviewerUserId String?     @map("reviewer_user_id") @db.Uuid
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User?         @relation("KycReviewer", fields: [reviewerUserId], references: [id])
  documents KycDocument[]

  @@index([userId])
  @@index([status])
  @@map("kyc_cases")
}

model KycDocument {
  id         String   @id @default(uuid()) @db.Uuid
  kycCaseId  String   @map("kyc_case_id") @db.Uuid
  docType    String   @map("doc_type")
  storageRef String   @map("storage_ref")
  sha256     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  kycCase KycCase @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)

  @@index([kycCaseId])
  @@map("kyc_documents")
}

// ============================================================================
// ASSETS / NETWORKS / WALLETS
// ============================================================================

model Network {
  id                    String      @id @default(uuid()) @db.Uuid
  code                  String      @unique
  kind                  NetworkKind
  chainId               String?     @map("chain_id")
  rpcUrl                String?     @map("rpc_url")
  confirmationsRequired Int         @default(6) @map("confirmations_required")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  assetNetworks AssetNetwork[]
  wallets       Wallet[]

  @@map("networks")
}

model Asset {
  id        String    @id @default(uuid()) @db.Uuid
  symbol    String    @unique
  name      String
  decimals  Int
  kind      AssetKind
  isEnabled Boolean   @default(true) @map("is_enabled")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  assetNetworks  AssetNetwork[]
  baseMarkets    Market[]        @relation("BaseAsset")
  quoteMarkets   Market[]        @relation("QuoteAsset")
  ledgerAccounts LedgerAccount[]
  trades         Trade[]
  feeSchedules   FeeSchedule[]

  @@map("assets")
}

model AssetNetwork {
  id                String  @id @default(uuid()) @db.Uuid
  assetId           String  @map("asset_id") @db.Uuid
  networkId         String  @map("network_id") @db.Uuid
  contractAddress   String? @map("contract_address")
  depositEnabled    Boolean @default(true) @map("deposit_enabled")
  withdrawalEnabled Boolean @default(true) @map("withdrawal_enabled")
  minWithdrawal     Decimal @map("min_withdrawal") @db.Decimal(38, 18)
  withdrawalFee     Decimal @map("withdrawal_fee") @db.Decimal(38, 18)

  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  depositAddresses UserDepositAddress[]
  deposits         Deposit[]
  withdrawals      Withdrawal[]

  @@unique([assetId, networkId])
  @@index([assetId])
  @@index([networkId])
  @@map("asset_networks")
}

model Wallet {
  id          String         @id @default(uuid()) @db.Uuid
  networkId   String         @map("network_id") @db.Uuid
  purpose     WalletPurpose
  provider    WalletProvider
  providerRef String         @map("provider_ref")
  address     String?
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  assignedAddresses UserDepositAddress[]

  @@index([networkId])
  @@index([provider, providerRef])
  @@map("wallets")
}

model UserDepositAddress {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  assetNetworkId   String               @map("asset_network_id") @db.Uuid
  address          String
  tag              String?
  assignedWalletId String?              @map("assigned_wallet_id") @db.Uuid
  status           DepositAddressStatus @default(ACTIVE)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id], onDelete: Cascade)
  wallet       Wallet?      @relation(fields: [assignedWalletId], references: [id])

  @@unique([assetNetworkId, address, tag])
  @@index([userId])
  @@index([assetNetworkId])
  @@map("user_deposit_addresses")
}

// ============================================================================
// MARKETS
// ============================================================================

model Market {
  id           String       @id @default(uuid()) @db.Uuid
  symbol       String       @unique
  baseAssetId  String       @map("base_asset_id") @db.Uuid
  quoteAssetId String       @map("quote_asset_id") @db.Uuid
  status       MarketStatus @default(ONLINE)
  priceTick    Decimal      @map("price_tick") @db.Decimal(38, 18)
  sizeStep     Decimal      @map("size_step") @db.Decimal(38, 18)
  minOrderSize Decimal      @map("min_order_size") @db.Decimal(38, 18)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  baseAsset  Asset @relation("BaseAsset", fields: [baseAssetId], references: [id], onDelete: Restrict)
  quoteAsset Asset @relation("QuoteAsset", fields: [quoteAssetId], references: [id], onDelete: Restrict)

  orders        Order[]
  trades        Trade[]
  feeSchedules  FeeSchedule[]
  candles       Candle[]
  marketControl MarketControl?

  @@unique([baseAssetId, quoteAssetId])
  @@index([status])
  @@map("markets")
}

// ============================================================================
// ORDERS / TRADES
// ============================================================================

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  marketId      String      @map("market_id") @db.Uuid
  side          OrderSide
  type          OrderType
  timeInForce   TimeInForce @map("time_in_force")
  status        OrderStatus @default(OPEN)
  price         Decimal?    @db.Decimal(38, 18)
  size          Decimal     @db.Decimal(38, 18)
  filledSize    Decimal     @default(0) @map("filled_size") @db.Decimal(38, 18)
  remainingSize Decimal     @map("remaining_size") @db.Decimal(38, 18)
  avgFillPrice  Decimal     @default(0) @map("avg_fill_price") @db.Decimal(38, 18)
  clientOrderId String?     @map("client_order_id")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  canceledAt    DateTime?   @map("canceled_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  events      OrderEvent[]
  takerTrades Trade[]      @relation("TakerOrder")
  makerTrades Trade[]      @relation("MakerOrder")

  @@unique([userId, marketId, clientOrderId])
  @@index([marketId, status, createdAt])
  @@index([userId, status])
  @@map("orders")
}

model OrderEvent {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @map("order_id") @db.Uuid
  type      OrderEventType
  payload   Json
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Trade {
  id             String   @id @default(uuid()) @db.Uuid
  marketId       String   @map("market_id") @db.Uuid
  takerOrderId   String   @map("taker_order_id") @db.Uuid
  makerOrderId   String   @map("maker_order_id") @db.Uuid
  takerUserId    String   @map("taker_user_id") @db.Uuid
  makerUserId    String   @map("maker_user_id") @db.Uuid
  price          Decimal  @db.Decimal(38, 18)
  size           Decimal  @db.Decimal(38, 18)
  quoteAmount    Decimal  @map("quote_amount") @db.Decimal(38, 18)
  makerFeeAmount Decimal  @map("maker_fee_amount") @db.Decimal(38, 18)
  takerFeeAmount Decimal  @map("taker_fee_amount") @db.Decimal(38, 18)
  feeAssetId     String   @map("fee_asset_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  market     Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  takerOrder Order  @relation("TakerOrder", fields: [takerOrderId], references: [id], onDelete: Cascade)
  makerOrder Order  @relation("MakerOrder", fields: [makerOrderId], references: [id], onDelete: Cascade)
  takerUser  User   @relation("TakerTrades", fields: [takerUserId], references: [id], onDelete: Cascade)
  makerUser  User   @relation("MakerTrades", fields: [makerUserId], references: [id], onDelete: Cascade)
  feeAsset   Asset  @relation(fields: [feeAssetId], references: [id], onDelete: Restrict)

  @@unique([marketId, takerOrderId, makerOrderId, createdAt])
  @@index([marketId, createdAt])
  @@index([takerUserId])
  @@index([makerUserId])
  @@map("trades")
}

// ============================================================================
// DOUBLE-ENTRY LEDGER
// ============================================================================

model LedgerAccount {
  id          String                 @id @default(uuid()) @db.Uuid
  ownerType   LedgerAccountOwnerType @map("owner_type")
  ownerId     String?                @map("owner_id") @db.Uuid
  accountType LedgerAccountType      @map("account_type")
  assetId     String                 @map("asset_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  entries      LedgerEntry[]
  balanceCache BalanceCache?

  @@unique([ownerType, ownerId, accountType, assetId])
  @@index([ownerId, assetId])
  @@index([accountType])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  type           LedgerTransactionType
  externalRef    String?               @map("external_ref")
  idempotencyKey String?               @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@index([type, createdAt])
  @@index([externalRef])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String         @id @default(uuid()) @db.Uuid
  ledgerTransactionId String         @map("ledger_transaction_id") @db.Uuid
  accountId           String         @map("account_id") @db.Uuid
  direction           EntryDirection
  amount              Decimal        @db.Decimal(38, 18)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([ledgerTransactionId])
  @@map("ledger_entries")
}

model BalanceCache {
  accountId String   @id @map("account_id") @db.Uuid
  available Decimal  @default(0) @db.Decimal(38, 18)
  locked    Decimal  @default(0) @db.Decimal(38, 18)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("balances_cache")
}

// ============================================================================
// DEPOSITS / WITHDRAWALS
// ============================================================================

model Deposit {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  assetNetworkId  String        @map("asset_network_id") @db.Uuid
  address         String
  tag             String?
  txid            String
  amount          Decimal       @db.Decimal(38, 18)
  status          DepositStatus @default(DETECTED)
  detectedAt      DateTime?     @map("detected_at") @db.Timestamptz(3)
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  creditedAt      DateTime?     @map("credited_at") @db.Timestamptz(3)
  confirmations   Int           @default(0)
  blockHash       String?       @map("block_hash")
  blockHeight     BigInt?       @map("block_height")
  source          DepositSource
  providerEventId String?       @unique @map("provider_event_id")
  idempotencyKey  String?       @unique @map("idempotency_key")
  raw             Json?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id], onDelete: Cascade)

  @@unique([assetNetworkId, txid, address, tag])
  @@index([userId, status])
  @@index([assetNetworkId, txid])
  @@index([status])
  @@map("deposits")
}

model Withdrawal {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  assetNetworkId     String             @map("asset_network_id") @db.Uuid
  destinationAddress String             @map("destination_address")
  destinationTag     String?            @map("destination_tag")
  amount             Decimal            @db.Decimal(38, 18)
  feeAmount          Decimal            @map("fee_amount") @db.Decimal(38, 18)
  status             WithdrawalStatus   @default(REQUESTED)
  requestedAt        DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  approvedAt         DateTime?          @map("approved_at") @db.Timestamptz(3)
  broadcastAt        DateTime?          @map("broadcast_at") @db.Timestamptz(3)
  confirmedAt        DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  txid               String?
  provider           WithdrawalProvider
  providerRef        String?            @map("provider_ref")
  idempotencyKey     String?            @unique @map("idempotency_key")
  riskScore          Decimal?           @map("risk_score") @db.Decimal(5, 2)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id], onDelete: Cascade)

  approvals WithdrawalApproval[]

  @@index([userId, status])
  @@index([status])
  @@index([assetNetworkId])
  @@map("withdrawals")
}

model WithdrawalApproval {
  id              String                   @id @default(uuid()) @db.Uuid
  withdrawalId    String                   @map("withdrawal_id") @db.Uuid
  approverUserId  String?                  @map("approver_user_id") @db.Uuid
  approverAdminId String?                  @map("approver_admin_id") @db.Uuid
  action          WithdrawalApprovalAction
  note            String?
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  withdrawal    Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  approverUser  User?      @relation(fields: [approverUserId], references: [id], onDelete: Cascade)
  approverAdmin Admin?     @relation("AdminWithdrawalApprover", fields: [approverAdminId], references: [id])

  @@unique([withdrawalId, approverUserId])
  @@unique([withdrawalId, approverAdminId])
  @@index([withdrawalId])
  @@map("withdrawal_approvals")
}

// ============================================================================
// FEES
// ============================================================================

model FeeSchedule {
  id                    String    @id @default(uuid()) @db.Uuid
  scope                 FeeScope
  name                  String?
  userId                String?   @map("user_id") @db.Uuid
  marketId              String?   @map("market_id") @db.Uuid
  makerBps              Int       @map("maker_bps")
  takerBps              Int       @map("taker_bps")
  withdrawalFeeOverride Decimal?  @map("withdrawal_fee_override") @db.Decimal(38, 18)
  rulesJson             Json?     @map("rules_json")
  status                String    @default("active")
  effectiveFrom         DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo           DateTime? @map("effective_to") @db.Timestamptz(3)
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  market  Market? @relation(fields: [marketId], references: [id], onDelete: Cascade)
  asset   Asset?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Admin?  @relation("FeeScheduleCreator", fields: [createdBy], references: [id])

  @@index([scope, effectiveFrom, effectiveTo])
  @@index([userId])
  @@index([marketId])
  @@map("fee_schedules")
}

// ============================================================================
// AUDIT & IDEMPOTENCY
// ============================================================================

model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  actorAdminId String?        @map("actor_admin_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  action       String
  entityType   String         @map("entity_type")
  entityId     String?        @map("entity_id")
  requestId    String?        @map("request_id")
  ip           String?        @db.Inet
  userAgent    String?        @map("user_agent")
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  actor      User?  @relation(fields: [actorUserId], references: [id])
  actorAdmin Admin? @relation(fields: [actorAdminId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([actorAdminId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model IdempotencyKey {
  key         String           @id
  scope       IdempotencyScope
  requestHash String           @map("request_hash")
  response    Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz(3)

  @@index([scope, createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// CANDLES (OHLCV Data)
// ============================================================================

enum CandleInterval {
  ONE_MINUTE
  FIVE_MINUTES
  FIFTEEN_MINUTES
  ONE_HOUR
  FOUR_HOURS
  ONE_DAY
}

model Candle {
  id          String         @id @default(uuid()) @db.Uuid
  marketId    String         @map("market_id") @db.Uuid
  interval    CandleInterval
  openTime    DateTime       @map("open_time") @db.Timestamptz(3)
  closeTime   DateTime       @map("close_time") @db.Timestamptz(3)
  open        Decimal        @db.Decimal(36, 18)
  high        Decimal        @db.Decimal(36, 18)
  low         Decimal        @db.Decimal(36, 18)
  close       Decimal        @db.Decimal(36, 18)
  volume      Decimal        @db.Decimal(36, 18)
  quoteVolume Decimal?       @map("quote_volume") @db.Decimal(36, 18)
  trades      Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  market Market @relation(fields: [marketId], references: [id])

  @@unique([marketId, interval, openTime])
  @@index([marketId, interval, openTime])
  @@map("candles")
}

// ============================================================================
// API NONCE TRACKING (for replay protection)
// ============================================================================

model ApiNonce {
  id        String   @id @default(uuid()) @db.Uuid
  apiKeyId  String   @map("api_key_id") @db.Uuid
  nonce     String
  timestamp BigInt
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([apiKeyId, nonce])
  @@index([apiKeyId, timestamp])
  @@index([expiresAt])
  @@map("api_nonces")
}

// ============================================================================
// ADMIN SYSTEM
// ============================================================================

model Admin {
  id                  String      @id @default(uuid()) @db.Uuid
  email               String      @unique @db.Citext
  passwordHash        String      @map("password_hash")
  totpSecretEncrypted String?     @map("totp_secret_encrypted")
  role                AdminRole
  status              AdminStatus @default(ACTIVE)
  lastLoginAt         DateTime?   @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             AdminSession[]
  auditLogs            AuditLog[]
  bitgoConfigsUpdated  BitgoConfig[]
  riskFlagsCreated     RiskFlag[]
  marketControlUpdates MarketControl[]
  feeSchedulesCreated  FeeSchedule[]        @relation("FeeScheduleCreator")
  withdrawalApprovals  WithdrawalApproval[] @relation("AdminWithdrawalApprover")
  incidentsCreated     Incident[]           @relation("IncidentCreator")
  incidentActions      IncidentAction[]

  @@map("admins")
}

model BitgoConfig {
  id                     String           @id @default("default")
  environment            BitgoEnvironment @default(TEST)
  baseUrl                String?          @map("base_url")
  accessTokenEncrypted   String?          @map("access_token_encrypted")
  webhookSecretEncrypted String?          @map("webhook_secret_encrypted")
  wallets                Json?
  coins                  Json?
  enabled                Boolean          @default(false)
  updatedBy              String?          @map("updated_by") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updater Admin? @relation(fields: [updatedBy], references: [id])

  @@map("bitgo_configs")
}

model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminId          String    @map("admin_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip               String?   @db.Inet
  userAgent        String?   @map("user_agent")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model RiskFlag {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  code      String
  severity  RiskFlagSeverity
  note      String?          @db.Text
  status    RiskFlagStatus   @default(OPEN)
  createdBy String           @map("created_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt  DateTime?        @map("closed_at") @db.Timestamptz(3)

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Admin @relation(fields: [createdBy], references: [id])

  @@index([userId, status])
  @@index([code])
  @@index([createdAt])
  @@map("risk_flags")
}

model MarketControl {
  id                 String   @id @default(uuid()) @db.Uuid
  marketId           String   @unique @map("market_id") @db.Uuid
  tradingEnabled     Boolean  @default(true) @map("trading_enabled")
  depositsEnabled    Boolean  @default(true) @map("deposits_enabled")
  withdrawalsEnabled Boolean  @default(true) @map("withdrawals_enabled")
  reason             String?  @db.Text
  updatedBy          String   @map("updated_by") @db.Uuid
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  market  Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  updater Admin  @relation(fields: [updatedBy], references: [id])

  @@map("market_controls")
}

model Incident {
  id         String           @id @default(uuid()) @db.Uuid
  title      String
  severity   RiskFlagSeverity
  status     IncidentStatus   @default(OPEN)
  createdBy  String           @map("created_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime?        @map("resolved_at") @db.Timestamptz(3)
  closedAt   DateTime?        @map("closed_at") @db.Timestamptz(3)

  creator Admin            @relation("IncidentCreator", fields: [createdBy], references: [id])
  actions IncidentAction[]

  @@index([status, createdAt])
  @@map("incidents")
}

model IncidentAction {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String    @map("incident_id") @db.Uuid
  action      String
  payload     Json?
  status      String
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  creator  Admin    @relation(fields: [createdBy], references: [id])

  @@index([incidentId, createdAt])
  @@map("incident_actions")
}
