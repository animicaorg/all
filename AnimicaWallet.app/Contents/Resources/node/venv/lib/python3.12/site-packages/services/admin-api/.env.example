# Database Configuration (shared with exchange-api)
DATABASE_URL="postgresql://user:password@localhost:5432/exchange_api?schema=public"

# Node Environment
NODE_ENV="development"

# Service Configuration
SERVICE_NAME="admin-api"
LOG_LEVEL="info"

# HTTP Server
HTTP_PORT=4000
HTTP_HOST="0.0.0.0"

# Redis Configuration (for rate limiting and sessions)
REDIS_URL="redis://localhost:6379/1"

# Authentication
JWT_SECRET="your-admin-jwt-secret-here"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="7d"
SESSION_SECRET="your-session-secret-here"

# TOTP Configuration
TOTP_ISSUER="Animica Admin"
TOTP_WINDOW=2

# CSRF Protection
CSRF_SECRET="your-csrf-secret-here"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=300000
RATE_LIMIT_ADMIN_PER_SESSION=60
RATE_LIMIT_ADMIN_WINDOW_MS=60000

# CORS
ADMIN_WEB_URL="http://localhost:5173"
CORS_CREDENTIALS=true

# External Services
EXCHANGE_API_URL="http://localhost:3000"
MATCHING_ENGINE_URL="http://localhost:3100"
LEDGER_SERVICE_URL="http://localhost:3200"
BITGO_API_URL="https://app.bitgo-test.com/api/v2"
BITGO_ACCESS_TOKEN="your-bitgo-token"
ANIMICA_NODE_URL="http://localhost:8545"

# Withdrawal Approval Policy
WITHDRAWAL_APPROVAL_TIER_1_LIMIT=10000
WITHDRAWAL_APPROVAL_TIER_1_REQUIRED=2
WITHDRAWAL_APPROVAL_TIER_2_LIMIT=100000
WITHDRAWAL_APPROVAL_TIER_2_REQUIRED=3
WITHDRAWAL_APPROVAL_TIER_3_REQUIRED=3
WITHDRAWAL_APPROVAL_REQUIRE_SUPERADMIN_ABOVE=100000
