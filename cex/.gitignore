# CEX .gitignore

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
v8-compile-cache-*/

# Environment files
.env
.env.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE - User-specific settings only
# Keep shared workspace configs (.vscode/extensions.json, etc.) for team consistency
.vscode/settings.json
.vscode/.ropeproject
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries
.idea/shelf
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp
