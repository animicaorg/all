# Service Configuration
SERVICE_NAME=bitgo-webhook-ingestor
PORT=3003
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cex

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# BitGo Configuration
# Get these from BitGo dashboard: https://www.bitgo.com
BITGO_WEBHOOK_SECRET=your-webhook-secret-here
BITGO_API_TOKEN=your-api-token-here
BITGO_ENV=test

# Rate Limiting
WEBHOOK_RATE_LIMIT_PER_MINUTE=100
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# Background Jobs
CONFIRMATION_BACKFILL_INTERVAL_MS=60000
OUTBOX_PROCESSOR_INTERVAL_MS=5000

# Admin API
ADMIN_KEY=your-admin-secret-key

# Ledger Service Integration
LEDGER_SERVICE_URL=http://localhost:3002
LEDGER_SERVICE_NATS_SUBJECT=ledger.deposit.credit
