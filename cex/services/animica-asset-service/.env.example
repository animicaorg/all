# Service Configuration
SERVICE_NAME=animica-asset-service
PORT=3007
LOG_LEVEL=info
NODE_ENV=production

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=cex
DB_PASSWORD=your-db-password
DB_NAME=cex

# Animica RPC Configuration
ANIMICA_RPC_URL=http://127.0.0.1:8545/rpc
ANIMICA_NETWORK=mainnet
ANIMICA_ASSET_NETWORK_ID=ffffffff-0006-0006-0006-000000000006

# Confirmation Settings
ANIMICA_CONFIRMATIONS_REQUIRED=20
ANIMICA_SCAN_START_HEIGHT=0
ANIMICA_SCAN_BATCH=200
ANIMICA_SCAN_POLL_MS=2000
ANIMICA_MAX_REORG_DEPTH=200

# Wallet Configuration
ANIMICA_WALLET_MODE=hotwallet
ANIMICA_HOT_WALLET_LABEL=exchange_hot
ANIMICA_HOT_WALLET_ADDRESS=anim1...

# Fee Configuration
ANIMICA_FEE_POLICY=dynamic
ANIMICA_FEE_RATE_ATOMS_PER_BYTE=1000000000
ANIMICA_MIN_FEE_ATOMS=1000000000000000
ANIMICA_MAX_FEE_ATOMS=100000000000000000

# Integration
LEDGER_SERVICE_URL=http://localhost:3002
ADMIN_API_KEY=your-secret-admin-key

# Background Processing
SCAN_WORKER_INTERVAL_MS=5000
WITHDRAWAL_POLL_INTERVAL_MS=30000
RECONCILE_INTERVAL_MS=300000

# RPC Client Settings
RPC_TIMEOUT_MS=30000
RPC_MAX_RETRIES=3
RPC_RETRY_DELAY_MS=1000

# Leader Election
SCAN_LOCK_TTL_MS=30000
INSTANCE_ID=animica-prod-1
