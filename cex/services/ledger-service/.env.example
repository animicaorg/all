# Service Configuration
SERVICE_NAME=ledger-service
PORT=3003
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cex

# NATS
NATS_URL=nats://localhost:4222

# Redis (optional, for distributed locks)
REDIS_URL=redis://localhost:6379

# Admin API (set to enable authentication on admin endpoints)
# ADMIN_KEY=your-secret-admin-key-here

# Reconciliation
AUTO_FIX_BALANCES=false
RECONCILE_INTERVAL_MS=86400000  # 24 hours
HEALTH_CHECK_INTERVAL_MS=60000  # 1 minute
