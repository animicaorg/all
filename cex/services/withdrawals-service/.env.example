# Service Configuration
SERVICE_NAME=withdrawals-service
PORT=3003
LOG_LEVEL=info

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cex_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379

# NATS Configuration (currently unused but required by common package)
NATS_URL=nats://localhost:4222

# BitGo Configuration
BITGO_ENV=test
BITGO_ACCESS_TOKEN=your_bitgo_access_token_here
BITGO_WEBHOOK_SECRET=your_webhook_secret_here
# BITGO_BASE_URL is optional - defaults based on BITGO_ENV
# BITGO_BASE_URL=https://app.bitgo-test.com

# Ledger Service Integration
LEDGER_SERVICE_URL=http://localhost:3002

# Admin Authentication
ADMIN_API_KEY=your_admin_api_key_here

# Background Processing Configuration
OUTBOX_WORKER_INTERVAL_MS=5000
POLL_PENDING_INTERVAL_MS=60000

# Rate Limiting
WITHDRAWAL_REQUEST_RATE_LIMIT=5

# JWT Configuration (optional - for production JWT auth)
# JWT_SECRET=your_jwt_secret_here
