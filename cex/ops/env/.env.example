DB_USER=cex
DB_PASSWORD=cex_password
# ⚠️  SECURITY WARNING: Change this password in production!
# Use a strong, unique password. Consider using a password generator.
# Example: openssl rand -base64 32
DB_NAME=cex_exchange
# For Docker Compose: use service name 'postgres'
# For local PostgreSQL: use 'localhost' and ensure the DB_USER role exists
DB_HOST=postgres
DB_PORT=5432
# DSN used by services that consume a single PostgreSQL URL.
DATABASE_URL=postgresql://cex:cex_password@postgres:5432/cex_exchange

REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222

API_GATEWAY_PORT=3000
ADMIN_SERVICE_PORT=4000
AUTH_SERVICE_PORT=3005
MATCHING_ENGINE_PORT=3006
LEDGER_SERVICE_PORT=3007
WALLET_ROUTER_PORT=3008
BITGO_INGESTOR_PORT=3002
ANIMICA_INDEXER_PORT=3009
RISK_SERVICE_PORT=3010

BITGO_ENV=test
BITGO_ACCESS_TOKEN=dev-token
BITGO_WEBHOOK_SECRET=dev-webhook-secret
BITGO_BASE_URL=https://app.bitgo-test.com
# Shared admin API key for internal admin routes in local development.
ADMIN_API_KEY=dev-admin-key

ANIMICA_RPC_URL=http://localhost:8545
