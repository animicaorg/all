# =============================================================================
# CEX Configuration Template
# For production: Use secrets manager and never commit real credentials
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=cex
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=cex
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# -----------------------------------------------------------------------------
# Redis & Message Queue
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
NATS_URL=nats://nats:4222

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=3000
ADMIN_SERVICE_PORT=3001
BITGO_INGESTOR_PORT=3002
AUTH_SERVICE_PORT=3003
MATCHING_ENGINE_PORT=3004
LEDGER_SERVICE_PORT=3005
WALLET_ROUTER_PORT=3006
ANIMICA_INDEXER_PORT=3007
RISK_SERVICE_PORT=3008

# -----------------------------------------------------------------------------
# Service Authentication (Internal)
# -----------------------------------------------------------------------------
# Generate unique keys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVICE_AUTH_KEYRING=key1:GENERATE_ME_BASE64_KEY
API_SIGNING_KEYS=apikey1:GENERATE_ME_BASE64_KEY

# -----------------------------------------------------------------------------
# Authentication & Sessions
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
TOTP_ISSUER=Animica Exchange
TOTP_WINDOW=1
TOTP_ENCRYPTION_KEY=CHANGE_ME_TOTP_ENCRYPTION_KEY_BASE64

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
NODE_ENV=production
SECURE_COOKIES=true
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
WITHDRAWAL_ADDRESS_COOLDOWN_HOURS=24

# -----------------------------------------------------------------------------
# BitGo Configuration
# -----------------------------------------------------------------------------
BITGO_ENV=sandbox
BITGO_ACCESS_TOKEN=CHANGE_ME_BITGO_TOKEN
BITGO_WEBHOOK_SECRET=CHANGE_ME_BITGO_WEBHOOK_SECRET
BITGO_BASE_URL=https://app.bitgo-test.com
BITGO_MIN_APPROVERS=2
BITGO_HIGH_VALUE_THRESHOLD_USD=10000

# -----------------------------------------------------------------------------
# Animica Node
# -----------------------------------------------------------------------------
ANIMICA_RPC_URL=http://127.0.0.1:8545/rpc
ANIMICA_WALLET_PASSPHRASE=CHANGE_ME_WALLET_PASSPHRASE

# -----------------------------------------------------------------------------
# Compliance
# -----------------------------------------------------------------------------
DEFAULT_DAILY_LIMIT_NO_KYC=1000
DEFAULT_DAILY_LIMIT_KYC=50000
TRAVEL_RULE_THRESHOLD=3000
FEATURE_2FA_REQUIRED_ADMINS=true
FEATURE_WITHDRAWAL_ADDRESS_BOOK=true

# -----------------------------------------------------------------------------
# Secrets Provider (env, aws, gcp)
# -----------------------------------------------------------------------------
SECRETS_PROVIDER=env
# AWS_REGION=us-east-1
# AWS_SECRETS_PREFIX=prod/exchange/
# GCP_PROJECT_ID=my-project
# GCP_SECRETS_PREFIX=prod-exchange-
