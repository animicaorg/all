# =============================================================================
# CEX Development Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file with real credentials

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=cex
DB_PASSWORD=cex_dev_password
DB_NAME=cex_exchange
DB_SSL=false
DATABASE_URL=postgresql://cex:cex_dev_password@postgres:5432/cex_exchange

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# NATS Configuration
# -----------------------------------------------------------------------------
NATS_URL=nats://nats:4222
NATS_CLUSTER_ID=cex-cluster
NATS_CLIENT_ID=cex-client

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3100
AUTH_SERVICE_URL=http://auth-service:3100
MATCHING_ENGINE_PORT=3200
LEDGER_SERVICE_PORT=3300
WALLET_ROUTER_PORT=3400
ANIMICA_INDEXER_PORT=3500
ANIMICA_ASSET_PORT=3600
RISK_SERVICE_PORT=3700
WITHDRAWALS_SERVICE_PORT=3800
ADMIN_SERVICE_PORT=3001
BITGO_INGESTOR_PORT=3002

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRY=1d

# Session configuration
SESSION_SECRET=dev-session-secret-change-in-production
SESSION_MAX_AGE=86400000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# -----------------------------------------------------------------------------
# Blockchain / Animica Configuration
# -----------------------------------------------------------------------------
ANIMICA_RPC_URL=http://localhost:8545
ANIMICA_CHAIN_ID=1337
ANIMICA_NETWORK=devnet

# Block scanner configuration
SCANNER_POLL_INTERVAL_MS=5000
SCANNER_CONFIRMATIONS=6

# -----------------------------------------------------------------------------
# BitGo Configuration (External Custody)
# -----------------------------------------------------------------------------
BITGO_ENV=test
BITGO_ACCESS_TOKEN=your-bitgo-test-token
BITGO_WEBHOOK_SECRET=your-webhook-secret
BITGO_BASE_URL=https://app.bitgo-test.com

# -----------------------------------------------------------------------------
# Email Configuration (MailHog for dev)
# -----------------------------------------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@cex.local
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Storage Configuration (MinIO for dev)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cex-backups
S3_REGION=us-east-1
S3_USE_SSL=false

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090

# OpenTelemetry (Optional)
OTLP_ENABLED=false
OTLP_ENDPOINT=http://otel-collector:4318

# -----------------------------------------------------------------------------
# Security & Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# API key for admin operations
ADMIN_API_KEY=dev-admin-key-change-in-production

# -----------------------------------------------------------------------------
# Trading Configuration
# -----------------------------------------------------------------------------
# Fee structure (basis points, 10 = 0.1%)
MAKER_FEE_BPS=10
TAKER_FEE_BPS=20

# Order limits
MAX_ORDER_SIZE=1000000
MIN_ORDER_SIZE=1

# -----------------------------------------------------------------------------
# Risk Management
# -----------------------------------------------------------------------------
# Daily withdrawal limits (in USD equivalent)
DAILY_WITHDRAWAL_LIMIT=100000
WITHDRAWAL_APPROVAL_THRESHOLD=10000

# KYC levels
KYC_LEVEL_1_DAILY_LIMIT=1000
KYC_LEVEL_2_DAILY_LIMIT=10000
KYC_LEVEL_3_DAILY_LIMIT=100000

# -----------------------------------------------------------------------------
# Worker Configuration
# -----------------------------------------------------------------------------
# Candle aggregation intervals (in seconds)
CANDLE_INTERVALS=60,300,900,3600,86400

# Job queue settings
JOB_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_MS=5000

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Enable debug endpoints
DEBUG_ENDPOINTS_ENABLED=true

# Seed database on startup
SEED_ON_STARTUP=false

# Auto-migrate on startup (dev only)
AUTO_MIGRATE=false
