# =============================================================================
# CEX Production Environment Configuration
# =============================================================================
# IMPORTANT: Replace all placeholder values with secure production values
# Store sensitive values in secrets management system (Vault, AWS Secrets Manager, etc.)

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=cex_prod
DB_PASSWORD=${SECRET_DB_PASSWORD}
DB_NAME=cex_exchange_prod
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DATABASE_URL=postgresql://${DB_USER}:${SECRET_DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require

# Connection pool
DB_POOL_MIN=10
DB_POOL_MAX=50

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${SECRET_REDIS_PASSWORD}
REDIS_URL=redis://:${SECRET_REDIS_PASSWORD}@redis:6379
REDIS_TLS=true

# -----------------------------------------------------------------------------
# NATS Configuration
# -----------------------------------------------------------------------------
NATS_URL=nats://nats:4222
NATS_CLUSTER_ID=cex-prod-cluster
NATS_CLIENT_ID=cex-prod-client
NATS_TOKEN=${SECRET_NATS_TOKEN}

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

JWT_SECRET=${SECRET_JWT_SECRET}
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

SESSION_SECRET=${SECRET_SESSION_SECRET}
SESSION_MAX_AGE=3600000
SESSION_SECURE=true
SESSION_SAME_SITE=strict

# CORS origins (comma-separated, production domains only)
CORS_ORIGINS=https://exchange.animica.io,https://admin.animica.io

# -----------------------------------------------------------------------------
# Blockchain / Animica Configuration
# -----------------------------------------------------------------------------
ANIMICA_RPC_URL=https://rpc.animica.io
ANIMICA_CHAIN_ID=1
ANIMICA_NETWORK=mainnet

SCANNER_POLL_INTERVAL_MS=10000
SCANNER_CONFIRMATIONS=12

# -----------------------------------------------------------------------------
# BitGo Configuration
# -----------------------------------------------------------------------------
BITGO_ENV=prod
BITGO_ACCESS_TOKEN=${SECRET_BITGO_TOKEN}
BITGO_WEBHOOK_SECRET=${SECRET_BITGO_WEBHOOK_SECRET}
BITGO_BASE_URL=https://app.bitgo.com

# -----------------------------------------------------------------------------
# Email Configuration (Production SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=${SECRET_SMTP_HOST}
SMTP_PORT=587
SMTP_SECURE=true
SMTP_FROM=noreply@animica.io
SMTP_USER=${SECRET_SMTP_USER}
SMTP_PASSWORD=${SECRET_SMTP_PASSWORD}

# -----------------------------------------------------------------------------
# Storage Configuration (S3)
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY=${SECRET_S3_ACCESS_KEY}
S3_SECRET_KEY=${SECRET_S3_SECRET_KEY}
S3_BUCKET=animica-cex-prod-backups
S3_REGION=us-east-1
S3_USE_SSL=true

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090

OTLP_ENABLED=true
OTLP_ENDPOINT=https://otlp.animica.io

# Sentry for error tracking
SENTRY_DSN=${SECRET_SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Security & Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_REDIS_PREFIX=rl:

ADMIN_API_KEY=${SECRET_ADMIN_API_KEY}

# Content Security Policy
CSP_ENABLED=true

# -----------------------------------------------------------------------------
# Trading Configuration
# -----------------------------------------------------------------------------
MAKER_FEE_BPS=5
TAKER_FEE_BPS=10

MAX_ORDER_SIZE=10000000
MIN_ORDER_SIZE=1

# Circuit breaker for extreme volatility
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_PRICE_CHANGE_THRESHOLD=0.2

# -----------------------------------------------------------------------------
# Risk Management
# -----------------------------------------------------------------------------
DAILY_WITHDRAWAL_LIMIT=1000000
WITHDRAWAL_APPROVAL_THRESHOLD=50000
WITHDRAWAL_AUTO_APPROVAL_LIMIT=1000

KYC_LEVEL_1_DAILY_LIMIT=5000
KYC_LEVEL_2_DAILY_LIMIT=50000
KYC_LEVEL_3_DAILY_LIMIT=1000000

# AML/Compliance
CHAINALYSIS_API_KEY=${SECRET_CHAINALYSIS_KEY}
SANCTIONS_CHECK_ENABLED=true

# -----------------------------------------------------------------------------
# Worker Configuration
# -----------------------------------------------------------------------------
CANDLE_INTERVALS=60,300,900,3600,14400,86400

JOB_CONCURRENCY=10
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_MS=10000

# -----------------------------------------------------------------------------
# High Availability
# -----------------------------------------------------------------------------
HEALTH_CHECK_INTERVAL=30000
GRACEFUL_SHUTDOWN_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=animica-cex-prod-backups

# -----------------------------------------------------------------------------
# Production Safeguards
# -----------------------------------------------------------------------------
DEBUG_ENDPOINTS_ENABLED=false
SEED_ON_STARTUP=false
AUTO_MIGRATE=false
