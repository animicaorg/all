{
  "name": "cex",
  "private": true,
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "migrate": "pnpm --filter @cex/db migrate",
    "seed": "pnpm --filter @cex/db seed",
    "postinstall": "pnpm --filter @cex/common build",
    "ports:check": "bash ./scripts/port_check.sh"
  },
  "pnpm": {
    "overrides": {
      "@google-cloud/secret-manager": "^6.1.1",
      "esbuild": "0.27.2",
      "@esbuild/*": "0.27.2",
      "pino": "9.14.0"
    }
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
