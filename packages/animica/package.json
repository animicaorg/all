{
  "name": "animica",
  "version": "0.1.12",
  "description": "Animica meta-package. Installing `animica` pulls in the full Animica toolchain and exposes a single `animica` CLI that routes to animica-node and animica-agent.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "animica": "./bin/animica.mjs"
  },
  "files": [
    "bin/animica.mjs",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "smoke": "node ./bin/animica.mjs --help",
    "prepack": "npm run smoke"
  },
  "dependencies": {
    "@animica/agent-core": "^0.1.11",
    "@animica/agent-sdk": "^0.1.11",
    "@animica/agent-ui": "^0.1.11",
    "animica-agent": "^0.1.11",
    "animica-node": "^0.1.11"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/animica/animica.git",
    "directory": "packages/animica"
  },
  "keywords": [
    "animica",
    "meta",
    "bundle",
    "agent",
    "full-node",
    "cli"
  ]
}
