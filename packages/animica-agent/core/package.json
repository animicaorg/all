{
  "name": "@animica/agent-core",
  "version": "0.1.0",
  "description": "Core library for the Animica Coding Agent: config, RPC, patches, repo and miner adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./safe-json": {
      "types": "./dist/safe-json.d.ts",
      "import": "./dist/safe-json.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./patches": {
      "types": "./dist/patches.d.ts",
      "import": "./dist/patches.js"
    },
    "./miner": {
      "types": "./dist/miner.d.ts",
      "import": "./dist/miner.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/animica/animica.git",
    "directory": "packages/animica-agent/core"
  },
  "keywords": ["animica", "agent", "blockchain", "rpc", "miner"]
}
