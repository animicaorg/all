# Animica Hash Worker Configuration - GPU Backend
# Copy this file to .env and customize for your environment

# RPC Configuration
ANIMICA_RPC_URL=http://localhost:8545
ANIMICA_CHAIN_ID=1337

# Backend Configuration
HASH_BACKEND_TYPE=gpu
HASH_BACKEND_CONFIG='{"cuda_device": 0, "threads_per_block": 256, "blocks_per_grid": 1024}'

# Worker Identity
HASH_WORKER_ADDRESS=anim1your_worker_address_here

# Operational Settings
HASH_POLL_INTERVAL=5.0
HASH_STATE_FILE=/var/lib/animica/hash_worker_gpu_state.json
HASH_MAX_CONCURRENT_JOBS=4  # GPUs can handle more concurrent jobs

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/animica/hash_worker_gpu.log

# GPU-Specific Settings
# CUDA device ID (use nvidia-smi to find)
GPU_DEVICE_ID=0
# CUDA compute capability (e.g., "8.6" for RTX 3090)
GPU_COMPUTE_CAPABILITY=8.6

# Memory Settings
# GPU memory limit (MB)
HASH_GPU_MEMORY_MB=8192
# Use pinned memory for faster transfers
HASH_USE_PINNED_MEMORY=true

# Algorithm Support
# Some algorithms are better suited for GPU
HASH_ENABLE_SHA256=true
HASH_ENABLE_SHA256D=true
HASH_ENABLE_SCRYPT=false  # Memory-hard, not ideal for GPU
HASH_ENABLE_BLAKE2B=true

# Performance
# Kernel launch configuration
GPU_KERNEL_LAUNCH_CONFIG='{"sha256": {"threads": 256, "blocks": 2048}}'

# Thermal Management
# Shutdown if GPU temp exceeds threshold (Celsius)
GPU_MAX_TEMP=85
# Target fan speed (%)
GPU_FAN_SPEED=70

# Resource Limits
HASH_MAX_ITERATIONS=1000000000  # Higher for GPU
HASH_MAX_MEMORY_MB=8192

# Auto-registration
HASH_AUTO_REGISTER=true
HASH_WORKERS_CONTRACT=anim1hash_workers_contract_address
