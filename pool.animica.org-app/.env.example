# pool.animica.org/app — rig rental marketplace. Copy to /etc/animica/pool-rental.env
# (systemd EnvironmentFile) and fill in. Never commit real secrets.

NODE_ENV=production
PORT=3020
PUBLIC_BASE_URL=https://pool.animica.org/app
COOKIE_DOMAIN=pool.animica.org

# Postgres (provision with deploy/provision-db.sh → container on 127.0.0.1:5438)
DATABASE_URL=postgresql://pool_rental:CHANGE_ME@127.0.0.1:5438/pool_rental?schema=public

# Session cookie signing (>= 32 bytes). Generate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_32_BYTES_MIN

# NOWPayments — start in SANDBOX, flip to false for prod.
NOWPAYMENTS_SANDBOX=true
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_PUBLIC_CALLBACK_URL=https://pool.animica.org/app/api/webhooks/nowpayments
NOWPAYMENTS_SUCCESS_URL=https://pool.animica.org/app/rental/success
NOWPAYMENTS_CANCEL_URL=https://pool.animica.org/app/rental/cancel

# Magic-link email — reuse the Gmail SMTP from /etc/animica/chat.env.
MAIL_DRIVER=smtp
MAIL_FROM=Animica Rig Rental <animicaorg@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=animicaorg@gmail.com
SMTP_PASS=

# Pool rental engine (server-to-server, HMAC). The SAME secret must also be
# set in /etc/animica/pool.env so the pool's require_rental_auth accepts us.
POOL_API_BASE_URL=http://127.0.0.1:8550
POOL_RENTAL_SHARED_SECRET=CHANGE_ME_16_BYTES_MIN

# Marketplace economics
MARKETPLACE_FEE_PERCENT=5
RIG_OFFLINE_GRACE_SECONDS=600
QUOTE_TTL_SECONDS=600

# Comma-separated admin emails
ADMIN_EMAILS=ai@3vdc.com

# Worker
WORKER_TICK_MS=10000
