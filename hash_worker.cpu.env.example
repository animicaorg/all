# Animica Hash Worker Configuration - CPU Backend
# Copy this file to .env and customize for your environment

# RPC Configuration
ANIMICA_RPC_URL=http://localhost:8545
ANIMICA_CHAIN_ID=1337

# Backend Configuration
HASH_BACKEND_TYPE=cpu
HASH_BACKEND_CONFIG={}

# Worker Identity
HASH_WORKER_ADDRESS=anim1your_worker_address_here

# Operational Settings
HASH_POLL_INTERVAL=5.0  # Seconds between job checks
HASH_STATE_FILE=/var/lib/animica/hash_worker_cpu_state.json
HASH_MAX_CONCURRENT_JOBS=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/animica/hash_worker_cpu.log

# Performance Tuning (CPU-specific)
# Number of threads (default: all CPU cores)
# HASH_CPU_THREADS=8

# Algorithm Support
# Enable/disable specific algorithms
# HASH_ENABLE_SHA256=true
# HASH_ENABLE_SHA256D=true
# HASH_ENABLE_SCRYPT=true
# HASH_ENABLE_BLAKE2B=true

# Resource Limits
# Max iterations per job (safety limit)
HASH_MAX_ITERATIONS=100000000
# Max memory per job (MB)
HASH_MAX_MEMORY_MB=2048

# Auto-registration (optional)
# Automatically register worker on startup
# HASH_AUTO_REGISTER=true
# HASH_WORKERS_CONTRACT=anim1hash_workers_contract_address
