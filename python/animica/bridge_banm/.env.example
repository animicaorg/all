# Core service
DATABASE_URL=postgresql+psycopg://animica:animica@postgres:5432/banm_bridge
BANM_BRIDGE_API_HOST=0.0.0.0
BANM_BRIDGE_API_PORT=8660
BANM_BRIDGE_PUBLIC_BASE_URL=http://localhost:5177
BANM_BRIDGE_ADMIN_TOKEN_SECRET=replace-with-strong-secret
BANM_BRIDGE_WORKER_ENABLED=true
BANM_BRIDGE_WORKER_POLL_INTERVAL_SECONDS=5

# Animica
ANIMICA_RPC_URL=http://animica-node:8545/rpc
ANIMICA_BRIDGE_CUSTODY_ADDRESS=anim1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANIMICA_BRIDGE_CUSTODY_KEY_REF=wallet:bridge-custody
ANIMICA_CONFIRMATIONS_REQUIRED=6
ANIMICA_RELEASE_CONFIRM_POLICY=confirmed

# EVM / BNB Chain
EVM_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
EVM_CHAIN_ID=97
EVM_BANM_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
EVM_BRIDGE_CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000000
EVM_BRIDGE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
EVM_BRIDGE_DEPOSIT_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
EVM_BRIDGE_OPERATOR_KEY_REF=env:EVM_OPERATOR_PRIVATE_KEY
EVM_OPERATOR_PRIVATE_KEY=0x
EVM_CONFIRMATIONS_REQUIRED=12

# Order/security controls
ORDER_EXPIRY_MINUTES=30
ENABLE_CLAIM_CODE_CONFIRMATION=false
REQUIRE_EVM_SIGNATURES=true
ENABLE_ANIMICA_SIGNATURES_IF_AVAILABLE=false
BRIDGE_PAUSED=false
BRIDGE_PAUSED_FORWARD=false
BRIDGE_PAUSED_REVERSE=false

# Limits/caps/fees
MIN_ORDER_AMOUNT_ANM=10000000
MAX_ORDER_AMOUNT_ANM=1000000000000
MIN_ORDER_AMOUNT_BANM=10000000000000000
MAX_ORDER_AMOUNT_BANM=1000000000000000000000000
DAILY_MINT_CAP_BANM=10000000000000000000000000
DAILY_RELEASE_CAP_ANM=10000000000000
BRIDGE_FEE_BPS_FORWARD=25
BRIDGE_FEE_BPS_REVERSE=25

