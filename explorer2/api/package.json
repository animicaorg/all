{
  "name": "@animica/explorer2-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "wait-on ../shared/dist/index.js && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "backfill:confirmed-txs": "tsx src/backfillConfirmedTxs.ts --missing-fields"
  },
  "dependencies": {
    "@animica/explorer2-shared": "workspace:*",
    "bech32": "^2.0.0",
    "better-sqlite3": "^11.10.0",
    "cbor": "^10.0.11",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "pino": "^9.14.0",
    "pino-http": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.24",
    "@types/supertest": "^6.0.3",
    "supertest": "^6.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
