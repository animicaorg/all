[Unit]
Description=ENA LLM Inference Service
After=network.target

[Service]
Type=simple
User=ena
Group=ena
WorkingDirectory=/opt/ena
EnvironmentFile=/etc/ena/ena.env
ExecStart=/usr/bin/python3 -m ena.services.ena_node.main
Restart=on-failure
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ena

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ena-node

[Install]
WantedBy=multi-user.target
