# ENA Service Configuration

# Animica RPC endpoint
ENA_RPC_URL=https://mainnet.animica.org/rpc

# ENA service address (receives payments)
ENA_SERVICE_ADDRESS=anim1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq000000

# AICF (AI Compute Fund) Configuration
ENA_AICF_ADDRESS=anim1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq111111
ENA_AICF_BP=2500                 # Basis points (2500 = 25% of total fee)
ENA_REQUIRE_AICF=true            # Hard requirement in production (false only for dev/testing)

# Payment mode: per_call_tx (pay per call) or credit (deposit ledger)
ENA_PAYMENT_MODE=per_call_tx

# Pricing (in base units: 1 ANM = 1e9 base units)
ENA_FEE_PER_CALL=10000000        # 0.01 ANM per call (base fee)
ENA_FEE_PER_TOKEN=1000           # 0.000001 ANM per output token
ENA_MIN_FEE_PER_CALL=10000000    # Minimum total fee user must pay

# Database path
ENA_DB_PATH=./ena_data/ena.db

# Default model
ENA_DEFAULT_MODEL=ena.tiny.v1

# Admin token for protected endpoints
ENA_ADMIN_TOKEN=change_me_in_production

# Server configuration
ENA_HOST=0.0.0.0
ENA_PORT=8080

# Rate limiting
ENA_RATE_LIMIT_PER_ADDRESS=100   # requests per hour
ENA_RATE_LIMIT_PER_IP=200        # requests per hour

# Circuit breaker
ENA_CIRCUIT_BREAKER_THRESHOLD=5  # failures before opening
ENA_CIRCUIT_BREAKER_TIMEOUT=60   # seconds before retry

# Development mode (NEVER use in production!)
# ENA_DEV_MODE=0

# Logging
ENA_LOG_LEVEL=INFO
ENA_LOG_FILE=./ena_data/ena.log

# Model paths
ENA_MODELS_DIR=./ena/models

# Prompt limits
ENA_MAX_PROMPT_LENGTH=2000
ENA_MAX_TOKENS_PER_CALL=500

# RPC timeouts
ENA_RPC_TIMEOUT=30
ENA_RPC_MAX_RETRIES=3
ENA_RPC_RETRY_BACKOFF=2
