{
  "name": "animica-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "sdk",
    "packages/shared/*",
    "packages/sdk/*",
    "packages/animica-agent/*",
    "packages/animica-node",
    "packages/animica",
    "website",
    "explorer-web",
    "studio-web",
    "apps/aicf-web",
    "apps/aicf-provider",
    "apps/aicf-api",
    "apps/aicf-docs",
    "wallet",
    "apps/miner-dashboard",
    "apps/dapp-ide",
    "apps/admin-web",
    "apps/animica-tokens",
    "apps/banm-bridge-web",
    "apps/banm-bridge-admin",
    "evm/banm-bridge",
    "explorer2",
    "explorer2/*",
    "services/exchange-api",
    "services/scheduler",
    "services/job-worker",
    "services/usage-meter",
    "services/provider-control-plane",
    "services/dispute-worker",
    "services/treasury-worker",
    "services/contract-job-watcher",
    "services/fulfillment-scheduler",
    "services/result-submitter",
    "services/finalization-worker",
    "services/admin-api",
    "services/usdan-api",
    "apps/usdan-web",
    "provider-daemon"
  ],
  "pnpm": {
    "overrides": {
      "@animica/sdk": "workspace:*",
      "@google-cloud/secret-manager": "^6.1.1"
    }
  },
  "dependencies": {
    "dotenv": "file:vendor/dotenv"
  },
  "devDependencies": {
    "browserslist": "^4.28.1",
    "chokidar": "^3.6.0",
    "tsx": "^4.20.6"
  }
}
