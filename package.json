{
  "name": "animica-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "sdk",
    "website",
    "explorer-web",
    "studio-web",
    "wallet",
    "apps/miner-dashboard",
    "apps/admin-web",
    "explorer2",
    "explorer2/*",
    "services/exchange-api",
    "services/admin-api"
  ],
  "pnpm": {
    "overrides": {
      "@animica/sdk": "workspace:*"
    }
  },
  "dependencies": {
    "dotenv": "file:vendor/dotenv"
  },
  "devDependencies": {
    "browserslist": "^4.28.1",
    "chokidar": "^3.6.0",
    "tsx": "^4.20.6"
  }
}
