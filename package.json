{
  "name": "animica-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "sdk",
    "website",
    "explorer-web",
    "studio-web",
    "wallet",
    "apps/miner-dashboard",
    "apps/dapp-ide",
    "apps/admin-web",
    "apps/animica-tokens",
    "apps/banm-bridge-web",
    "apps/banm-bridge-admin",
    "evm/banm-bridge",
    "explorer2",
    "explorer2/*",
    "services/exchange-api",
    "services/admin-api",
    "services/usdan-api",
    "apps/usdan-web"
  ],
  "pnpm": {
    "overrides": {
      "@animica/sdk": "workspace:*",
      "@google-cloud/secret-manager": "^6.1.1"
    }
  },
  "dependencies": {
    "dotenv": "file:vendor/dotenv"
  },
  "devDependencies": {
    "browserslist": "^4.28.1",
    "chokidar": "^3.6.0",
    "tsx": "^4.20.6"
  }
}
