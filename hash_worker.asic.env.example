# Animica Hash Worker Configuration - ASIC Backend
# Copy this file to .env and customize for your environment

# RPC Configuration
ANIMICA_RPC_URL=http://localhost:8545
ANIMICA_CHAIN_ID=1337

# Backend Configuration
HASH_BACKEND_TYPE=asic
HASH_BACKEND_CONFIG='{"device_id": "antminer_s19", "api_endpoint": "http://192.168.1.100:4028"}'

# Worker Identity
HASH_WORKER_ADDRESS=anim1your_worker_address_here

# Operational Settings
HASH_POLL_INTERVAL=2.0  # ASICs are fast, check more frequently
HASH_STATE_FILE=/var/lib/animica/hash_worker_asic_state.json
HASH_MAX_CONCURRENT_JOBS=1  # ASICs are specialized, one job at a time

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/animica/hash_worker_asic.log

# ASIC-Specific Settings
# Device type and model
ASIC_DEVICE_MODEL=antminer_s19_pro
ASIC_FIRMWARE_VERSION=latest

# API Configuration (for supported devices)
# CGMiner/BFGMiner API endpoint
ASIC_API_HOST=192.168.1.100
ASIC_API_PORT=4028
ASIC_API_TIMEOUT=10

# Algorithm Support
# Most ASICs are algorithm-specific
HASH_ENABLE_SHA256=true
HASH_ENABLE_SHA256D=true
HASH_ENABLE_SCRYPT=false  # Only if Scrypt ASIC
HASH_ENABLE_BLAKE2B=false

# Performance Monitoring
# Expected hashrate (H/s) for health checks
ASIC_EXPECTED_HASHRATE=110000000000000  # 110 TH/s for S19 Pro
# Alert if hashrate drops below percentage
ASIC_MIN_HASHRATE_PCT=90

# Power Management
# Max power consumption (watts)
ASIC_MAX_POWER_WATTS=3250
# Power efficiency target (J/TH)
ASIC_POWER_EFFICIENCY_TARGET=29.5

# Cooling
# Fan control (auto/manual)
ASIC_FAN_MODE=auto
# Manual fan speed (%)
# ASIC_FAN_SPEED=80
# Shutdown temperature (Celsius)
ASIC_MAX_TEMP=80

# Pool Configuration (if using pool mode)
# Backup pool settings for when no jobs available
# ASIC_BACKUP_POOL_URL=stratum+tcp://pool.example.com:3333
# ASIC_BACKUP_POOL_USER=worker_name
# ASIC_BACKUP_POOL_PASS=x

# Resource Limits
HASH_MAX_ITERATIONS=1000000000000  # Very high for ASICs
HASH_MAX_MEMORY_MB=256  # ASICs have limited memory

# Auto-registration
HASH_AUTO_REGISTER=true
HASH_WORKERS_CONTRACT=anim1hash_workers_contract_address

# Watchdog
# Restart worker if stuck
WATCHDOG_ENABLED=true
WATCHDOG_TIMEOUT=300  # Seconds
