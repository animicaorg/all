# Animica MCP server — configuration
# Get an API key at https://pool.animica.org
ANIMICA_API_KEY=anm_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Inference API (OpenAI-compatible). Default is the live broker.
ANIMICA_BASE_URL=https://pool.animica.org/v1
ANIMICA_MODEL=anm-fast-8b
ANIMICA_CODE_MODEL=anm-code-7b

# Provider / mining side (the supply tools). Defaults are the live pool.
ANIMICA_POOL_URL=https://pool.animica.org
ANIMICA_STRATUM_URL=stratum+tcp://pool.animica.org:3333

# Transport: stdio (default, for Claude Desktop/Cursor) or http (hosted remote)
# MCP_TRANSPORT=http
# PORT=8765

# Optional: override per-model pricing (USD per 1M tokens) used by animica_price_quote
# ANIMICA_PRICING_JSON={"anm-fast-8b":{"in":0.10,"out":0.30}}
