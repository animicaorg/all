{
  "name": "animica-mcp",
  "version": "0.1.0",
  "description": "Animica MCP server — lets AI agents (Claude, Cursor, Windsurf, custom) discover and use Animica's OpenAI-compatible AI inference, code generation, embeddings, and agent tools.",
  "type": "module",
  "license": "MIT",
  "bin": { "animica-mcp": "dist/server.js" },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm src/server.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.21"
  },
  "engines": { "node": ">=18" }
}
