# Animica node environment configuration
# Set to true when running a bootstrap-only node that should not reach out to
# the default public RPC endpoint.
ANIMICA_BOOTSTRAP_NODE=false

# Optional: override the bootstrap RPC endpoint (leave blank to disable when
# ANIMICA_BOOTSTRAP_NODE=true).
ANIMICA_BOOTSTRAP_RPC_URL=

# Mining portal / public Stratum overrides
ANIMICA_STRATUM_BIND=0.0.0.0:3333
ANIMICA_POOL_API_BIND=0.0.0.0:8550
ANIMICA_PUBLIC_STRATUM_HOST=
ANIMICA_PUBLIC_STRATUM_PORT=
ANIMICA_PUBLIC_STRATUM_URL=
ANIMICA_PUBLIC_STRATUM_SCHEME=stratum+tcp
ANIMICA_PUBLIC_STRATUM_TLS_ENABLED=false
ANIMICA_PUBLIC_POOL_API_URL=
ANIMICA_MINING_DOWNLOAD_DIR=
ANIMICA_MINING_DOWNLOAD_BASE_URL=
ANIMICA_POOL_ENABLED=true
ANIMICA_POOL_FEE_PERCENT=
ANIMICA_POOL_PAYOUT_MINIMUM=
