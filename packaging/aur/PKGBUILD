# Maintainer: Animica <ai@3vdc.com>
#
# AUR package for the Animica blockchain CLI (PyPI `animica`).
#
# HONESTY NOTES (read before flagging on AUR):
#  * Name: this uses `animica` (an end-user application suite). If AUR
#    moderators prefer library naming it can be resubmitted as
#    `python-animica` with `animica` as a provides= alias.
#  * Upstream declares ~60 runtime Python deps INCLUDING the full AI stack
#    (torch, transformers, diffusers, ...) as base deps by design. Arch has no
#    packages for several of them (animica-fastpow, trl, pyloudnorm, ...) and
#    packaging that whole tree faithfully is impractical. depends=() below
#    lists the subset needed for the node/RPC/CLI core, which was empirically
#    verified: a venv with exactly this set boots `python -m rpc` on mainnet
#    (genesis chainId=1) and serves /healthz. Everything else is listed in
#    optdepends= and imported lazily by the code (the miner/AI paths fall back
#    or error out with a clear message when an extra is missing).
#  * python-installer will emit warnings about missing dist-info deps at
#    runtime only if you run `pip check`; pacman does not enforce Python
#    metadata, so the lazy-optdepends approach works.
#  * .SRCINFO was written BY HAND because makepkg is unavailable on the build
#    host (Ubuntu). Regenerate with `makepkg --printsrcinfo > .SRCINFO` on a
#    real Arch box before pushing (see NOTES.md).

pkgname=animica
pkgver=9.0.8
pkgrel=1
pkgdesc="Post-quantum L1 blockchain CLI: node, wallet, miner, contracts, useful-work jobs"
arch=('any')
url="https://animica.org"
license=('Apache-2.0')
depends=(
  'python'
  'python-typer'
  'python-rich'
  'python-httpx'
  'python-pydantic'
  'python-yaml'
  'python-cbor2'
  'python-cryptography'
  'python-requests'
  'python-fastapi'
  'python-starlette'
  'python-prometheus-client'
  'uvicorn'
)
optdepends=(
  'python-sqlalchemy: bridge/EVM-relayer database features'
  'python-alembic: bridge database migrations'
  'python-psycopg: bridge PostgreSQL support'
  'python-web3: EVM bridge client'
  'python-pytorch: AI/ENA training, GPU mining fallback scanner, media provider'
  'python-transformers: AI serving and ENA jobs'
  'python-safetensors: AI model loading'
  'python-scipy: ENA training math'
  'python-pillow: generative media provider'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-wheel'
  'python-hatchling'
)
# Predictable PyPI source URL (verified live: 302s to the exact hashed
# artifact ...packages/e6/26/54dc.../animica-9.0.8.tar.gz). sha256 computed
# from the downloaded artifact; matches https://pypi.org/pypi/animica/json
source=("https://files.pythonhosted.org/packages/source/a/animica/animica-$pkgver.tar.gz")
sha256sums=('429a4c270f33847cb1d0954dae2dea2e13b3830199a55eddb76e14d36e1fc712')

build() {
  cd "$srcdir/animica-$pkgver"
  # The sdist carries a custom hatch_build.py that injects the vendored node
  # packages (rpc/, consensus/, core/, p2p/, ...) from _build_vendor/ into the
  # wheel; --no-isolation is fine because hatchling is in makedepends.
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/animica-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
