# /etc/animica/quw.env — Animica Quantum Useful Work node config
# Contributor wallet that earns ProofType.QUANTUM credit.
ANIMICA_QUW_ADDRESS=anim1youraddrxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Node RPC to submit to (a local or remote Animica node). Leave blank for single-node/local.
ANIMICA_QUW_RPC_URL=http://127.0.0.1:8545/rpc
# Attestation signer: yubihsm2 | tpm2 | software (software = NON-ATTESTED, no quantum reward)
ANIMICA_QUW_SIGNER=yubihsm2
# Bytes of entropy per contribution and seconds between rounds.
ANIMICA_QUW_BYTES=8192
ANIMICA_QUW_INTERVAL=30
# YubiHSM 2 (PKCS#11) — required when ANIMICA_QUW_SIGNER=yubihsm2
ANIMICA_QUW_PKCS11_MODULE=/usr/lib/x86_64-linux-gnu/pkcs11/yubihsm_pkcs11.so
ANIMICA_QUW_PKCS11_PIN=0001password
# Quantis device override (else auto-detected: /dev/qrandom0,/dev/quantis0,...)
# ANIMICA_QUW_QUANTIS_DEVICE=/dev/qrandom0
