# Animica mainnet placeholder defaults
ANIMICA_NETWORK=mainnet
ANIMICA_RPC_URL=http://0.0.0.0:10545/rpc
ANIMICA_RPC_HOST=0.0.0.0
ANIMICA_RPC_PORT=10545
ANIMICA_DATA_ROOT=${ANIMICA_DATA_ROOT:-$HOME/.animica}
ANIMICA_RPC_DB_URI=${ANIMICA_RPC_DB_URI:-sqlite:///${ANIMICA_DATA_ROOT}/chain-1/animica.db}
ANIMICA_MINING_POOL_DB_URL=${ANIMICA_MINING_POOL_DB_URL:-sqlite:///${ANIMICA_DATA_ROOT}/chain-1/pool.db}
ANIMICA_STRATUM_BIND=0.0.0.0:5333
ANIMICA_POOL_API_BIND=0.0.0.0:10550
ANIMICA_MINING_POOL_LOG_LEVEL=info
