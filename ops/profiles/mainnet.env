# Animica mainnet production defaults.
# The public mining pool endpoint is raw TCP Stratum on pool.animica.org:3333.
ANIMICA_NETWORK=mainnet
ANIMICA_CHAIN_ID=1

# Local node bind and local RPC client URL. Keep the client URL on loopback;
# ANIMICA_RPC_HOST controls the public bind for the node process.
ANIMICA_RPC_URL=http://127.0.0.1:8545/rpc
ANIMICA_RPC_HOST=0.0.0.0
ANIMICA_RPC_PORT=8545

ANIMICA_DATA_ROOT=${ANIMICA_DATA_ROOT:-${HOME:-/root}/.animica}
ANIMICA_RPC_DB_URI=${ANIMICA_RPC_DB_URI:-sqlite:///${ANIMICA_DATA_ROOT}/chain-1/animica.db}
ANIMICA_MINING_POOL_DB_URL=${ANIMICA_MINING_POOL_DB_URL:-sqlite:///${ANIMICA_DATA_ROOT}/chain-1/pool.db}
ANIMICA_P2P_DATA_DIR=${ANIMICA_P2P_DATA_DIR:-${ANIMICA_DATA_ROOT}/chain-1/p2p}
ANIMICA_PEER_STORE_PATH=${ANIMICA_PEER_STORE_PATH:-${ANIMICA_P2P_DATA_DIR}}

# Public pool contract. The deployment script also exports ANIMICA_* aliases
# for the backend and pool-web API responses.
POOL_HOST=pool.animica.org
STRATUM_HOST=0.0.0.0
STRATUM_PORT=3333
PUBLIC_STRATUM_URL=pool.animica.org:3333

ANIMICA_STRATUM_BIND=${STRATUM_HOST}:${STRATUM_PORT}
ANIMICA_STRATUM_HOST=${STRATUM_HOST}
ANIMICA_STRATUM_PORT=${STRATUM_PORT}
ANIMICA_PUBLIC_DOMAIN=${POOL_HOST}
ANIMICA_PUBLIC_STRATUM_HOST=${POOL_HOST}
ANIMICA_PUBLIC_STRATUM_PORT=${STRATUM_PORT}
ANIMICA_PUBLIC_STRATUM_URL=stratum+tcp://${PUBLIC_STRATUM_URL}
ANIMICA_PUBLIC_STRATUM_SCHEME=stratum+tcp

# Pool API is consumed through Nginx at https://pool.animica.org/api and /v1.
ANIMICA_POOL_API_BIND=127.0.0.1:8550
ANIMICA_PUBLIC_POOL_API_URL=https://pool.animica.org
ANIMICA_POOL_ENABLED=1
ANIMICA_POOL_MODE=${ANIMICA_POOL_MODE:-pps}
ANIMICA_POOL_PROFILE=${ANIMICA_POOL_PROFILE:-hashshare}
ANIMICA_MINING_POOL_LOG_LEVEL=info
