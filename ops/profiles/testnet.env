# Animica testnet placeholder defaults
ANIMICA_NETWORK=testnet
ANIMICA_RPC_URL=http://127.0.0.1:9545/rpc
ANIMICA_RPC_HOST=0.0.0.0
ANIMICA_RPC_PORT=9545
ANIMICA_DATA_ROOT=${ANIMICA_DATA_ROOT:-$HOME/.animica}
ANIMICA_RPC_DB_URI=${ANIMICA_RPC_DB_URI:-sqlite:///${ANIMICA_DATA_ROOT}/chain-2/animica.db}
ANIMICA_MINING_POOL_DB_URL=${ANIMICA_MINING_POOL_DB_URL:-sqlite:///${ANIMICA_DATA_ROOT}/chain-2/pool.db}
ANIMICA_P2P_DATA_DIR=${ANIMICA_P2P_DATA_DIR:-${ANIMICA_DATA_ROOT}/chain-2/p2p}
ANIMICA_PEER_STORE_PATH=${ANIMICA_PEER_STORE_PATH:-${ANIMICA_P2P_DATA_DIR}}
ANIMICA_STRATUM_BIND=0.0.0.0:4333
ANIMICA_POOL_API_BIND=0.0.0.0:9550
ANIMICA_MINING_POOL_LOG_LEVEL=info
