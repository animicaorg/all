FROM node:20-alpine AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /app/
COPY apps/banm-bridge-web /app/apps/banm-bridge-web
RUN corepack enable && pnpm install --filter @animica/banm-bridge-web... --frozen-lockfile=false
RUN pnpm --filter @animica/banm-bridge-web build

FROM nginx:1.27-alpine
COPY ops/docker/banm-bridge/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/banm-bridge-web/dist /usr/share/nginx/html
COPY ops/docker/banm-bridge/entrypoint-web.sh /entrypoint-web.sh
RUN chmod +x /entrypoint-web.sh
EXPOSE 80
ENTRYPOINT ["/entrypoint-web.sh"]

