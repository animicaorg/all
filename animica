#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CLI_PATH="$ROOT_DIR/.venv/bin/animica"

# Prefer the venv-installed entrypoint if present.
if [[ -x "$CLI_PATH" ]]; then
  exec "$CLI_PATH" "$@"
fi

# If animica is on PATH (system install), delegate to it.
if command -v animica >/dev/null 2>&1; then
  exec animica "$@"
fi

# Fallback: run the module directly with repo on PYTHONPATH.
PYTHON_BIN="${PYTHON:-${PYTHON3:-}}"
if [[ -z "$PYTHON_BIN" ]]; then
  PYTHON_BIN="$(command -v python3 || true)"
fi
if [[ -z "$PYTHON_BIN" ]]; then
  PYTHON_BIN="$(command -v python || true)"
fi
if [[ -z "$PYTHON_BIN" ]]; then
  echo "animica: could not locate python interpreter" >&2
  exit 127
fi
export PYTHONPATH="$ROOT_DIR/python:$ROOT_DIR:${PYTHONPATH:-}"
exec "$PYTHON_BIN" -m animica.cli.main "$@"
