#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CLI_PATH="$ROOT_DIR/.venv/bin/animica"

# Prefer the venv-installed entrypoint if present.
if [[ -x "$CLI_PATH" ]]; then
  exec "$CLI_PATH" "$@"
fi

# If animica is on PATH (system install), delegate to it.
if command -v animica >/dev/null 2>&1; then
  exec animica "$@"
fi

echo "animica: CLI entrypoint not found. Run ./setup.sh --with-pq to install .venv/bin/animica." >&2
exit 127
