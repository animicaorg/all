{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Animica Wallet"
  },
  "author": "Animica Labs",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "content/bridge.js",
        "content/inject.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'self'"
  },
  "default_locale": "en",
  "description": "PQ-secure browser wallet for Animica: keyring, in-page provider (window.animica), approvals, and simulation.",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "split",
  "manifest_version": 3,
  "minimum_chrome_version": "108",
  "name": "Animica Wallet",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "short_name": "Animica",
  "version": "0.1.0",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "provider.js",
        "fonts/Inter/Inter-Regular.woff2",
        "fonts/Inter/Inter-SemiBold.woff2"
      ]
    }
  ]
}
