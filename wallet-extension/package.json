{
  "name": "@animica/wallet-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Animica Wallet \u2014 MV3 browser extension with in-page provider, PQ keyring, simulation, and approvals.",
  "type": "module",
  "author": "Animica",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "build:chrome": "rimraf dist-chrome && cross-env TARGET=chrome tsx scripts/build.ts chrome",
    "build:firefox": "rimraf dist-firefox && cross-env TARGET=firefox tsx scripts/build.ts firefox",
    "test": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier -w .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "msgpackr": "^1.11.5",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.0.279",
    "@types/node": "^20.19.24",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "chokidar": "^3.6.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "ws": "^8.18.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ]
}
