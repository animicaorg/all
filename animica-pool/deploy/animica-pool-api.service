[Unit]
Description=Animica Pool API (NestJS)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/animica/animica-pool
EnvironmentFile=/etc/animica/animica-pool.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node apps/api/dist/main.js
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
