[Unit]
Description=Animica Pool web (Next.js)
Wants=network-online.target
After=network-online.target animica-pool-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/animica/animica-pool/apps/web
EnvironmentFile=/etc/animica/animica-pool.env
Environment=NODE_ENV=production
ExecStart=/root/animica/animica-pool/apps/web/node_modules/.bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
