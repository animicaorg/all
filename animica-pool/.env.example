# ===== Core =====
DATABASE_URL=postgresql://animica:animica@localhost:5439/animica_pool?schema=public
REDIS_URL=redis://localhost:6380

JWT_SECRET=change-me-min-32-chars-aaaaaaaaaaaaaaaaaaaa
SESSION_SECRET=change-me-min-32-chars-bbbbbbbbbbbbbbbbbbbb

NEXT_PUBLIC_APP_URL=https://pool.animica.org
API_BASE_URL=https://pool.animica.org
API_PORT=4000
WEB_PORT=3000
# Comma-separated emails auto-promoted to ADMIN at first login
ADMIN_EMAILS=

# ===== Payments =====
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_PUBLIC_CALLBACK_URL=https://pool.animica.org/api/nowpayments/webhook
NOWPAYMENTS_PAYOUTS_ENABLED=false
AUTO_PAYOUTS_ENABLED=false
NOWPAYMENTS_SANDBOX=true

# ===== Mining =====
ANM_USD_PRICE=0.00125
XMR_USD_PRICE=
POOL_FEE_PERCENT=5
ANM_POOL_STRATUM_URL=stratum+tcp://pool.animica.org:3333
XMR_POOL_STRATUM_URL=stratum+tcp://pool.animica.org:3333
DUAL_POOL_STRATUM_URL=stratum+tcp://pool.animica.org:3333
ANM_POOL_API_URL=http://127.0.0.1:8550
XMR_POOL_API_URL=http://127.0.0.1:8550
MINING_USE_MOCK=false   # dev only: set true for fake mining stats without the live pool

# ===== Providers =====
MOCK_PROVIDER_ENABLED=false   # dev only: set true to serve canned responses without real providers

# Bittensor demand side — buys emission-subsidized inference from Chutes
# (SN64) and resells at anm-* prices. Gateway defaults to
# https://llm.chutes.ai/v1; get a cpk_ key at chutes.ai (pay-as-you-go,
# TAO or fiat, no minimum). Adapter self-disables without a key.
BITTENSOR_ENABLED=true
BITTENSOR_GATEWAY_URL=
BITTENSOR_API_KEY=
BITTENSOR_DEFAULT_SUBNET=64
BITTENSOR_TIMEOUT_MS=30000
# Optional JSON override: {"anm-x":{"upstream":"...","inUsdPer1M":0.1,"outUsdPer1M":0.4}}
BITTENSOR_MODEL_MAP=

# OpenRouter pinned to the `chutes` provider — fiat-billed Bittensor fallback.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_API_URL=
OPENROUTER_PIN_PROVIDER=chutes
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_MODEL_MAP=

# Targon (SN4) — live API but no public rate card; enable only after
# confirming pricing in the Targon dashboard.
TARGON_ENABLED=false
TARGON_API_KEY=
TARGON_API_URL=
TARGON_MODEL_MAP=

RUNPOD_ENABLED=false
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_TIMEOUT_MS=30000

AKASH_ENABLED=false
AKASH_API_URL=
AKASH_DEPLOYMENT_ID=
AKASH_TIMEOUT_MS=30000

# OpenAI-compatible providers — *_API_URL defaults to the vendor's public
# endpoint; override for self-hosted. All disabled until enabled + key set.
PROVIDER_TIMEOUT_MS=30000
LAMBDA_ENABLED=false
LAMBDA_API_KEY=
LAMBDA_API_URL=
SPHERON_ENABLED=false
SPHERON_API_KEY=
SPHERON_API_URL=
HYPERBOLIC_ENABLED=false
HYPERBOLIC_API_KEY=
HYPERBOLIC_API_URL=
RENDER_ENABLED=false
RENDER_API_KEY=
RENDER_API_URL=
IONET_ENABLED=false
IONET_API_KEY=
IONET_API_URL=

# ===== Mining ANM payouts (on-chain) + price oracle =====
# For ANM payout requests: send on-chain via the Animica node RPC.
ANIMICA_RPC_URL=
ANIMICA_RPC_USER=
ANIMICA_RPC_PASSWORD=
ANIMICA_PAYOUT_FROM_ADDRESS=
# Price oracle for converting USD payout amounts to BTC/SOL/XMR.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ===== Redistribution (net realized profit only) =====
SPLIT_PROVIDERS_PERCENT=70
SPLIT_TREASURY_PERCENT=20
SPLIT_REFERRAL_PERCENT=10

# ===== Bittensor supply side (SN51 Celium GPU pool) =====
# Pool model: user GPUs back OUR SN51 miner hotkey as executors; we take the
# pool share, owners get BITTENSOR_OWNER_SHARE_PERCENT. Fully built but
# PAUSED until the treasury accumulator covers the registration burn +
# first collateral (BITTENSOR_REG_TARGET_USD) — zero upfront capital.
BITTENSOR_MINING_ENABLED=false
BITTENSOR_MINING_NETUID=51
# Our registered miner hotkey (SS58) — set after `btcli subnet register --netuid 51`.
BITTENSOR_MINER_HOTKEY=
# Slashing protection: SN51 burns per-executor collateral (7 days of rental
# fees) if a rig drops mid-rental — only proven rigs may enroll.
BITTENSOR_MIN_UPTIME_PCT=97
BITTENSOR_MIN_HISTORY_DAYS=7
BITTENSOR_MIN_VRAM_GB=16
# Earnings split + holdback window mirroring SN51's collateral horizon.
BITTENSOR_OWNER_SHARE_PERCENT=70
BITTENSOR_HOLDBACK_DAYS=7
BITTENSOR_REG_TARGET_USD=2000
# TAO/USD override for earnings conversion ("" = CoinGecko live price).
TAO_USD_PRICE=
