---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  active="rewards"
  title="Reward pool — Animica Academy"
  description="The academy reward pool funds tutorial payouts. Anyone can deposit. Every deposit and payout is a public, verifiable on-chain transaction."
>
  <section class="max-w-7xl mx-auto px-4 py-12">
    <p class="text-[11px] uppercase tracking-[0.24em] text-amber-400 font-semibold">Reward pool</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-semibold tracking-tight">Open-funded learning incentives.</h1>
    <p class="mt-3 text-ink-300 max-w-2xl">
      The reward pool is a single on-chain Animica address. Its balance funds
      every tutorial payout in the academy. Deposits are public; payouts to
      learners are public; everything is verifiable on the
      <a class="text-amber-400 hover:underline" href="https://explorer.animica.org">explorer</a>.
    </p>

    <div class="mt-10 grid lg:grid-cols-[1.3fr_1fr] gap-8 items-start">
      <div>
        <pool-summary class="block"></pool-summary>

        <div class="mt-10 rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <h2 class="text-xl font-semibold">How it works</h2>
          <ol class="mt-4 space-y-3 text-sm text-ink-300 list-decimal pl-5 marker:text-amber-400">
            <li>
              <strong class="text-ink-100">Anyone deposits.</strong> The pool address
              is public. Send ANIMICA from any wallet — via the CLI, a partner
              app, or the deposit form on this page if you have the browser
              extension installed.
            </li>
            <li>
              <strong class="text-ink-100">Learners complete tutorials.</strong> Each
              step prints something verifiable: an address, a tx hash, a block
              height. The academy never claims a step you didn't actually run.
            </li>
            <li>
              <strong class="text-ink-100">The pool pays out.</strong> On tutorial
              completion the academy submits an on-chain transfer from the pool
              to the wallet that signed the completion attestation. Same chain,
              same finality as any other Animica transfer.
            </li>
          </ol>
        </div>

        <div class="mt-6 rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <h2 class="text-xl font-semibold">Verify everything</h2>
          <p class="mt-2 text-sm text-ink-300">
            You can audit the pool from the CLI without trusting this site:
          </p>
          <pre class="mt-4"><code>animica chain account anim1...pool-address
animica chain events --address anim1...pool-address --limit 50</code></pre>
          <p class="mt-3 text-xs text-ink-400">
            Substitute the live pool address shown above. The output is
            authoritative — this page is just a friendlier view of the same data.
          </p>
        </div>
      </div>

      <aside class="rounded-2xl border border-amber-400/30 bg-amber-500/5 p-6 lg:sticky lg:top-20">
        <div class="text-[10px] uppercase tracking-wider text-amber-400 font-semibold mb-1">
          Deposit
        </div>
        <h2 class="text-xl font-semibold mb-3">Top up the pool</h2>
        <p class="text-sm text-ink-300 mb-4">
          With the wallet extension installed, this form opens the extension's
          confirmation UI with the destination + amount pre-filled. Without the
          extension, copy the pool address below and send a transfer from any
          wallet.
        </p>
        <deposit-form class="block"></deposit-form>
      </aside>
    </div>
  </section>

  <script>
    import { connectWallet, depositToRewardPool, readWallet, baseUnitsToAnim, shortAddr } from "../lib/wallet";
    import { academyApi } from "../lib/api";

    declare const __REWARD_POOL_ADDR__: string;

    class PoolSummary extends HTMLElement {
      async connectedCallback() {
        this.innerHTML = `<div class="text-sm text-ink-300">Loading pool state…</div>`;
        try {
          const status = await academyApi.getPoolStatus();
          this.innerHTML = `
            <div class="grid sm:grid-cols-3 gap-4">
              <div class="rounded-2xl border border-amber-400/30 bg-gradient-to-br from-amber-400/[0.08] to-transparent p-5">
                <div class="text-[10px] uppercase tracking-wider text-amber-300 font-semibold">Balance</div>
                <div class="mt-1 text-3xl font-mono font-semibold text-amber-400">${baseUnitsToAnim(status.balanceBaseUnits)}</div>
                <div class="text-xs text-ink-300 mt-1">ANIMICA available</div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
                <div class="text-[10px] uppercase tracking-wider text-ink-300 font-semibold">Paid out</div>
                <div class="mt-1 text-3xl font-mono font-semibold text-teal-400">${baseUnitsToAnim(status.paidOutBaseUnits)}</div>
                <div class="text-xs text-ink-300 mt-1">to learners</div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
                <div class="text-[10px] uppercase tracking-wider text-ink-300 font-semibold">Contributors</div>
                <div class="mt-1 text-3xl font-mono font-semibold">${status.contributors}</div>
                <div class="text-xs text-ink-300 mt-1">unique wallets</div>
              </div>
            </div>
            <div class="mt-4 text-xs text-ink-300">
              Pool address:
              <a class="font-mono text-amber-400 hover:underline" href="https://explorer.animica.org/address/${status.poolAddress}" target="_blank" rel="noopener">${shortAddr(status.poolAddress, 14)}</a>
            </div>`;
        } catch {
          const poolAddr = __REWARD_POOL_ADDR__;
          this.innerHTML = `
            <div class="rounded-2xl border border-amber-400/20 bg-amber-400/[0.04] p-6">
              <div class="text-[10px] uppercase tracking-wider text-amber-300 font-semibold mb-2">Status · pre-launch</div>
              <h2 class="text-xl font-semibold">Reward pool activates with the v1 academy.</h2>
              <p class="mt-2 text-sm text-ink-200 max-w-prose">
                Tutorials work today — complete them to learn the stack. Once
                the reward-pool API is online, your finished tutorials will
                back-pay from the pool to the wallet that signed each completion.
              </p>
              <div class="mt-4 text-xs text-ink-300">
                Pool address (already funded by contributors):
                <a class="block mt-1 font-mono text-amber-400 hover:underline break-all" href="https://explorer.animica.org/address/${poolAddr}" target="_blank" rel="noopener">${poolAddr}</a>
              </div>
            </div>`;
        }
      }
    }
    if (!customElements.get("pool-summary")) customElements.define("pool-summary", PoolSummary);

    class DepositForm extends HTMLElement {
      async connectedCallback() {
        const poolAddr = __REWARD_POOL_ADDR__;
        const hasExtension =
          typeof window !== "undefined" && Boolean((window as any).animica);

        if (!hasExtension) {
          this.innerHTML = `
            <div class="rounded-xl border border-white/10 bg-ink-950/60 p-4">
              <div class="text-[11px] text-ink-300 mb-1">Send ANIMICA from any wallet to:</div>
              <code class="font-mono text-xs text-amber-400 break-all block">${poolAddr}</code>
              <button id="dep-copy" class="mt-3 w-full rounded-lg border border-amber-400/40 hover:border-amber-400 text-amber-300 px-3 py-2 text-xs font-medium transition">Copy address</button>
              <p class="mt-3 text-[11px] text-ink-400">
                From the CLI: <code class="font-mono text-amber-400/80">animica tx send --from me --to ${poolAddr.slice(0, 8)}…${poolAddr.slice(-4)} --value 5</code>
              </p>
            </div>`;
          this.querySelector<HTMLButtonElement>("#dep-copy")?.addEventListener("click", async () => {
            const btn = this.querySelector<HTMLButtonElement>("#dep-copy");
            try {
              await navigator.clipboard.writeText(poolAddr);
              if (btn) {
                btn.textContent = "Copied ✓";
                setTimeout(() => { if (btn) btn.textContent = "Copy address"; }, 1500);
              }
            } catch {
              if (btn) btn.textContent = "Copy failed";
            }
          });
          return;
        }

        this.innerHTML = `
          <label class="text-xs uppercase tracking-wider text-ink-300 font-semibold">Amount (ANIMICA)</label>
          <input id="dep-amt" type="text" inputmode="decimal" placeholder="50" class="mt-1 w-full rounded-lg bg-ink-950 border border-white/10 px-3 py-2 text-lg font-mono focus:border-amber-400 outline-none" />
          <label class="block mt-3 text-xs uppercase tracking-wider text-ink-300 font-semibold">Memo (optional)</label>
          <input id="dep-memo" type="text" maxlength="120" placeholder="from <name> with love" class="mt-1 w-full rounded-lg bg-ink-950 border border-white/10 px-3 py-2 text-sm focus:border-amber-400 outline-none" />
          <button id="dep-go" class="mt-4 w-full rounded-xl bg-amber-500 hover:bg-amber-400 disabled:bg-ink-700 text-ink-950 font-semibold px-4 py-3 transition">Deposit</button>
          <div id="dep-result" class="mt-3 text-xs"></div>
          <div class="text-[11px] text-ink-300 mt-4 font-mono break-all">→ ${poolAddr}</div>`;

        const btn = this.querySelector<HTMLButtonElement>("#dep-go")!;
        const amt = this.querySelector<HTMLInputElement>("#dep-amt")!;
        const memo = this.querySelector<HTMLInputElement>("#dep-memo")!;
        const out = this.querySelector<HTMLElement>("#dep-result")!;

        btn.addEventListener("click", async () => {
          out.textContent = "";
          btn.disabled = true;
          btn.textContent = "Sending…";
          try {
            const state = await readWallet();
            const address = state.address ?? (await connectWallet()).address;
            const result = await depositToRewardPool({
              poolAddr,
              amountAnim: amt.value,
              memo: memo.value || undefined,
            });
            try {
              await academyApi.recordDeposit({
                address,
                txHash: result.txHash,
                amountAnim: amt.value,
              });
            } catch {
              /* leaderboard reconciles from chain anyway */
            }
            out.innerHTML = `<span class="text-amber-300">Sent ${amt.value} ANIMICA</span><br/><a class="font-mono underline break-all" href="https://explorer.animica.org/tx/${result.txHash}" target="_blank" rel="noopener">${result.txHash.slice(0, 20)}…</a>`;
            btn.textContent = "Deposited ✓";
            setTimeout(() => {
              btn.textContent = "Deposit";
              btn.disabled = false;
              amt.value = "";
              memo.value = "";
            }, 4000);
          } catch (e) {
            out.textContent = (e as Error).message;
            btn.textContent = "Deposit";
            btn.disabled = false;
          }
        });
      }
    }
    if (!customElements.get("deposit-form")) customElements.define("deposit-form", DepositForm);
  </script>
</BaseLayout>
