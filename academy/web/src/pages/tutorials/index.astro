---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Server-rendered (at build time) catalog. The backend API is the long-run
// source of truth for rewards & step counts, but the markdown collection
// makes the catalog discoverable without the API up; the live page also
// fetches /tutorials at runtime to overlay current reward values and the
// user's progress.
const entries = await getCollection("tutorials");
const tracks = ["wallet", "aicf", "contracts", "node"] as const;
type Track = (typeof tracks)[number];

const byTrack: Record<Track, typeof entries> = {
  wallet: [],
  aicf: [],
  contracts: [],
  node: [],
};
for (const entry of entries) {
  const t = entry.data.track as Track;
  if (byTrack[t]) byTrack[t].push(entry);
}
for (const t of tracks) {
  byTrack[t].sort((a, b) => a.data.order - b.data.order);
}

const trackTitles: Record<Track, string> = {
  wallet: "Wallet basics",
  aicf: "AICF compute",
  contracts: "Smart contracts",
  node: "Run a node",
};
---

<BaseLayout
  title="Animica Academy — Tutorials"
  description="Pick a track. Each tutorial pays ANIMICA from the public reward pool when you complete it."
>
  <section class="max-w-7xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight mb-2">Tutorials</h1>
    <p class="text-ink-300 max-w-2xl mb-8">
      Each step is verified by a signed attestation from your wallet extension.
      Completing a tutorial pays the listed reward; completing every tutorial in
      a track awards a track badge with a bonus payout.
    </p>

    {tracks.map((track) => (
      <div class="mb-12">
        <div class="flex items-baseline gap-3 mb-4">
          <h2 class="text-xl font-semibold tracking-tight">{trackTitles[track]}</h2>
          <span class="text-xs uppercase tracking-wider text-amber-400">
            {byTrack[track].length} tutorials
          </span>
        </div>
        {byTrack[track].length === 0 ? (
          <p class="text-sm text-ink-300">Coming soon.</p>
        ) : (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {byTrack[track].map((entry) => (
              <a
                href={`/tutorials/${entry.slug}`}
                class="block rounded-2xl border border-white/10 bg-white/[0.03] p-5 hover:border-amber-400/40 transition"
              >
                <div class="flex items-baseline justify-between mb-2">
                  <span class="text-[10px] uppercase tracking-wider text-amber-400 font-semibold">
                    {entry.data.difficulty}
                  </span>
                  <span class="text-xs text-ink-300">
                    ≈ {entry.data.estimatedMinutes} min
                  </span>
                </div>
                <h3 class="font-semibold text-lg leading-tight">{entry.data.title}</h3>
                <p class="text-sm text-ink-300 mt-2 line-clamp-3">
                  {entry.data.summary}
                </p>
                <div class="flex items-center justify-between mt-4 pt-3 border-t border-white/5">
                  <span class="text-xs font-mono text-amber-400">
                    +{entry.data.rewardAnim} ANIMICA
                  </span>
                  <span class="text-xs text-ink-300 progress-dot" data-tutorial={entry.slug}>
                    — / {entry.data.steps} steps
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <script>
    // Overlay per-wallet progress on each card.
    import { readWallet } from "../../lib/wallet";
    import { academyApi } from "../../lib/api";

    async function hydrateProgress() {
      const { address } = await readWallet();
      if (!address) return;
      try {
        const { progress } = await academyApi.getProgress(address);
        const byTutorial: Record<string, Set<string>> = {};
        for (const p of progress) {
          (byTutorial[p.tutorialId] ??= new Set()).add(p.stepId);
        }
        document.querySelectorAll<HTMLElement>(".progress-dot").forEach((el) => {
          const id = el.dataset.tutorial;
          if (!id) return;
          const done = byTutorial[id]?.size ?? 0;
          const total = Number(el.textContent?.split("/")?.[1]?.trim().split(" ")[0] ?? 0);
          el.textContent = `${done} / ${total} steps`;
          if (total > 0 && done >= total) {
            el.classList.add("text-amber-400");
          }
        });
      } catch {
        /* leave the dashes — non-critical UI */
      }
    }
    hydrateProgress();
    document.addEventListener("animica:wallet-connected", hydrateProgress);
  </script>
</BaseLayout>
