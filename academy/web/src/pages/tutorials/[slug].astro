---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClaimPanel from "../../components/ClaimPanel.astro";

export async function getStaticPaths() {
  const entries = await getCollection("tutorials");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, summary, difficulty, estimatedMinutes, rewardAnim, stepIds } =
  entry.data;
---

<BaseLayout title={`${title} — Animica Academy`} description={summary}>
  <section class="max-w-7xl mx-auto px-4 py-12">
    <a href="/tutorials" class="text-xs text-amber-400 hover:underline">← All tutorials</a>
    <div class="mt-3 grid lg:grid-cols-[1fr_320px] gap-10 items-start">
      <article>
        <header class="mb-6">
          <div class="flex items-center gap-3 text-xs uppercase tracking-wider text-ink-300 mb-3">
            <span class="text-amber-400 font-semibold">{difficulty}</span>
            <span class="opacity-50">·</span>
            <span>≈ {estimatedMinutes} min</span>
            <span class="opacity-50">·</span>
            <span>{stepIds.length} steps</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">{title}</h1>
          <p class="mt-2 text-ink-200 max-w-3xl">{summary}</p>
        </header>
        <div class="prose prose-invert max-w-none">
          <Content />
        </div>
      </article>
      <ClaimPanel
        tutorialId={entry.slug}
        rewardAnim={rewardAnim}
        stepIds={stepIds}
      />
    </div>
  </section>

  <script>
    import { connectWallet, readWallet, signCompletionAttestation } from "../../lib/wallet";
    import { academyApi } from "../../lib/api";

    const STORAGE_PREFIX = "academy:complete:";

    function storageKey(tutorialId: string, address: string) {
      return `${STORAGE_PREFIX}${address}:${tutorialId}`;
    }

    function loadCompleted(tutorialId: string, address: string): Set<string> {
      try {
        const raw = localStorage.getItem(storageKey(tutorialId, address));
        return new Set(raw ? (JSON.parse(raw) as string[]) : []);
      } catch {
        return new Set();
      }
    }

    function saveCompleted(tutorialId: string, address: string, set: Set<string>) {
      localStorage.setItem(storageKey(tutorialId, address), JSON.stringify([...set]));
    }

    // Sync the visible badges + claim button state.
    function render(panel: HTMLElement, completed: Set<string>) {
      const ids: string[] = JSON.parse(panel.dataset.stepIds ?? "[]");
      const reward = panel.dataset.rewardAnim ?? "0";

      document.querySelectorAll<HTMLElement>(".step").forEach((stepEl) => {
        const id = stepEl.dataset.stepId;
        if (!id) return;
        const done = completed.has(id);
        stepEl.classList.toggle("border-amber-400/50", done);
        const badge = stepEl.querySelector(".step-badge");
        if (badge) badge.textContent = done ? "✓" : "●";
        const btn = stepEl.querySelector<HTMLButtonElement>(".step-toggle");
        if (btn) btn.textContent = done ? "Completed" : "Mark complete";
      });

      const countEl = panel.querySelector(".claim-progress-count");
      if (countEl) countEl.textContent = String(completed.size);

      const claimBtn = panel.querySelector<HTMLButtonElement>(".claim-btn");
      if (claimBtn) {
        const allDone = ids.every((s) => completed.has(s));
        claimBtn.disabled = !allDone;
        claimBtn.textContent = allDone
          ? `Claim ${reward} ANIMICA`
          : "Complete all steps to claim";
      }
    }

    async function init() {
      const panel = document.querySelector<HTMLElement>(".claim-panel");
      if (!panel) return;
      const tutorialId = panel.dataset.tutorialId!;
      const stepIds: string[] = JSON.parse(panel.dataset.stepIds ?? "[]");

      let cachedAddress: string | null = (await readWallet()).address;
      async function ensureAddress(): Promise<string> {
        if (cachedAddress) return cachedAddress;
        const { address: connected } = await connectWallet();
        cachedAddress = connected;
        return connected;
      }

      // Use server-side progress as the authoritative source when a wallet
      // is connected; fall back to localStorage so the page is still usable
      // when offline / mid-attestation.
      const seed = cachedAddress ? loadCompleted(tutorialId, cachedAddress) : new Set<string>();
      if (cachedAddress) {
        try {
          const { progress } = await academyApi.getProgress(cachedAddress);
          for (const p of progress) {
            if (p.tutorialId === tutorialId) seed.add(p.stepId);
          }
          saveCompleted(tutorialId, cachedAddress, seed);
        } catch {
          /* offline — use local */
        }
      }
      render(panel, seed);

      // Step toggles.
      document.querySelectorAll<HTMLButtonElement>(".step-toggle").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.dataset.step;
          if (!id) return;
          let address: string;
          try {
            address = await ensureAddress();
          } catch (e) {
            alert((e as Error).message);
            return;
          }
          const current = loadCompleted(tutorialId, address);
          if (current.has(id)) {
            // Allow un-marking pre-finalize so the user can review.
            current.delete(id);
          } else {
            current.add(id);
          }
          saveCompleted(tutorialId, address, current);
          render(panel, current);
        });
      });

      // Claim flow.
      const claimBtn = panel.querySelector<HTMLButtonElement>(".claim-btn");
      const resultEl = panel.querySelector<HTMLElement>(".claim-result");
      claimBtn?.addEventListener("click", async () => {
        if (!claimBtn || claimBtn.disabled) return;
        let address: string;
        try {
          address = await ensureAddress();
        } catch (e) {
          if (resultEl) resultEl.textContent = (e as Error).message;
          return;
        }

        claimBtn.disabled = true;
        claimBtn.textContent = "Claiming…";
        if (resultEl) resultEl.textContent = "";

        // Pay out the final step in the list; the server treats this as the
        // tutorial-completion claim and credits the full reward.
        const finalStep = stepIds[stepIds.length - 1];
        if (!finalStep) {
          claimBtn.textContent = "No steps defined";
          claimBtn.disabled = false;
          return;
        }
        try {
          const start = await academyApi.startClaim({
            tutorialId,
            stepId: finalStep,
            address,
          });
          const { signature, message } = await signCompletionAttestation({
            tutorialId,
            stepId: finalStep,
            address,
            nonce: start.nonce,
          });
          const result = await academyApi.finalizeClaim({
            tutorialId,
            stepId: finalStep,
            address,
            nonce: start.nonce,
            signature,
            message,
          });

          if (result.paid && result.txHash) {
            claimBtn.textContent = "Paid ✓";
            if (resultEl) {
              resultEl.innerHTML = `<span class="text-amber-300">Sent ${start.rewardAnim} ANIMICA</span><br/><a class="font-mono underline break-all" href="https://explorer.animica.org/tx/${result.txHash}" target="_blank" rel="noopener">${result.txHash.slice(0, 20)}…</a>`;
            }
          } else {
            claimBtn.textContent = "Claim failed";
            claimBtn.disabled = false;
            if (resultEl) {
              resultEl.textContent = result.reason ?? "no funds in pool";
            }
          }
        } catch (e) {
          claimBtn.textContent = "Try again";
          claimBtn.disabled = false;
          if (resultEl) resultEl.textContent = (e as Error).message;
        }
      });

      document.addEventListener("animica:wallet-connected", () => location.reload());
    }

    init();
  </script>
</BaseLayout>
