---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClaimPanel from "../../components/ClaimPanel.astro";

export async function getStaticPaths() {
  const entries = await getCollection("tutorials");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, summary, difficulty, estimatedMinutes, rewardAnim, stepIds, track } =
  entry.data;

const difficultyColor: Record<string, string> = {
  intro: "text-emerald-300",
  intermediate: "text-amber-300",
  advanced: "text-rose-300",
};

const trackEmoji: Record<string, string> = {
  wallet: "🪙",
  node: "🌐",
  aicf: "⚡",
  contracts: "📜",
};
---

<BaseLayout
  active="tutorials"
  title={`${title} — Animica Academy`}
  description={summary}
>
  <section class="max-w-7xl mx-auto px-4 py-12">
    <a
      href={`/tutorials?track=${track}`}
      class="inline-flex items-center gap-1 text-xs text-amber-400 hover:underline"
    >
      <span aria-hidden="true">←</span> All tutorials
    </a>
    <div class="mt-4 grid lg:grid-cols-[1fr_340px] gap-10 items-start">
      <article>
        <header class="mb-8">
          <div class="flex items-center gap-3 text-[11px] uppercase tracking-wider text-ink-300 mb-3">
            <span class="inline-flex items-center gap-1.5">
              <span>{trackEmoji[track] ?? "🏅"}</span>
              <span class="capitalize">{track}</span>
            </span>
            <span class="opacity-50">·</span>
            <span class={`font-semibold ${difficultyColor[difficulty] ?? "text-amber-400"}`}>{difficulty}</span>
            <span class="opacity-50">·</span>
            <span>≈ {estimatedMinutes} min</span>
            <span class="opacity-50">·</span>
            <span>{stepIds.length} steps</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-semibold tracking-tight leading-[1.1]">{title}</h1>
          <p class="mt-3 text-base text-ink-200 max-w-3xl leading-relaxed">{summary}</p>
        </header>

        <div class="prose">
          <Content />
        </div>

        <div class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-5 flex flex-wrap items-center justify-between gap-4">
          <div class="text-sm text-ink-300">
            Stuck? File an issue on
            <a href="https://github.com/animicaorg" class="text-amber-400 hover:underline">GitHub</a>
            — every tutorial is reproducible from the CLI source it documents.
          </div>
          <a href="/tutorials" class="text-sm rounded-lg border border-white/10 hover:border-amber-400/50 hover:text-amber-300 px-3 py-1.5 transition">
            Back to catalog →
          </a>
        </div>
      </article>
      <ClaimPanel
        tutorialId={entry.slug}
        rewardAnim={rewardAnim}
        stepIds={stepIds}
      />
    </div>
  </section>

  <script>
    import { connectWallet, readWallet, signCompletionAttestation } from "../../lib/wallet";
    import { academyApi } from "../../lib/api";

    const STORAGE_PREFIX = "academy:complete:";

    function storageKey(tutorialId: string, address: string | null) {
      return `${STORAGE_PREFIX}${address ?? "anon"}:${tutorialId}`;
    }

    function loadCompleted(tutorialId: string, address: string | null): Set<string> {
      try {
        const raw = localStorage.getItem(storageKey(tutorialId, address));
        return new Set(raw ? (JSON.parse(raw) as string[]) : []);
      } catch {
        return new Set();
      }
    }

    function saveCompleted(tutorialId: string, address: string | null, set: Set<string>) {
      localStorage.setItem(storageKey(tutorialId, address), JSON.stringify([...set]));
    }

    function render(panel: HTMLElement, completed: Set<string>, apiOffline: boolean) {
      const ids: string[] = JSON.parse(panel.dataset.stepIds ?? "[]");
      const reward = panel.dataset.rewardAnim ?? "0";

      document.querySelectorAll<HTMLElement>(".step").forEach((stepEl) => {
        const id = stepEl.dataset.stepId;
        if (!id) return;
        const done = completed.has(id);
        stepEl.classList.toggle("border-amber-400/50", done);
        stepEl.classList.toggle("bg-amber-500/[0.04]", done);
        const badge = stepEl.querySelector(".step-badge");
        if (badge) badge.textContent = done ? "✓" : "●";
        const btn = stepEl.querySelector<HTMLButtonElement>(".step-toggle");
        if (btn) {
          btn.textContent = done ? "Completed" : "Mark complete";
          btn.classList.toggle("bg-amber-500/10", done);
        }
      });

      const countEl = panel.querySelector(".claim-progress-count");
      if (countEl) countEl.textContent = String(completed.size);
      const barEl = panel.querySelector<HTMLElement>(".claim-progress-bar");
      if (barEl) {
        const pct = ids.length === 0 ? 0 : Math.round((completed.size / ids.length) * 100);
        barEl.style.width = `${pct}%`;
      }

      const claimBtn = panel.querySelector<HTMLButtonElement>(".claim-btn");
      if (claimBtn) {
        const allDone = ids.every((s) => completed.has(s));
        if (!allDone) {
          claimBtn.disabled = true;
          claimBtn.textContent = "Complete all steps to claim";
        } else if (apiOffline) {
          claimBtn.disabled = true;
          claimBtn.textContent = "Rewards launching soon";
        } else {
          claimBtn.disabled = false;
          claimBtn.textContent = `Claim ${reward} ANIMICA`;
        }
      }
    }

    async function init() {
      const panel = document.querySelector<HTMLElement>(".claim-panel");
      if (!panel) return;
      const tutorialId = panel.dataset.tutorialId!;
      const stepIds: string[] = JSON.parse(panel.dataset.stepIds ?? "[]");

      let cachedAddress: string | null = (await readWallet()).address;

      // Probe the API once. If it's offline, we stay in "local progress only"
      // mode — the user can still mark steps complete in localStorage.
      let apiOffline = false;
      try {
        await academyApi.getPoolStatus();
      } catch {
        apiOffline = true;
      }

      async function ensureAddress(): Promise<string> {
        if (cachedAddress) return cachedAddress;
        const { address: connected } = await connectWallet();
        cachedAddress = connected;
        return connected;
      }

      // Seed completion state from local + (if API up + wallet known) server.
      const seed = loadCompleted(tutorialId, cachedAddress);
      if (cachedAddress && !apiOffline) {
        try {
          const { progress } = await academyApi.getProgress(cachedAddress);
          for (const p of progress) {
            if (p.tutorialId === tutorialId) seed.add(p.stepId);
          }
          saveCompleted(tutorialId, cachedAddress, seed);
        } catch {
          /* surface as offline next paint */
        }
      }
      render(panel, seed, apiOffline);

      // Surface an "offline" hint inside the panel so the user knows why
      // the claim button is disabled even after all steps are done.
      if (apiOffline) {
        const result = panel.querySelector<HTMLElement>(".claim-result");
        if (result) {
          result.innerHTML = `<span class="text-ink-300">Tutorial progress is saved locally. Payouts unlock with the v1 academy API.</span>`;
        }
      }

      document.querySelectorAll<HTMLButtonElement>(".step-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.step;
          if (!id) return;
          const current = loadCompleted(tutorialId, cachedAddress);
          if (current.has(id)) {
            current.delete(id);
          } else {
            current.add(id);
          }
          saveCompleted(tutorialId, cachedAddress, current);
          render(panel, current, apiOffline);
        });
      });

      const claimBtn = panel.querySelector<HTMLButtonElement>(".claim-btn");
      const resultEl = panel.querySelector<HTMLElement>(".claim-result");
      claimBtn?.addEventListener("click", async () => {
        if (!claimBtn || claimBtn.disabled) return;
        let address: string;
        try {
          address = await ensureAddress();
        } catch (e) {
          if (resultEl) resultEl.textContent = (e as Error).message;
          return;
        }

        claimBtn.disabled = true;
        claimBtn.textContent = "Claiming…";
        if (resultEl) resultEl.textContent = "";

        const finalStep = stepIds[stepIds.length - 1];
        if (!finalStep) {
          claimBtn.textContent = "No steps defined";
          claimBtn.disabled = false;
          return;
        }
        try {
          const start = await academyApi.startClaim({
            tutorialId,
            stepId: finalStep,
            address,
          });
          const { signature, message } = await signCompletionAttestation({
            tutorialId,
            stepId: finalStep,
            address,
            nonce: start.nonce,
          });
          const result = await academyApi.finalizeClaim({
            tutorialId,
            stepId: finalStep,
            address,
            nonce: start.nonce,
            signature,
            message,
          });

          if (result.paid && result.txHash) {
            claimBtn.textContent = "Paid ✓";
            if (resultEl) {
              resultEl.innerHTML = `<span class="text-amber-300">Sent ${start.rewardAnim} ANIMICA</span><br/><a class="font-mono underline break-all" href="https://explorer.animica.org/tx/${result.txHash}" target="_blank" rel="noopener">${result.txHash.slice(0, 20)}…</a>`;
            }
          } else {
            claimBtn.textContent = "Claim failed";
            claimBtn.disabled = false;
            if (resultEl) {
              resultEl.textContent = result.reason ?? "no funds in pool";
            }
          }
        } catch (e) {
          claimBtn.textContent = "Try again";
          claimBtn.disabled = false;
          if (resultEl) resultEl.textContent = (e as Error).message;
        }
      });

      document.addEventListener("animica:wallet-connected", () => location.reload());
    }

    init();
  </script>
</BaseLayout>
