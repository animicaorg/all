---
/**
 * Renders the claim flow for a tutorial. Bound by [slug].astro after the
 * user toggles every step complete. When the academy API is offline,
 * the panel falls back to a "rewards launching soon" notice so the
 * tutorial page still feels intentional.
 *
 *   tutorialId   — slug from the content collection
 *   rewardAnim   — display-only; actual amount is enforced server-side
 *   stepIds      — JSON-encoded array of every step ID in this tutorial
 */
interface Props {
  tutorialId: string;
  rewardAnim: string;
  stepIds: string[];
}
const { tutorialId, rewardAnim, stepIds } = Astro.props;
---

<aside
  class="claim-panel lg:sticky lg:top-24 rounded-2xl border border-amber-400/30 bg-gradient-to-br from-amber-500/[0.08] via-amber-500/[0.04] to-transparent p-5"
  data-tutorial-id={tutorialId}
  data-step-ids={JSON.stringify(stepIds)}
  data-reward-anim={rewardAnim}
>
  <div class="flex items-baseline justify-between">
    <div class="text-[10px] uppercase tracking-wider text-amber-400 font-semibold">
      Reward
    </div>
    <span class="text-[10px] uppercase tracking-wider text-ink-300 font-mono">
      {stepIds.length} steps
    </span>
  </div>
  <div class="mt-2 flex items-baseline gap-2">
    <span class="text-4xl font-mono font-semibold text-amber-400">
      {rewardAnim}
    </span>
    <span class="text-xs text-ink-300">ANIMICA</span>
  </div>
  <p class="text-xs text-ink-300 mt-3 leading-relaxed">
    Mark every step complete, then claim. With the wallet extension installed
    you sign a tiny attestation; the pool pays out from
    <a href="/rewards" class="text-amber-300 hover:underline">the reward pool</a>.
  </p>

  <div class="claim-progress mt-4">
    <div class="flex items-baseline justify-between text-xs text-ink-300 mb-1.5">
      <span>Progress</span>
      <span><span class="claim-progress-count font-mono">0</span> / {stepIds.length}</span>
    </div>
    <div class="h-1.5 rounded-full bg-white/5 overflow-hidden">
      <div
        class="claim-progress-bar h-full bg-gradient-to-r from-amber-500 to-amber-300 transition-all duration-300"
        style="width:0%"
      ></div>
    </div>
  </div>

  <button
    class="claim-btn mt-4 w-full rounded-xl bg-amber-500 hover:bg-amber-400 disabled:bg-ink-700 disabled:text-ink-400 disabled:cursor-not-allowed text-ink-950 font-semibold px-4 py-3 transition"
    disabled
  >
    Complete all steps to claim
  </button>
  <div class="claim-result mt-3 text-xs"></div>

  <div class="mt-5 pt-4 border-t border-white/5 text-[11px] text-ink-300 space-y-1.5">
    <div class="flex items-center gap-1.5">
      <span class="w-1 h-1 rounded-full bg-amber-400/70"></span>
      Your progress is saved in this browser.
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-1 h-1 rounded-full bg-amber-400/70"></span>
      Payouts go to the wallet that signs the attestation.
    </div>
  </div>
</aside>
