# Academy backend env example.
# Copy to .env and edit for your environment. Never commit secrets.

# Listen port for the API
PORT=4324

# Local SQLite path. WAL files (.db-shm, .db-wal) are created alongside.
ACADEMY_DB_PATH=./academy.db

# RPC endpoint of an animica node we trust for signature verification and
# payout submission. Should be a private endpoint in production.
ACADEMY_NODE_RPC=http://127.0.0.1:8545

# The on-chain address that funds tutorial rewards. Display-only on the
# frontend; the node-side keystore (`academy-rewards`) actually signs the
# transfers.
ACADEMY_REWARD_POOL_ADDR=anim1academy0reward0pool0000000000000000

# Path inside the node to the keystore label for the reward pool. The
# server does NOT hold the key; it asks the node to sign via
# `animica.sendFromKeystore`. Leave unset to disable on-chain payouts.
ACADEMY_PAYOUT_SIGNER_KEY=academy-rewards

# Set to "1" to allow real on-chain payouts. Leave unset/0 in staging.
ACADEMY_PAYOUTS_ENABLED=0

# Allowed CORS origins for the JSON API.
ACADEMY_CORS_ORIGINS=https://academy.animica.org,http://localhost:4323

# Time-to-live for issued claim nonces, in seconds.
ACADEMY_NONCE_TTL_SECONDS=600

# Dev-only escape hatch: if the node does not expose animica.verifyMessage,
# the server accepts any well-formed signature. Never enable in prod.
# ACADEMY_ALLOW_DEV_VERIFY=1
