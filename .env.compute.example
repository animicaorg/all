# Animica Compute Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# CORE ANIMICA BLOCKCHAIN
# ============================================================================

# Animica node RPC endpoint
ANIMICA_RPC_URL=http://localhost:8545

# Animica P2P network seeds (comma-separated)
ANIMICA_P2P_SEEDS=

# Network profile: mainnet | testnet | devnet | local-devnet
ANIMICA_NETWORK=devnet

# Bootstrap node mode (true if this is a bootstrap-only node)
ANIMICA_BOOTSTRAP_NODE=false

# Optional: override the bootstrap RPC endpoint
ANIMICA_BOOTSTRAP_RPC_URL=

# ============================================================================
# DATABASES
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://animica:animica_dev_password@localhost:5432/animica_compute

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# RabbitMQ connection string
RABBITMQ_URL=amqp://animica:animica_dev_password@localhost:5672/

# ============================================================================
# API GATEWAY
# ============================================================================

# API Gateway host and port
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ============================================================================
# AUTHENTICATION & AUTHORIZATION
# ============================================================================

# JWT secret key (change in production!)
JWT_SECRET_KEY=dev_jwt_secret_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15

# Refresh token expiration (days)
REFRESH_TOKEN_EXPIRATION_DAYS=30

# OAuth2 providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================================================
# BILLING & PAYMENTS
# ============================================================================

# Stripe configuration
STRIPE_API_KEY=sk_test_example_change_in_production
STRIPE_WEBHOOK_SECRET=whsec_example
STRIPE_PUBLISHABLE_KEY=pk_test_example

# PayPal configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ANM token payment configuration
ANM_PAYMENT_ENABLED=true
ANM_PAYMENT_CONFIRMATION_BLOCKS=6

# Credit ledger configuration
DEFAULT_FREE_CREDITS=1000
CREDIT_TO_USD_RATE=0.01

# ============================================================================
# LLM INFERENCE SERVICE
# ============================================================================

# vLLM configuration
VLLM_HOST=0.0.0.0
VLLM_PORT=8003
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_MODEL_LEN=4096

# Model paths
MODEL_STORAGE_PATH=/models
MODEL_CACHE_DIR=/tmp/model_cache

# S3/MinIO for model storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=animica
S3_SECRET_KEY=animica_dev_password
S3_BUCKET=animica-models
S3_REGION=us-east-1

# Supported models (comma-separated)
AVAILABLE_MODELS=llama-3-8b-instruct,mistral-7b-instruct

# Default model
DEFAULT_MODEL=llama-3-8b-instruct

# Inference pricing (credits per 1k tokens)
LLAMA_3_8B_PRICE_PER_1K_TOKENS=10
MISTRAL_7B_PRICE_PER_1K_TOKENS=12

# ============================================================================
# CODE EXECUTION SANDBOX
# ============================================================================

# Sandbox runtime: gvisor | firecracker | docker
SANDBOX_RUNTIME=gvisor

# Resource limits
SANDBOX_DEFAULT_TIMEOUT=30
SANDBOX_MAX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512MB
SANDBOX_CPU_QUOTA=100
SANDBOX_MAX_PROCESSES=100

# Network configuration
SANDBOX_NETWORK_ENABLED=false
SANDBOX_ALLOWED_DOMAINS=api.github.com,pypi.org,registry.npmjs.org

# Code execution pricing (credits per second)
CODE_EXECUTION_PRICE_PER_SECOND=1

# ============================================================================
# GITHUB APP INTEGRATION
# ============================================================================

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# GitHub App features
GITHUB_AUTO_REVIEW_ENABLED=true
GITHUB_TEST_GENERATION_ENABLED=true
GITHUB_ISSUE_LABELING_ENABLED=true

# ============================================================================
# QUEUE SERVICE
# ============================================================================

# Celery configuration
CELERY_BROKER_URL=amqp://animica:animica_dev_password@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/5
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=3600

# ============================================================================
# OBSERVABILITY
# ============================================================================

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Structured logging format: json | text
LOG_FORMAT=json

# Sentry error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Jaeger tracing
JAEGER_ENABLED=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# ============================================================================
# SECURITY
# ============================================================================

# Enable HTTPS
HTTPS_ENABLED=false
SSL_CERT_PATH=/certs/cert.pem
SSL_KEY_PATH=/certs/key.pem

# Security headers
HSTS_ENABLED=true
CSP_ENABLED=true

# API key prefix for secret scanning
API_KEY_PREFIX=anm_

# ============================================================================
# ANIMICA BRIDGE (OFF-CHAIN)
# ============================================================================

# Bridge service configuration
BRIDGE_ENABLED=true
BRIDGE_POLL_INTERVAL=10
BRIDGE_SETTLEMENT_INTERVAL=3600

# Smart contract addresses (set after deployment)
MARKETPLACE_CONTRACT_ADDRESS=
PROVIDER_REGISTRY_CONTRACT_ADDRESS=
PAYMENT_INTENT_CONTRACT_ADDRESS=

# ============================================================================
# GPU CONTRIBUTOR NODE
# ============================================================================

# Contributor node configuration
CONTRIBUTOR_NODE_ENABLED=false
CONTRIBUTOR_WALLET_PRIVATE_KEY_PATH=/secrets/contributor-wallet.key

# GPU configuration
GPU_DEVICES=0,1
MAX_CONCURRENT_JOBS=4

# Supported job types
SUPPORTED_JOB_TYPES=llm_inference,code_execution

# Marketplace configuration
MARKETPLACE_POLL_INTERVAL=10
JOB_CLAIM_TIMEOUT=300

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Enable debug mode (verbose logging, auto-reload)
DEBUG=true

# Enable API documentation
API_DOCS_ENABLED=true
API_DOCS_URL=/docs

# Mock external services for testing
MOCK_STRIPE=false
MOCK_PAYPAL=false
MOCK_GITHUB=false

# Test accounts
TEST_USER_EMAIL=test@animica.ai
TEST_USER_PASSWORD=test_password_change_me

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
FEATURE_CHAT_DASHBOARD=true
FEATURE_CODE_WORKSPACE=true
FEATURE_GITHUB_APP=true
FEATURE_MARKETPLACE=true
FEATURE_GPU_CONTRIBUTOR=false
FEATURE_QUANTUM_HASHING=false

# ============================================================================
# COMPLIANCE
# ============================================================================

# Data residency
DATA_RESIDENCY_REGION=us-east-1

# GDPR compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=365

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Cache TTLs (seconds)
CACHE_TTL_SHORT=60
CACHE_TTL_MEDIUM=300
CACHE_TTL_LONG=3600

# Request timeouts (seconds)
HTTP_TIMEOUT=30
WEBSOCKET_TIMEOUT=300

# ============================================================================
# EMAIL (Optional)
# ============================================================================

# Email provider: sendgrid | ses | smtp
EMAIL_PROVIDER=sendgrid

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@animica.ai
SENDGRID_FROM_NAME=Animica Compute

# SMTP (alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
