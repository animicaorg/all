{
  "name": "@animica/wallet-extension",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm exec vite build --watch --mode development",
    "build": "pnpm exec vite build",
    "preview": "pnpm exec vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "prebuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('node_modules')){console.error('Dependencies are missing. Run pnpm install at repository root.'); process.exit(1)}\"",
    "test:smoke:tx-send": "node ./scripts/smoke-send-rpc-shape.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.3",
    "bech32": "^2.0.0",
    "cbor-x": "^1.5.4",
    "js-sha3": "^0.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.253",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.0.4",
    "jsdom": "^28.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4",
    "webextension-polyfill": "^0.10.0"
  }
}
