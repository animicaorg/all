#!/usr/bin/env node
'use strict';
/**
 * animica-x402 — local operator CLI. Reads the DBs directly (facilitator
 * payments ledger + gateway incidents/idempotency store); never a public
 * endpoint, never prints secrets (the DBs hold none).
 *
 *   animica-x402 settlements list [--status settled|failed|pending|submitting|expired] [--limit N]
 *   animica-x402 payment get <payment_id | authorization_hash | tx_hash>
 *   animica-x402 revenue [--since 24h|7d|<unix>|<ISO>]
 *   animica-x402 reconcile [--limit N]      cross-check settled rows vs chain receipts (X402_RPC_URL)
 *   animica-x402 gas report [--since ...]
 *   animica-x402 incidents list [--status open|refunded|resolved]
 *   animica-x402 incidents resolve <incident_id> --status refunded|resolved
 *   animica-x402 index status               address-index backfill/lag
 *   animica-x402 commitments list|get <id>|prune [--older-than 90d]
 *   animica-x402 treasury status            sweep-and-sip policy, balances, breaker state
 *   animica-x402 treasury history [--kind sip|sweep|approve] [--limit N]
 *   animica-x402 treasury reconcile         resolve in-flight treasury txs from chain truth
 *   animica-x402 treasury sip --confirm     force one adaptive sip NOW
 *   animica-x402 treasury sweep --confirm   force one sweep of the surplus NOW
 *   animica-x402 treasury resume --confirm  clear a consecutive-failure disable
 *
 * Anything that SIGNS (sip/sweep/reconcile) takes the treasury's exclusive
 * lease from the shared DB first and refuses to run while the facilitator
 * service holds it: one signer per transaction-nonce lane, always.
 *
 * One exception to "the DBs hold none": random_commitments holds sealed
 * commit-reveal secrets. `commitments` never prints material the FREE public
 * reveal route would still be withholding — see cmdCommitments.
 *
 * Env: X402_DB_PATH (default ./state/x402.db), X402_GATEWAY_DB_PATH
 * (default ./state/x402-gateway.db), X402_CHAIN_INDEX_DB_PATH
 * (default ./state/x402-chain-index.db), X402_RPC_URL (reconcile),
 * X402_SETTLEMENT_ADDRESS (optional: enables the Transfer-log destination
 * check in reconcile). --json on any command emits machine-readable output.
 */

const path = require('node:path');

const { atomicToDecimalString } = require(path.join(__dirname, '..', 'src', 'metrics'));
const usdc = require(path.join(__dirname, '..', 'src', 'facilitator-evm', 'usdc'));

const DB_PATH = process.env.X402_DB_PATH || './state/x402.db';
const GATEWAY_DB_PATH = process.env.X402_GATEWAY_DB_PATH || './state/x402-gateway.db';
const CHAIN_INDEX_DB_PATH = process.env.X402_CHAIN_INDEX_DB_PATH || './state/x402-chain-index.db';

function openDb(dbPath, { writable = false } = {}) {
  const Database = require('better-sqlite3');
  try {
    return new Database(dbPath, writable ? { fileMustExist: true } : { readonly: true, fileMustExist: true });
  } catch (e) {
    fail(`cannot open ${dbPath}: ${e.message} (set X402_DB_PATH / X402_GATEWAY_DB_PATH)`);
  }
}

function fail(msg) {
  console.error(`error: ${msg}`);
  process.exit(1);
}

function parseArgs(argv) {
  const args = { _: [], flags: {} };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const next = argv[i + 1];
      if (next !== undefined && !next.startsWith('--')) {
        args.flags[key] = next;
        i++;
      } else {
        args.flags[key] = true;
      }
    } else {
      args._.push(a);
    }
  }
  return args;
}

/** '24h' | '7d' | '30m' | unix seconds | ISO date -> unix seconds. */
function parseSince(v, fallbackSec) {
  if (v === undefined || v === true) return fallbackSec;
  const rel = /^(\d+)([smhd])$/.exec(String(v));
  if (rel) {
    const mult = { s: 1, m: 60, h: 3600, d: 86400 }[rel[2]];
    return Math.floor(Date.now() / 1000) - Number(rel[1]) * mult;
  }
  if (/^\d{9,}$/.test(String(v))) return Number(v);
  const t = Date.parse(String(v));
  if (!Number.isNaN(t)) return Math.floor(t / 1000);
  fail(`cannot parse --since ${JSON.stringify(v)} (want 24h/7d/unix/ISO)`);
}

function fmtTs(sec) {
  return sec ? new Date(sec * 1000).toISOString() : '-';
}

function table(rows, cols) {
  if (rows.length === 0) return console.log('(no rows)');
  const widths = cols.map((c) => Math.max(c.length, ...rows.map((r) => String(r[c] ?? '').length)));
  console.log(cols.map((c, i) => c.padEnd(widths[i])).join('  '));
  for (const r of rows) console.log(cols.map((c, i) => String(r[c] ?? '').padEnd(widths[i])).join('  '));
}

function out(args, rows, cols) {
  if (args.flags.json) console.log(JSON.stringify(rows, null, 2));
  else table(rows, cols);
}

// ---------------------------------------------------------------- commands

function cmdSettlements(args) {
  const db = openDb(DB_PATH);
  const limit = Number(args.flags.limit || 50);
  const status = args.flags.status;
  const rows = status
    ? db.prepare('SELECT * FROM payments WHERE status = ? ORDER BY created_at DESC LIMIT ?').all(status, limit)
    : db.prepare('SELECT * FROM payments ORDER BY created_at DESC LIMIT ?').all(limit);
  out(args, rows.map((r) => ({
    payment_id: r.payment_id,
    status: r.status,
    payer: r.payer,
    amount_usdc: atomicToDecimalString(BigInt(r.amount), 6),
    resource: r.resource,
    tx: r.settlement_tx_hash || '-',
    created: fmtTs(r.created_at),
    settled: fmtTs(r.settled_at),
    error: r.error_reason || '',
  })), ['payment_id', 'status', 'payer', 'amount_usdc', 'resource', 'tx', 'created', 'settled', 'error']);
}

function cmdPaymentGet(args) {
  const id = args._[0];
  if (!id) fail('usage: animica-x402 payment get <payment_id | authorization_hash | tx_hash>');
  const db = openDb(DB_PATH);
  const row = db.prepare(
    'SELECT * FROM payments WHERE payment_id = ? OR authorization_hash = ? OR settlement_tx_hash = ?'
  ).get(id, id.toLowerCase(), id.toLowerCase());
  if (!row) fail(`no payment found for ${id}`);
  // raw_tx is a fully signed, rebroadcastable settlement transaction whose
  // calldata embeds the payer's EIP-3009 signature. Printing it puts a
  // replayable payment authorization into terminal scrollback, logs and
  // screenshots, so it is summarised unless explicitly demanded.
  const safe = { ...row };
  if (safe.raw_tx) {
    safe.raw_tx = args.flags['unsafe-show-raw']
      ? safe.raw_tx
      : `<redacted: ${String(safe.raw_tx).length} chars; --unsafe-show-raw to reveal>`;
  }
  if (args.flags.json) return console.log(JSON.stringify(safe, null, 2));
  for (const [k, v] of Object.entries(safe)) {
    const shown = k === 'amount' ? `${v} (= ${atomicToDecimalString(BigInt(v), 6)} USDC)` :
      (k === 'created_at' || k === 'settled_at' || k === 'expires_at') ? `${v} (${fmtTs(v)})` : v;
    console.log(`${k.padEnd(20)} ${shown ?? '-'}`);
  }
}

function cmdRevenue(args) {
  const db = openDb(DB_PATH);
  const since = parseSince(args.flags.since, 0);
  const rows = db.prepare(
    `SELECT resource, COUNT(*) AS n, GROUP_CONCAT(amount) AS amounts
     FROM payments WHERE status='settled' AND COALESCE(settled_at, created_at) >= ?
     GROUP BY resource ORDER BY n DESC`
  ).all(since);
  let total = 0n;
  const shaped = rows.map((r) => {
    let sum = 0n;
    for (const a of String(r.amounts || '').split(',').filter(Boolean)) sum += BigInt(a);
    total += sum;
    return { resource: r.resource || '(none)', settled: r.n, revenue_usdc: atomicToDecimalString(sum, 6) };
  });
  // Payments settled by a THIRD-PARTY facilitator are not in our payments
  // ledger — that DB is written by OUR facilitator, and since 2026-08-19 the
  // USDC lane settles at CDP. Without this the command reports the last
  // self-settled payment and reads as "nothing has sold since", which is the
  // opposite of the truth. Shown as a separate section because the two are not
  // the same kind of record: there is no gas accounting for a remote
  // settlement, because we no longer pay the gas.
  let remote = [];
  try {
    const gdb = openDb(GATEWAY_DB_PATH);
    remote = gdb.prepare(
      `SELECT product, resource, COUNT(*) AS n, SUM(CAST(amount_atomic AS INTEGER)) AS atomic
       FROM remote_settlements WHERE settled_at >= ?
       GROUP BY product ORDER BY atomic DESC`
    ).all(Math.floor(since / 1000));
  } catch { /* table absent on a gateway that never used a remote facilitator */ }

  const remoteTotal = remote.reduce((n, r) => n + BigInt(r.atomic || 0), 0n);
  const remoteShaped = remote.map((r) => ({
    resource: `${r.resource || r.product} (remote)`,
    settled: r.n,
    revenue_usdc: atomicToDecimalString(BigInt(r.atomic || 0), 6),
  }));

  out(args, shaped.concat(remoteShaped), ['resource', 'settled', 'revenue_usdc']);
  if (!args.flags.json) {
    const localCount = shaped.reduce((n, r) => n + r.settled, 0);
    const remoteCount = remote.reduce((n, r) => n + r.n, 0);
    console.log(`\nself-settled  since ${fmtTs(since)}: ${atomicToDecimalString(total, 6)} USDC (${localCount} settlements)`);
    if (remoteCount) {
      console.log(`remote-settled since ${fmtTs(since)}: ${atomicToDecimalString(remoteTotal, 6)} USDC (${remoteCount} settlements, no local gas)`);
    }
    console.log(`TOTAL         since ${fmtTs(since)}: ${atomicToDecimalString(total + remoteTotal, 6)} USDC (${localCount + remoteCount} settlements)`);
  }
}

async function rpcCall(url, method, params) {
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }),
    signal: AbortSignal.timeout(10000),
  });
  if (!res.ok) throw new Error(`rpc http ${res.status}`);
  const body = await res.json();
  if (body.error) throw new Error(body.error.message || 'rpc error');
  return body.result;
}

async function cmdReconcile(args) {
  const rpcUrl = process.env.X402_RPC_URL;
  if (!rpcUrl) fail('reconcile needs X402_RPC_URL (an EVM RPC for the settlement chain)');
  const payTo = process.env.X402_SETTLEMENT_ADDRESS || null;
  const db = openDb(DB_PATH);
  const limit = Number(args.flags.limit || 50);
  const rows = db.prepare("SELECT * FROM payments WHERE status='settled' ORDER BY settled_at DESC LIMIT ?").all(limit);
  const results = [];
  let bad = 0;
  for (const r of rows) {
    const entry = { payment_id: r.payment_id, tx: r.settlement_tx_hash || '-', verdict: '', detail: '' };
    try {
      if (!r.settlement_tx_hash) {
        entry.verdict = 'MISSING_TX';
        entry.detail = 'settled row has no settlement_tx_hash';
        bad++;
      } else {
        const receipt = await rpcCall(rpcUrl, 'eth_getTransactionReceipt', [r.settlement_tx_hash]);
        if (!receipt) {
          entry.verdict = 'NO_RECEIPT';
          entry.detail = 'chain has no receipt for this tx (dropped? wrong RPC?)';
          bad++;
        } else if (payTo) {
          const check = usdc.validateSettlementReceipt(receipt, {
            token: r.asset, payer: r.payer, payTo, value: BigInt(r.amount), nonce: r.auth_nonce || '0x' + '0'.repeat(64),
          });
          entry.verdict = check.ok ? 'OK' : 'MISMATCH';
          entry.detail = check.ok ? 'status+AuthorizationUsed+Transfer all match' : check.reason;
          if (!check.ok) bad++;
        } else {
          // Without X402_SETTLEMENT_ADDRESS we can still check status and
          // the AuthorizationUsed(payer, nonce) log.
          const okStatus = receipt.status === '0x1';
          const logs = Array.isArray(receipt.logs) ? receipt.logs : [];
          const authOk = !r.auth_nonce || logs.some((l) =>
            Array.isArray(l.topics) && l.topics[0] === usdc.TOPICS.authorizationUsed &&
            l.topics.length >= 3 && l.topics[2].toLowerCase() === r.auth_nonce.toLowerCase());
          entry.verdict = okStatus && authOk ? 'OK(partial)' : 'MISMATCH';
          entry.detail = okStatus
            ? (authOk ? 'status+nonce ok (set X402_SETTLEMENT_ADDRESS for the full Transfer check)' : 'AuthorizationUsed nonce not found')
            : 'receipt status is not success';
          if (!(okStatus && authOk)) bad++;
        }
      }
    } catch (e) {
      entry.verdict = 'ERROR';
      entry.detail = e.message;
      bad++;
    }
    results.push(entry);
  }
  out(args, results, ['payment_id', 'tx', 'verdict', 'detail']);
  if (!args.flags.json) console.log(`\nchecked ${results.length} settled payments: ${results.length - bad} ok, ${bad} needing attention`);
  if (bad > 0) process.exitCode = 1;
}

function cmdGasReport(args) {
  const db = openDb(DB_PATH);
  const since = parseSince(args.flags.since, 0);
  const rows = db.prepare('SELECT spent_wei, created_at FROM gas_spend WHERE created_at >= ? ORDER BY created_at').all(since);
  const byDay = new Map();
  let total = 0n;
  for (const r of rows) {
    const day = new Date(r.created_at * 1000).toISOString().slice(0, 10);
    const cur = byDay.get(day) || { day, settlements: 0, wei: 0n };
    cur.settlements += 1;
    cur.wei += BigInt(r.spent_wei);
    total += BigInt(r.spent_wei);
    byDay.set(day, cur);
  }
  const shaped = [...byDay.values()].map((d) => ({
    day: d.day, settlements: d.settlements, gas_wei: d.wei.toString(), gas_eth: atomicToDecimalString(d.wei, 18),
  }));
  out(args, shaped, ['day', 'settlements', 'gas_wei', 'gas_eth']);
  if (!args.flags.json) console.log(`\ntotal: ${total.toString()} wei (${atomicToDecimalString(total, 18)} ETH incl. OP-stack L1 data fees) over ${rows.length} entries`);
}

function cmdIncidents(args) {
  const sub = args._[0];
  if (sub === 'resolve') {
    const id = args._[1];
    const status = args.flags.status;
    if (!id || !['refunded', 'resolved'].includes(status)) {
      fail('usage: animica-x402 incidents resolve <incident_id> --status refunded|resolved');
    }
    const db = openDb(GATEWAY_DB_PATH, { writable: true });
    const r = db.prepare('UPDATE incidents SET status = ? WHERE incident_id = ?').run(status, id);
    if (r.changes !== 1) fail(`incident ${id} not found`);
    return console.log(`incident ${id} -> ${status}`);
  }
  // default: list
  const db = openDb(GATEWAY_DB_PATH);
  const status = args.flags.status;
  const limit = Number(args.flags.limit || 100);
  const rows = status
    ? db.prepare('SELECT * FROM incidents WHERE status = ? ORDER BY created_at DESC LIMIT ?').all(status, limit)
    : db.prepare('SELECT * FROM incidents ORDER BY created_at DESC LIMIT ?').all(limit);
  out(args, rows.map((r) => ({
    incident_id: r.incident_id,
    status: r.status,
    kind: r.kind,
    resource: r.resource,
    amount: r.amount === null ? '-' : atomicToDecimalString(BigInt(r.amount), 6),
    payer: r.payer || '-',
    tx: r.settlement_tx || '-',
    created: fmtTs(r.created_at),
    error: (r.error || '').slice(0, 60),
  })), ['incident_id', 'status', 'kind', 'resource', 'amount', 'payer', 'tx', 'created', 'error']);
}

/**
 * Address-index status: the operator's window on the walker that backs
 * chain_address_history. Read-only. `lag` is measured against the head the
 * walker last SAW, so a stale last_tick is itself the signal — the product's
 * own gate re-resolves the live head before it agrees to sell anything.
 */
function cmdIndex(args) {
  const sub = args._[0];
  if (sub !== undefined && sub !== 'status') fail('usage: animica-x402 index status');
  const db = openDb(CHAIN_INDEX_DB_PATH);
  const meta = Object.fromEntries(db.prepare('SELECT key, value FROM meta').all().map((r) => [r.key, r.value]));
  const indexed = meta.indexed_height === undefined ? -1 : Number(meta.indexed_height);
  const head = meta.head_height === undefined ? null : Number(meta.head_height);
  const lastTickMs = meta.last_tick_ms ? Number(meta.last_tick_ms) : 0;
  const row = {
    db: CHAIN_INDEX_DB_PATH,
    indexed_height: indexed,
    head_height: head === null ? '-' : head,
    lag: head === null ? '-' : head - indexed,
    blocks: db.prepare('SELECT COUNT(*) AS n FROM blocks').get().n,
    rows: db.prepare('SELECT COUNT(*) AS n FROM address_tx').get().n,
    accounts: db.prepare('SELECT COUNT(DISTINCT digest) AS n FROM address_tx').get().n,
    caught_up: meta.caught_up_ms ? fmtTs(Math.floor(Number(meta.caught_up_ms) / 1000)) : 'never',
    last_tick: lastTickMs ? fmtTs(Math.floor(lastTickMs / 1000)) : 'never',
    last_tick_age_s: lastTickMs ? Math.round((Date.now() - lastTickMs) / 1000) : '-',
  };
  out(args, [row], [
    'indexed_height', 'head_height', 'lag', 'blocks', 'rows', 'accounts', 'caught_up', 'last_tick', 'last_tick_age_s',
  ]);
}

/**
 * Commit-reveal commitments (random_commit). The rows hold the only secrets
 * in any of these DBs, so this command has ONE rule: it never discloses
 * material the free public reveal route would not. While `now <
 * reveal_after` the commitment is sealed and `secret`/`salt` print as
 * `<sealed>`; once the reveal window is open the same bytes are already
 * world-readable at GET /x402/random/reveal/{id}, so printing them here
 * reveals nothing new. `list` never prints them at all.
 */
/**
 * PROMO CREDIT VOUCHERS.
 *
 * The friction on a first x402 call is not the half-cent price — it is
 * everything in front of it: install a client, fund a wallet with USDC on
 * Base, implement EIP-3009 signing. That is a two-hour integration to
 * evaluate a $0.005 API, and nobody does it on spec. A voucher collapses it
 * to one HTTP header.
 *
 * These vouchers are minted by the OPERATOR, not bought, so they carry no
 * settlement_tx and are labelled `promo:*` — the ledger must never suggest
 * money arrived that did not. They are otherwise identical to purchased
 * credit and spend through the same debit path.
 */
function cmdCredits(args) {
  const sub = args._[0];
  const crypto = require('node:crypto');
  const nowSec = Math.floor(Date.now() / 1000);

  if (sub === 'mint') {
    const usd = String(args.flags.value || '0.25');
    if (!/^\d+(\.\d{1,6})?$/.test(usd)) fail('--value must be a decimal USD amount, e.g. 0.25');
    const count = Number(args.flags.count || 1);
    if (!Number.isInteger(count) || count < 1 || count > 100) fail('--count must be 1..100');
    const days = Number(args.flags.days || 90);
    const label = args.flags.label ? String(args.flags.label) : 'promo';
    // USD -> atomic USDC (6dp), integer math only.
    const [w, f = ''] = usd.split('.');
    const atomic = BigInt(w) * 1000000n + BigInt((f + '000000').slice(0, 6));
    if (atomic <= 0n) fail('--value must be greater than zero');

    const db = openDb(GATEWAY_DB_PATH, { writable: true });
    const ins = db.prepare(`INSERT INTO credit_vouchers
      (voucher_id, label, minted_atomic, bonus_atomic, balance_atomic, payer, settlement_tx,
       created_at, expires_at, revoked, last_used_at, spend_count)
      VALUES (@voucher_id, @label, @minted_atomic, '0', @balance_atomic, NULL, NULL,
       @created_at, @expires_at, 0, NULL, 0)`);
    const minted = [];
    for (let i = 0; i < count; i++) {
      const token = 'anmc_' + crypto.randomBytes(32).toString('base64url');
      const voucherId = crypto.createHash('sha256').update(token, 'utf8').digest('hex');
      ins.run({
        voucher_id: voucherId,
        label: `promo:${label}${count > 1 ? '#' + (i + 1) : ''}`,
        minted_atomic: atomic.toString(),
        balance_atomic: atomic.toString(),
        created_at: nowSec,
        expires_at: nowSec + days * 86400,
      });
      minted.push({ token, voucherId });
    }
    db.close();

    if (args.flags.json) {
      return console.log(JSON.stringify({ minted: minted.map((m) => ({ token: m.token, voucher_id: m.voucherId })), value_usd: usd, expires_days: days }, null, 2));
    }
    console.log(`minted ${count} voucher(s) worth $${usd} each, valid ${days} days\n`);
    for (const m of minted) {
      console.log('─'.repeat(78));
      console.log(`token      ${m.token}`);
      console.log(`voucher_id ${m.voucherId.slice(0, 16)}…   (this is what the DB stores; the token is not)`);
      console.log(`
Try it — no wallet, no gas, no x402 client:

  curl -s -X POST https://animica.dev/x402/web/fetch \\
    -H 'content-type: application/json' \\
    -H 'X-Animica-Credits: ${m.token}' \\
    -d '{"url":"https://example.com"}'

  # balance + full spend history, free:
  curl -s https://animica.dev/x402/credits/balance \\
    -H 'X-Animica-Credits: ${m.token}'

Spends on any of the 24 paid products: https://animica.dev/.well-known/x402
`);
    }
    console.log('─'.repeat(78));
    console.log('The token is shown ONCE and stored only as its SHA-256 hash — save it now.');
    return undefined;
  }

  if (sub === 'list') {
    const db = openDb(GATEWAY_DB_PATH);
    const rows = db.prepare(`SELECT voucher_id, label, minted_atomic, balance_atomic, spend_count,
        created_at, expires_at, revoked, settlement_tx
        FROM credit_vouchers ORDER BY created_at DESC LIMIT ?`).all(Number(args.flags.limit || 50));
    db.close();
    if (args.flags.json) return console.log(JSON.stringify(rows, null, 2));
    if (!rows.length) return console.log('no vouchers');
    console.log('voucher_id        label                 minted     balance    spends  origin   expires');
    for (const r of rows) {
      console.log([
        r.voucher_id.slice(0, 16),
        String(r.label || '').padEnd(20).slice(0, 20),
        atomicToDecimalString(r.minted_atomic, 6).padStart(9),
        atomicToDecimalString(r.balance_atomic, 6).padStart(10),
        String(r.spend_count).padStart(6),
        (r.settlement_tx ? 'paid' : 'promo').padEnd(7),
        fmtTs(r.expires_at) + (r.revoked ? '  REVOKED' : ''),
      ].join(' '));
    }
    return undefined;
  }

  if (sub === 'revoke') {
    const id = args._[1];
    if (!id) fail('usage: animica-x402 credits revoke <voucher_id>');
    const db = openDb(GATEWAY_DB_PATH, { writable: true });
    const r = db.prepare('UPDATE credit_vouchers SET revoked = 1 WHERE voucher_id = ?').run(String(id));
    db.close();
    return console.log(r.changes === 1 ? `revoked ${id}` : `no voucher ${id}`);
  }

  return fail('usage: animica-x402 credits mint [--value 0.25] [--count N] [--label name] [--days 90] | list | revoke <voucher_id>');
}

function cmdCommitments(args) {
  const sub = args._[0];
  const nowSec = Math.floor(Date.now() / 1000);

  if (sub === 'prune') {
    const cutoff = parseSince(args.flags['older-than'], nowSec - 90 * 24 * 3600);
    const db = openDb(GATEWAY_DB_PATH, { writable: true });
    const r = db.prepare('DELETE FROM random_commitments WHERE created_at < ?').run(cutoff);
    return console.log(`pruned ${r.changes} commitment(s) created before ${fmtTs(cutoff)}`);
  }

  const db = openDb(GATEWAY_DB_PATH);
  const stateOf = (r) => (r.revealed_at !== null ? 'revealed' : (nowSec < r.reveal_after ? 'sealed' : 'open'));

  if (sub === 'get') {
    const id = args._[1];
    if (!id) fail('usage: animica-x402 commitments get <commit_id>');
    const r = db.prepare('SELECT * FROM random_commitments WHERE commit_id = ?').get(id);
    if (!r) fail(`commitment ${id} not found`);
    const state = stateOf(r);
    const sealed = state === 'sealed';
    const draw = JSON.parse(r.draw_json || '{}');
    const row = {
      commit_id: r.commit_id,
      state,
      commitment: r.commitment,
      algorithm: r.algorithm,
      kind: r.kind,
      request_id: r.request_id || '',
      memo: r.memo || '',
      created: fmtTs(r.created_at),
      reveal_after: fmtTs(r.reveal_after),
      revealed: r.revealed_at ? fmtTs(r.revealed_at) : '-',
      // Withheld while sealed — the CLI must never break a seal early.
      secret: sealed ? '<sealed>' : r.secret_hex,
      salt: sealed ? '<sealed>' : r.salt_hex,
      randomness: sealed ? '<sealed>' : (draw.bytes_hex || '-'),
      attestation_digest: (draw.attestation && draw.attestation.digest_hex) || '-',
      attested: draw.attestation ? Boolean(draw.attestation.attested) : '-',
      entropy_source: (draw.source && draw.source.name) || '-',
    };
    if (args.flags.json) return console.log(JSON.stringify(row, null, 2));
    for (const [k, v] of Object.entries(row)) console.log(`${k.padEnd(20)} ${v}`);
    return undefined;
  }

  if (sub !== undefined && sub !== 'list') fail('usage: animica-x402 commitments list|get <id>|prune [--older-than 90d]');
  const limit = Number(args.flags.limit || 100);
  const want = args.flags.state;
  if (want !== undefined && !['sealed', 'open', 'revealed'].includes(want)) {
    fail('--state must be sealed|open|revealed');
  }
  const rows = db.prepare('SELECT * FROM random_commitments ORDER BY created_at DESC LIMIT ?').all(limit)
    .map((r) => ({
      commit_id: r.commit_id,
      state: stateOf(r),
      commitment: r.commitment.slice(0, 16) + '…',
      request_id: r.request_id || '-',
      memo: (r.memo || '-').slice(0, 32),
      created: fmtTs(r.created_at),
      reveal_after: fmtTs(r.reveal_after),
      revealed: r.revealed_at ? fmtTs(r.revealed_at) : '-',
    }))
    .filter((r) => want === undefined || r.state === want);
  return out(args, rows, ['commit_id', 'state', 'commitment', 'request_id', 'memo', 'created', 'reveal_after', 'revealed']);
}

/* ------------------------------------------------------------- treasury -- */

/**
 * Treasury commands. `status`/`history` are read-only and work with nothing
 * but the DB. `sip`/`sweep`/`resume` MUTATE and need the facilitator's own
 * environment (key + RPC), so they are gated on --confirm.
 *
 * WARNING carried into the help text and the docs: a manual sip/sweep signs
 * a transaction from the facilitator wallet using the account's `pending`
 * nonce. If the facilitator service is running it owns that nonce lane
 * behind its own submit lock, which this process cannot see — so a manual
 * send can collide with a settlement in flight. Either stop the unit first
 * or accept that one of the two may need a retry.
 */
function treasuryTables(db) {
  const has = db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name IN ('treasury_actions','treasury_state')").all();
  return has.length === 2;
}

function cmdTreasuryStatus(args) {
  const db = openDb(DB_PATH);
  if (!treasuryTables(db)) {
    if (args.flags.json) return console.log(JSON.stringify({ enabled: false, detail: 'treasury has never run against this DB' }, null, 2));
    return console.log('treasury: no treasury_actions table in this DB — the module has never run (X402_TREASURY_ENABLED=0?)');
  }
  const state = Object.fromEntries(db.prepare('SELECT key, value FROM treasury_state').all().map((r) => [r.key, r.value]));
  const sinceDay = Math.floor(Date.now() / 1000) - 86400;
  const sipsToday = db.prepare(
    "SELECT COALESCE(SUM(CAST(usdc_amount AS INTEGER)), 0) AS n, COUNT(*) AS c FROM treasury_actions WHERE kind='sip' AND status IN ('submitting','confirmed') AND created_at >= ?"
  ).get(sinceDay);
  const totals = db.prepare(
    "SELECT kind, status, COUNT(*) AS n, GROUP_CONCAT(COALESCE(usdc_amount,'0')) AS usdc, GROUP_CONCAT(COALESCE(eth_received_wei,'0')) AS eth, GROUP_CONCAT(COALESCE(gas_spent_wei,'0')) AS gas FROM treasury_actions GROUP BY kind, status"
  ).all();
  const sum = (s) => String(s || '').split(',').filter(Boolean).reduce((a, b) => { try { return a + BigInt(b); } catch (e) { return a; } }, 0n);
  const agg = { sipped: 0n, swept: 0n, eth: 0n, gas: 0n, counts: {} };
  for (const r of totals) {
    agg.counts[`${r.kind}_${r.status}`] = r.n;
    agg.gas += sum(r.gas);
    if (r.status === 'confirmed' && r.kind === 'sip') { agg.sipped += sum(r.usdc); agg.eth += sum(r.eth); }
    if (r.status === 'confirmed' && r.kind === 'sweep') agg.swept += sum(r.usdc);
  }
  const lastSip = db.prepare("SELECT * FROM treasury_actions WHERE kind='sip' ORDER BY created_at DESC LIMIT 1").get();
  const lastSweep = db.prepare("SELECT * FROM treasury_actions WHERE kind='sweep' ORDER BY created_at DESC LIMIT 1").get();

  // Policy/live view is best-effort: it needs the facilitator's own env.
  let live = null;
  try {
    const cfgMod = require(path.join(__dirname, '..', 'src', 'config'));
    const cfg = cfgMod.loadEvmFacilitatorConfig(process.env);
    live = {
      network: cfg.network,
      settlement_address: cfg.settlementAddress,
      treasury_enabled: cfg.treasury.enabled,
      cold_address: cfg.treasury.coldAddress || '(unset)',
      eth_floor_wei: cfg.treasury.ethFloorWei.toString(),
      sip_usdc: atomicToDecimalString(cfg.treasury.sipUsdcAtomic, 6),
      sip_min_usdc: atomicToDecimalString(cfg.treasury.sipMinUsdcAtomic, 6),
      daily_budget_usdc: atomicToDecimalString(cfg.treasury.dailySwapBudgetAtomic, 6),
      ceiling_usdc: atomicToDecimalString(cfg.treasury.usdcCeilingAtomic, 6),
      cooldown_s: cfg.treasury.sipCooldownS,
      slippage_bps: cfg.treasury.maxSlippageBps,
      pool_fees: cfg.treasury.poolFees.join(','),
    };
  } catch (e) {
    live = { config: `unavailable (${e.message.split('\n')[0]})` };
  }

  const row = {
    sipping_disabled: state.sipping_disabled === '1',
    sipping_disabled_reason: state.sipping_disabled_reason || '',
    sip_consecutive_failures: Number(state.sip_consecutive_failures || 0),
    sweeping_disabled: state.sweeping_disabled === '1',
    sweep_consecutive_failures: Number(state.sweep_consecutive_failures || 0),
    sips_confirmed: agg.counts.sip_confirmed || 0,
    sips_failed: agg.counts.sip_failed || 0,
    sweeps_confirmed: agg.counts.sweep_confirmed || 0,
    sweeps_failed: agg.counts.sweep_failed || 0,
    sipped_usdc_total: atomicToDecimalString(agg.sipped, 6),
    swept_usdc_total: atomicToDecimalString(agg.swept, 6),
    eth_received_total_wei: agg.eth.toString(),
    treasury_gas_wei: agg.gas.toString(),
    sip_usdc_last_24h: atomicToDecimalString(BigInt(sipsToday.n || 0), 6),
    sips_last_24h: sipsToday.c,
    last_sip: lastSip ? `${fmtTs(lastSip.created_at)} ${lastSip.status} ${lastSip.tx_hash || '-'}` : 'never',
    last_sweep: lastSweep ? `${fmtTs(lastSweep.created_at)} ${lastSweep.status} ${lastSweep.tx_hash || '-'}` : 'never',
  };
  if (args.flags.json) return console.log(JSON.stringify({ ...row, config: live }, null, 2));
  for (const [k, v] of Object.entries(live)) console.log(`${k.padEnd(26)} ${v}`);
  console.log('');
  for (const [k, v] of Object.entries(row)) console.log(`${k.padEnd(26)} ${v}`);
  return undefined;
}

function cmdTreasuryHistory(args) {
  const db = openDb(DB_PATH);
  if (!treasuryTables(db)) return console.log('(no treasury history in this DB)');
  const limit = Number(args.flags.limit || 50);
  const kind = args.flags.kind;
  const rows = kind
    ? db.prepare('SELECT * FROM treasury_actions WHERE kind = ? ORDER BY created_at DESC, rowid DESC LIMIT ?').all(kind, limit)
    : db.prepare('SELECT * FROM treasury_actions ORDER BY created_at DESC, rowid DESC LIMIT ?').all(limit);
  out(args, rows.map((r) => ({
    action_id: r.action_id,
    kind: r.kind,
    status: r.status,
    trigger: r.trigger,
    usdc: r.usdc_amount === null ? '-' : atomicToDecimalString(BigInt(r.usdc_amount), 6),
    eth_received_wei: r.eth_received_wei || '-',
    fee: r.pool_fee === null ? '-' : r.pool_fee,
    destination: r.destination || '-',
    tx: r.tx_hash || '-',
    created: fmtTs(r.created_at),
    error: (r.error || '').slice(0, 48),
  })), ['action_id', 'kind', 'status', 'trigger', 'usdc', 'eth_received_wei', 'fee', 'destination', 'tx', 'created', 'error']);
}

/** Build a live treasury from the facilitator's own environment. */
function liveTreasury() {
  const cfgMod = require(path.join(__dirname, '..', 'src', 'config'));
  const { loadSigner } = require(path.join(__dirname, '..', 'src', 'facilitator-evm', 'key'));
  const { createRpcClient } = require(path.join(__dirname, '..', 'src', 'facilitator-evm', 'rpc'));
  const { createMetrics } = require(path.join(__dirname, '..', 'src', 'metrics'));
  const { createLogger } = require(path.join(__dirname, '..', 'src', 'logging'));
  const { createTreasury, createTreasuryStore, assertTreasuryPolicy } = require(path.join(__dirname, '..', 'src', 'treasury'));

  const cfg = cfgMod.loadEvmFacilitatorConfig(process.env);
  if (!cfg.treasury.enabled) fail('X402_TREASURY_ENABLED is not 1 in this environment — refusing to move money the service is not configured to move');
  const signer = loadSigner(cfg.privateKey);
  delete cfg.privateKey;
  assertTreasuryPolicy(cfg, signer.address);
  const db = openDb(DB_PATH, { writable: true });
  const tstore = createTreasuryStore(db);
  const rpc = createRpcClient(cfg.rpcUrl, { timeoutMs: cfg.rpcTimeoutMs, retries: cfg.rpcRetries });
  const logger = createLogger({ service: 'animica-x402-cli', format: process.env.X402_LOG_FORMAT || 'pretty' });
  return createTreasury({ cfg, rpc, tstore, signer, metrics: createMetrics(), logger });
}

/**
 * Everything below signs from the facilitator wallet, i.e. it writes to the
 * SAME transaction-nonce lane the running service uses. Two signers on one
 * lane is how a manual sip takes a live settlement's nonce and gets it
 * rejected as an underpriced replacement — so this process must hold the
 * treasury's exclusive lease (a TTL row in the shared DB) before it signs,
 * and the running facilitator holds that lease continuously.
 */
async function withTreasuryLease(fn) {
  const treasury = liveTreasury();
  const lease = treasury.acquireLease({ label: `cli:${process.pid}`, ttlS: 300 });
  if (!lease.ok) {
    const holder = lease.holder || {};
    fail(
      'the treasury signing lease is held by another process'
      + (holder.label ? ` (${holder.label})` : '')
      + '. The running facilitator holds it continuously: stop animica-x402-facilitator.service first,\n'
      + '       or wait for the lease to expire. Signing anyway would put two writers on one nonce lane,\n'
      + '       which rejects a live settlement as an underpriced replacement.'
    );
  }
  try {
    return await fn(treasury);
  } finally {
    try { treasury.releaseLease(); } catch (e) { /* best effort */ }
  }
}

async function cmdTreasuryAction(kind, args) {
  if (!args.flags.confirm) {
    fail(`treasury ${kind} moves real money — re-run with --confirm.\n`
      + '       This signs from the facilitator wallet. It takes the treasury signing lease first and\n'
      + '       refuses to run while the facilitator service holds it (one signer per nonce lane).');
  }
  return withTreasuryLease(async (treasury) => {
    // Resolve anything left in flight before signing something new: a
    // treasury transaction with an unknown outcome sits in front of every
    // settlement in the same nonce lane.
    const recovery = await treasury.recover({ trigger: 'cli' });
    if (recovery.checked) console.error(`(recovered ${JSON.stringify(recovery)})`);
    const result = kind === 'sip' ? await treasury.sipNow() : await treasury.sweepNow();
    if (args.flags.json) {
      console.log(JSON.stringify(result, (k, v) => (typeof v === 'bigint' ? v.toString() : v), 2));
    } else {
      for (const [k, v] of Object.entries(result)) console.log(`${k.padEnd(20)} ${typeof v === 'bigint' ? v.toString() : v}`);
    }
    if (result.action !== 'sipped' && result.action !== 'swept') process.exitCode = 1;
    return undefined;
  });
}

/** Resolve in-flight treasury transactions from chain truth (no new signing). */
async function cmdTreasuryReconcile(args) {
  return withTreasuryLease(async (treasury) => {
    const report = await treasury.recover({ trigger: 'cli' });
    if (args.flags.json) return console.log(JSON.stringify(report, null, 2));
    for (const [k, v] of Object.entries(report)) console.log(`${k.padEnd(16)} ${v}`);
    return undefined;
  });
}

function cmdTreasuryResume(args) {
  if (!args.flags.confirm) fail('treasury resume re-arms automatic swaps — re-run with --confirm (fix the cause first)');
  const treasury = liveTreasury();
  const was = treasury.resume();
  console.log(`treasury re-armed (was: sipping_disabled=${was.sipping_disabled}, sweeping_disabled=${was.sweeping_disabled})`);
}

async function cmdTreasury(args) {
  // parseArgs already split flags out; args._[0] is the subcommand (if any).
  const sub = args._[0];
  if (sub === undefined || sub === 'status') return cmdTreasuryStatus(args);
  if (sub === 'history') return cmdTreasuryHistory(args);
  if (sub === 'sip') return cmdTreasuryAction('sip', args);
  if (sub === 'sweep') return cmdTreasuryAction('sweep', args);
  if (sub === 'reconcile') return cmdTreasuryReconcile(args);
  if (sub === 'resume') return cmdTreasuryResume(args);
  return fail('usage: animica-x402 treasury status|history|reconcile|sip --confirm|sweep --confirm|resume --confirm');
}

function usage() {
  console.log(`animica-x402 — x402 operator CLI (local DBs only)

  settlements list [--status s] [--limit N]   settlement ledger
  payment get <id|auth_hash|tx_hash>          one payment, full detail
  revenue [--since 24h|7d|unix|ISO]           settled revenue per product
  reconcile [--limit N]                       settled rows vs chain receipts (X402_RPC_URL)
  gas report [--since ...]                    gas expenditure (incl. L1 data fee)
  incidents list [--status open]              paid-but-failed ledger (gateway DB)
  incidents resolve <id> --status refunded|resolved
  index status                                address-index backfill/lag (chain_address_history)
  commitments list [--state sealed|open|revealed]   commit-reveal ledger (random_commit)
  commitments get <commit_id>                 one commitment (secret withheld while sealed)
  commitments prune [--older-than 90d]        drop old commitments
  credits mint [--value 0.25] [--count N] [--label name] [--days 90]
                                              mint PROMO vouchers (operator, not bought)
  credits list [--limit N]                    vouchers, with paid vs promo origin
  credits revoke <voucher_id>                 disable a voucher
  treasury status                             sweep-and-sip policy, breaker state, totals
  treasury history [--kind sip|sweep|approve] sip/sweep ledger
  treasury reconcile                          resolve in-flight treasury txs from the chain
  treasury sip --confirm                      force one adaptive sip now (real money)
  treasury sweep --confirm                    force one sweep to the cold address (real money)
  treasury resume --confirm                   clear a consecutive-failure disable
  --json on any command for machine output`);
}

async function main() {
  const [cmd, sub, ...rest] = process.argv.slice(2);
  if (cmd === 'settlements' && sub === 'list') return cmdSettlements(parseArgs(rest));
  if (cmd === 'payment' && sub === 'get') return cmdPaymentGet(parseArgs(rest));
  if (cmd === 'revenue') return cmdRevenue(parseArgs(sub === undefined ? [] : [sub, ...rest]));
  if (cmd === 'reconcile') return cmdReconcile(parseArgs(sub === undefined ? [] : [sub, ...rest]));
  if (cmd === 'gas') return cmdGasReport(parseArgs(rest));
  if (cmd === 'incidents') return cmdIncidents(parseArgs([sub, ...rest].filter((x) => x !== undefined)));
  if (cmd === 'index') return cmdIndex(parseArgs([sub, ...rest].filter((x) => x !== undefined)));
  if (cmd === 'credits') return cmdCredits(parseArgs([sub, ...rest].filter((x) => x !== undefined)));
  if (cmd === 'commitments') return cmdCommitments(parseArgs([sub, ...rest].filter((x) => x !== undefined)));
  if (cmd === 'treasury') return cmdTreasury(parseArgs([sub, ...rest].filter((x) => x !== undefined)));
  usage();
  if (cmd !== undefined && cmd !== 'help' && cmd !== '--help') process.exit(1);
}

main().catch((e) => fail(e.message));
