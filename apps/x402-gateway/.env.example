# Animica x402 gateway + self-hosted EVM facilitator — environment template.
#
#   install -m 0600 /dev/null /etc/animica-x402.env    # create as 0600 FIRST,
#   then fill it in — the facilitator key must never exist in a readable file
#   even briefly. Both systemd units (systemd/) read this one file via
#   EnvironmentFile=. NEVER commit a filled-in copy. All placeholders below
#   are intentionally empty; defaults in comments apply when unset.
#   (systemd EnvironmentFile is not a shell file: no quoting/expansion —
#   values are taken literally, so avoid characters like `$` in secrets.)

# ------------------------------------------------------------ master switch
ANM_X402_ENABLED=            # 1 to enable; anything else refuses to gate/serve

# ------------------------------------------------------------ gateway (demo)
# REQUIRED when X402_ENV=production (startup fails on an unset or loopback
# value): it is published in every 402 resource.url AND in the commit-reveal
# reveal_url a buyer hands to their players.
X402_RESOURCE_BASE_URL=      # default http://127.0.0.1:4656 (production: https://animica.dev)
X402_SERVICE_NAME=           # default Animica
X402_DEMO_PORT=              # default 4656 (binds 127.0.0.1)

# ------------------------------------------- production gateway (src/server.js)
X402_ENV=                    # development (default) | production (disables echo)
X402_ENABLE_ECHO=            # 1 re-enables the dev echo route in production
X402_GATEWAY_BIND=           # default 127.0.0.1 — keep loopback; nginx fronts it
X402_GATEWAY_PORT=           # default 8742
X402_GATEWAY_DB_PATH=        # default ./state/x402-gateway.db (idempotency + incidents)
X402_ANIMICA_RPC_URL=        # default http://127.0.0.1:8545/rpc (LOCAL node only)
X402_RECEIPT_HMAC_KEY=       # REQUIRED in production: signs error receipts (any long random string)
X402_IDEMPOTENCY_MAX_BODY_BYTES=  # default 4000000
X402_IDEMPOTENCY_TTL_SECONDS=     # default 604800 (7 days)

# --------------------------------------------------- product: qrng ($0.01)
X402_QRNG_ENABLED=           # default 1
X402_QRNG_PRICE_USDC=        # default 0.01 (USD decimal string)
X402_QRNG_MAX_BYTES=         # default 1024 random bytes per draw
X402_QRNG_TIMEOUT_MS=        # default 5000

# ------------------------------- products: randomness family (int/shuffle/
# pick/bulk/commit-reveal). All five buy ONE draw through the qrng source
# above (so they inherit X402_QRNG_TIMEOUT_MS and its health gate) and then
# derive deterministically — see src/products/derive.js for the published
# rules. Setting X402_RANDOM_ENABLED=0 unroutes all of them, including the
# free reveal endpoint.
X402_RANDOM_ENABLED=              # default 1
X402_RANDOM_INT_PRICE_USDC=       # default 0.01
X402_RANDOM_SHUFFLE_PRICE_USDC=   # default 0.02
X402_RANDOM_PICK_PRICE_USDC=      # default 0.02
X402_RANDOM_BULK_PRICE_USDC=      # default 0.05 for up to X402_RANDOM_BULK_MAX_DRAWS
                                  # INDEPENDENT draws (one node call + one
                                  # attestation each) in ONE settlement. The
                                  # minimum accepted draw count is derived from
                                  # this price: floor(bulk/qrng)+1 (6 at the
                                  # defaults), so the batch is always cheaper
                                  # than the same number of single draws.
                                  # Below that it is a 400 pointing at
                                  # /x402/qrng/draw; if the price can never
                                  # beat MAX_DRAWS single draws the product
                                  # reports available:false instead of selling
                                  # a "discount" that is a premium.
X402_RANDOM_COMMIT_PRICE_USDC=    # default 0.02
X402_RANDOM_SEED_BYTES=           # default 32 — a full DRNG seed; the SHA3
                                  # counter-mode stream expands it, so more
                                  # bytes would buy nothing (bulk is the
                                  # exception: there the bytes ARE the product)
X402_RANDOM_MAX_INTS=             # default 1000 integers per request
X402_RANDOM_MAX_ITEMS=            # default 10000 items per shuffle/pick
X402_RANDOM_MAX_PICKS=            # default 1000 picks per request
X402_RANDOM_MAX_BODY_BYTES=       # default 512000 (shuffle/pick JSON bodies)
X402_RANDOM_MAX_RESPONSE_BYTES=   # default 4000000 — OUTPUT cap, checked
                                  # before settlement. Input caps alone do not
                                  # bound the answer: pick with replace:true
                                  # can emit one large item k times, so a
                                  # 512 KB request could ask for a ~512 MB
                                  # response. Over it: 400 response_too_large
                                  # with an indices_only hint, never a charge.
X402_RANDOM_BULK_MAX_DRAWS=       # default 10 independent draws per bulk call
X402_RANDOM_MAX_DRAW_BYTES=       # default 65536 total bytes per bulk call
X402_RANDOM_COMMIT_MAX_DELAY_SECONDS=  # default 604800 (7 d) reveal delay cap
X402_RANDOM_COMMIT_TTL_SECONDS=   # default 7776000 (90 d) retention for
                                  # sealed/revealed commitments; the free
                                  # reveal 404 states this window verbatim

# --------------------------------------------- product: bulk chain ($0.05)
X402_BULK_CHAIN_ENABLED=     # default 1
X402_BULK_CHAIN_PRICE_USDC=  # default 0.05
X402_BULK_MAX_BLOCKS=        # default 1000 blocks/request
X402_BULK_MAX_TX_RECORDS=    # default 10000 tx rows/request
X402_BULK_MAX_RESPONSE_BYTES=  # default 16000000 (uncompressed)
X402_BULK_EXEC_TIMEOUT_MS=   # default 25000
X402_BULK_CHUNK_BLOCKS=      # default 100 (batched RPC chunk — protects the node loop)
X402_BULK_HEAD_MARGIN=       # default 6 (exports pin to head - margin)

# ------------------------------------- product: address history ($0.05)
# Served from the gateway's OWN sqlite address index (no such index exists
# anywhere else on this box: the node RPC has no history method and the
# explorer scans at most 250 blocks / 3.5 s per call). Full backfill of the
# ~73k-block chain measured ~5-7 min; until it is caught up the product
# reports available:false and never asks for payment.
X402_CHAIN_HISTORY_ENABLED=  # default 1
X402_CHAIN_HISTORY_PRICE_USDC=   # default 0.05
X402_CHAIN_HISTORY_MAX_LIMIT=    # default 500 rows/call (cap enforced pre-settlement)
X402_CHAIN_HISTORY_DEFAULT_LIMIT=  # default 100

# ------------------------------------------- the address index walker
X402_CHAIN_INDEX_ENABLED=    # default 1 (0 => history product is unavailable, honestly)
X402_CHAIN_INDEX_DB_PATH=    # default ./state/x402-chain-index.db (its OWN file)
X402_CHAIN_INDEX_CHUNK_BLOCKS=   # default 100 — batch size toward the node's single event loop
X402_CHAIN_INDEX_CHUNK_PAUSE_MS= # default 50 — politeness yield between chunks
X402_CHAIN_INDEX_POLL_MS=    # default 15000 (idle poll; backfill runs back-to-back)
X402_CHAIN_INDEX_BATCH_TIMEOUT_MS=  # default 20000
X402_CHAIN_INDEX_HEAD_MARGIN=    # default 6 — never index a block a reorg could replace
X402_CHAIN_INDEX_REORG_REWIND=   # default 64 — blocks to unwind on a parentHash break
X402_CHAIN_INDEX_MAX_LAG_BLOCKS= # default 12 — above this the product is unavailable (MUST exceed HEAD_MARGIN)
X402_CHAIN_INDEX_MAX_TICK_AGE_MS=  # default 300000 — a stalled walker fails closed

# ------------------------------------- product: bulk balances ($0.02)
X402_CHAIN_BALANCES_ENABLED= # default 1
X402_CHAIN_BALANCES_PRICE_USDC=  # default 0.02
X402_CHAIN_BALANCES_MAX_ADDRESSES=  # default 500/call (~5 ms per address batched)
X402_CHAIN_BALANCES_TIMEOUT_MS=  # default 20000

# --------------------- product: priority inference ($0.10, DISABLED default)
PRIORITY_INFERENCE_ENABLED=  # default 0 — do NOT enable while serving capacity is broken
PRIORITY_INFERENCE_MIN_SERVING_WORKERS=  # default 2
X402_INFERENCE_PRICE_USDC=   # default 0.10
X402_INFERENCE_WORKER_WALLETS=  # comma-separated anim1… — SAME list as the bridge's BRIDGE_KNOWN_WORKER_WALLETS
X402_INFERENCE_TIER=         # default standard (kimi-k3's chain tier)
X402_INFERENCE_UPSTREAM_URL= # default http://127.0.0.1:4600/v1/chat/completions (the serving bridge)
X402_INFERENCE_TIMEOUT_MS=   # default 180000
X402_INFERENCE_MAX_BODY_BYTES=  # default 262144
X402_CAPACITY_PROBE_INTERVAL_MS=  # default 15000
X402_CAPACITY_MAX_PROBE_AGE_MS=   # default 60000 (older probe => gate closes)

# ------------------------------------------------- facilitator selection
# self   = our own facilitator-evm server on loopback (THE DEFAULT and the
#          production configuration — no third party settles our payments)
# remote = an external x402 v2 §7-compatible facilitator. There is NO default
#          URL: remote without X402_FACILITATOR_URL refuses to start, because
#          falling back to an unnamed third party would route real money
#          through whoever the default happened to name. One documented
#          option is PayAI (https://facilitator.payai.network).
X402_FACILITATOR_MODE=self   # self (default) | remote
X402_FACILITATOR_URL=        # REQUIRED when mode=remote; http(s), no default
X402_EVM_FACILITATOR_URL=    # legacy name for X402_FACILITATOR_URL (still honored)

# --------------------------------------------- EVM lane (gateway 402 offers)
# In mode=self this MUST name the same chain as X402_NETWORK below, or the
# gateway refuses to start (offers would be verified against another chain).
X402_NETWORK_EVM=            # CAIP-2; default eip155:8453 (Base mainnet); testnet eip155:84532
X402_BASE_PAYTO=             # EVM address that receives USDC (payTo)
X402_USDC_ASSET=             # default = canonical USDC for X402_NETWORK_EVM
X402_MAX_TIMEOUT_SECONDS=    # default 60 — maxTimeoutSeconds advertised in every offer

# --------------------------------------- self-hosted EVM facilitator (strict)
# All of these are validated fail-closed at startup; see src/config.js
# loadEvmFacilitatorConfig for the full rules.
X402_NETWORK=                # base | base-sepolia (default base)
X402_CHAIN_ID=               # optional; MUST match X402_NETWORK if set (8453 / 84532)
X402_ASSET=                  # optional; "USDC" (default) or the exact allowlisted address
X402_RPC_URL=                # REQUIRED, e.g. https://mainnet.base.org (prefer a dedicated RPC)
X402_RPC_FALLBACK_URL=       # optional second RPC endpoint
X402_SETTLEMENT_ADDRESS=     # REQUIRED; the address that receives USDC (server-side payTo)
X402_FACILITATOR_PRIVATE_KEY=  # REQUIRED (mode=self); 32-byte hex; ONLY from a 0600 env file
X402_FACILITATOR_BIND=       # default 127.0.0.1 — do not expose the facilitator
X402_EVM_FACILITATOR_PORT=   # default 8743

# ------------------------------------------------------------- gas policy
X402_MAX_GAS_PER_SETTLEMENT= # default 150000 gas units
X402_MAX_FEE_PER_GAS_WEI=    # default 1000000000 (1 gwei)
X402_DAILY_GAS_BUDGET_WEI=   # default 0 = circuit breaker disabled
X402_MIN_GAS_BALANCE_WEI=    # default 2000000000000000 (~0.002 ETH readyz floor)

# ------------------------------------------------------------ confirmation
X402_CONFIRMATIONS=          # default 2 (Base blocks are 2 s)
X402_RECEIPT_TIMEOUT_MS=     # default 30000
X402_RECEIPT_POLL_MS=        # default 1000
X402_EXPIRY_MARGIN_SECONDS=  # default 6 (validBefore must exceed now by this)

# ----------------------------------------------------------------- storage
X402_DB_PATH=                # default ./state/x402.db (dir auto-created, WAL mode)

# ------------------------------------------------------------------- rpc
X402_RPC_TIMEOUT_MS=         # default 10000
X402_RPC_RETRIES=            # default 2 (transport errors only; sends never retried)

# ---------------------------------------------------------------- logging
X402_LOG_LEVEL=              # debug|info|warn|error (default info)
X402_LOG_FORMAT=             # json (default) | pretty

# ------------------------------------------------- legacy SVM lane (unused)
X402_NETWORK_SVM=
WANM_MINT=
WANM_TREASURY=
WANM_DECIMALS=
WANM_USD_PRICE=
WANM_FEEPAYER_PUBKEY=
WANM_FEEPAYER_SECRET=
X402_SVM_FACILITATOR_URL=
SOLANA_RPC_URL=
X402_FACILITATOR_PORT=
