# =============================================================================
# Animica Chat — environment variables
# =============================================================================
# Copy this file to .env and fill in the secrets. Never commit the .env.
# Each variable is read once at startup (server/src/env.ts); the server
# refuses to boot if a required variable is missing in production.

# ---- App -------------------------------------------------------------------
NODE_ENV=development
PORT=4400
PUBLIC_BASE_URL=http://localhost:4400
# Comma-separated origins permitted via CORS (the web/ dev server lives here).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bind the cookie to this domain in production (leave blank for localhost).
COOKIE_DOMAIN=
# JWT signing secret (256-bit random hex/base64). Generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgresql://animica_chat:animica_chat@127.0.0.1:5432/animica_chat?schema=public

# ---- AI provider (OpenAI-compatible) --------------------------------------
# Works with OpenAI, Together.ai, Groq, Anyscale, vLLM, ollama
# (with --api-key flag), Animica's own gateway, etc. Anything that
# exposes /v1/chat/completions with the OpenAI request shape.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-replace-me
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
# Optional: bound per-request output so a runaway model can't burn budget.
AI_REQUEST_TIMEOUT_MS=120000

# ---- PayPal ----------------------------------------------------------------
# PayPal Subscriptions REST API. Create a Business app at
# https://developer.paypal.com/dashboard/applications and a Subscription
# Plan ($10/month) via the Catalog Products / Plans APIs. See README §
# "PayPal setup" for the curl recipes.
# Production LIVE PayPal — rotate after the credentials in this
# transcript are revoked at https://developer.paypal.com/dashboard/applications.
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=AUiDVOEtTXpwMxN020AacOnvjJ_AyPgutWhovTDPuMNMgBsGBzn7y9wk0bsREFzyH8XqSyiMWx0q9f9O
PAYPAL_CLIENT_SECRET=EPqQvkNGPGMfy3z06kBewgWStIaP5Zc9udM8lOfvMVPwirwLRjSdzncRxGKIF3lUYisR8Qes2_8_dsFU
# Live Animica Chat Pro plan — created via /v1/billing/plans on 2026-05-29
# under product PROD-76F48732291329126. $10 USD / month, infinite cycles.
PAYPAL_PLAN_ID_PRO=P-5JU759019X204745CNIMPWTA
# Webhook id is filled in AFTER you've registered the webhook URL on
# PayPal (see README §"PayPal setup"). Leave blank to skip signature
# verification (server logs all events either way).
PAYPAL_WEBHOOK_ID=

# Production hosted no-code link from the live PayPal account. When set,
# the BillingPage's "Subscribe" button opens this URL directly instead
# of calling /api/paypal/create-subscription. Webhook handler falls back
# to payer_email matching since hosted links can't carry our custom_id.
# NOTE: this link was created on the PayPal dashboard before the REST
# Plan above existed, so it may be priced differently or set up as a
# one-off. Verify in the PayPal dashboard, then either update the link
# to point at P-5JU759019X204745CNIMPWTA or unset this env var so the
# subscribe button uses the REST flow instead.
PAYPAL_HOSTED_CHECKOUT_URL=https://www.paypal.com/ncp/payment/XPVZ6RMAQXU88

# ---- PayPal — sandbox alternative (for local dev) -------------------------
# Uncomment + comment out the live block above to develop locally
# without touching real money:
#   PAYPAL_ENV=sandbox
#   PAYPAL_CLIENT_ID=Af4789CE_E0VCTSQwM_BpMWHM802_kpm_Yx8QpPefjWOr43nKXQ60cQ41lN4-aunz9a-b-EwqE3PhxeE
#   PAYPAL_CLIENT_SECRET=EKnIkbSDf-GM2uMkMVkmk-ad8uRD1SyQeqp9b-WE9t7Ns6phSXoRWOnEETdBfqNxYfzzErA6UK9oSJDT
#   PAYPAL_PLAN_ID_PRO=P-0CM8460439957745ANIMPV2Y  # sandbox plan (was $20/mo — recreate at $10 if you switch to sandbox)
# Hard-stop: if 1, the server rejects PayPal webhooks whose signature
# fails the verify-webhook-signature API call. Default 0 in dev so you
# can drive flows locally; set to 1 in production.
PAYPAL_VERIFY_WEBHOOKS=0

# ---- Magic-link email (placeholder) ---------------------------------------
# The auth flow ships email magic links. In dev, set MAIL_DRIVER=console
# and the link prints to the server log. In prod, configure SMTP.
MAIL_DRIVER=console
MAIL_FROM=Animica Chat <chat@animica.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Admin -----------------------------------------------------------------
# Email addresses (comma-separated) that get admin role on first login.
# After that, manage admin status via the admin UI.
ADMIN_EMAILS=

# ---- GitHub OAuth (coding agent) ------------------------------------------
# Create a GitHub OAuth App at https://github.com/settings/developers
# (Authorization callback URL: <PUBLIC_BASE_URL>/api/integrations/github/callback)
# The coding-mode agent uses these to read repos, list files, and open
# PRs on behalf of the linked account. Tokens are encrypted at rest.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated; "repo" is required to open PRs against private repos.
# Use "public_repo" if you only want to touch public repos.
GITHUB_OAUTH_SCOPES=repo,read:user,user:email

# ---- GitLab OAuth (coding agent) ------------------------------------------
# Create an Application at https://gitlab.com/-/profile/applications
# (Redirect URI: <PUBLIC_BASE_URL>/api/integrations/gitlab/callback)
# Same flow as GitHub. GITLAB_HOST lets you point at a self-hosted
# instance for enterprise users.
GITLAB_HOST=https://gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_SCOPES=api,read_user,read_repository,write_repository

# ---- Tool gates ------------------------------------------------------------
# Default policy when the coding agent wants to call a non-read tool
# (open PR, commit file). "ask" = surface a confirm step in the UI;
# "allow" = auto-approve (use sparingly); "deny" = never run.
AGENT_DEFAULT_WRITE_POLICY=ask

# ---- Usage limits ----------------------------------------------------------
# Per-day messages for unauthenticated/free users.
FREE_DAILY_MESSAGES=10
# Per-month messages for Pro subscribers (resets on subscription anniversary).
PRO_MONTHLY_MESSAGES=1000
# Hard ceiling on a single user message body (in characters).
MAX_MESSAGE_CHARS=8000
