    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma": "prisma"
  },
  "dependencies": {
    "@gitbeaker/rest": "^41.3.0",
    "@octokit/rest": "^21.0.2",
    "@prisma/client": "^5.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.16",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma",
    "seed": "tsx ../prisma/seed.ts"
