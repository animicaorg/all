    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
