{
  "name": "animica-chat-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Animica Chat — local coding agent CLI",
  "bin": {
    "animica-chat": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
