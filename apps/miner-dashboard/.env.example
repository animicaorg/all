# ──────────────────────────────────────────────────────────────────────────────
# Animica Miner Dashboard — .env.example
# Copy to `.env.local` and adjust for your setup.
# ──────────────────────────────────────────────────────────────────────────────

# Pool API endpoint (HTTP)
VITE_POOL_URL=http://127.0.0.1:8332

# Pool WebSocket endpoint (for live updates)
VITE_POOL_WS=ws://127.0.0.1:8333

# Stratum API URL (legacy - may be deprecated)
VITE_STRATUM_API_URL=http://127.0.0.1:8550

# Node RPC endpoint (optional - for chain stats)
VITE_RPC_URL=http://127.0.0.1:8545

# Chain ID (for network display)
VITE_CHAIN_ID=1337

# Refresh interval in seconds (how often to poll for updates)
VITE_REFRESH_INTERVAL=10
