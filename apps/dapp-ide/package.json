{
  "name": "@animica/dapp-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Animica Dapp IDE — Build, compile, deploy, and interact with Animica smart contracts in the browser",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "preview": "vite preview --open",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@animica/sdk": "workspace:*",
    "@animica/studio-wasm": "workspace:*",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.90.11",
    "idb": "^8.0.0",
    "monaco-editor": "^0.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.24",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^1.6.1"
  }
}
