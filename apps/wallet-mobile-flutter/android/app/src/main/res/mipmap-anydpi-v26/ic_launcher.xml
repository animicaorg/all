<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+): the launcher masks this into a
     circle/squircle per device, so the white triangle-in-circle mark sits
     on a full-bleed Animica-blue background. Legacy ic_launcher.png in the
     density buckets covers pre-8.0 devices. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
