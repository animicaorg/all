{
  "name": "@animica/animica-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0 --port 5182",
    "dev:server": "node server/index.mjs",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5182",
    "typecheck": "tsc --noEmit --pretty false",
    "start:server": "node server/index.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
