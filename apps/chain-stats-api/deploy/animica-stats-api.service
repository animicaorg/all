# Animica chain-stats + supply API (aggregator-facing)
#
# Install (NOT done automatically — file delivery only):
#   cp /root/animica/apps/chain-stats-api/deploy/animica-stats-api.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now animica-stats-api.service
#
# Verify: curl -s http://127.0.0.1:8560/healthz

[Unit]
Description=Animica chain-stats + supply API (CoinGecko/CMC/WhatToMine-facing, 127.0.0.1:8560)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/animica/apps/chain-stats-api
# All config is env-overridable; defaults are correct for this host.
# Environment=ANIMICA_STATS_RPC_URL=http://127.0.0.1:8545/rpc
# Environment=ANIMICA_STATS_POOL_API_URL=http://127.0.0.1:8550
# Environment=ANIMICA_STATS_PRICE_FILE=/var/www/animica.org/anm-price.json
# Environment=ANIMICA_STATS_SNAPSHOT_PATH=/var/lib/animica-stats/last_good.json
# Environment=ANIMICA_STATS_CACHE_TTL=30
# Environment=ANIMICA_NON_CIRCULATING=anim1...,anim1...   (comma-separated override)
ExecStart=/root/animica/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8560 --workers 1 --no-access-log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
