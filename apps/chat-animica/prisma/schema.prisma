generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  createdAt     DateTime       @default(now())
  projects      Project[]
  subscriptions Subscription[]
  deployJobs    DeployJob[]
  usage         UsageDaily[]
  walletSessions WalletSession[]
  walletRequests WalletConnectRequest[]
}

model WalletSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  accounts   String[]
  status     String
  metadata   Json?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
}

model WalletConnectRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  nonce     String   @unique
  payload   Json
  signature String
  status    String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  subscriptionId  String    @unique
  status          String
  nextBillingTime DateTime?
  payerEmail      String?
  payerId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Project {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime   @default(now())
  threads   Thread[]
  contracts Contract[]
}

model Thread {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  title     String
  createdAt DateTime   @default(now())
  contracts Contract[]
}

model Contract {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  threadId      String
  thread        Thread   @relation(fields: [threadId], references: [id])
  source        String
  bytecode      String?
  abiJson       Json?
  manifestJson  Json?
  compileOutput Json?
  createdAt     DateTime @default(now())
  deployJobs    DeployJob[]
}

model DeployJob {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  contractId       String
  contract         Contract @relation(fields: [contractId], references: [id])
  status           String
  txDraft          Json?
  txHash           String?
  rpcAttempts      Json?
  simulationOutput Json?
  receipt          Json?
  error            Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UsageDaily {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  day          DateTime
  messageCount Int      @default(0)

  @@unique([userId, day])
}
