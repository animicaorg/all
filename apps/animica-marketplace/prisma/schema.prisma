// Animica AI Marketplace — data model
// ANM-native app store for AI agents, RAGs, and generative media.
// Money invariants:
//   * Balance of an account == SUM(LedgerEntry.deltaNanm) for that account (append-only ledger).
//   * Every PURCHASE_DEBIT has a matching SALE_CREDIT (creator share) + FEE (treasury share).
//   * Deposits credit ONLY on observed on-chain recipient balance-delta after finality (inclusion != execution).
//   * All amounts are integer nANM (1 ANM = 1e9 nANM). Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// An Account is wallet-keyed. It may be a human OR an autonomous AI agent —
// the server makes no distinction; capability is governed entirely by ApiKey scopes.
model Account {
  id          String   @id @default(cuid())
  address     String   @unique // bech32m anim1..., ml_dsa_65 (algId 0x1003) only
  // Public developer handle -> animica.dev/developers/<handle>. Nullable: only developers who
  // publish need one, and it is claimed once (case-insensitive, reserved-word checked).
  handle      String?  @unique
  displayName String?
  bio         String?
  websiteUrl  String?
  avatarUrl   String?
  isAgent     Boolean  @default(false) // self-declared; informational only
  role        Role     @default(USER)
  balanceNanm BigInt   @default(0) // cached; authoritative value is SUM(ledger.deltaNanm)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKeys      ApiKey[]
  listings     Listing[]
  purchases    Purchase[]
  ledger       LedgerEntry[]
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  reviews      Review[]
  usageEvents  UsageEvent[]
  depositAddrs DepositAddress[]
  feedback     Feedback[]
  agentProfile AgentProfile?
  domains      AnmDomain[]
  hostings     HostingPin[]
  vpnExits     VpnExit[]
  vpnSessions  VpnSession[]
  mediaItems   MediaItem[]

  planSubscriptions    PlanSubscription[]
  workers              Worker[]
  ownedWorkspaces      Workspace[]
  workspaceMemberships WorkspaceMember[]

  // --- Animica Python Cloud ---
  cloudApps       CloudApp[]      @relation("CloudAppOwner")
  cloudFunctions  CloudFunction[] @relation("CloudFunctionOwner")
  cloudAgents     CloudAgent[]    @relation("CloudAgentOwner")
  cloudCalls      CloudExecution[] @relation("CloudExecutionCaller")
  cloudEarnings   CloudExecution[] @relation("CloudExecutionDeveloper")
  cloudProviders  CloudProvider[]
  cloudGrants     CloudGrant[]
  cloudSecrets    CloudSecret[]
  cloudPurchases  CloudAppPurchase[]
  cloudReviews    CloudReview[]
  cloudCredits    CloudCredit[]
  billingPayments BillingPayment[]
  usageCharges    UsageCharge[]
  foundingDev     FoundingDeveloper?

  @@index([role])
}

enum Role {
  USER
  ADMIN
}

// Scoped API keys. Agents receive keys scoped by their owner. Raw key is shown once;
// only the sha256 hash is stored (pool-API pattern).
model ApiKey {
  id              String    @id @default(cuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String    @default("default")
  keyHash         String    @unique // sha256(raw)
  prefix          String // first chars of raw, for display (anm_mkt_...)
  scopes          String[] // read, buy, use, publish, withdraw
  status          KeyStatus @default(ACTIVE)
  rateLimitPerMin Int       @default(120)
  // basic = the classic self-serve marketplace key (unchanged behavior).
  // production = tier-gated key (Pro+): counted against the plan's api_keys limit and
  // minted with the plan's api_rate_limit. Suspended (not revoked) on downgrade.
  kind            String    @default("basic") // basic | production
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@index([accountId])
}

enum KeyStatus {
  ACTIVE
  REVOKED
  // Plan-limit suspension (downgrade): key stops resolving but is NOT revoked — flips back
  // to ACTIVE when the account re-upgrades or frees a slot. resolveApiKey already rejects
  // anything != ACTIVE, so no auth-path change is needed.
  SUSPENDED
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Listing {
  id          String      @id @default(cuid())
  slug        String      @unique // /marketplace/[slug]
  ownerId     String
  owner       Account     @relation(fields: [ownerId], references: [id])
  type        ListingType
  name        String
  tagline     String?
  description String      @default("")
  category    String      @default("Personal")
  coverUrl    String?

  // Serving config (for RAG_ASSISTANT / AGENT / KNOWLEDGE_AI)
  systemPrompt String @default("")
  model        String @default("animica-chat") // upstream model id
  temperature  Float  @default(0.7)
  toolsJson    String @default("[]") // JSON array of enabled tools

  // Generative-media config (for MEDIA listings): which job kind + defaults
  mediaKind   String? // image | video_t2v | video_i2v | video_v2v | audio
  mediaParams String  @default("{}")

  // App-store config (for APP / DIGITAL_GOOD listings). `category` above stays the
  // free-form AI-catalog string; store browsing filters on the typed appCategory.
  appCategory      AppCategory?
  packageName      String?      @unique // Android applicationId, claimed at first build
  pinnedCertSha256 String? // signer-cert SHA-256 pinned at first build (rotation = admin-only)
  anmDomainId      String? // verified-publisher badge: linked .anm domain
  anmDomain        AnmDomain?   @relation(fields: [anmDomainId], references: [id])

  // Web-game play bundle (DIGITAL_GOOD web games from Game Lab). CID of a self-contained,
  // sandboxed HTML document stored via lib/storage.ts (ContentObject, <=2MB). FREE games play
  // straight from the public content route; PAID games are served license-gated (play-token).
  // NULL = not a web game. Deliberately NOT an AppBuild — web bundles never touch registerBuild.
  bundleCid        String? // ContentObject CID of the game play bundle

  visibility Visibility    @default(PUBLIC)
  status     ListingStatus @default(DRAFT)
  verified   Boolean       @default(false)
  version    Int           @default(1)

  // Forking (revenue-share carry when a fork is allowed)
  forkable       Boolean   @default(false)
  forkOfId       String?
  forkOf         Listing?  @relation("ListingForks", fields: [forkOfId], references: [id])
  forks          Listing[] @relation("ListingForks")
  forkRoyaltyBps Int       @default(1000) // paid to parent creator on forked-listing sales

  usersCount  Int @default(0)
  usageCount  Int @default(0)
  playCount   Int @default(0) // web-game plays; denormalized cheap counter for badges/trending (POST /store/games/[slug]/play)
  ratingSum   Int @default(0)
  ratingCount Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  prices      Price[]
  sources     KnowledgeSource[]
  chunks      Chunk[]
  purchases   Purchase[]
  reviews     Review[]
  versions    ListingVersion[]
  usageEvents UsageEvent[]
  feedback    Feedback[]
  builds      AppBuild[]
  storeAssets StoreAsset[]
  gamePlays   GamePlay[]
  gameScores  GameScore[]

  @@index([category])
  @@index([appCategory])
  @@index([status, visibility])
  @@index([ownerId])
}

enum ListingType {
  RAG_ASSISTANT
  AGENT
  WORKFLOW
  KNOWLEDGE_AI
  MEDIA // image / video / audio generator
  APP // installable Android app (APK releases live in AppBuild)
  DIGITAL_GOOD // downloadable non-app good
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  DELISTED
}

model ListingVersion {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  version      Int
  snapshotJson String // full config snapshot at publish time
  notes        String   @default("")
  createdAt    DateTime @default(now())

  @@unique([listingId, version])
}

model Price {
  id          String     @id @default(cuid())
  listingId   String
  listing     Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  model       PriceModel
  amountNanm  BigInt     @default(0) // one-time / subscription period price
  perCallNanm BigInt     @default(0) // usage price per call
  periodDays  Int        @default(30) // for SUBSCRIPTION
  active      Boolean    @default(true)
  label       String?
  createdAt   DateTime   @default(now())

  purchases Purchase[]

  @@index([listingId])
}

enum PriceModel {
  FREE
  ONE_TIME
  SUBSCRIPTION
  USAGE
}

// ---------------------------------------------------------------------------
// Knowledge / RAG
// ---------------------------------------------------------------------------

model KnowledgeSource {
  id         String       @id @default(cuid())
  listingId  String
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind       SourceKind
  title      String
  ref        String // URL, github repo, filename
  status     IngestStatus @default(PENDING)
  chunkCount Int          @default(0)
  tokenCount Int          @default(0)
  error      String?
  createdAt  DateTime     @default(now())
  ingestedAt DateTime?

  chunks Chunk[]

  @@index([listingId])
}

enum SourceKind {
  PDF
  URL
  GITHUB
  TEXT
  DOC
}

enum IngestStatus {
  PENDING
  INGESTING
  READY
  FAILED
}

// Chunk embeddings live in a pgvector column added via raw SQL migration
// (Prisma has no native vector type). See prisma/vector.sql. `embedded` flags readiness.
model Chunk {
  id         String          @id @default(cuid())
  listingId  String
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sourceId   String
  source     KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content    String
  tokenCount Int             @default(0)
  embedded   Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([listingId, embedded])
  @@index([sourceId])
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

// One deposit address per (account, purpose). Because the chain has NO memo/data
// send path, on-chain payment matching is per-address balance-delta.
model DepositAddress {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  address        String   @unique // anim1..., created via host CLI, key in wallets file
  label          String
  purpose        String   @default("topup") // topup | purchase:<listingId>
  baselineNanm   BigInt   @default(0) // balance snapshot at creation; credit = observed - baseline - alreadyCredited
  creditedNanm   BigInt   @default(0) // cumulative credited from this address
  lastSeenHeight Int      @default(0)
  // Finality window (reorg-safe crediting, mirrors the store payment watcher's 12-conf gate).
  // A newly observed uncredited delta is recorded PENDING (amount + the head height it was first
  // seen at) and credited only once head - pendingSinceHeight >= TX_FINALITY_CONFIRMATIONS with
  // the funds still present. If the delta shrinks before maturing (reorg / depositor moved funds
  // back out) the window restarts at the lower level and the reverted portion is never credited.
  pendingNanm        BigInt @default(0) // uncredited delta currently aging through the finality window
  pendingSinceHeight Int    @default(0) // head height the current pending delta was first observed at
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  deposits Deposit[]

  @@index([accountId, active])
}

model Deposit {
  id             String         @id @default(cuid())
  accountId      String
  account        Account        @relation(fields: [accountId], references: [id])
  depositAddrId  String
  depositAddr    DepositAddress @relation(fields: [depositAddrId], references: [id])
  amountNanm     BigInt // credited delta
  observedHeight Int // head height at which the delta was observed final
  confirmations  Int            @default(0)
  status         DepositStatus  @default(CREDITED)
  createdAt      DateTime       @default(now())

  @@index([accountId])
}

enum DepositStatus {
  CREDITED
  REVERSED
}

// Append-only ledger. Never UPDATE/DELETE rows.
model LedgerEntry {
  id           String     @id @default(cuid())
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id])
  deltaNanm    BigInt // signed
  kind         LedgerKind
  ref          String? // txid | purchaseId | withdrawalId | usageEventId
  memo         String?
  balanceAfter BigInt // running balance snapshot for audit
  createdAt    DateTime   @default(now())

  @@index([accountId, createdAt])
  @@index([ref])
}

enum LedgerKind {
  DEPOSIT
  PURCHASE_DEBIT
  SALE_CREDIT
  FEE
  FORK_ROYALTY
  USAGE_DEBIT
  WITHDRAWAL
  WITHDRAWAL_REFUND
  REFUND
  ADJUSTMENT
}

model Purchase {
  id         String         @id @default(cuid())
  buyerId    String
  buyer      Account        @relation(fields: [buyerId], references: [id])
  listingId  String
  listing    Listing        @relation(fields: [listingId], references: [id])
  priceId    String
  price      Price          @relation(fields: [priceId], references: [id])
  priceModel PriceModel
  amountNanm BigInt
  status     PurchaseStatus @default(ACTIVE)
  source     String         @default("balance") // balance | wallet
  txid       String? // if paid directly from wallet to a purchase deposit address
  expiresAt  DateTime? // for SUBSCRIPTION
  createdAt  DateTime       @default(now())

  // Store subscriptions (custodial auto-renewal) + renewal chain.
  autoRenew        Boolean    @default(false)
  graceUntil       DateTime? // dunning grace after a failed renewal; lapse => EXPIRED
  parentPurchaseId String? // previous purchase in the renewal chain (subscription history)
  parentPurchase   Purchase?  @relation("PurchaseRenewals", fields: [parentPurchaseId], references: [id])
  renewals         Purchase[] @relation("PurchaseRenewals")
  consentId        String? // StoreConsent id authorizing auto-renewal

  paymentIntent StorePaymentIntent?
  license       License?

  @@index([buyerId, listingId])
  @@index([listingId])
}

enum PurchaseStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

model Withdrawal {
  id              String           @id @default(cuid())
  accountId       String
  account         Account          @relation(fields: [accountId], references: [id])
  amountNanm      BigInt
  toAddress       String
  status          WithdrawalStatus @default(REQUESTED)
  txid            String?
  error           String?
  confirmedHeight Int?
  createdAt       DateTime         @default(now())
  sentAt          DateTime?
  confirmedAt     DateTime?

  @@index([accountId, status])
  @@index([status])
}

enum WithdrawalStatus {
  REQUESTED
  SENDING
  SENT
  CONFIRMED
  FAILED
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  rating    Int // 1..5
  text      String   @default("")
  createdAt DateTime @default(now())

  @@unique([listingId, accountId]) // one review per buyer per listing
  @@index([listingId])
}

// Metered usage of a listing's AI (chat tokens / media job). Ties into VIE receipts when available.
model UsageEvent {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  kind      String   @default("chat") // chat | image | video | audio | embed
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costNanm  BigInt   @default(0)
  receiptId String? // Proof-of-Inference receipt id (VIE)
  jobId     String? // AICF job id for media
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([accountId])
}

// User feedback captured on animica.dev + marketplace, fed to ENA self-improvement (DPO rounds).
// Consent is recorded per submission.
model Feedback {
  id          String   @id @default(cuid())
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id])
  surface     String   @default("animica.dev") // animica.dev | marketplace | api
  kind        String // thumbs_up | thumbs_down | regenerate | preference
  model       String?
  promptHash  String? // sha256 of prompt (privacy: no raw prompt unless consented)
  payloadJson String   @default("{}") // preference pair / rating context (consented data only)
  consent     Boolean  @default(false)
  exported    Boolean  @default(false) // pulled into an ENA round
  createdAt   DateTime @default(now())

  @@index([kind, exported])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// App Store — installable Android apps + digital goods. APKs are verified server-side
// (apksigner/aapt2), stored on disk in a sweep-exempt builds dir, paid either from the
// custodial ledger or by a wallet-signed on-chain transfer carrying an ANMSTORE1 memo
// (verified fail-closed by the payment watcher: 12-conf finality + sender balance-delta
// execution proof + treasury baseline reconciliation — NEVER on tx presence alone), and
// licensed with Merkle-anchored (ANMLIC1 data-tx) records the wallet verifies on-chain.
// ---------------------------------------------------------------------------

enum AppCategory {
  GAMES
  AI_AGENTS
  TOOLS
  DEV_APPS
  MOBILE
  WEB
}

// One uploaded + verified APK release of an APP listing. versionCode is strictly
// monotonic per (listing, channel); the signer cert must match the listing's pinned
// cert after the first build (Play-style key pinning — no silent publisher swap).
model AppBuild {
  id              String      @id @default(cuid())
  listingId       String
  listing         Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  versionCode     Int
  versionName     String
  channel         String      @default("stable")
  packageName     String // Android applicationId (must match the listing's claim)
  path            String // disk path under the builds store (sweep-exempt)
  sizeBytes       BigInt
  sha3            String // sha3-256 of the APK bytes (device re-verifies before install)
  certSha256      String // apksigner signer-cert SHA-256 (device re-verifies before install)
  minSdk          Int
  targetSdk       Int
  permissionsJson Json // requested Android permissions (from aapt2 badging)
  badgingJson     Json // full parsed `aapt2 dump badging` output
  releaseNotes    String?
  status          BuildStatus @default(UPLOADED)
  reviewNote      String?
  createdAt       DateTime    @default(now())
  approvedAt      DateTime?

  licenses License[]

  @@unique([listingId, channel, versionCode])
  @@index([listingId, status])
}

enum BuildStatus {
  UPLOADED
  CHECKS_FAILED
  PENDING_REVIEW
  APPROVED
  REJECTED
  DELISTED
}

// Store imagery (icon / screenshots / banner). Bytes live as CID-addressed
// ContentObjects (<=2MB, lib/storage.ts); this row orders them per listing.
model StoreAsset {
  id        String         @id @default(cuid())
  listingId String
  listing   Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind      StoreAssetKind
  cid       String // ContentObject CID ("anm1c" + sha3-256)
  width     Int?
  height    Int?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([listingId])
}

enum StoreAssetKind {
  ICON
  SCREENSHOT
  BANNER
}

// Single-use wallet-payment intent for a store purchase: the buyer pays the dedicated
// store treasury ONCE on-chain with the exact ANMSTORE1 memo below. The payment watcher
// credits ONLY after 12-conf finality + per-tx sender balance-delta execution proof +
// treasury baseline reconciliation (inclusion != execution on this chain).
model StorePaymentIntent {
  id            String    @id @default(cuid())
  purchaseId    String    @unique
  purchase      Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  payTo         String // dedicated store treasury address (ANMSTORE1 purchases only)
  amountNanm    BigInt
  memoHex       String // exact expected tx data bytes: "ANMSTORE1" magic + strict compact JSON
  nonce         String    @unique // 16-hex single-use nonce baked into the memo
  expiresAt     DateTime // 30-min TTL; expired intents are never credited
  submittedTxid String?
  verifiedAt    DateTime?
  failReason    String?
  createdAt     DateTime  @default(now())

  @@index([submittedTxid])
}

// The entitlement record issued when a purchase settles. leafHash goes into the next
// ANMLIC1 Merkle anchor; the wallet stores {license, proof, anchor txid} in its vault
// and can verify inclusion against the on-chain anchor tx without trusting the server.
model License {
  id              String         @id @default(cuid())
  purchaseId      String         @unique
  purchase        Purchase       @relation(fields: [purchaseId], references: [id])
  buyerAddress    String // anim1... the license is bound to
  listingId       String
  buildId         String? // exact binary licensed; null = covers all builds (digital goods / subscriptions)
  build           AppBuild?      @relation(fields: [buildId], references: [id])
  buildSha3       String?
  certSha256      String?
  kind            LicenseKind
  issuedAt        DateTime       @default(now())
  expiresAt       DateTime? // for SUBSCRIPTION licenses
  revokedAt       DateTime? // refund / malware delist — API-checked (anchors are append-only)
  leafHash        String // sha3-256 of the canonical license record
  anchorId        String?
  anchor          LicenseAnchor? @relation(fields: [anchorId], references: [id])
  merkleProofJson Json? // inclusion proof against the anchor's merkleRoot

  @@index([buyerAddress])
  @@index([listingId])
}

enum LicenseKind {
  PERPETUAL
  SUBSCRIPTION
}

// Periodic Merkle-root checkpoint over issued licenses, published on-chain as an
// ANMLIC1 data-tx from the store treasury (DomainAnchor pattern — tamper-evident,
// hash-chained, zero consensus change).
model LicenseAnchor {
  id          String    @id @default(cuid())
  seq         Int       @unique
  merkleRoot  String // sha3-256 root over sorted license leafHashes
  leafCount   Int
  prevTxid    String? // txid of the previous anchor (hash chain)
  txid        String? // on-chain data-tx that carries this root (null until published)
  blockHeight Int?
  status      String    @default("pending") // pending | published | confirmed
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  licenses License[]
}

// Wallet-signed consent record for custodial subscription auto-renewal (verified via
// lib/wallet-verify.ts). The exact signed string is stored for audit.
model StoreConsent {
  id           String   @id @default(cuid())
  accountId    String
  purchaseId   String?
  purpose      String // e.g. "subscribe"
  message      String // exact signed string (animica-login|v2|purpose=subscribe|...)
  signatureHex String
  pubkeyHex    String
  createdAt    DateTime @default(now())

  @@index([accountId])
}

// Single-use burn of v2 login/consent challenge MACs — a signed challenge can never be
// replayed into a second session/consent.
model ChallengeBurn {
  id     String   @id @default(cuid())
  mac    String   @unique
  usedAt DateTime @default(now())

  @@index([usedAt])
}

// ---------------------------------------------------------------------------
// Agent Mesh — agents roam, discover each other, message, negotiate, and transact.
// An agent's identity/address is its account (and, once ANS lands, its .anm domain).
// ---------------------------------------------------------------------------

// Directory entry making an account discoverable as an autonomous agent + its capabilities.
model AgentProfile {
  id            String  @id @default(cuid())
  accountId     String  @unique
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  handle        String  @unique // e.g. "research-bot" -> research-bot.anm once ANS lands
  anmDomain     String? @unique // linked .anm domain (nullable pre-ANS)
  summary       String  @default("")
  skillsJson    String  @default("[]") // capability tags for discovery (AADP)
  endpointsJson String  @default("{}") // advertised callable endpoints (listing slugs, ask URLs)
  priceHintNanm BigInt  @default(0) // advertised price/task hint
  inboxOpen     Boolean @default(true)
  online        Boolean @default(true)

  // Reputation (built over completed escrowed tasks — trust accrues, cannot be self-set).
  reputation     Int @default(0) // 0..10000 bps composite score
  tasksCompleted Int @default(0)
  tasksFailed    Int @default(0)
  ratingSum      Int @default(0)
  ratingCount    Int @default(0)
  avgResponseMs  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hiredTasks  AgentTask[] @relation("TaskHirer")
  workerTasks AgentTask[] @relation("TaskWorker")

  @@index([handle])
  @@index([reputation])
}

// Escrowed agent-to-agent (or human-to-agent) task contract.
// Flow: hirer OPENs (funds escrowed from balance) -> worker ACCEPTs -> worker DELIVERs ->
// hirer RELEASEs (escrow -> worker, minus fee) OR DISPUTEs -> admin/timeout resolves.
// All value moves through the ledger; escrow is held in the marketplace treasury sub-account.
model AgentTask {
  id              String        @id @default(cuid())
  hirerId         String
  hirer           AgentProfile  @relation("TaskHirer", fields: [hirerId], references: [id])
  workerId        String?
  worker          AgentProfile? @relation("TaskWorker", fields: [workerId], references: [id])
  workerHandle    String? // requested worker (e.g. "designer") before accept
  title           String
  brief           String        @default("")
  inputJson       String        @default("{}")
  deliverableJson String        @default("{}")
  amountNanm      BigInt // escrowed
  status          TaskStatus    @default(OPEN)
  rating          Int? // hirer rates worker on release (1..5)
  ledgerRef       String        @unique // idempotency for escrow ledger postings
  createdAt       DateTime      @default(now())
  acceptedAt      DateTime?
  deliveredAt     DateTime?
  closedAt        DateTime?

  @@index([status])
  @@index([workerId, status])
  @@index([hirerId, status])
}

enum TaskStatus {
  OPEN // posted, escrow funded, awaiting a worker
  ACCEPTED // worker claimed it
  DELIVERED // worker submitted deliverable, awaiting release
  RELEASED // paid out to worker (minus fee)
  DISPUTED // hirer contests; admin/timeout resolves
  REFUNDED // escrow returned to hirer
  CANCELLED
}

// Direct agent-to-agent (or human-to-agent) message. Supports negotiation threads and
// optional attached ANM offers that settle through the ledger on accept.
model AgentMessage {
  id            String    @id @default(cuid())
  threadId      String // groups a conversation/negotiation
  fromAccountId String
  toAccountId   String
  body          String    @default("")
  intent        String    @default("message") // message | offer | accept | reject | deliver
  offerNanm     BigInt    @default(0) // ANM proposed in this message (settles on accept)
  refListingId  String? // listing the negotiation concerns
  metaJson      String    @default("{}")
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([toAccountId, readAt])
  @@index([threadId, createdAt])
  @@index([fromAccountId])
}

// ---------------------------------------------------------------------------
// Animica Internet — ANS (.anm name service). Domains are the address system for humans,
// apps, and autonomous agents. Ownership is a wallet (ml_dsa_65). Records are content-addressed
// and node-hosted; the registry state is anchored on-chain via a signed data-tx Merkle checkpoint.
// ---------------------------------------------------------------------------

model AnmDomain {
  id            String       @id @default(cuid())
  name          String       @unique // e.g. "research" -> research.anm (label only, no dots)
  ownerId       String
  owner         Account      @relation(fields: [ownerId], references: [id])
  kind          String       @default("app") // app | agent | personal | business | ai
  // Content + service pointers (resolver payload).
  contentCid    String? // hash of hosted site/app content
  agentHandle   String? // links to an AgentProfile (agent domains)
  recordsJson   String       @default("{}") // {A, TXT, endpoints, avatar, description, ...}
  nodeProviders String[] // node ids announcing they host this domain's content
  // Lifecycle.
  status        DomainStatus @default(ACTIVE)
  registeredAt  DateTime     @default(now())
  expiresAt     DateTime
  updatedAt     DateTime     @updatedAt
  // Auditability: last on-chain anchor that included this record.
  lastAnchorId  String?

  history  DomainEvent[]
  listings Listing[] // APP listings claiming this domain (verified-publisher badge)

  @@index([ownerId])
  @@index([kind])
  @@index([status, expiresAt])
}

enum DomainStatus {
  ACTIVE
  EXPIRED
  GRACE
  // Plan-limit suspension (subscription downgrade): the gateway 404s it (status != ACTIVE),
  // search hides it, and — unlike EXPIRED — the name canNOT be re-registered by someone else.
  // Content + ownership are preserved; flips back to ACTIVE when a slot frees up.
  SUSPENDED
}

model DomainEvent {
  id        String    @id @default(cuid())
  domainId  String
  domain    AnmDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  kind      String // register | renew | transfer | update | anchor
  detail    String    @default("")
  createdAt DateTime  @default(now())

  @@index([domainId, createdAt])
}

// A periodic Merkle-root checkpoint of the whole ANS state, published on-chain as a signed data-tx.
// The chain enforces txsRoot (live), so an included anchor is tamper-evident — no consensus fork needed.
model DomainAnchor {
  id          String   @id @default(cuid())
  seq         Int      @unique
  merkleRoot  String // sha3_256 root over sorted (name -> record hash)
  domainCount Int
  prevAnchor  String? // txid of the previous anchor (hash chain)
  txid        String? // on-chain data-tx that carries this root (null until published)
  heightHint  Int?
  status      String   @default("pending") // pending | published | confirmed
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Idempotency (developer API) — durable, keyed by (apiKeyId, key) + body hash
// ---------------------------------------------------------------------------

model IdempotencyRecord {
  id           String   @id @default(cuid())
  apiKeyId     String
  key          String
  bodyHash     String
  statusCode   Int
  responseJson String
  createdAt    DateTime @default(now())

  @@unique([apiKeyId, key])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Content hosting: CID-addressed objects served by the .anm gateway.
// A .anm site is a self-contained HTML document addressed by its sha3-256 hash (the CID).
// nodeProviders on AnmDomain announce which nodes replicate this content (hosting-reward basis).
// ---------------------------------------------------------------------------

model ContentObject {
  cid         String   @id // "anm1c" + sha3_256(bytes) hex — content address
  mime        String   @default("text/html; charset=utf-8")
  bytes       Bytes // the stored content (self-contained HTML for v1)
  size        Int
  publishedBy String? // account id that published it
  pins        Int      @default(1) // replica count across nodes (hosting reward weight)
  createdAt   DateTime @default(now())

  hostings HostingPin[]

  @@index([publishedBy])
}

// A node announcing it hosts (replicates) a content object. Basis for hosting rewards: reward accrues
// as bytes-hours of proven availability. Nodes heartbeat to stay live; stale pins stop accruing.
model HostingPin {
  id          String        @id @default(cuid())
  cid         String
  content     ContentObject @relation(fields: [cid], references: [cid], onDelete: Cascade)
  nodeId      String // provider node id (e.g. a .anm node handle or address)
  accountId   String? // wallet that collects this node's hosting rewards
  account     Account?      @relation(fields: [accountId], references: [id])
  bytes       Int // size hosted (denormalized from ContentObject.size)
  pinnedAt    DateTime      @default(now())
  lastSeen    DateTime      @default(now()) // last heartbeat; accrual stops if this goes stale
  byteHours   Float         @default(0) // accumulated availability = Σ bytes × hours-live
  rewardNanm  BigInt        @default(0) // IOU reward accrued (NOT yet a spendable balance credit)
  settledNanm BigInt        @default(0) // 9.0.0: portion already PAID on-chain via IOU-settlement anchors
  active      Boolean       @default(true)

  @@unique([cid, nodeId])
  @@index([nodeId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Animica dVPN — WireGuard exit registry. Control plane only: exits register + heartbeat,
// clients request /32 session leases, both peers post signed cumulative byte receipts, and the
// server reconciles the two counters to accrue relay-operator rewards. Rewards accrue as IOUs
// (VpnExit.rewardNanm / VpnSession.rewardNanm) — NEVER a LedgerEntry, NEVER a spendable balance
// credit — same deferred, treasury-funded settlement model as hosting/AICF pay.
// ---------------------------------------------------------------------------

// A registered WireGuard exit/relay. The owner account collects its (IOU) relay rewards.
model VpnExit {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              Account  @relation(fields: [ownerId], references: [id])
  label              String
  region             String
  country            String
  city               String
  wgPubkey           String   @unique // WireGuard public key (exit identity)
  endpoint           String // host:port the client dials for the WG tunnel
  httpProxy          String? // optional host:port for an HTTP(S) proxy fronting the exit
  proxyToken         String? // secret bearer for the HTTP proxy (NEVER returned on public listings)
  capacityMbps       Int // advertised link capacity (reward reconciliation ceiling)
  priceHintNanmPerGb BigInt   @default(0) // advertised price/GB hint (informational)
  tosHash            String // sha3 of the exit operator's accepted terms
  reputation         Float    @default(0)
  online             Boolean  @default(true)
  load               Float    @default(0) // 0..1 utilization from heartbeats
  openSessions       Int      @default(0)
  lastSeenAt         DateTime @default(now()) // last heartbeat; accrual stops if stale
  payoutAddress      String? // 9.0.7: anim1 address bandwidth-reward IOUs settle to (default: owner Account.address)
  rewardNanm         BigInt   @default(0) // IOU reward accrued (NOT yet a spendable balance credit)
  settledNanm        BigInt   @default(0) // 9.0.0: portion already PAID on-chain via IOU-settlement anchors
  createdAt          DateTime @default(now())

  sessions     VpnSession[]
  abuseReports VpnAbuseReport[]

  @@index([ownerId])
  @@index([online, region])
  @@index([online, country])
}

// A client's session lease on an exit: a /32 in 10.99.0.0/16 + reconciled byte accounting.
model VpnSession {
  id              String    @id @default(cuid())
  exitId          String
  exit            VpnExit   @relation(fields: [exitId], references: [id], onDelete: Cascade)
  clientAccountId String
  clientAccount   Account   @relation(fields: [clientAccountId], references: [id])
  clientWgPub     String // client's WireGuard public key
  allocatedIp     String // e.g. "10.99.0.7" — unique per exit while ACTIVE
  status          String    @default("ACTIVE") // ACTIVE | CLOSED | FLAGGED
  clientCumBytes  BigInt    @default(0) // latest client-signed cumulative bytes
  exitCumBytes    BigInt    @default(0) // latest exit-signed cumulative bytes
  reconciledBytes BigInt    @default(0) // min(client,exit) capped at capacity*wallclock
  rewardNanm      BigInt    @default(0) // IOU reward accrued for this session (NOT spendable)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  lastReportAt    DateTime?

  receipts VpnUsageReceipt[]

  @@unique([exitId, allocatedIp]) // deterministic /32 allocation — no collisions
  @@index([exitId, status])
  @@index([clientAccountId])
  @@index([status])
}

// A signed cumulative usage receipt from one side of a session. Replay-protected by the unique
// (sessionId, side, seq) tuple. Reconciliation credits the min of the two sides' cumulative bytes.
model VpnUsageReceipt {
  id        String     @id @default(cuid())
  sessionId String
  session   VpnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  side      String // client | exit
  seq       Int // monotonically increasing per (session, side)
  cumRx     BigInt // cumulative bytes received
  cumTx     BigInt // cumulative bytes transmitted
  ts        BigInt // client/exit-reported unix ts (ms)
  sig       String // ml_dsa_65 detached signature (hex)
  address   String // signer's anim1... address
  createdAt DateTime   @default(now())

  @@unique([sessionId, side, seq]) // replay protection
  @@index([sessionId])
}

// An abuse report against an exit. Enough OPEN reports auto-takes the exit offline pending review.
model VpnAbuseReport {
  id              String   @id @default(cuid())
  exitId          String?
  exit            VpnExit? @relation(fields: [exitId], references: [id])
  reporterAddress String
  reason          String
  detail          String   @default("")
  status          String   @default("OPEN") // OPEN | REVIEWED
  createdAt       DateTime @default(now())

  @@index([exitId, status])
}

// Denylisted CIDRs / peer keys that exits pull to refuse routing (abuse mitigation).
model VpnDenylistEntry {
  id        String   @id @default(cuid())
  kind      String // cidr | peer
  value     String
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([kind])
}

// ---------------------------------------------------------------------------
// Generative-media job QUEUE. Dispatch-only: NO model runs on the gateway. Every media
// request (image / video / music / image->video) is enqueued PENDING; a registered GPU
// media miner atomically CLAIMS it, renders, and posts the result — so a request GOES
// THROUGH EVENTUALLY. It waits in the queue until a miner is free rather than failing
// with "no miner". Private jobs (image->video from user uploads) hold their inputs
// transiently and WIPE them the moment a miner claims them (and again on any terminal
// state / delivery) — the bytes live only between the miner and the user, never exposed
// on any read path. Miner pay accrues as an IOU (MediaMiner.rewardNanm) — NEVER a
// LedgerEntry, NEVER a spendable balance — same deferred, treasury-funded settlement as
// hosting/VPN/AICF pay.
// ---------------------------------------------------------------------------

// A registered GPU media miner (runs `animica media serve --register`). Identified by the
// sha3 of a bearer token it chooses; the raw token is never stored.
model MediaMiner {
  id             String   @id @default(cuid())
  keyHash        String   @unique // sha3-256(bearer token) — raw token never persisted
  label          String   @default("")
  ownerAccountId String? // optional account id that collects IOU rewards
  address        String? // anim1... reward address (informational)
  capabilities   String[] // image | video_t2v | video_i2v | video_multiscene | audio
  maxPixels      Int      @default(1048576)
  device         String   @default("") // self-reported cuda/cpu
  online         Boolean  @default(true)
  load           Float    @default(0)
  jobsDone       Int      @default(0)
  rewardNanm     BigInt   @default(0) // IOU only — never a spendable balance credit
  settledNanm    BigInt   @default(0) // 9.0.0: portion of rewardNanm already PAID on-chain via an IOU-settlement anchor (block-reward carve, ≤50 ANM/block). payable = rewardNanm − settledNanm.
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  jobs MediaJob[]

  @@index([online])
}

// ---------------------------------------------------------------------------
// Consent-based email newsletter (Animica Growth Engine, 8.1.0). CONSENT-ONLY by
// construction: an address becomes CONFIRMED only by redeeming an emailed double-opt-in
// token — there is NO admin/import path to CONFIRMED. Suppression is append-only and
// always honored; a suppressed address can never re-enter the active list. The Python
// sender reads recipients ONLY from confirmedRecipients() (CONFIRMED anti-join Suppression)
// — no caller-supplied recipient list exists anywhere. No scraping/harvesting: addresses
// enter solely through the public double-opt-in form. See animica/growth/*.
// ---------------------------------------------------------------------------
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique // normalized lowercased; RFC5322-validated, no control chars
  status         String    @default("PENDING") // PENDING | CONFIRMED | UNSUBSCRIBED
  confirmHash    String? // sha3-256(pepper || raw confirm token) — raw token only ever emailed
  confirmSentAt  DateTime?
  confirmExpires DateTime?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  // Consent proof (GDPR/CASL): captured at subscribe + confirm.
  source         String    @default("") // signup page/campaign the opt-in came from
  consentIp      String?
  consentUa      String?
  consentText    String    @default("") // exact consent wording shown at opt-in
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sends NewsletterSend[]

  @@index([status])
}

// Append-only opt-out / bounce / complaint store. Keyed by a one-way hash of the email so it
// survives subscriber deletion (GDPR erasure keeps the hash to guarantee we never re-contact).
// The engine has NO code path that clears a suppression row.
model NewsletterSuppression {
  id        String   @id @default(cuid())
  emailHash String   @unique // sha3-256(lower(email)) — no plaintext PII required to honor opt-out
  reason    String // UNSUBSCRIBE | COMPLAINT | HARD_BOUNCE | ERASURE | MANUAL
  createdAt DateTime @default(now())

  @@index([reason])
}

// A marketing campaign. A bulk send requires status=APPROVED with a recorded human approver;
// the content-generating agent cannot self-approve. Financial campaigns (buy/trade) carry a
// mandatory disclaimer + material-interest disclosure enforced in the Python renderer.
model NewsletterCampaign {
  id          String    @id @default(cuid())
  slug        String    @unique
  subject     String
  bodyHtml    String
  bodyText    String
  status      String    @default("DRAFT") // DRAFT | APPROVED | SENDING | SENT | PAUSED
  financial   Boolean   @default(false) // triggers strict disclaimer + prohibited-phrase lint
  approvedBy  String? // account id / operator handle of the human approver
  approvedAt  DateTime?
  contentHash String? // sha3 of (subject||body) bound at approval; sender re-verifies
  sentCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sends NewsletterSend[]

  @@index([status])
}

// Per-(campaign, subscriber) send ledger — UNIQUE so a crash/retry can never double-send.
model NewsletterSend {
  id           String               @id @default(cuid())
  campaignId   String
  campaign     NewsletterCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status       String               @default("SENT") // SENT | BOUNCED | COMPLAINED
  sentAt       DateTime             @default(now())

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
}

model MediaJob {
  id            String      @id @default(cuid())
  kind          String // image | video_t2v | video_i2v | video_multiscene | audio | 9.0.0 studio kinds (video_upscale/interpolate/subtitles/bgremove/shorts, audio_stems/isolate/enhance/master, render_blender/chunk/assemble)
  status        String      @default("PENDING") // PENDING | RUNNING | DONE | FAILED | EXPIRED | WAITING (render parent — never claimable) | CANCELLED (sibling of a failed chunk)
  prompt        String      @default("")
  paramsJson    String      @default("{}") // width/height/fps/tier/seconds/scenes...
  inputB64      String? // TRANSIENT private input (i2v uploads); wiped on claim/terminal
  isPrivate     Boolean     @default(false) // uploads path: never exposed, wiped after delivery
  priority      Int         @default(0)
  requesterIp   String? // rate-limit bucket only; never exposed on reads
  requesterAcct String?
  claimedById   String?
  claimedBy     MediaMiner? @relation(fields: [claimedById], references: [id])
  leaseUntil    DateTime? // claim lease; an expired lease returns the job to PENDING
  attempts      Int         @default(0)
  resultB64     String? // inline result bytes; private results wiped after first delivery
  resultCid     String? // optional public result anchored as a ContentObject
  resultMime    String?
  resultSha3    String? // content hash — Proof-of-Inference receipt anchor
  resultMeta    String? // json: model, device, duration_s, scenes...
  resultPath    String? // 9.0.0: disk artifact (big studio outputs) — served via /media/artifacts/[id]
  resultBytes   BigInt? // size of the disk artifact
  progressPct   Int? // 9.0.0: miner-reported live progress (heartbeat also extends the lease)
  progressNote  String?
  parentId      String? // 9.0.0: render_chunk/render_assemble → their render_blender parent
  error         String?
  deliveredAt   DateTime? // first time the requester fetched the result
  expiresAt     DateTime? // TTL; past this an undelivered job EXPIRES and inputs are wiped
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, priority, createdAt])
  @@index([claimedById])
  @@index([parentId])
}

// 9.0.0 GPU Studios: a large uploaded input (video / audio / .blend / mastering reference)
// stored on the gateway DISK (never inline in a JSON body / DB row). Referenced from job
// params by id; wiped when the owning job completes+delivers, or after TTL when unused.
// Miners fetch it with their bearer token; it is never served on any public read path.
model MediaUpload {
  id              String   @id @default(cuid())
  purpose         String // video | audio | blend | reference
  mime            String   @default("application/octet-stream")
  bytes           BigInt
  sha3            String
  path            String // absolute path inside MEDIA_STORE_DIR
  requesterIp     String?
  consumedByJobId String? // set when a job claims this upload (its lifecycle then rules the wipe)
  expiresAt       DateTime // unconsumed uploads are wiped after this
  createdAt       DateTime @default(now())

  @@index([expiresAt])
  @@index([consumedByJobId])
}

// ── Animica Animal — the autonomous mascot ambassador ─────────────────────────
// A social account the OPERATOR OWNS, connected via that platform's official OAuth (or a
// manually-pasted token). Access/refresh tokens are AES-GCM sealed at rest and are NEVER
// returned on any browser/session read path — only the localhost Bearer internal endpoint
// (that the local posting engine uses) can unseal them. No account is ever self-created.
model SocialConnection {
  id              String    @id @default(cuid())
  platform        String    @unique // x | tiktok | youtube | instagram | reddit | mastodon | ...
  handle          String    @default("")
  displayName     String    @default("")
  status          String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | NEEDS_AUTH | ERROR
  accessTokenEnc  String? // AES-256-GCM sealed; never exposed to the browser
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scope           String    @default("")
  externalId      String    @default("") // platform user id
  metaJson        String    @default("{}")
  autoPost        Boolean   @default(true) // operator can pause a single channel
  connectedAt     DateTime?
  lastPostAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Short-lived CSRF/PKCE state for an in-flight OAuth connect. Consumed once at callback.
model OAuthState {
  id         String   @id @default(cuid())
  platform   String
  state      String   @unique
  verifier   String   @default("") // PKCE code_verifier
  redirectTo String   @default("/animal")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// The steering channel: the operator tells the mascot what to focus on; the agent can reply.
model AnimalDirective {
  id        String   @id @default(cuid())
  role      String   @default("operator") // operator | agent
  kind      String   @default("goal") // goal | instruction | note | reply
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, createdAt])
}

// A unit of mascot content. DRY_RUN is the default posture: a fully-rendered preview that was
// NOT sent anywhere. Only becomes POSTED when the operator has connected the account AND flipped
// the live switch, and the engine actually called the platform's official posting API.
model AnimalPost {
  id          String    @id @default(cuid())
  platform    String
  kind        String    @default("text") // text | image | video | music
  status      String    @default("DRY_RUN") // DRAFT | QUEUED | DRY_RUN | POSTED | FAILED | SKIPPED
  caption     String    @default("")
  mediaJobId  String?
  mediaKind   String?
  externalId  String? // post id on the platform (when live)
  externalUrl String?
  error       String?
  metaJson    String    @default("{}")
  postedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([platform, createdAt])
  @@index([status, createdAt])
}

// Durable per-IP + global throttle for the console password gate (survives restarts).
model ConsoleThrottle {
  id          String    @id @default(cuid())
  bucket      String    @unique // sha256(ip) or "global"
  fails       Int       @default(0)
  lockedUntil DateTime?
  windowStart DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Liveness/heartbeat + posture for the always-run posting engine (single row, id="animal").
model AnimalEngineState {
  id            String    @id // "animal"
  running       Boolean   @default(false)
  dryRun        Boolean   @default(true) // engine-REPORTED posture (from its own env flags)
  forceDryRun   Boolean   @default(false) // operator override: engine must dry-run regardless of env
  paused        Boolean   @default(false) // operator kill-switch honored by the engine
  consoleEpoch  Int       @default(1) // bumped on logout to revoke outstanding console sessions
  lastHeartbeat DateTime?
  lastCycleJson String    @default("{}")
  characterJson String    @default("{}") // the live-editable Character sheet (personality + appearance)
  liveJson      String    @default("{}") // last livestream status reported by the stream worker
  updatedAt     DateTime  @updatedAt
}

// Per-character knowledge base for the livestream brain (RAG). Embeddings are stored as
// JSON and scored in-process (cosine), so no pgvector migration is needed for this small,
// per-character corpus; falls back to keyword match when embeddings are unavailable.
model AnimalKnowledgeChunk {
  id            String   @id @default(cuid())
  ref           String // character knowledge-base id (Character.knowledge_ref)
  source        String   @default("")
  content       String
  embeddingJson String   @default("")
  createdAt     DateTime @default(now())

  @@index([ref])
}

// 9.0.0 on-chain IOU settlement: one row per APPLIED settlement anchor. The txHash
// primary key makes marking settledNanm idempotent — the settlement worker INSERTs
// this row and applies ALL settledNanm increments in ONE transaction, so a crash
// between the DB commit and its state-file save can never double-apply (the retry
// hits the txHash conflict and just clears its pending state).
model IouSettlementAnchor {
  txHash      String   @id
  entriesJson String
  totalNanm   BigInt
  height      Int
  appliedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Game social layer — web-game leaderboards + play counts (Game Lab / DIGITAL_GOOD
// web games). COSMETIC / "for fun" ONLY: a sandboxed game window.parent.postMessages
// its score to the play shell, which submits it here. Client-reported scores are
// UNTRUSTED and are NEVER tied to ANM, balances, or payouts. Anti-abuse is rate-limit
// + sane integer bounds ONLY — there is no anti-cheat. `playerKey` is either an
// authenticated account ref ("acct:<accountId>") or a HASHED anonymous token
// ("anon:<hmac>" from a client uuid, or "ip:<hmac>" fallback) — no raw client token
// or client-claimed address is ever stored or trusted.
// ---------------------------------------------------------------------------

// One row per recorded play session (POST /store/games/[slug]/play, deduped per player
// per short window). Feeds uniquePlayers + dedup; Listing.playCount is the denormalized
// cheap counter used for card badges + the Trending Games surface.
model GamePlay {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  playerKey String // "acct:<accountId>" | "anon:<hmac>" | "ip:<hmac>"
  startedAt DateTime @default(now())

  @@index([listingId, startedAt])
  @@index([listingId, playerKey, startedAt])
}

// Personal-best score per (game, player) — upserted on POST /store/games/[slug]/score.
// The leaderboard is ORDER BY score DESC over these rows; one row = one player's best.
model GameScore {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  playerKey  String // "acct:<accountId>" | "anon:<hmac>" | "ip:<hmac>"
  score      Int // bounded 0..1_000_000_000; UNTRUSTED client-reported value
  achievedAt DateTime @default(now())
  meta       String? // small JSON blob: { state: "gameover"|"win", ... } — capped length

  @@unique([listingId, playerKey])
  @@index([listingId, score])
}

// ═══════════════════ Hire Me — managed infrastructure services (2026-07-26) ═══════════════════

// Catalog of managed services sold on /hire. Data-driven: the page renders whatever rows are
// active here, so future offerings (GPU hosting, validators, seed nodes, consulting, …) are added
// from the admin panel without touching frontend code.
model HireService {
  id              String   @id @default(cuid())
  slug            String   @unique // mining-pool | rpc-node | custom | ...
  name            String
  tagline         String   @default("")
  description     String   @default("")
  features        String[] @default([])
  icon            String   @default("🛠️")
  kind            String   @default("subscription") // subscription | quote
  priceUsdMonthly Int? // whole USD per month; null => quote-only
  setupFeeUsd     Int      @default(0) // one-time, charged on first payment via PayPal plan setup_fee
  paypalPlanId    String? // live PayPal billing plan id (created by scripts/hire-setup.ts)
  active          Boolean  @default(true)
  sortOrder       Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders ServicesOrder[]
}

// Email/password customer account for the hire flow (deliberately separate from wallet Accounts —
// these users buy managed services with fiat; they log in on /hire and dashboard.animica.dev).
model HireCustomer {
  id           String    @id @default(cuid())
  email        String    @unique // stored lowercase
  passwordHash String // scrypt$N$r$p$saltHex$hashHex (never plaintext)
  name         String    @default("")
  company      String?
  discord      String?
  sessionEpoch Int       @default(1) // bump to invalidate every outstanding session token
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders  ServicesOrder[]
  tickets HireTicket[]
}

// One managed-service order: a paid PayPal subscription or a quote request.
model ServicesOrder {
  id                   String        @id @default(cuid())
  orderId              String        @unique // human-facing id, e.g. HM-7Q2M9XKV
  userId               String?
  user                 HireCustomer? @relation(fields: [userId], references: [id])
  serviceId            String
  service              HireService   @relation(fields: [serviceId], references: [id])
  serviceType          String // catalog slug snapshot at order time
  serviceName          String // display-name snapshot at order time
  monthlyPriceUsd      Int? // snapshot; null for quote requests
  setupFeeUsd          Int           @default(0) // snapshot
  customerName         String
  email                String // snapshot of account email at order time
  company              String?
  domain               String?
  discordUsername      String?
  notes                String?
  paypalPlanId         String?
  paypalOrderId        String?
  paypalSubscriptionId String?       @unique
  paypalTransactionId  String?
  paymentStatus        String        @default("draft") // draft | pending | active | suspended | cancelled | failed | quote
  deploymentStatus     String        @default("awaiting_payment") // awaiting_payment | pending_setup | active | suspended | cancelled | quote_requested
  adminNotes           String?
  // Operator bookkeeping (manually entered): when the underlying server was provisioned and when
  // its rental/renewal is due — drives the admin Renewals view.
  serverStartAt        DateTime?
  serverEndAt          DateTime?
  serverLabel          String? // provider/instance note, e.g. "Contabo VPS16 #12345"
  customerIp           String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tickets HireTicket[]

  @@index([email])
  @@index([userId])
  @@index([deploymentStatus])
  @@index([paymentStatus, createdAt])
}

// Support tickets for hire customers (dashboard "Support" tab + admin console).
model HireTicket {
  id       String  @id @default(cuid())
  ticketId String  @unique // human-facing id, e.g. HT-4K2P7QRZ
  userId   String
  user     HireCustomer @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId  String? // optional link to a ServicesOrder
  order    ServicesOrder? @relation(fields: [orderId], references: [id])
  subject  String
  status   String  @default("open") // open | answered | customer_reply | closed
  priority String  @default("normal") // low | normal | high
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages HireTicketMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model HireTicketMessage {
  id        String     @id @default(cuid())
  ticketId  String
  ticket    HireTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    String // customer | admin
  body      String
  createdAt DateTime   @default(now())

  @@index([ticketId, createdAt])
}

// ── Animica Internet media platform: music.anm (SoundCloud-style) + video.anm (YouTube-style) ──
// Audio/video bytes are stored in the ANM DA (data-availability) layer as one or more <=32MiB
// blobs (daBlobsJson = ordered list of blob ids); a disk copy under mediaStore('artifacts') is
// the Range-streaming cache, rehydrated from DA on a miss. Small cover/thumb art uses the CID
// object store (posterCid). Creators are tipped in ANM directly wallet->wallet (MediaTip records
// the on-chain txid for display; funds never touch the marketplace).
enum MediaKind {
  AUDIO
  VIDEO
}

model MediaItem {
  id           String    @id @default(cuid())
  kind         MediaKind
  ownerId      String
  owner        Account   @relation(fields: [ownerId], references: [id])
  ownerAddress String // creator's anim1 address — the tip destination (denormalized for the feed)
  title        String
  creatorName  String    @default("")
  description  String    @default("")
  posterCid    String? // cover / thumbnail in the CID object store (<=2MB)
  daBlobsJson  String    @default("[]") // ordered JSON array of DA blob ids (chunks)
  daCommitment String? // NMT commitment root when stored with a namespace
  mime         String
  sizeBytes    BigInt    @default(0)
  durationSec  Int?
  plays        Int       @default(0)
  tipTotalNanm BigInt    @default(0)
  tipCount     Int       @default(0)
  visibility   String    @default("public") // public | unlisted
  createdAt    DateTime  @default(now())

  tips MediaTip[]

  @@index([kind, createdAt])
  @@index([ownerId])
}

model MediaTip {
  id          String    @id @default(cuid())
  itemId      String
  item        MediaItem @relation(fields: [itemId], references: [id])
  fromAddress String
  toAddress   String
  amountNanm  BigInt
  txid        String    @unique // on-chain tx hash; unique so a tip is recorded once
  createdAt   DateTime  @default(now())

  @@index([itemId, createdAt])
}

// ---------------------------------------------------------------------------
// Platform subscriptions (fiat SaaS tiers) + Animica Workers — docs/subscriptions.md
//
// "AI is free. Put it to work." Tiers attach to the wallet-keyed Account (the identity that
// owns keys, listings, .anm domains and Workers). USD/PayPal accounting here is DELIBERATELY
// separate from the nANM ledger: a tier buys platform capability, never ANM.
// ---------------------------------------------------------------------------

// Tier catalog (like HireService for /hire): rendered on /pricing, PayPal plans minted by
// scripts/subs-setup.ts. `key` is a string (not an enum) so an enterprise/custom tier can be
// added without a type migration. limitsJson overrides the code defaults in lib/planConfig.ts,
// making every limit adjustable without a deploy.
model Plan {
  id            String   @id @default(cuid())
  key           String   @unique // free | starter | pro | operator | business (extensible)
  name          String
  tagline       String   @default("")
  description   String   @default("")
  features      String[] @default([]) // marketing checklist rendered on /pricing
  icon          String   @default("⚡")
  priceUsdCents Int      @default(0) // 999 / 2999 / 7999 / 19999; 0 => free (no PayPal plan)
  paypalPlanId  String? // live PayPal billing plan id; null for the free plan
  limitsJson    String   @default("{}") // JSON overrides merged over PLAN_DEFAULTS[key]
  featured      Boolean  @default(false) // "MOST POPULAR" ribbon (pro)
  active        Boolean  @default(true)
  sortOrder     Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions PlanSubscription[]
}

// One account⇄PayPal-subscription binding. History-preserving: an account may accumulate
// rows over time (drafts, cancels, upgrades); the CURRENT plan is resolved in lib/plan.ts
// (latest row whose status grants entitlements). paypalSubscriptionId is @unique so one
// PayPal subscription can never pay for two rows (P2002 = already linked).
model PlanSubscription {
  id                     String    @id @default(cuid())
  accountId              String
  account                Account   @relation(fields: [accountId], references: [id])
  planKey                String // snapshot of Plan.key at order time
  plan                   Plan      @relation(fields: [planKey], references: [key])
  status                 SubStatus @default(PENDING)
  priceUsdCents          Int // snapshot — what this subscriber actually pays
  paypalPlanId           String? // snapshot — the PayPal plan this sub was approved against
  paypalSubscriptionId   String?   @unique // I-...
  payerEmail             String? // PayPal subscriber email (admin console + receipts)
  currentPeriodEnd       DateTime? // billing_info.next_billing_time; advanced on each SALE.COMPLETED
  graceUntil             DateTime? // dunning window end while PAST_DUE/GRACE_PERIOD
  lastPaymentAt          DateTime?
  lastPaymentAmountCents Int?
  failedPayments         Int       @default(0)
  lastWebhookAt          DateTime?
  lastWebhookType        String?
  lastError              String? // most recent billing problem (shown in /admin/billing)
  canceledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([accountId, status])
  @@index([status, updatedAt])
  @@index([planKey])
}

enum SubStatus {
  PENDING // draft created at checkout start; never granted entitlements
  ACTIVE
  PAST_DUE // payment failed; paid limits kept, user warned, new paid-resource creation blocked
  GRACE_PERIOD // dunning window running out
  SUSPENDED // PayPal suspended / grace lapsed: free limits, Workers paused, config preserved
  CANCELED // terminal for this row (a replayed webhook can never resurrect it)
}

// Processed PayPal webhook deliveries, keyed by PayPal's event id — THE replay/idempotency
// guard (the spec requires persisted event ids; unlike hire, entitlement grants here are not
// all absolute-state writes). Insert-first: a duplicate insert (P2002) short-circuits to 200
// before any state change.
model BillingEvent {
  id             String   @id // PayPal event id (WH-...)
  eventType      String
  resourceId     String? // raw resource.id from the event
  subscriptionId String? // resolved I-... id when determinable
  accountId      String?
  summary        String?
  payloadJson    String   @default("{}")
  processedAt    DateTime @default(now())

  @@index([subscriptionId, processedAt])
  @@index([eventType, processedAt])
}

// Monthly metered usage, bucketed per UTC calendar month (period = 'YYYY-MM'). Consumption is
// an atomic conditional increment (used + n <= limit) — race-safe under concurrent runs.
model UsageCounter {
  id        String   @id @default(cuid())
  accountId String
  feature   String // worker_executions | ...
  period    String // 'YYYY-MM' (UTC)
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([accountId, feature, period])
  @@index([accountId, period])
}

// An Animica Worker: an agent that performs authorized work automatically (scheduled /
// recurring / externally triggered), vs a normal agent that only responds when asked.
// Execution config mirrors Listing's serving config; execution itself is the MediaJob
// claim-lease pattern over WorkerRun rows, driven by scripts/worker-runner.ts.
model Worker {
  id          String       @id @default(cuid())
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  workspaceId String? // optional team scoping (Pro+)
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id])
  name        String
  purpose     String       @default("")
  status      WorkerStatus @default(ACTIVE)
  // Why the worker is DISABLED/PLAN_LIMIT (failure threshold, emergency stop, downgrade...).
  statusReason String?

  // Execution config
  systemPrompt String @default("")
  taskPrompt   String @default("") // what to do on each run
  model        String @default("kimi-k3")
  temperature  Float  @default(0.7)
  toolsJson    String @default("[]") // subset of: "webhook", "anm_publish"
  webhookUrl   String? // https endpoint owned by the user; result POSTed there (SSRF-guarded)
  anmName      String? // .anm name this worker may publish to — must be owned by accountId

  // Schedule
  scheduleKind    String    @default("manual") // manual | interval
  intervalMinutes Int? // clamped to the plan's worker_min_interval_minutes
  nextRunAt       DateTime?
  lastRunAt       DateTime?

  // Safety rails (user-settable within platform caps; enforced by the runner)
  maxRunSeconds       Int @default(120)
  failureThreshold    Int @default(5) // consecutive failures before auto-DISABLED
  consecutiveFailures Int @default(0)

  // External trigger (Operator+): sha256 of a single-purpose anm_trg_ bearer token.
  triggerTokenHash String? @unique

  runsTotal Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs WorkerRun[]

  @@index([accountId, status])
  @@index([status, nextRunAt])
  @@index([workspaceId])
}

enum WorkerStatus {
  ACTIVE
  PAUSED // user-paused; schedule frozen
  DISABLED // kill switch or failure threshold; user must explicitly re-enable
  PLAN_LIMIT // over the plan's worker count after a downgrade; config preserved
}

// One Worker execution. Quota accounting: every run (schedule/manual/external) consumes 1
// from the account's monthly worker_executions counter at enqueue time.
model WorkerRun {
  id           String          @id @default(cuid())
  workerId     String
  worker       Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  accountId    String // denormalized for quota/analytics queries
  status       WorkerRunStatus @default(PENDING)
  trigger      String          @default("schedule") // schedule | manual | external
  priority     Int             @default(0) // plan execution_priority at enqueue time
  attempts     Int             @default(0)
  leaseUntil   DateTime? // heartbeat-extended while RUNNING; expired lease => requeue/fail
  scheduledFor DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  output       String? // truncated result text
  error        String?
  tokensIn     Int             @default(0)
  tokensOut    Int             @default(0)
  logsJson     String          @default("[]") // step log [{t, msg}]
  createdAt    DateTime        @default(now())

  @@index([status, priority, createdAt])
  @@index([workerId, createdAt])
  @@index([accountId, createdAt])
}

enum WorkerRunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
  TIMEOUT
}

// Singleton (id='workers') — the administrator kill switch + runner heartbeat, mirroring
// AnimalEngineState. paused=true stops scheduling AND claiming on the next tick.
model WorkerEngineState {
  id           String    @id @default("workers")
  paused       Boolean   @default(false)
  note         String?
  lastTickAt   DateTime?
  lastTickInfo String?
  updatedAt    DateTime  @updatedAt
}

// Teams/workspaces (Pro+; Business gets many => agency client separation). Access is granted
// ONLY by a WorkspaceMember row — never by knowing an id.
model Workspace {
  id           String   @id @default(cuid())
  ownerId      String
  owner        Account  @relation(fields: [ownerId], references: [id])
  name         String
  kind         String   @default("team") // team | client
  // White-label / custom branding (Operator+), rendered on customer-facing worker views.
  brandName    String?
  brandLogoUrl String?
  brandColor   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members WorkspaceMember[]
  workers Worker[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  role        WorkspaceRole @default(MEMBER)
  status      String        @default("active") // active | inactive_plan_limit
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, accountId])
  @@index([accountId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

// Subscription funnel + adoption analytics (admin dashboard). Deliberately PII-light:
// account ids only, no emails/IPs.
model BillingAnalyticsEvent {
  id          String   @id @default(cuid())
  kind        String // pricing_view | checkout_start | checkout_success | checkout_error | upgrade | downgrade | cancel | payment_failed | reactivation | plan_limit_hit
  accountId   String?
  planKey     String?
  fromPlanKey String?
  meta        String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
}

// ===========================================================================
// ANIMICA PYTHON CLOUD
//
//   "Write Python. Deploy to Animica. Get paid when people use it."
//
// Execution truth model (measured, not assumed — see docs/python-cloud.md):
//   * Animica consensus does NOT execute arbitrary Python. vm_py CALL txs revert on mainnet
//     by design (raw-exec is fail-closed; enabling it would be node RCE). What IS real and
//     consensus-carried is the DEPLOY tx (kind t=1), which stores {code, manifest} bytes in
//     state and lands in a block. So every deployment is ANCHORED on-chain (source hash +
//     artifact hash + DA blob id inside a signed DEPLOY tx) and EXECUTED off-chain, either in
//     a hardened local container or on the Animica compute-provider fleet.
//   * Money is real in both directions: users fund balances with finality-verified on-chain
//     deposits, and developers/providers withdraw through the existing payout worker
//     (`animica tx send`). Every nANM that moves does so through lib/ledger.ts post().
//
// Accounting invariants:
//   * CloudExecution is the authoritative per-execution financial record. Every aggregate
//     shown anywhere (earnings, analytics, /admin/profitability) is reproducible from these
//     rows plus LedgerEntry — never from a mutable counter.
//   * priceNanm = platformFeeNanm + developerNanm + providerNanm   (exactly, no rounding drift)
//   * contributionNanm = platformFeeNanm - cogsNanm                (Animica's real profit)
//   * USD (subscriptions) and nANM (execution economy) are accounted SEPARATELY and only
//     joined for reporting, at an explicitly recorded ANM/USD reference price.
// ===========================================================================

// --- Catalog: apps & functions ---------------------------------------------

// An App is a product: one or more functions, a marketplace listing, its own pricing.
// Deliberately NOT the legacy `Listing` model — apps are Python Cloud native and must not
// inherit the retired AI-marketplace surface.
model CloudApp {
  id          String        @id @default(cuid())
  slug        String        @unique // /apps/[slug]
  ownerId     String
  owner       Account       @relation("CloudAppOwner", fields: [ownerId], references: [id])
  name        String
  tagline     String        @default("")
  description String        @default("")
  category    CloudCategory @default(UTILITIES)
  iconEmoji   String        @default("🐍")
  iconUrl     String?
  bannerUrl   String?
  docsMd      String        @default("")
  tags        String[]      @default([])

  status     CloudStatus     @default(DRAFT)
  visibility CloudVisibility @default(PUBLIC)

  // Pricing is a snapshot-at-purchase concern; these are the CURRENT terms.
  pricingModel CloudPricingModel @default(PAY_PER_USE)
  priceNanm    BigInt            @default(0) // ONE_TIME purchase price / SUBSCRIPTION monthly price
  // Capabilities the app declares it needs; users authorize these before first run.
  capabilities String[]          @default([])

  // Denormalized counters are CACHES ONLY (§92) — every one is recomputable from
  // CloudExecution / CloudAppPurchase / CloudReview and is refreshed by the stats worker.
  execCount     Int    @default(0)
  installCount  Int    @default(0)
  ratingSum     Int    @default(0)
  ratingCount   Int    @default(0)
  revenueNanm   BigInt @default(0)

  publishedAt DateTime?
  suspendedAt DateTime?
  suspendedReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  functions  CloudFunction[]
  purchases  CloudAppPurchase[]
  reviews    CloudReview[]
  executions CloudExecution[]
  agents     CloudAgent[]

  @@index([status, visibility, publishedAt])
  @@index([ownerId])
  @@index([category, status])
}

enum CloudCategory {
  AI
  AGENTS
  DEVELOPER_TOOLS
  AUTOMATION
  DATA
  GAMES
  PRODUCTIVITY
  BLOCKCHAIN
  UTILITIES
  APIS
}

enum CloudStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum CloudVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CloudPricingModel {
  FREE
  PAY_PER_USE // metered: base + resource units (the default)
  ONE_TIME // buy once, then pay-per-use at cost
  SUBSCRIPTION // monthly ANM subscription
}

// A deployed Python function. The unit of execution, pricing and metering.
model CloudFunction {
  id      String   @id @default(cuid())
  ownerId String
  owner   Account  @relation("CloudFunctionOwner", fields: [ownerId], references: [id])
  appId   String?
  app     CloudApp? @relation(fields: [appId], references: [id])

  slug        String // unique per owner — public endpoint is /api/cloud/v1/fn/{ownerSlug}/{slug}
  name        String
  description String @default("")

  runtime    String @default("python3.12")
  entrypoint String @default("main") // module-level callable name

  status     CloudStatus     @default(DRAFT)
  visibility CloudVisibility @default(PUBLIC)

  // Execution envelope. Hard-clamped server-side against CLOUD_LIMITS (never trusted from UI).
  timeoutMs Int @default(30000)
  memoryMb  Int @default(256)

  // Capability grants this function is allowed to request at runtime (AI_INFERENCE, CALL_FUNCTION,
  // READ_CHAIN, SPEND_ANM, PERSIST_STATE, SCHEDULE). Enforced by the sandbox host broker.
  capabilities String[] @default([])

  // Developer-set surcharge, added on top of metered cost. 0 => pure cost-plus metering.
  priceModel     CloudPricingModel @default(PAY_PER_USE)
  perCallNanm    BigInt            @default(0)
  requiresAuth   Boolean           @default(false) // public endpoint requires an API key

  currentVersion Int    @default(0)
  execCount      Int    @default(0) // cache; authoritative count is COUNT(CloudExecution)
  revenueNanm    BigInt @default(0) // cache; authoritative is SUM(CloudExecution.developerNanm)

  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  versions    CloudFunctionVersion[]
  deployments CloudDeployment[]
  executions  CloudExecution[]
  schedules   CloudSchedule[]
  secrets     CloudSecret[]
  agents      CloudAgent[]

  @@unique([ownerId, slug])
  @@index([status, visibility])
  @@index([appId])
}

// Immutable source snapshot. NEVER updated after creation (§6) — a redeploy makes a new row.
model CloudFunctionVersion {
  id         String        @id @default(cuid())
  functionId String
  function   CloudFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  version    Int

  source     String // the Python source, verbatim
  sourceSha3 String // sha3-256(source utf-8), hex — bound into the on-chain anchor
  artifactSha3 String // sha3-256(canonical artifact zip) — what the sandbox actually runs
  sizeBytes  Int

  entrypoint String
  packages   String[] @default([]) // requested packages, validated against the package policy
  envKeys    String[] @default([]) // names only; values live in CloudSecret

  // Validation report produced BEFORE deploy (AST scan, import policy, entrypoint check).
  validationJson String @default("{}")
  estimateNanm   BigInt @default(0) // cost estimate shown to the developer at deploy time

  createdById String
  createdAt   DateTime @default(now())

  deployments CloudDeployment[]
  executions  CloudExecution[]

  @@unique([functionId, version])
  @@index([sourceSha3])
}

// One deployment attempt, tracked through the full lifecycle (§5).
model CloudDeployment {
  id         String               @id @default(cuid())
  functionId String
  function   CloudFunction        @relation(fields: [functionId], references: [id], onDelete: Cascade)
  versionId  String
  version    CloudFunctionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  status CloudDeployStatus @default(DRAFT)

  // Real on-chain anchor: a DEPLOY (t=1) tx whose manifest binds owner+function+hashes+blob.
  daBlobId       String? // da.put blob id (content-addressed source/artifact commitment)
  anchorTxid     String? @unique
  anchorHeight   Int?
  anchorConfirms Int     @default(0)
  registryName   String? // aicf.fn.deploy registry name, when the node registry accepted it

  deployerAddress String? // the wallet that signed the anchor
  endpoint        String? // public URL once ACTIVE

  error     String?
  logsJson  String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activatedAt DateTime?

  @@index([functionId, createdAt])
  @@index([status])
}

enum CloudDeployStatus {
  DRAFT
  VALIDATING
  BUILDING
  AWAITING_SIGNATURE
  BROADCASTING
  CONFIRMING
  ACTIVE
  FAILED
  PAUSED
  ARCHIVED
}

// --- Agents -----------------------------------------------------------------

// A persistent, capability-bounded program with its own Animica identity.
model CloudAgent {
  id      String  @id @default(cuid())
  ownerId String
  owner   Account @relation("CloudAgentOwner", fields: [ownerId], references: [id])

  slug        String  @unique
  name        String
  description String  @default("")
  appId       String?
  app         CloudApp? @relation(fields: [appId], references: [id])
  functionId  String
  function    CloudFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  // The agent's own Animica address — a real bech32m address it can be paid at.
  address String? @unique

  status CloudAgentStatus @default(PAUSED)

  // Autonomy budget. Enforced atomically by the host broker on every spend.
  capabilities     String[] @default([])
  maxSpendPerRunNanm BigInt @default(0)
  dailySpendCapNanm  BigInt @default(0)
  spentTodayNanm     BigInt @default(0)
  spendDayKey        String @default("") // 'YYYY-MM-DD' UTC; reset marker

  lastRunAt DateTime?
  runsTotal Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions CloudExecution[]

  @@index([ownerId, status])
}

enum CloudAgentStatus {
  ACTIVE
  PAUSED
  DISABLED
  SUSPENDED
}

// --- Execution & metering ---------------------------------------------------

// THE authoritative record of one function invocation and its full economics (§8, §75).
model CloudExecution {
  id        String @id @default(cuid())
  requestId String @unique // public, returned in every response + receipt

  functionId String
  function   CloudFunction        @relation(fields: [functionId], references: [id])
  versionId  String
  version    CloudFunctionVersion @relation(fields: [versionId], references: [id])
  appId      String?
  app        CloudApp?            @relation(fields: [appId], references: [id])
  agentId    String?
  agent      CloudAgent?          @relation(fields: [agentId], references: [id])

  // Who paid, who earns. callerAccountId is null for anonymous free-tier calls.
  callerAccountId    String?
  caller             Account? @relation("CloudExecutionCaller", fields: [callerAccountId], references: [id])
  callerKind         String   @default("user") // user | agent | schedule | internal
  developerAccountId String
  developer          Account  @relation("CloudExecutionDeveloper", fields: [developerAccountId], references: [id])
  providerId         String?
  provider           CloudProvider? @relation(fields: [providerId], references: [id])

  // Nested calls (§18). depth 0 = top-level; rootId groups a whole trace.
  parentExecutionId String?
  parent            CloudExecution?  @relation("CloudExecutionTrace", fields: [parentExecutionId], references: [id])
  children          CloudExecution[] @relation("CloudExecutionTrace")
  rootId            String?
  depth             Int              @default(0)

  status     CloudExecStatus @default(QUEUED)
  lane       String          @default("local") // local | fleet
  errorCode  String?
  error      String?
  httpStatus Int?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int       @default(0)

  // Measured resource usage.
  cpuMs        Int    @default(0)
  memoryMbMs   BigInt @default(0)
  aiTokensIn   Int    @default(0)
  aiTokensOut  Int    @default(0)
  aiCalls      Int    @default(0)
  egressBytes  Int    @default(0)
  bytesIn      Int    @default(0)
  bytesOut     Int    @default(0)

  // Customer-facing money (nANM). priceNanm == platformFee + developer + provider, exactly.
  quotedNanm      BigInt @default(0) // pre-authorized reservation
  priceNanm       BigInt @default(0) // final charge
  platformFeeNanm BigInt @default(0)
  developerNanm   BigInt @default(0)
  providerNanm    BigInt @default(0)
  feeBps          Int    @default(2000) // policy SNAPSHOT — historical accounting never rewrites (§88)

  // Internal cost accounting (§74). Never exposed to customers.
  cogsNanm         BigInt @default(0) // total direct variable cost
  cogsAiNanm       BigInt @default(0)
  cogsComputeNanm  BigInt @default(0)
  cogsInfraNanm    BigInt @default(0)
  cogsPromoNanm    BigInt @default(0) // platform-absorbed cost of credit-funded execution
  contributionNanm BigInt @default(0) // platformFeeNanm - cogsNanm (may be negative)
  creditNanm       BigInt @default(0) // portion of priceNanm paid from promotional credits
  billed           Boolean @default(false) // true once the ledger settlement posted
  freeTier         Boolean @default(false) // consumed a free allowance instead of ANM
  pricingPolicyId  String? // which PricingPolicy version priced this execution

  createdAt DateTime @default(now())

  logs CloudExecutionLog[]
  job  CloudJob?

  @@index([functionId, createdAt])
  @@index([developerAccountId, createdAt])
  @@index([callerAccountId, createdAt])
  @@index([status, queuedAt])
  @@index([rootId])
  @@index([appId, createdAt])
  @@index([createdAt])
}

enum CloudExecStatus {
  QUEUED
  DISPATCHED
  RUNNING
  SUCCEEDED
  FAILED
  TIMEOUT
  CANCELLED
  REJECTED
}

// Structured logs, retention-bounded per plan (§30, §72 log_retention).
model CloudExecutionLog {
  id          String         @id @default(cuid())
  executionId String
  execution   CloudExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  ts          DateTime       @default(now())
  level       String         @default("info") // debug | info | warn | error
  message     String
  seq         Int            @default(0)

  @@index([executionId, seq])
  @@index([ts])
}

// --- Compute providers (the fleet) ------------------------------------------

// A node operator serving Python Cloud jobs. Mirrors the proven MediaMiner pattern:
// self-registration, sha3-hashed bearer token, lease-based claiming.
model CloudProvider {
  id        String  @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  address   String // ANM payout address (bech32m)
  name      String  @default("")
  keyHash   String  @unique // sha3-256(bearer token) — raw never stored

  capabilities String[] @default([]) // e.g. ["python3.12", "gpu"]
  cpuCores     Int      @default(1)
  memoryMb     Int      @default(1024)
  gpu          String?

  status       CloudProviderStatus @default(ACTIVE)
  lastSeenAt   DateTime            @default(now())
  jobsClaimed  Int                 @default(0)
  jobsDone     Int                 @default(0)
  jobsFailed   Int                 @default(0)
  reputation   Int                 @default(0)

  // Earnings are REAL spendable ledger credits (posted through lib/ledger.ts), not an IOU.
  // earnedNanm caches SUM(CloudExecution.providerNanm) for this provider.
  earnedNanm BigInt @default(0)

  suspendedReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs       CloudJob[]
  executions CloudExecution[]

  @@index([status, lastSeenAt])
  @@index([address])
}

enum CloudProviderStatus {
  ACTIVE
  IDLE
  SUSPENDED
  DISABLED
}

// A unit of dispatched work. One-to-one with a fleet-lane execution.
model CloudJob {
  id          String         @id @default(cuid())
  executionId String         @unique
  execution   CloudExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  providerId  String?
  provider    CloudProvider? @relation(fields: [providerId], references: [id])

  status     CloudJobStatus @default(PENDING)
  priority   Int            @default(0)
  attempts   Int            @default(0)
  leaseUntil DateTime?

  payloadJson String @default("{}") // artifact ref + packed call, never secrets in the clear
  resultJson  String?
  error       String?

  createdAt  DateTime  @default(now())
  claimedAt  DateTime?
  finishedAt DateTime?

  @@index([status, priority, createdAt])
  @@index([providerId, status])
  @@index([leaseUntil])
}

enum CloudJobStatus {
  PENDING
  CLAIMED
  RUNNING
  DONE
  FAILED
  EXPIRED
}

// --- Capabilities, secrets, schedules ---------------------------------------

// A user's explicit authorization for an app/agent to use sensitive capabilities and
// (optionally) spend ANM on their behalf. Enforced atomically at every spend (§19, §20).
model CloudGrant {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  subjectKind String // app | agent | function
  subjectId   String

  capabilities String[] @default([])

  maxPerCallNanm  BigInt   @default(0)
  maxPerExecNanm  BigInt   @default(0)
  dailyCapNanm    BigInt   @default(0)
  spentTodayNanm  BigInt   @default(0)
  spendDayKey     String   @default("")
  allowedPayees   String[] @default([]) // empty => only functions inside the same app

  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([accountId, subjectKind, subjectId])
  @@index([accountId])
}

// Encrypted developer secret. Ciphertext only; injected into authorized executions and
// redacted from logs (§28).
model CloudSecret {
  id         String         @id @default(cuid())
  ownerId    String
  owner      Account        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  functionId String?
  function   CloudFunction? @relation(fields: [functionId], references: [id], onDelete: Cascade)

  name       String // ENV_STYLE_NAME
  ciphertext String // vault.seal() AES-256-GCM
  hint       String @default("") // last 4 chars, for the UI
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ownerId, functionId, name])
  @@index([ownerId])
}

// Scheduled invocation (§29).
model CloudSchedule {
  id         String        @id @default(cuid())
  functionId String
  function   CloudFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  ownerId    String

  kind            String  @default("interval") // interval | cron
  intervalMinutes Int?
  cron            String?
  payloadJson     String  @default("{}")

  enabled     Boolean   @default(true)
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  lastStatus  String?
  runsTotal   Int       @default(0)
  failures    Int       @default(0)
  disabledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, nextRunAt])
  @@index([ownerId])
}

// --- Marketplace: purchases, reviews, reports -------------------------------

model CloudAppPurchase {
  id        String   @id @default(cuid())
  appId     String
  app       CloudApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  kind            String // one_time | subscription
  amountNanm      BigInt @default(0)
  platformFeeNanm BigInt @default(0)
  developerNanm   BigInt @default(0)
  feeBps          Int    @default(2000) // snapshot (§88)

  status    String    @default("ACTIVE") // ACTIVE | EXPIRED | REFUNDED
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([appId, accountId, kind])
  @@index([accountId, createdAt])
}

// Only genuine users may review: enforced by requiring a purchase or a successful execution.
model CloudReview {
  id        String   @id @default(cuid())
  appId     String
  app       CloudApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rating    Int
  body      String   @default("")
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, accountId])
  @@index([appId, createdAt])
}

model CloudReport {
  id          String   @id @default(cuid())
  subjectKind String // app | function | developer
  subjectId   String
  reporterId  String?
  reason      String
  detail      String   @default("")
  status      String   @default("OPEN") // OPEN | REVIEWING | ACTIONED | DISMISSED
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([subjectKind, subjectId])
}

// Every admin action that touches money, pricing, or availability (§39, §94).
model CloudAuditLog {
  id        String   @id @default(cuid())
  actor     String // admin account id or 'token:<prefix>'
  action    String
  subject   String
  before    String   @default("{}")
  after     String   @default("{}")
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

// A denied code fingerprint — blocks a known-malicious artifact from ever deploying again.
model CloudCodeDenylist {
  sha3      String   @id
  reason    String
  addedBy   String
  createdAt DateTime @default(now())
}

// --- Commercial engine: pricing policy, costs, USD revenue ------------------

// Versioned economic configuration (§59, §94). The ACTIVE row prices new executions; old rows
// are retained so historical accounting is reproducible and never rewritten (§88, §92).
model PricingPolicy {
  id        String   @id @default(cuid())
  version   Int      @unique
  active    Boolean  @default(false)
  note      String   @default("")

  // Customer pricing (nANM).
  baseCallNanm      BigInt @default(100000) // 0.0001 ANM floor per invocation
  cpuMsNanm         BigInt @default(20) // per CPU-millisecond
  memMbMsNanm       BigInt @default(1) // per MB-millisecond
  aiTokenInNanm     BigInt @default(1000)
  aiTokenOutNanm    BigInt @default(3000)
  egressKbNanm      BigInt @default(50)
  gpuMsNanm         BigInt @default(400)

  // Splits (basis points, must sum with platform to 10000).
  platformFeeBps  Int @default(2000) // Animica take rate
  providerShareBps Int @default(1000) // of the total price, when a fleet provider ran it

  // Internal unit COSTS (§74) — what Animica actually pays, in nANM-equivalent.
  costCpuMsNanm    BigInt @default(6)
  costMemMbMsNanm  BigInt @default(1)
  costAiTokenNanm  BigInt @default(400)
  costEgressKbNanm BigInt @default(10)
  costPerCallNanm  BigInt @default(20000) // fixed infra allocation per execution

  // Margin protection (§76).
  targetMarginBps Int @default(6000) // 60%
  enforceMinMargin Boolean @default(true)

  // Free tier (§35, §78).
  freeExecutionsPerDay   Int    @default(50)
  freeExecutionsPerMonth Int    @default(500)
  freeAiTokensPerDay     Int    @default(20000)
  freeTierMonthlyCeilingNanm BigInt @default(0) // 0 => no ceiling configured

  // ANM/USD risk policy (§79).
  anmUsdFloorMicros BigInt @default(0) // price floor used when the market ref is below this

  createdBy String   @default("system")
  createdAt DateTime @default(now())

  executionsPriced Int @default(0)

  @@index([active])
}

// Immutable audit of every pricing change (§94).
model PricingChange {
  id        String   @id @default(cuid())
  actor     String
  field     String
  oldValue  String
  newValue  String
  policyId  String?
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// The ANM/USD reference used for a given financial report. Sourced from the existing
// anm-price feed (nonkyc); NEVER invented (§79).
model AnmPriceSnapshot {
  id         String   @id @default(cuid())
  usdMicros  BigInt // USD price of 1 ANM, in micro-dollars
  source     String // 'nonkyc' | 'manual'
  observedAt DateTime
  createdAt  DateTime @default(now())

  @@index([observedAt])
}

// A verified USD payment (PayPal capture). Authoritative USD revenue record (§70, §81).
model BillingPayment {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  subscriptionId String?
  planKey        String?
  paypalCaptureId String  @unique // idempotency anchor
  paypalSubscriptionId String?
  amountCents    Int
  currency       String   @default("USD")
  status         String   @default("COMPLETED") // COMPLETED | REFUNDED | FAILED
  kind           String   @default("subscription") // subscription | service | enterprise
  payerEmail     String?
  occurredAt     DateTime
  rawJson        String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([accountId, occurredAt])
  @@index([occurredAt])
  @@index([status, occurredAt])
}

// Metered overage beyond a plan's included allowance (§73). Accrues during the period and is
// charged (USD) or debited (ANM) at close.
model UsageCharge {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  period     String // 'YYYY-MM' UTC
  feature    String // executions | compute_units | ai_units | storage_mb
  units      BigInt   @default(0)
  unitPriceCents Int  @default(0)
  amountCents    Int  @default(0)
  amountNanm     BigInt @default(0)
  asset      String   @default("USD") // USD | ANM
  status     String   @default("ACCRUING") // ACCRUING | INVOICED | PAID | WAIVED
  invoicedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountId, period, feature])
  @@index([period, status])
}

// Daily rollup of the whole business (§82). A CACHE — every field is recomputable from
// CloudExecution + BillingPayment + LedgerEntry, and the reconciliation job proves it.
model FinanceDaily {
  day String @id // 'YYYY-MM-DD' UTC

  // ANM economy
  grossVolumeNanm   BigInt @default(0)
  platformRevNanm   BigInt @default(0)
  developerPayNanm  BigInt @default(0)
  providerPayNanm   BigInt @default(0)
  cogsNanm          BigInt @default(0)
  contributionNanm  BigInt @default(0)
  freeTierCogsNanm  BigInt @default(0)

  // USD business
  usdRevenueCents Int @default(0)
  mrrCents        Int @default(0)
  newMrrCents     Int @default(0)
  churnedMrrCents Int @default(0)

  executions      Int @default(0)
  freeExecutions  Int @default(0)
  activeDevelopers Int @default(0)
  payingAccounts  Int @default(0)

  anmUsdMicros BigInt @default(0) // reference price used for this day's USD-equivalents
  computedAt   DateTime @default(now())

  @@index([computedAt])
}

// Daily reconciliation report (§91). Never mutates balances — it only reports.
model ReconciliationReport {
  id        String   @id @default(cuid())
  day       String
  scope     String // anm_ledger | usd_paypal | provider | execution
  ok        Boolean  @default(true)
  expected  String   @default("0")
  observed  String   @default("0")
  deltaAbs  String   @default("0")
  detail    String   @default("{}")
  createdAt DateTime @default(now())

  @@unique([day, scope])
  @@index([ok, createdAt])
}

// Operational + economic alerts surfaced to admins (§90).
model FinanceAlert {
  id         String    @id @default(cuid())
  kind       String // negative_margin | ai_cost_spike | compute_spike | free_tier_abuse | provider_payout | ledger_mismatch | webhook_failure | settlement_failure | payment_failure | usage_anomaly
  severity   String    @default("warn") // info | warn | critical
  title      String
  detail     String    @default("{}")
  subject    String? // execution id / account id / provider id
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt, createdAt])
  @@index([kind, createdAt])
}

// Enterprise sales pipeline (§86).
model EnterpriseInquiry {
  id           String   @id @default(cuid())
  name         String
  company      String
  email        String
  workload     String   @default("")
  aiNeeds      String   @default("")
  computeNeeds String   @default("")
  monthlyExecs String   @default("")
  dedicated    Boolean  @default(false)
  message      String   @default("")
  accountId    String?
  status       String   @default("NEW") // NEW | CONTACTED | QUALIFIED | WON | LOST
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

// --- Founding Developer program ---------------------------------------------

// The first 100 accepted developers. Every benefit here is a REAL, enforced record:
//   * proUntil            -> resolved by the entitlement layer as a Pro-equivalent grant
//   * creditsNanm         -> a CloudCredit grant drawn down before the ANM balance
//   * feeBps / feeUntil   -> overrides the platform take rate for THIS developer's sales,
//                            snapshotted onto every execution and purchase (§88: changing the
//                            global rate never rewrites history, and neither does expiry)
//   * featured            -> marketplace placement flag, gated on a qualifying published app
// seq is assigned atomically at acceptance and is capped at FOUNDING_DEV_SEATS.
model FoundingDeveloper {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  seq       Int?     @unique // 1..100, assigned on acceptance
  status    String   @default("APPLIED") // APPLIED | ACCEPTED | REJECTED | REVOKED

  handle   String @default("")
  email    String @default("")
  pitch    String @default("")

  proUntil     DateTime? // 3 months of Pro from acceptance
  feeBps       Int       @default(1000) // 10% instead of the standard 20%
  feeUntil     DateTime? // one year from acceptance
  creditsNanm  BigInt    @default(0) // granted execution credits
  featured     Boolean   @default(false)

  acceptedAt   DateTime?
  acceptedBy   String?
  revokedAt    DateTime?
  revokedReason String?
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

// Promotional ANM execution credits. Drawn down BEFORE the account's real ledger balance so a
// developer can be given runway without minting spendable/withdrawable ANM. Credit-funded
// executions still pay the developer and provider for real — the platform absorbs that as a
// promo cost recorded in CloudExecution.cogsPromoNanm, so margins stay honest (§74, §75).
model CloudCredit {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grantedNanm BigInt @default(0)
  usedNanm    BigInt @default(0)
  reason      String @default("")
  source      String @default("promo") // promo | founding | support | migration
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdBy   String @default("system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId, expiresAt])
}
