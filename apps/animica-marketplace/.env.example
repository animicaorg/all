# Animica Marketplace — copy to .env (dev) / .env.production (systemd) and fill in.
DATABASE_URL="postgresql://postgres:anm_mkt_local_pw@127.0.0.1:5443/animica_marketplace?schema=public"

# Node RPC (verify payments; read balances). Point DIRECTLY at the node, not the cache.
ANIMICA_RPC_URL="http://127.0.0.1:8545/rpc"

# Inference upstreams:
#  - Free keyless chat-bridge for preview/free-tier chat (call directly to skip nginx per-IP limit).
ANIMICA_FREE_V1="http://127.0.0.1:4600/v1"
#  - Paid pool /v1 for metered marketplace serving (an anm_live_ key; keeps free treasury from draining).
ANIMICA_POOL_V1="http://127.0.0.1:4000/v1"
ANIMICA_POOL_KEY=""            # anm_live_... minted from the pool; REQUIRED for metered serving
ANIMICA_EMBED_MODEL="anm-embed"  # 768-dim; validate length on every response

# Marketplace treasury + payout worker (creator withdrawals). Uses `animica tx send` local-sign.
ANIMICA_CLI="/root/animica/.venv/bin/animica"   # ABSOLUTE path (systemd PATH lacks it — latent-bug lesson)
MKT_TREASURY_LABEL="animica-marketplace"        # wallet label in wallets file, ml_dsa_65
MKT_TREASURY_ADDRESS=""                          # anim1... treasury address (fee sink + payout source)
ANIMICA_WALLETS_FILE="/root/.animica/wallets.json"

# Payout safety caps (animica.net pattern).
PAYOUT_ENABLED="0"                 # 1 to arm the payout worker
PAYOUT_MAX_PER_TX_ANM="5000"
PAYOUT_MAX_PER_DAY_ANM="20000"
PAYOUT_CONFIRM_SECS="120"
TX_FINALITY_CONFIRMATIONS="12"

# Economics.
MKT_FEE_BPS="2000"                 # 20% marketplace fee (basis points)
MIN_WITHDRAWAL_ANM="1"

# Auth.
SESSION_SECRET="change-me-in-prod"  # HMAC secret for wallet-login session cookies
PUBLIC_BASE_URL="https://animica.dev"

# ── Platform subscription tiers + Animica Workers (docs/subscriptions.md) ──
# PayPal REST app creds are shared with the hire vertical (PAYPAL_ENV/PAYPAL_CLIENT_ID/
# PAYPAL_CLIENT_SECRET in .env.production). The tiers use their OWN webhook registration:
# run `npx tsx scripts/subs-setup.ts --webhook https://animica.dev/api/mkt/v1/billing/paypal/webhook`
# and paste the printed id here. Value must be '$'-free (all PayPal ids are).
SUBS_PAYPAL_WEBHOOK_ID=""
SUBS_GRACE_DAYS="7"                # dunning window after a failed payment

# Worker runner (systemd timer animica-workers.timer -> scripts/worker-runner.ts).
# Disarmed by default (observe-only): set 1 in .env.production to arm.
WORKERS_ENABLED="0"
# Infrastructure safety caps — separate from plan limits; apply to EVERY tier.
WORKER_MAX_RUN_SECONDS="300"       # hard per-run duration ceiling
WORKERS_GLOBAL_CONCURRENCY="4"     # max simultaneously RUNNING runs, whole platform
WORKERS_MAX_PER_TICK="25"          # max runs executed per timer tick
WORKER_MAX_ATTEMPTS="2"            # attempts before a run is FAILED
