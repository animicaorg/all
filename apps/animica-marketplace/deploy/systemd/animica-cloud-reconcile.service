# Animica Python Cloud — daily financial reconciliation oneshot (§91/§92). Refreshes the
# FinanceDaily rollup for the closed UTC day, then verifies: Account.balanceNanm == SUM(ledger),
# execution price == split == ledger-net-zero, PayPal captures vs subscription state, and
# CloudProvider.earnedNanm vs execution truth. NEVER modifies balances — reports + alerts only.
# TEMPLATE ONLY — this repo file is NOT installed/enabled by the Python Cloud change itself.
# INSTALL (operator):
#   cp deploy/systemd/animica-cloud-reconcile.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now animica-cloud-reconcile.timer
# ARM (persists ReconciliationReport/FinanceAlert/FinanceDaily rows; default below computes and
# logs without writing): set CLOUD_RECONCILE_ENABLED=1 in .env.production.

[Unit]
Description=Animica Python Cloud daily reconciliation (FinanceDaily rollup + 4-scope comparison: anm_ledger, execution, usd_paypal, provider; mismatch -> critical FinanceAlert)
Documentation=file:/root/animica/apps/animica-marketplace/scripts/cloud-reconcile.ts
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/animica/apps/animica-marketplace
# Conservative defaults — .env.production (EnvironmentFile) overrides these to arm.
Environment=CLOUD_RECONCILE_ENABLED=0
EnvironmentFile=/root/animica/apps/animica-marketplace/.env.production
# flock = first belt (whole-run single instance); the worker's pg advisory lock is the second.
ExecStart=/usr/bin/flock -n /run/lock/animica-cloud-reconcile.lock /root/animica/apps/animica-marketplace/node_modules/.bin/tsx scripts/cloud-reconcile.ts
NoNewPrivileges=true
