# TEMPLATE ONLY — install per the .service header; not enabled by the repo change.
[Unit]
Description=Run the Animica Python Cloud scheduler every minute (minute granularity matches the enterprise 1-min schedule floor)

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=15s
Persistent=true

[Install]
WantedBy=timers.target
