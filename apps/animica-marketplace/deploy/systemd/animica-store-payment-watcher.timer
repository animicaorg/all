# TEMPLATE ONLY — install per the .service header; not enabled by the repo change.
[Unit]
Description=Run the Animica store payment watcher every minute (12-conf finality makes latency minutes anyway)

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=15s
Persistent=true

[Install]
WantedBy=timers.target
