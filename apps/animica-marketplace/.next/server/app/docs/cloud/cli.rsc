.cdoc{display:grid;grid-template-columns:230px minmax(0,1fr);gap:36px;align-items:start;padding:30px 0 60px}
.cd-toc{position:sticky;top:80px;display:grid;gap:2px;font-size:13.5px}
.cd-toc a{display:block;padding:6px 10px;border-radius:8px;color:var(--text-dim);min-height:22px}
.cd-toc a:hover{background:var(--bg-card);color:var(--text)}
.cd-toc a.active{background:rgba(108,92,255,0.1);color:var(--text);border-left:2px solid var(--accent);border-radius:4px 8px 8px 4px}
.cd-toc-back{color:var(--text-faint) !important;margin-bottom:8px}
.cd-toc-grp{margin-top:12px;font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--text-faint);padding:0 10px}
.cd-main{min-width:0}
.cd-main h1{font-size:32px;letter-spacing:-0.03em;margin:0 0 8px;font-weight:800}
.cd-main .cd-lead{font-size:16.5px;color:var(--text-dim);line-height:1.6;margin:0 0 24px;max-width:720px}
.cd-main h2{font-size:21px;letter-spacing:-0.02em;margin:34px 0 8px;scroll-margin-top:80px}
.cd-main h3{font-size:16px;margin:22px 0 6px}
.cd-main p,.cd-main li{color:var(--text-dim);font-size:14.5px;line-height:1.7}
.cd-main li{margin:4px 0}
.cd-main b,.cd-main strong{color:var(--text)}
.cd-main a{color:#a99bff}
.cd-main a:hover{text-decoration:underline}
.cd-codewrap{margin:12px 0;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--bg-elev)}
.cd-codetitle{font-size:11.5px;color:var(--text-faint);padding:7px 13px;border-bottom:1px solid var(--border)}
.cd-code{margin:0;padding:13px 14px;overflow-x:auto;font:12.5px/1.65 var(--mono);color:#cdd6ee;background:transparent}
.cd-k{font-family:var(--mono);background:var(--bg-elev);border:1px solid var(--border);padding:1px 6px;border-radius:6px;font-size:12.5px;color:#bfe9ff}
.cd-callout{border:1px solid var(--border-bright);border-left:3px solid var(--accent-2);border-radius:10px;padding:11px 14px;margin:14px 0;font-size:13.5px;color:var(--text-dim);line-height:1.6}
.cd-callout b{color:var(--text)}
.cd-tablewrap{overflow-x:auto;margin:12px 0;border:1px solid var(--border);border-radius:10px}
.cd-table{width:100%;border-collapse:collapse;font-size:13px;min-width:520px}
.cd-table th,.cd-table td{border-bottom:1px solid var(--border);padding:8px 12px;text-align:left;vertical-align:top;color:var(--text-dim)}
.cd-table th{color:var(--text);background:var(--bg-elev);font-size:12px;letter-spacing:.03em;white-space:nowrap}
.cd-table tr:last-child td{border-bottom:0}
.cd-table code,.cd-main td code{font-family:var(--mono);font-size:12px;color:#bfe9ff}
.cd-pagenav{display:flex;justify-content:space-between;gap:10px;margin-top:44px;border-top:1px solid var(--border);padding-top:20px}
@media (max-width:860px){
  .cdoc{grid-template-columns:1fr;gap:14px;padding-top:16px}
  .cd-toc{position:static;display:flex;overflow-x:auto;gap:6px;padding-bottom:10px;border-bottom:1px solid var(--border);-webkit-overflow-scrolling:touch}
  .cd-toc a{white-space:nowrap;padding:8px 12px;border:1px solid var(--border);border-radius:999px;min-height:40px;display:flex;align-items:center}
  .cd-toc a.active{border-color:var(--accent);border-left-width:1px;border-radius:999px}
  .cd-toc-grp{display:none}
  .cd-toc-back{margin-bottom:0}
  .cd-main h1{font-size:26px}
}
0:["CI4D0U37ctSra0TUSKWsl",[[["",{"children":["docs",{"children":["cloud",{"children":["cli",{"children":["__PAGE__",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["docs",{"children":["cloud",{"children":["cli",{"children":["__PAGE__",{},[["$L1",[["$","h1",null,{"children":"CLI"}],["$","p",null,{"className":"cd-lead","children":["Python Cloud is operated over its REST API — every operation is one curl away, and the"," ",["$","code",null,{"className":"cd-k","children":"idempotency-key"}]," header makes scripted retries safe. The pip-installed ",["$","code",null,{"className":"cd-k","children":"animica"}]," CLI covers the chain side: wallets, balances and transfers."]}],["$","div",null,{"className":"cd-callout","style":"$undefined","children":[["$","b",null,{"children":"Honest status:"}]," a dedicated ",["$","code",null,{"className":"cd-k","children":"animica cloud"}]," subcommand does not ship yet — the REST workflows below are the supported terminal path today (they are exactly what the web console calls). The platform itself uses the ",["$","code",null,{"className":"cd-k","children":"animica"}]," CLI under the hood to sign and broadcast the on-chain anchor DEPLOY transactions."]}],["$","h2",null,{"children":"Deploy from the terminal"}],["$","div",null,{"className":"cd-codewrap","children":[["$","div",null,{"className":"cd-codetitle mono","children":"deploy.sh"}],["$","pre",null,{"className":"cd-code","children":["$","code",null,{"children":"# deploy.sh — create once, then push versions. Plain REST; nothing to install but curl+jq.\nBASE=https://animica.dev/api/cloud/v1\nAUTH=\"authorization: Bearer $ANM_KEY\"\n\n# 1) create the function shell (idempotent with an idempotency-key)\nFN_ID=$(curl -s \"$BASE/functions\" -H \"$AUTH\" -H 'content-type: application/json' \\\n  -H \"idempotency-key: create-hello-1\" \\\n  -d '{\"slug\":\"hello\",\"timeoutMs\":10000,\"memoryMb\":128}' | jq -r '.function.id')\n\n# 2) push source as the next immutable version and deploy it\njq -Rs '{source: ., entrypoint: \"main\"}' < handler.py | \\\n  curl -s \"$BASE/functions/$FN_ID/versions\" -H \"$AUTH\" \\\n       -H 'content-type: application/json' -d @- | \\\n  jq '{version: .version.version, status: .deployment.status, anchor: .deployment.anchorTxid}'"}]}]]}],["$","h2",null,{"children":"Operate from the terminal"}],["$","div",null,{"className":"cd-codewrap","children":[["$","div",null,{"className":"cd-codetitle mono","children":"logs, history, rollback, earnings"}],["$","pre",null,{"className":"cd-code","children":["$","code",null,{"children":"# day-2 operations, same pattern\ncurl -s \"$BASE/functions/$FN_ID/executions?limit=20\" -H \"$AUTH\" | jq       # history + money\ncurl -s \"$BASE/functions/$FN_ID/logs?limit=100\" -H \"$AUTH\" | jq            # redacted logs\ncurl -s \"$BASE/functions/$FN_ID/rollback\" -H \"$AUTH\" -X POST \\\n     -H 'content-type: application/json' -d '{\"version\": 1}' | jq          # roll back\ncurl -s \"$BASE/me/earnings?days=30\" -H \"$AUTH\" | jq                        # earnings"}]}]]}],["$","h2",null,{"children":"Chain-side: the animica CLI"}],["$","div",null,{"className":"cd-codewrap","children":[["$","div",null,{"className":"cd-codetitle mono","children":"wallets and balances"}],["$","pre",null,{"className":"cd-code","children":["$","code",null,{"children":"# the pip-installed animica CLI handles the CHAIN side: wallets, balances, transfers\npip install -U animica\n\nanimica wallet create --label me\nanimica wallet list\nanimica account balance anim1…            # check any address\n# fund your platform balance by sending ANM to your deposit address (Developer Center)"}]}]]}],["$","p",null,{"children":["Get an API key in the ",["$","a",null,{"href":"/dev","children":"Developer Center"}],". Keys are scoped (",["$","code",null,{"className":"cd-k","children":"read"}],","," ",["$","code",null,{"className":"cd-k","children":"publish"}],", …) — mint one per automation with only the scopes it needs, and rotate it there too."]}],["$","h2",null,{"children":"Verify a deployment yourself"}],["$","p",null,{"children":["Every anchored deployment can be independently audited from any Animica node: fetch the DA blob by its id (",["$","code",null,{"className":"cd-k","children":"da.get"}],"), SHA3-256 the bytes (they must equal the blob id), read the bundle's"," ",["$","code",null,{"className":"cd-k","children":"source"}]," and re-hash it against the ",["$","code",null,{"className":"cd-k","children":"sourceSha3"}]," bound in the anchor transaction's manifest. No trust in the platform required — that is the point of anchoring."]}],["$","div",null,{"className":"cd-pagenav","children":[["$","a",null,{"className":"btn ghost","href":"/docs/cloud/sdk","children":["← ","Python SDK"]}],["$","a",null,{"className":"btn ghost","href":"/docs/cloud/security","children":["Security"," →"]}]]}]],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","docs","children","cloud","children","cli","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"className":"wrap","children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"$4"}}],["$","div",null,{"className":"cdoc","children":[["$","$L5",null,{"sections":[{"href":"/docs/cloud","label":"Quickstart","group":"Start"},{"href":"/docs/cloud/runtime","label":"Runtime & ABI"},{"href":"/docs/cloud/packages","label":"Supported packages"},{"href":"/docs/cloud/functions","label":"Functions","group":"Build"},{"href":"/docs/cloud/apps","label":"Apps"},{"href":"/docs/cloud/agents","label":"Agents & schedules"},{"href":"/docs/cloud/ai","label":"AI"},{"href":"/docs/cloud/capabilities","label":"Capabilities & permissions"},{"href":"/docs/cloud/pricing","label":"Pricing & economics","group":"Earn"},{"href":"/docs/cloud/earnings","label":"Wallets & earnings"},{"href":"/docs/cloud/providers","label":"Compute providers"},{"href":"/docs/cloud/api","label":"REST API","group":"Reference"},{"href":"/docs/cloud/sdk","label":"Python SDK"},{"href":"/docs/cloud/cli","label":"CLI"},{"href":"/docs/cloud/security","label":"Security"},{"href":"/docs/cloud/examples","label":"Examples"}]}],["$","main",null,{"className":"cd-main","children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","docs","children","cloud","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]]}]]}]],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","docs","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/674123f529c04b78.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"children":[["$","nav",null,{"className":"nav","children":["$","div",null,{"className":"wrap nav-in","children":[["$","a",null,{"className":"brand","href":"/","children":[["$","span",null,{"className":"dot"}],"Animica ",["$","small",null,{"children":"cloud"}]]}],["$","$L6",null,{"links":[{"href":"/ai","label":"AI"},{"href":"/apps","label":"Apps"},{"href":"/functions","label":"Functions"},{"href":"/agents","label":"Agents"},{"href":"/compute","label":"Compute"},{"href":"/developers","label":"Developers"},{"href":"/docs","label":"Docs"},{"href":"/pricing","label":"Pricing"}],"cta":{"href":"/cloud","label":"Deploy"}}]]}]}],["$","$L2",null,{"parallelRouterKey":"children","segment