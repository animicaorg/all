ldren":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"jinja2"}]}],["$","td","1",{"children":"3.1.4"}],["$","td","2",{"children":"templating"}]]}],["$","tr","6",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"markdown"}]}],["$","td","1",{"children":"3.7"}],["$","td","2",{"children":"Markdown → HTML"}]]}],["$","tr","7",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"beautifulsoup4"}]}],["$","td","1",{"children":"4.12.3"}],["$","td","2",{"children":"HTML parsing (import bs4)"}]]}],["$","tr","8",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"pillow"}]}],["$","td","1",{"children":"11.0.0"}],["$","td","2",{"children":"image processing (import PIL)"}]]}],["$","tr","9",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"cryptography"}]}],["$","td","1",{"children":"44.0.0"}],["$","td","2",{"children":"hashing, HMAC, symmetric/asymmetric crypto"}]]}],["$","tr","10",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"pydantic"}]}],["$","td","1",{"children":"2.10.3"}],["$","td","2",{"children":"data validation"}]]}]]}]]}]}],["$","p",null,{"children":["Declare what you use in the deploy request (both pip names and import names are accepted, e.g."," ",["$","code",null,{"className":"cd-k","children":"bs4"}]," or ",["$","code",null,{"className":"cd-k","children":"beautifulsoup4"}],"). An unsupported package is refused at deploy time with a clear"," ",["$","code",null,{"className":"cd-k","children":"422 unsupported_package"}]," — turning what would be a guaranteed runtime ",["$","code",null,{"className":"cd-k","children":"ImportError"}]," into an immediate message. At most 16 packages per function."]}],["$","div",null,{"className":"cd-codewrap","children":[["$","div",null,{"className":"cd-codetitle mono","children":"deploying with packages"}],["$","pre",null,{"className":"cd-code","children":["$","code",null,{"children":"# declare packages when deploying a version:\n{\"source\": \"…\", \"entrypoint\": \"main\", \"packages\": [\"numpy\", \"pandas\"]}"}]}]]}],["$","h2",null,{"children":"Why there is no HTTP client"}],["$","p",null,{"children":[["$","code",null,{"className":"cd-k","children":"requests"}],", ",["$","code",null,{"className":"cd-k","children":"httpx"}]," and ",["$","code",null,{"className":"cd-k","children":"aiohttp"}]," are deliberately absent, and stdlib network modules (",["$","code",null,{"className":"cd-k","children":"socket"}],", ",["$","code",null,{"className":"cd-k","children":"http"}],", ",["$","code",null,{"className":"cd-k","children":"urllib"}],") are rejected by the validator. The sandbox container is started with ",["$","code",null,{"className":"cd-k","children":"--network none"}],": there is no network interface inside it at all, so an HTTP client would have nothing to talk to. The ",["$","b",null,{"children":"only"}]," outbound path is"," ",["$","code",null,{"className":"cd-k","children":"animica.http.fetch"}],", which the host performs on your behalf — https-only, SSRF-guarded (private/loopback/internal targets blocked, DNS re-checked at request time, redirects not followed), size-capped and metered as egress. See ",["$","a",null,{"href":"/docs/cloud/security","children":"Security"}],"."]}],["$","h2",null,{"children":"Why pip at runtime is impossible"}],["$","p",null,{"children":[["$","code",null,{"className":"cd-k","children":"pip install"}]," needs the network, and the sandbox has none — by construction, not by policy. The validator additionally rejects ",["$","code",null,{"className":"cd-k","children":"pip"}],"/",["$","code",null,{"className":"cd-k","children":"setuptools"}],"/",["$","code",null,{"className":"cd-k","children":"distutils"}]," imports at deploy time so the failure is explained early. Packages exist in exactly one place: the runtime image (",["$","code",null,{"className":"cd-k","children":"sandbox/Dockerfile"}],"), where they are version-pinned so every function on the platform runs the same audited set. The pinned versions are part of the canonical artifact manifest that gets anchored on-chain with your deployment."]}],["$","div",null,{"className":"cd-callout","style":"$undefined","children":["Need a package that is not here? The set is curated on request — additions ship as a new runtime image version, never as per-function installs. Ask via the"," ",["$","a",null,{"href":"/docs/cloud/api","children":"reports/enterprise API"}]," or the Developer Center."]}],["$","h2",null,{"children":"Blocked stdlib modules"}],["$","p",null,{"children":"The deploy-time validator refuses modules that cannot work in the sandbox or only make sense as an attack, with the reason in the finding:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","b",null,{"children":"No network:"}]," ",["$","code",null,{"className":"cd-k","children":"socket"}],", ",["$","code",null,{"className":"cd-k","children":"socketserver"}],", ",["$","code",null,{"className":"cd-k","children":"http"}],", ",["$","code",null,{"className":"cd-k","children":"urllib"}],", ",["$","code",null,{"className":"cd-k","children":"ftplib"}],","," ",["$","code",null,{"className":"cd-k","children":"smtplib"}],", ",["$","code",null,{"className":"cd-k","children":"telnetlib"}]]}],["$","li",null,{"children":[["$","b",null,{"children":"No subprocesses / native access:"}]," ",["$","code",null,{"className":"cd-k","children":"subprocess"}],", ",["$","code",null,{"className":"cd-k","children":"ctypes"}],", ",["$","code",null,{"className":"cd-k","children":"multiprocessing"}],","," ",["$","code",null,{"className":"cd-k","children":"fcntl"}],", ",["$","code",null,{"className":"cd-k","children":"mmap"}],", ",["$","code",null,{"className":"cd-k","children":"pty"}],", ",["$","code",null,{"className":"cd-k","children":"tty"}]]}],["$","li",null,{"children":[["$","b",null,{"children":"Runtime integrity:"}]," "