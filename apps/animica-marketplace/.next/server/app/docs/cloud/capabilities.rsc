_APP-api",{"children":"animica.call into an app’s functions"}]}],["$","td","2",{"children":"like CALL_FUNCTION, scoped to app targets"}],["$","td","3",{"children":"yes"}]]}],["$","tr","3",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"READ_CHAIN"}]}],["$","td","1",{"children":["$","code","READ_CHAIN-api",{"children":"animica.chain.head / balance"}]}],["$","td","2",{"children":"read-only Animica chain access"}],["$","td","3",{"children":"no"}]]}],["$","tr","4",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"SPEND_ANM"}]}],["$","td","1",{"children":["$","code","SPEND_ANM-api",{"children":"animica.wallet.pay / balance"}]}],["$","td","2",{"children":"pay ANM from the CALLER’s balance, inside their granted caps"}],["$","td","3",{"children":"yes"}]]}],["$","tr","5",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"PERSIST_STATE"}]}],["$","td","1",{"children":["$","code","PERSIST_STATE-api",{"children":"animica.state.get / set / delete"}]}],["$","td","2",{"children":"per-function encrypted key/value store"}],["$","td","3",{"children":"no"}]]}],["$","tr","6",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"SCHEDULE"}]}],["$","td","1",{"children":["$","code","SCHEDULE-api",{"children":"CloudSchedule"}]}],["$","td","2",{"children":"the function is allowed to be driven by schedules"}],["$","td","3",{"children":"no"}]]}],["$","tr","7",{"children":[["$","td","0",{"children":["$","code",null,{"className":"cd-k","children":"HTTP_FETCH"}]}],["$","td","1",{"children":["$","code","HTTP_FETCH-api",{"children":"animica.http.fetch"}]}],["$","td","2",{"children":"host-mediated outbound HTTPS with SSRF guards"}],["$","td","3",{"children":"yes"}]]}]]}]]}]}],["$","h2",null,{"children":"Two layers of consent"}],["$","ol",null,{"children":[["$","li",null,{"children":[["$","b",null,{"children":"The developer declares"}]," capabilities on the function at deploy time. The deploy-time validator infers which capabilities the source appears to use (advisory, to pre-fill the UI) — but enforcement never trusts the source: the host broker checks the ",["$","b",null,{"children":"declared"}]," list on every host call and refuses anything undeclared with ",["$","code",null,{"className":"cd-k","children":"CapabilityDenied"}],"."]}],["$","li",null,{"children":[["$","b",null,{"children":"The caller grants"}]," the sensitive subset (","SPEND_ANM, CALL_APP, CALL_FUNCTION, HTTP_FETCH",") explicitly, per app/agent/function, with hard budget bounds. No grant, no spend — even if the capability is declared."]}]]}],["$","div",null,{"className":"cd-codewrap","children":[["$","div",null,{"className":"cd-codetitle mono","children":"grants API"}],["$","pre",null,{"className":"cd-code","children":["$","code",null,{"children":"# a user authorizes an app once, with hard bounds; revocable any time\nPOST /api/cloud/v1/grants\n{\n  \"subjectKind\": \"app\", \"subjectId\": \"…\",\n  \"capabilities\": [\"SPEND_ANM\"],\n  \"maxPerCallNanm\": \"1000000\",\n  \"maxPerExecNanm\": \"5000000\",\n  \"dailyCapNanm\": \"50000000\",\n  \"allowedPayees\": [\"anim1…\"]\n}\nDELETE /api/cloud/v1/grants?id=…   # takes effect on the very next host call"}]}]]}],["$","h2",null,{"children":"How SPEND_ANM actually moves money"}],["$","ul",null,{"children":[["$","li",null,{"children":"User code never touches a key. It asks the host to pay; the host verifies everything."}],["$","li",null,{"children":["Checks on every payment, atomically: grant exists, not revoked/expired, includes"," ",["$","code",null,{"className":"cd-k","children":"SPEND_ANM"}],"; amount within ",["$","code",null,{"className":"cd-k","children":"maxPerCallNanm"}],"; recipient in ",["$","code",null,{"className":"cd-k","children":"allowedPayees"}]," (when set); running total within ",["$","code",null,{"className":"cd-k","children":"maxPerExecNanm"}],"; UTC-day total within ",["$","code",null,{"className":"cd-k","children":"dailyCapNanm"}]," ","(conditional-update claim — concurrent executions cannot double-spend the last allowance); and the whole call tree's budget not exceeded."]}],["$","li",null,{"children":"The transfer itself is two balanced ledger postings (payer debit, payee credit) in one transaction — nothing is minted, nothing is lost."}]]}],["$","div",null,{"className":"cd-callout","style":"$undefined","children":[["$","b",null,{"children":"Why this is real security, not advisory:"}]," the sandbox has no network, no credentials and no keys — every privileged operation must pass through the broker, and the broker authorizes against the deployment row, the grant row and the live budgets, never against anything the guest sent. Revocation is read fresh at every spend, so it takes effect immediately."]}],["$","h2",null,{"children":"Failure codes your code will see"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","code",null,{"className":"cd-k","children":"animica.CapabilityDenied"}]," — capability not declared, or the caller's grant is missing / revoked / doesn't cover it."]}],["$","li",null,{"children":[["$","code",null,{"className":"cd-k","children":"animica.BudgetExceeded"}]," — a spend/AI/call budget, quota or per-day cap would be exceeded."]}],["$","li",null,{"children":[["$","code",null,{"className":"cd-k","children":"animica.AnimicaError"}]," — any other host-side failure (upstream unavailable, bad request…)."]}]]}],["$","div",null,{"className":"cd-pagenav","children":[["$","a",null,{"className":"btn ghost","href":"/docs/cloud/ai","children":["← ","AI"]}],["$","a",null,{"className":"btn ghost","href":"/docs/cloud/pricing","children":["Pricing & economics"," →"]}]]}]],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","docs","children","cloud","children","capabilities","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3"