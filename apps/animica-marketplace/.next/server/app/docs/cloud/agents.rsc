ildren":["Status: ",["$","code",null,{"className":"cd-k","children":"ACTIVE"}]," / ",["$","code",null,{"className":"cd-k","children":"PAUSED"}]," / ",["$","code",null,{"className":"cd-k","children":"DISABLED"}]," / ",["$","code",null,{"className":"cd-k","children":"SUSPENDED"}]," — anything but ACTIVE refuses runs."]}]]}],["$","h2",null,{"children":"Agent-to-agent calls"}],["$","p",null,{"children":["Inside any execution, ",["$","code",null,{"className":"cd-k","children":"animica.call(\"owner/slug\", payload)"}]," invokes another published function as a nested execution in the same call tree:"]}],["$","div",null,{"className":"cd-codewrap","children":[["$","div",null,{"className":"cd-codetitle mono","children":"nested execution"}],["$","pre",null,{"className":"cd-code","children":["$","code",null,{"children":"import animica\n\ndef main(request, ctx):\n    # delegate to another published function — a real nested execution\n    res = animica.call(\"examples/anm-toolkit\", {\"op\": \"convert\", \"anm\": \"0.25\"})\n    return {\"delegated\": res[\"status\"], \"cost_nanm\": res[\"cost_nanm\"], \"out\": res[\"result\"]}"}]}]]}],["$","div",null,{"className":"cd-tablewrap","children":["$","table",null,{"className":"cd-table","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"children":"guard"}],["$","th","1",{"children":"value"}],["$","th","2",{"children":"behavior when exceeded"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$","td","0",{"children":"call depth"}],["$","td","1",{"children":"4"}],["$","td","2",{"children":["$","code",null,{"className":"cd-k","children":"depth_exceeded"}]}]]}],["$","tr","1",{"children":[["$","td","0",{"children":"calls per execution"}],["$","td","1",{"children":"16"}],["$","td","2",{"children":["$","code",null,{"className":"cd-k","children":"budget_exceeded"}]}]]}],["$","tr","2",{"children":[["$","td","0",{"children":"shared spend budget"}],["$","td","1",{"children":"the root caller’s authorization (maxSpendNanm or the pre-execution estimate)"}],["$","td","2",{"children":["$","code",null,{"className":"cd-k","children":"budget_exceeded — refused before the nested call runs"}]}]]}],["$","tr","3",{"children":[["$","td","0",{"children":"self-calls"}],["$","td","1",{"children":"never allowed"}],["$","td","2",{"children":["$","code",null,{"className":"cd-k","children":"recursion"}]}]]}]]}]]}]}],["$","p",null,{"children":["Each hop returns ",["$","code",null,{"className":"cd-k","children":"{status, result, request_id, cost_nanm}"}],", and every nested run is a real execution row with ",["$","code",null,{"className":"cd-k","children":"parentExecutionId"}],"/",["$","code",null,{"className":"cd-k","children":"rootId"}],"/",["$","code",null,{"className":"cd-k","children":"depth"}]," — the whole trace is reconstructable and billed transparently. The working"," ",["$","a",null,{"href":"/docs/cloud/examples","children":"agent-calls-app example"}]," shows a paid nested call end to end."]}],["$","h2",null,{"children":"Schedules"}],["$","div",null,{"className":"cd-codewrap","children":[["$","div",null,{"className":"cd-codetitle mono","children":"create a schedule"}],["$","pre",null,{"className":"cd-code","children":["$","code",null,{"children":"POST /api/cloud/v1/schedules\n{ \"functionId\": \"…\", \"kind\": \"interval\", \"intervalMinutes\": 60, \"payload\": {} }\n\n# or 5-field UTC cron (minute hour dom month dow; Vixie dom/dow semantics):\n{ \"functionId\": \"…\", \"kind\": \"cron\", \"cron\": \"*/15 * * * *\" }"}]}]]}],["$","ul",null,{"children":[["$","li",null,{"children":["The scheduler fires due schedules through the normal execution path — ",["$","code",null,{"className":"cd-k","children":"callerKind: \"schedule\""}],", the schedule's ",["$","b",null,{"children":"owner"}]," as the paying account, full admission control applied. Since the owner is usually the function's developer, scheduled runs of your own function consume plan quota rather than ANM."]}],["$","li",null,{"children":["Minimum interval is your plan's ",["$","code",null,{"className":"cd-k","children":"min_schedule_minutes"}]," (Free: hourly · Developer: 15 min · Pro/Business: 5 min), never below the platform floor of ",5," minutes."]}],["$","li",null,{"children":"Soft failures (quota, funds, capacity) defer the run; hard failures count toward auto-disable after 5 consecutive failures, with the reason recorded on the schedule."}],["$","li",null,{"children":["Use ",["$","code",null,{"className":"cd-k","children":"animica.state"}]," for memory between runs — see the working"," ",["$","a",null,{"href":"/docs/cloud/examples","children":"scheduled-agent example"}],"."]}]]}],["$","div",null,{"className":"cd-callout","style":"$undefined","children":"Schedules and agent budgets are enforced by the backend — the scheduler adds nothing money-shaped of its own, so there is no path where an agent \"runs for free\" or outspends its caps."}],["$","div",null,{"className":"cd-pagenav","children":[["$","a",null,{"className":"btn ghost","href":"/docs/cloud/apps","children":["← ","Apps"]}],["$","a",null,{"className":"btn ghost","href":"/docs/cloud/ai","children":["AI"," →"]}]]}]],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","docs","children","cloud","children","agents","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"className":"wrap","children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"$4"}}],["$","div",null,{"className":"cdoc","children":[["$","$L5",null,{"sections":[{"href":"/docs/cloud","label":"Quickstart","group":"Start"},{"href":"/docs/cloud/runtime","label":"Runtime & ABI"},{"href":"/docs/cloud/packages","label":"Supported packages"},{"href":"/docs/cloud/functions","label":"Functions"